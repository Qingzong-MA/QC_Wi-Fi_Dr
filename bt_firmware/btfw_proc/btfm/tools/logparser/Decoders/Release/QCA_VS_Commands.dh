     {0x00 "Info"}
     {0x01 "Warning"}
     {0x02 "Error"}
     {0x03 "Debug"}
     {Default "Invalid Status Type"}
ENDTABLE

GROUP gAudioOffloadVSEvent_AOF_STATUS_IND "AOF Status Indication"
{
     FIELD gAOF_STATUS_IND_Status_Type         (Fixed 1 byte) (Table tAOF_STATUS_IND_Status_Type) "Status Type"
     FIELD gAOF_STATUS_IND_Status_Sub_TypeType (Fixed 2 byte) (Hex)                               "Status Sub Type"
     FIELD gAOF_STATUS_IND_Status_Payload (toendoflayer) IF(MoreBytes) (stringofhex)              "Status payload"
}

