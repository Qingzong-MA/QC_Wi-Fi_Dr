    <TAG Number="1" Name="BUILD_LABEL">
      <DESCRIPTION>Fixed Array to represent BUILD LABEL in ASCII format and is utilized by Build system to generate the NVMX and make it as part of BIN file</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="BuildLabelArray" Type="FIXED_ARRAY" ElementSize="1" Size="64" Min="0x0" Max="0xFF" Signed="false" Description="" VariableName="BUILD_LABEL">
        <ELEMENTS Name="Char_0" Default="0x0" Description="Element Description" />
