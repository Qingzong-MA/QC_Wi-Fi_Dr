    </TAG>
    <TAG Number="17" Name="HCI Uart Settings">
      <DESCRIPTION>This parameter is used for HCI UART communication control.  If the UART transport parameters are changed, the new settings take affect after an HCI_Reset command is issued. The HCI Command_Complete Event that is returned from the HCI_Reset will return at the new baud rate.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="HCI Uart Settings" Type="STRUCTURE" Size="6">
        <ELEMENTS Name="H4 UART Config" Type="BITFIELD" Size="1">
          <ELEMENTS Name="HW Flow Control En" Default="0x1" Start="0" End="0" Description="Configure UART HW FLOW CONTROL. Set 1 to enable or 0 to disable HW Flow Control." />
          <ELEMENTS Name="FIFO Empty Entries to Flow Off" Default="0x2" Start="1" End="3" Description="If the number of empty entries in the Rx FIFO falls below this number, the host will be flowed off." />
          <ELEMENTS Name="8 Byte FIFO" Default="0x1" Start="4" End="4" Description="When set to 1 this will enable the 8 byte FIFO.  When set to 0, the default 2 byte FIFO will be used." />
        </ELEMENTS>
        <ELEMENTS Name="UART Baud Rate" Type="ENUM" Size="1" Default="0x0" Signed="false">
          <ELEMENTS Name="Baud_115200" Default="0x0" Description="115200 baud" />
          <ELEMENTS Name="Baud_57600" Default="0x1" Description="57600 Baud" />
          <ELEMENTS Name="Baud_38400" Default="0x2" Description="38400 Baud" />
          <ELEMENTS Name="Baud_19200" Default="0x3" Description="19200 Baud" />
          <ELEMENTS Name="Baud_9600" Default="0x4" Description="9600 Baud" />
          <ELEMENTS Name="Baud_230400" Default="0x5" Description="230400 Baud" />
          <ELEMENTS Name="Baud_250000" Default="0x6" Description="250000 Baud" />
          <ELEMENTS Name="Baud_460800" Default="0x7" Description="460800 Baud" />
          <ELEMENTS Name="Baud_500000" Default="0x8" Description="500000 Baud" />
          <ELEMENTS Name="Baud_720000" Default="0x9" Description="720000 Baud" />
          <ELEMENTS Name="Baud_921600" Default="0xA" Description="921600 Baud" />
          <ELEMENTS Name="Baud_1000000" Default="0xB" Description="1000000 Baud" />
          <ELEMENTS Name="Baud_125000" Default="0xC" Description="125000 Baud" />
          <ELEMENTS Name="Baud_2000000" Default="0xD" Description="2000000 Baud" />
          <ELEMENTS Name="Baud_3000000" Default="0xE" Description="3000000 Baud" />
          <ELEMENTS Name="Baud_4000000" Default="0xF" Description="4000000 Baud" />
          <ELEMENTS Name="Baud_1600000" Default="0x10" Description="1600000 Baud" />
          <ELEMENTS Name="Baud_3200000" Default="0x11" Description="3200000 Baud" />
          <ELEMENTS Name="Baud_3500000" Default="0x12" Description="3500000 Baud" />
          <ELEMENTS Name="Baud_Auto" Default="0xFE" Description="Enables AutoBaud (SiW4000 and later processors only)" />
          <ELEMENTS Name="Baud_UserDefined" Default="0xFF" Description="User defined Baud" />
        </ELEMENTS>
        <ELEMENTS Name="User Defined Baud" Type="STRUCTURE" Size="4">
          <ELEMENTS Name="Integer Rate Divisor" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x22" Signed="false" Description="Integer Baud Rate divisor;  Formula's to Calculate Baud Rate Registers: ibrd = ( BBCLK/(8*BAUD) ); For SiW1750/1760: BBCLK = 16,000,000; For the SiW3000 : BBCLK = 32,000,000; For QCA6174 2.x : BBCLK = 32,000,000; For QCA6174 3.x : BBCLK = 32,000,000 or 64,000,000" />
          <ELEMENTS Name="Fractional Rate Divisor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x2E" Signed="false" Description="SiW1750/1760: BBCLK = 16,000,000; For the SiW3000 : BBCLK = 32,000,000; For QCA6174 2.x : BBCLK = 32,000,000; For QCA6174 3.x : BBCLK = 32,000,000 or 64,000,000" />
          <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="27" Name="Sleep Control">
      <DESCRIPTION>Controls when the Bluetooth device goes into a low-power 'sleep' state.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Sleep Control" Type="STRUCTURE" Size="11">
        <ELEMENTS Name="SleepEn" Type="ENUM" Size="1" Default="0x0" Signed="false">
          <ELEMENTS Name="Disable" Default="0x0" Description="Disable sleep" />
          <ELEMENTS Name="Enable" Default="0x1" Description="Enable sleep" />
        </ELEMENTS>
        <ELEMENTS Name="TxpSleepMode" Type="ENUM" Size="1" Default="0x0" Signed="false">
          <ELEMENTS Name="DISABLE" Default="0x0" Description="Transport layer sleep is disabled" />
          <ELEMENTS Name="UART_SIBS" Default="0x1" Description="Softeware in-band sleep mode for Uart interface" />
          <ELEMENTS Name="USB_SUSPEND" Default="0x2" Description="USB suspend resume sleep mode for USB interface" />
          <ELEMENTS Name="GPIO_OOB" Default="0x3" Description="Hardware Out-of-band sleep mode for both UART and USB interface" />
          <ELEMENTS Name="UART_HWIBS" Default="0x4" Description="Hardware in-band sleep mode for Uart interface" />
          <ELEMENTS Name="MIXED_GPIO_SIBS" Default="0x5" Description="Mixed GPIO HostWake Pin and Softeware in-band sleep mode for Uart interface. HostWake Pin will continue outputing Square Wave while sending SIBS Wake signal to Host. The parameter 'Wake Retransmission Timeout' is also used as the Square Wave width. Do not suggest to set the flag 'Dynamic Wake Retransmit Timeout' in this mode." />
        </ELEMENTS>
        <ELEMENTS Name="SIBS Parameters" Type="STRUCTURE" Size="3">
          <ELEMENTS Name="Wake Retransmission Timeout" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x2" Signed="false" Description="Software In-Band Sleep Wake Retransmission Timeout in ms. Wake will be re-transmitted after this number of ms if a Wake Ack is not received." />
          <ELEMENTS Name="Tx Idle Timeout" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xA" Signed="false" Description="Software In-Band Sleep Tx Idle Timeout in ms. Sleep signal will be sent if Tx stays idle for the defined timeout period." />
          <ELEMENTS Name="Options" Type="BITFIELD" Size="1">
            <ELEMENTS Name="Wake Byte Required" Default="0x0" Start="0" End="0" Description="When enabled (set to 1), an actual Wake byte must be received to respond with a Wake Ack byte.  When disabled, a Wake Ack byte will be sent on wakeup due to any Rx activity." />
            <ELEMENTS Name="Dynamic Wake Retransmit Timeout" Default="0x0" Start="1" End="1" Description="Wake Retransmit Timeout can be set to either constant value always or can be configured to increment dynamically based on number of Wake Indication Timeouts. When this BIT is set to 1: Wake Retransmit timeout will increment linearly. For example if the Wake Retransmit timeout is set to 10msec then Wake Indication will be sent out at 0, 10, 20, 30, 40, 50, 60msec timeouts." />
            <ELEMENTS Name="Wakeup Source" Default="0x0" Start="2" End="3" Description="Wakeup source selection for SIBS mode. Value of 0x0(default) is used when both HCI RxD &amp; RxD Fast are configured as wakeup source., Value of 0x1 is used when HCI RxD only is configured as wakeup source." />
          </ELEMENTS>
        </ELEMENTS>
        <ELEMENTS Name="HWOOB Parameters" Type="STRUCTURE" Size="4">
          <ELEMENTS Name="BTWake Polarity" Type="ENUM" Size="1" Default="0x0" Signed="false">
            <ELEMENTS Name="Active_Low" Default="0x0" Description="Active Low" />
            <ELEMENTS Name="Active_High" Default="0x1" Description="Active High" />
          </ELEMENTS>
          <ELEMENTS Name="HostWake Polarity" Type="ENUM" Size="1" Default="0x0" Signed="false">
            <ELEMENTS Name="Active_Low" Default="0x0" Description="Active Low" />
            <ELEMENTS Name="Active_High" Default="0x1" Description="Active High" />
          </ELEMENTS>
          <ELEMENTS Name="BTWake Pin" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFF" Signed="false" Description="" />
          <ELEMENTS Name="HostWake Pin" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFF" Signed="false" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="HCLK Scaling" Type="ENUM" Size="1" Default="0x0" Signed="false">
          <ELEMENTS Name="DIV1" Default="0x0" Description="Disable HCLK_ungated scaling" />
          <ELEMENTS Name="DIV4" Default="0x1" Description="" />
          <ELEMENTS Name="DIV8" Default="0x2" Description="" />
          <ELEMENTS Name="DIV16" Default="0x3" Description="" />
          <ELEMENTS Name="DIV32" Default="0x4" Description="" />
          <ELEMENTS Name="DIV64" Default="0x5" Description="" />
          <ELEMENTS Name="CLK OFF" Default="0x6" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="EXT HCLK Scaling" Type="ENUM" Size="1" Default="0x0" Signed="false">
          <ELEMENTS Name="DIV1" Default="0x0" Description="Disable ext hclk scaling" />
          <ELEMENTS Name="DIV4" Default="0x1" Description="" />
          <ELEMENTS Name="DIV8" Default="0x2" Description="" />
          <ELEMENTS Name="DIV16" Default="0x3" Description="" />
          <ELEMENTS Name="DIV32" Default="0x4" Description="" />
          <ELEMENTS Name="DIV64" Default="0x5" Description="" />
          <ELEMENTS Name="CLK_OFF" Default="0x6" Description="" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="31" Name="NVM Version - FW">
      <DESCRIPTION>Contains a version identifier to track the contents of the NVM settings. This Tag is owned by Dev/FW team and gets updated when any FW owned NVM tags are updated.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="NVM Version FW" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="NVM Version to be incremented on every change to the NVM settings." />
    </TAG>
    <TAG Number="32" Name="NVM Version - VI">
      <DESCRIPTION>Contains a version identifier to track the contents of the NVM settings. This Tag is owned by VI/HW team and gets updated on every NVM release by VI team.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="NVM Version VI" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="Contains a version identifier for the contents of NVM. Defaults to 0x00." />
    </TAG>
    <TAG Number="35" Name="Internal Power Configuration">
      <DESCRIPTION>These parameters control the TX output power control, FE Match Setting for BT Tx/Rx Mode and PA Match Setting for BT Tx/Rx Mode.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Power Configuration" Type="STRUCTURE" Size="120">
        <ELEMENTS Name="PL_Mapping" Type="FIXED_ARRAY" ElementSize="4" Size="48" Min="0x0" Max="0x3135A" Signed="false" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level" VariableName="PL">
          <ELEMENTS Name="PL_0" Default="0x1040" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 0" />
          <ELEMENTS Name="PL_1" Default="0x1041" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 1" />
          <ELEMENTS Name="PL_2" Default="0x1042" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 2" />
          <ELEMENTS Name="PL_3" Default="0x1043" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 3" />
          <ELEMENTS Name="PL_4" Default="0x1044" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 4" />
          <ELEMENTS Name="PL_5" Default="0x1045" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 5" />
          <ELEMENTS Name="PL_6" Default="0x1046" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 6" />
          <ELEMENTS Name="PL_7" Default="0x1047" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 7" />
          <ELEMENTS Name="PL_8" Default="0x1028" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 8" />
          <ELEMENTS Name="PL_9" Default="0x1039" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 9" />
          <ELEMENTS Name="PL_10" Default="0x150A" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level 10" />
          <ELEMENTS Name="PL_11" Default="0x150B" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for each power level" />
        </ELEMENTS>
        <ELEMENTS Name="BLE_PL_Mapping" Type="FIXED_ARRAY" ElementSize="4" Size="48" Min="0x0" Max="0x0" Signed="false" Description="Element description" VariableName="BLE_PL">
          <ELEMENTS Name="BLE_PL_0" Default="0x1840" Description="Element description" />
          <ELEMENTS Name="BLE_PL_1" Default="0x1841" Description="Element description" />
          <ELEMENTS Name="BLE_PL_2" Default="0x1842" Description="Element description" />
          <ELEMENTS Name="BLE_PL_3" Default="0x1843" Description="Element description" />
          <ELEMENTS Name="BLE_PL_4" Default="0x1844" Description="Element description" />
          <ELEMENTS Name="BLE_PL_5" Default="0x1845" Description="Element description" />
          <ELEMENTS Name="BLE_PL_6" Default="0x1846" Description="Element description" />
          <ELEMENTS Name="BLE_PL_7" Default="0x1847" Description="Element description" />
          <ELEMENTS Name="BLE_PL_8" Default="0x1828" Description="Element description" />
          <ELEMENTS Name="BLE_PL_9" Default="0x1839" Description="Element description" />
          <ELEMENTS Name="BLE_PL_10" Default="0x1D0A" Description="Element description" />
          <ELEMENTS Name="BLE_PL_11" Default="0x1D0B" Description="Element description" />
        </ELEMENTS>
        <ELEMENTS Name="Neg_PL_Mapping" Type="FIXED_ARRAY" ElementSize="4" Size="16" Min="0x0" Max="0x3135A" Signed="false" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for negative power level" VariableName="Mapping">
          <ELEMENTS Name="PL_neg1" Default="0x124C" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for negative power level 1" />
          <ELEMENTS Name="PL_neg2" Default="0x124D" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for negative power level 2" />
          <ELEMENTS Name="PL_neg3" Default="0x124E" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for negative power level 3" />
          <ELEMENTS Name="PL_neg4" Default="0x124F" Description="Configures DTOP register SOFTWARE_PWR_CTNL_REG for negative power level 4" />
        </ELEMENTS>
        <ELEMENTS Name="D8PSK_EDR Backoff" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0xC" Signed="false" Description="" />
        <ELEMENTS Name="DQPSK_EDR Backoff" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0xC" Signed="false" Description="" />
        <ELEMENTS Name="EDR Backoff Offset" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0x0" Signed="false" Description="To be written in BACKOFF_OFFSET[11:8] field, which only exists in Apache." />
        <ELEMENTS Name="PSK8_LEHS Backoff" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0x0" Signed="false" Description="" />
        <ELEMENTS Name="QPSK_LEHS Backoff" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0x0" Signed="false" Description="" />
        <ELEMENTS Name="LE Backoff" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0x0" Signed="false" Description="" />
        <ELEMENTS Name="Flags" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Override_LUT" Default="0x0" Start="0" End="0" Description="If 1, fw will override the LUT registers from nvm." />
          <ELEMENTS Name="EDR_DAC_boost" Default="0x0" Start="1" End="1" Description="Disable DAC backoff for PL 8 and above to improve EDR ACP performance" />
          <ELEMENTS Name="wlpa_ch0_sel" Default="0x0" Start="2" End="2" Description="Selects WLAN PA. Writes to BT_TOP_TX_CONFIG_0 : WLPA_CH0_SEL." />
        </ELEMENTS>
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
