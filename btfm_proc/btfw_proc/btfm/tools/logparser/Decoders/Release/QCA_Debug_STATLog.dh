     FIELD fQca_gSalfDebug_stats_BufferStatus    (Fixed 1 Bytes)    (TABLE t_BufferState)    "Buffer status"
     FIELD fQca_gSalfDebug_stats_curr_LQ_QC      (Fixed 1 Byte)     (TABLE tLQ_levelsQC)     "Current Link Quality"
     FIELD fQca_gSalfDebug_stats_rsvd_bits       (Fixed 6 Bits)     (Decimal)                SUPPRESS_DETAIL
     FIELD fQca_gSalfDebug_stats_force_LQ        (Fixed 1 Bits)     (Decimal)                "Force LQ"
     FIELD fQca_gSalfDebug_stats_3M_Allowed      (Fixed 1 Bits)     (Decimal)                "3M Pkt Type Allowed"
