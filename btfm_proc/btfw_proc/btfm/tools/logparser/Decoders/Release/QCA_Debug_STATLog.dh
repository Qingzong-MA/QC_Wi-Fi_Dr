GROUP gQca_STAT_PMInfo "PMInfo"
{
    FIELD fQca_STAT_PMInfo_txTime         (Fixed 4 Bytes) (Decimal)            "txTime(ms)"
    FIELD fQca_STAT_PMInfo_rxTime         (Fixed 4 Bytes) (Decimal)            "rxTime(ms)"
    FIELD fQca_STAT_PMInfo_rxATime        (Fixed 4 Bytes) (Decimal)            "rxActiveTime(ms)"
    FIELD fQca_STAT_PMInfo_iTime          (Fixed 4 Bytes) (Decimal)            "idleTime(ms)"
    FIELD fQca_STAT_PMInfo_sTime          (Fixed 4 Bytes) (Decimal)            "sleepTime(ms)"
    FIELD fQca_STAT_PMInfo_totalTime      (Fixed 4 Bytes) (Decimal)            "totalTime(ms)"

    FIELD fQca_STAT_PMInfo_txEnergy       (Fixed 4 Bytes) (Decimal)            "txEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo_rxEnergy       (Fixed 4 Bytes) (Decimal)            "rxEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo_rxAEnergy      (Fixed 4 Bytes) (Decimal)            "rxActiveEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo_iEnergy        (Fixed 4 Bytes) (Decimal)            "idleEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo_sEnergy        (Fixed 4 Bytes) (Decimal)            "sleepEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo_totalEnergy    (Fixed 4 Bytes) (Decimal)            "totalEnergy(mW*ms)"

    FIELD fQca_STAT_PMInfo13              (Fixed 4 Bytes) (Decimal)            "txEnergy(mW)"
    FIELD fQca_STAT_PMInfo14              (Fixed 4 Bytes) (Decimal)            "rxEnergy(mW)"
    FIELD fQca_STAT_PMInfo15              (Fixed 4 Bytes) (Decimal)            "totalEnergy(mW)"

    FIELD fQca_STAT_PMInfo16              (Fixed 4 Bytes) (Decimal)            "txRFEnergy(mW*ms)"
    FIELD fQca_STAT_PMInfo17              (Fixed 4 Bytes) (Decimal)            "txRFEnergy(mW)"

    FIELD fQca_STAT_PMInfo_txTime1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_txTime 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_txTime2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_txTime1 fQca_STAT_PMInfo_totalTime) (Decimal) "TxTime%"

    FIELD fQca_STAT_PMInfo_rxTime1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_rxTime 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_rxTime2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_rxTime1 fQca_STAT_PMInfo_totalTime) (Decimal) "RxTime%"

    FIELD fQca_STAT_PMInfo_rxATime1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_rxATime 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_rxATime2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_rxATime1 fQca_STAT_PMInfo_totalTime) (Decimal) "RxActiveTime%"

    FIELD fQca_STAT_PMInfo_iTime1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_iTime 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_iTime2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_iTime1 fQca_STAT_PMInfo_totalTime) (Decimal) "IdleTime%"

    FIELD fQca_STAT_PMInfo_sTime1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_sTime 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_sTime2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_sTime1 fQca_STAT_PMInfo_totalTime) (Decimal) "SleepTime%"

    FIELD fQca_STAT_PMInfo_txEnergy1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_txEnergy 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_txEnergy2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_txEnergy1 fQca_STAT_PMInfo_totalEnergy) (Decimal) "TxEnergy%"

    FIELD fQca_STAT_PMInfo_rxEnergy1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_rxEnergy 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_rxEnergy2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_rxEnergy1 fQca_STAT_PMInfo_totalEnergy) (Decimal) "RxEnergy%"

    FIELD fQca_STAT_PMInfo_rxAEnergy1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_rxAEnergy 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_rxAEnergy2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_rxAEnergy1 fQca_STAT_PMInfo_totalEnergy) (Decimal) "RxActiveEnergy%"

    FIELD fQca_STAT_PMInfo_iEnergy1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_iEnergy 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_iEnergy2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_iEnergy1 fQca_STAT_PMInfo_totalEnergy) (Decimal) "IdleEnergy%"

    FIELD fQca_STAT_PMInfo_sEnergy1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_STAT_PMInfo_sEnergy 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_PMInfo_sEnergy2 (Fixed 0) RETRIEVE (DivideFieldByField fQca_STAT_PMInfo_sEnergy1 fQca_STAT_PMInfo_totalEnergy) (Decimal) "SleepEnergy%"
}

