    FIELD fQca_STAT_initConReqTxCnt          (Fixed 1 Bytes) (Decimal)  "init Connect IND TX Count"
    FIELD fQca_STAT_initConReqAbortCnt       (Fixed 1 Bytes) (Decimal)  "init Connect IND abort Count"
    FIELD fQca_STAT_initConRspRxNothing      (Fixed 1 Bytes) (Decimal)  "init Rx ConnRsp Nothing Count"
    FIELD fQca_STAT_initConRspRxBadCRC       (Fixed 1 Bytes) (Decimal)  "init Rx ConnRsp Bad CRC Count"
    FIELD fQca_STAT_initConRspRxUnexpectPkt  (Fixed 1 Bytes) (Decimal)  "init Rx ConnRsp Unexpect Pkt Count"
    FIELD fQca_STAT_initConRspRxSuccess      (Fixed 1 Bytes) (Decimal)  "init Rx ConnRsp Success Count"
    FIELD fQca_STAT_initAdvResolveAdvACnt    (Fixed 1 Bytes) (Decimal)  "resolveInitAdvACnt"
    FIELD fQca_STAT_initAdvResolveTargetACnt (Fixed 1 Bytes) (Decimal)  "resolveInitTargetACnt"
