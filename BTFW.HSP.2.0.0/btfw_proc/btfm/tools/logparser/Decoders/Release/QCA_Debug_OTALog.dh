TABLE tQca_OTALogID APPENDS_ONLY tQca_EnhLogID
    {0x0300 "OTA LMP RX PDU"        "OTA LMP RX PDU"            0 gQca_OTA_LMPRxPDU}
    {0x0301 "OTA LMP TX PDU"        "OTA LMP TX PDU"            0 gQca_OTA_LMPTxPDU}
    {0x0302 "OTA LE CTRL RX PDU"    "OTA LE CTRL RX PDU"        0 gQca_OTA_LECtrlRxPDU}
    {0x0303 "OTA LE CTRL TX PDU"    "OTA LE CTRL TX PDU"        0 gQca_OTA_LECtrlTxPDU}
    {0x0304 "OTA QLL CTRL RX PDU"    "OTA QLL CTRL RX PDU"        0 gQca_OTA_QLLCtrlPDU}
    {0x0305 "OTA QLL CTRL TX PDU"    "OTA QLL CTRL TX PDU"        0 gQca_OTA_QLLCtrlPDU}
    {0x0306 "OTA QLMP CTRL RX PDU"    "OTA QLMP CTRL RX PDU"        0 gQca_OTA_QLMPCtrlPDU}
    {0x0307 "OTA QLMP CTRL TX PDU"    "OTA QLMP CTRL TX PDU"        0 gQca_OTA_QLMPCtrlPDU}
    {0x0308 "OTA QLMP NOT ACCEPTED PDU" "OTA QLMP NOT ACCEPTED PDU" 0 gQca_OTA_QLMPNotAcceptedPDU}
    {0x0309 "OTA BIG CTRL RX PDU"    "OTA BIG CTRL RX PDU"        0 gQca_OTA_BIGCtrlRxPDU}
    {0x030A "OTA BIG CTRL TX PDU"    "OTA BIG CTRL TX PDU"        0 gQca_OTA_BIGCtrlTxPDU}
    {0x030B "OTA PROTOTYPE CTRL RX PDU"    "OTA LEP CTRL RX PDU"        0 gQca_OTA_LEPCtrlPDU}
    {0x030C "OTA PROTOTYPE CTRL TX PDU"    "OTA LEP CTRL TX PDU"        0 gQca_OTA_LEPCtrlPDU}
ENDTABLE

GROUP gQca_OTA_LMPTxPDU "LMP Tx PDU Info"
{

    FIELD fQca_OTA_Handle               (Fixed 1 Byte)      (Decimal)           "Handle"
    RESERVED                            (Fixed 1 Byte)
    FIELD fQca_OTA_LMPPduLen            (Fixed 1 Byte)      (Decimal)           "PDU Length"
    FIELD fQca_OTA_LMPTxAck             (Fixed 1 Bit)       (Decimal)           "TxACK Req"    
    RESERVED                            (Fixed 7 Bits)    
    FIELD fQca_OTA_LMPPDU_Type          (Fixed 0) RETRIEVE(StoreInteger 0) (Decimal) SUPPRESS_DETAIL	STORE sQca_PduType
    FIELD fQca_SetTraversalOverride     (Fixed 0) RETRIEVE(StoreInteger 1) (HEX) SUPPRESS_DETAIL Store sQca_TraversalOverride

}

GROUP gQca_OTA_LMPRxPDU "LMP Rx PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                            (Fixed 1 Byte)
    FIELD fQca_OTA_LMPPduLen;
    FIELD fQca_OTA_LMPTxAck;    
    RESERVED                            (Fixed 7 Bits)   
    FIELD fQca_OTA_LMPPDU_Type;
    FIELD fQca_SetTraversalOverride;
}

GROUP gQca_OTA_LECtrlRxPDU "LE Ctrl Rx PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                            (Fixed 2 Bytes)
    FIELD fQca_OTA_LETxAck              (Fixed 1 Bit)       (Decimal)                   "TxACK Req"
    FIELD fQca_OTA_LEPduLen             (Fixed 7 Bits)      (Decimal)                   "PDU Length"
    
    FIELD fQca_OTA_LEPDU_Type           (Fixed 0) RETRIEVE(StoreInteger 1) (Decimal) SUPPRESS_DETAIL	STORE sQca_PduType
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_LERxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 2) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_OTA_LECtrlTxPDU "LE Ctrl Tx PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                            (Fixed 2 Bytes)
    FIELD fQca_OTA_LETxAck;
    FIELD fQca_OTA_LEPduLen;
    
    FIELD fQca_OTA_LEPDU_Type;
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_LETxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 1) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL    
}

GROUP gQca_OTA_BIGCtrlRxPDU "BIG Ctrl Rx PDU Info"
{
    RESERVED                            (Fixed 3 Bytes)
    FIELD fQca_OTA_BIGPduLen            (Fixed 1 Bytes)     (Decimal)                  "PDU Length"
    
    FIELD fQca_OTA_BIGPDU_Type           (Fixed 0) RETRIEVE(StoreInteger 2) (Decimal) SUPPRESS_DETAIL	STORE sQca_PduType
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_BIGTxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 1) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_OTA_BIGCtrlTxPDU "BIG Ctrl Tx PDU Info"
{
    FIELD fQca_OTA_BIGRetrx             (Fixed 1 Bytes)     (Decimal)                  "Tx Count" 
    RESERVED                            (Fixed 2 Bytes)
    FIELD fQca_OTA_BIGPduLen;
    
    FIELD fQca_OTA_BIGPDU_Type;
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_BIGRxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 2) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_OTA_LEPCtrlPDU "LEP Ctrl PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                          (Fixed 2 Bytes)
    FIELD fQca_OTA_LEPPAck            (Fixed 1 Bit)       (Decimal)                   "TxACK Req"
    FIELD fQca_OTA_LEPPduLen          (Fixed 7 Bits)      (Decimal)                   "PDU Length"
    
    FIELD fQca_OTA_LEPPDU_Type        (Fixed 1 Byte)  (TABLE tQca_LC_PrototypeCtrlOpcode)   "LL Prototype Control opcode" 
    BRANCH (FromTable tQca_LC_PrototypeCtrlOpcode fQca_OTA_LEPPDU_Type)
    FIELD fQca_OTA_LEPEvtCnter        (Fixed 2 Bytes) (Hex) "Event counter"
}

GROUP gQca_ChangeTraversal  if(FieldIs Equalto 1 sQca_TraversalOverride) 
{
	GROUP gQca_TraverseToLMP IF (FieldIs EqualTo 0 sQca_PduType)
	{
		FIELD fQca_LMPTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf1)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
	GROUP gQca_TraverseToLLCtrl IF (FieldIs EqualTo 1 sQca_PduType)
	{
		FIELD fQca_LLCtrlTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf2)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
	GROUP gQca_TraverseToBIGCtrl IF (FieldIs EqualTo 2 sQca_PduType)
	{
        /* Not sure the protocol value, need update if it is defined in frontline. */
		//FIELD fQca_LLCtrlTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf3)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
	
	// We are traversing to LMP and it expects to see the values below.  Put something there to suppress errors.
    FIELD SatisfyClock 			(fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField clock) (hex)  SUPPRESS_DETAIL 
    FIELD SatisfyAddress		(Fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField Static_ConnHandle)  (Decimal) SUPPRESS_DETAIL
	
    //LE LL 
    FIELD SatisfyAccessAddr     (Fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField AccessAddr)   (Hex)			SUPPRESS_DETAIL 	 
    FIELD SatisfyEventCtr       (Fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField EventCtr)     (Hex)			SUPPRESS_DETAIL
    FIELD SatisfyEncrInfo       (Fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField EncrInfo)     (Hex)			SUPPRESS_DETAIL
    //FIELD SatisfySide           (Fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField side)         (Hex)			SUPPRESS_DETAIL 	     
}

TABLE tQca_QLL_Channel
    { 0x00  "QLL_CHANNEL_LINK_CONTROL"}
    { 0x01  "QLL_CHANNEL_LINK_LAYER"}
    { 0x40  "QLL_CHANNEL_HOST_SERVICE_DISCOVERY"}
	{Default "Unknown" } 
ENDTABLE

TABLE tQca_QLL_LC_SpecOpcode 
	{ 0xA0 "QLL_LC_LINK_TERMINATE_IND" "QLL_LC_LINK_TERMINATE_IND" 0 gQca_Q2Q_CtrlData_TerminateIND }
	{ 0xA1 "QLL_LC_EST_SERVICE_REQ" "QLL_LC_EST_SERVICE_REQ" 0 gQca_Q2Q_CtrlData_EstSrvReq}
	{ 0xA2 "QLL_LC_EST_AUTH_REQ" "QLL_LC_EST_AUTH_REQ" 0 gQca_Q2Q_CtrlData_EstAuthReq}
	{ 0xA3 "QLL_LC_EST_SERVICE_RSP" "QLL_LC_EST_SERVICE_RSP" 0 gQca_Q2Q_CtrlData_EstSrvRsp }
	{ 0xA4 "QLL_LC_EST_AUTH_RSP" "QLL_LC_EST_AUTH_RSP" 0 gQca_Q2Q_CtrlData_EstAuthRsp}
	{ 0xA5 "QLL_LC_EST_CONN_CONNECT_IND" "QLL_LC_EST_CONN_CONNECT_IND" }
	{Default "Unknown"          "Unknown"              0   } 
ENDTABLE

TABLE tQca_QLL_LL_SpecOpcode
	{ 0x06 "QLL_REJET_IND" "QLL_REJET_IND" 0 gQca_Q2Q_CtrlData_TerminateIND}
	{ 0xA0 "QLL_LL_FEATURE_REQ" "QLL_LL_FEATURE_REQ" 0 gQca_QLL_CtrlData_FeatureSet}
	{ 0xA1 "QLL_LL_FEATURE_RSP" "QLL_LL_FEATURE_RSP" 0 gQca_QLL_CtrlData_FeatureSet}
	{ 0xA2 "QLL_LL_ACL_PHY_REQ" "QLL_LL_ACL_PHY_REQ" 0 gQca_QLL_CtrlData_PhyReqRsp}
	{ 0xA3 "QLL_LL_ACL_PHY_RSP"  "QLL_LL_ACL_PHY_RSP" 0 gQca_QLL_CtrlData_PhyReqRsp}
	{ 0xA4 "QLL_LL_ACL_PHY_UPDATE_IND" "QLL_LL_ACL_PHY_UPDATE_IND" 0 gQca_QLL_CtrlData_PhyUpdateInd}
	{ 0xA5 "QLL_LL_PREFERRED_RATE_IND" "QLL_LL_PREFERRED_RATE_IND" 0 gQca_QLL_CtrlData_PreferredRate}
	{ 0xA6 "QLL_LL_PWR_CTRL_REQ" "QLL_LL_PWR_CTRL_REQ" 0 gQca_QLL_PwrCtrlReq}
	{ 0xA7 "QLL_LL_PWR_CTRL_RSP" "QLL_LL_PWR_CTRL_RSP" 0 gQca_QLL_PwrCtrlRsp}
	{ 0xA8 "QLL_LL_PWR_CTRL_IND" "QLL_LL_PWR_CTRL_IND" 0 gQca_QLL_PwrCtrlInd}
	{ 0xA9 "QLL_IV_REQ" "QLL_IV_REQ" 0 gQca_QLL_ivReqrsp}
	{ 0xAA "QLL_IV_RSP" "QLL_IV_RSP" 0 gQca_QLL_ivReqrsp}
	{ 0xAB "QLL_PAUSE_ENC_RSP" "QLL_PAUSE_ENC_RSP" }
	{ 0xAC "QLL_ACO_SWITCH_REQ" "QLL_ACO_SWITCH_REQ" }
	{ 0xAD "QLL_ACO_SWITCH_RSP" "QLL_ACO_SWITCH_RSP" }
	{ 0xAE "QLL_LL_CIS_REQ" "QLL_LL_CIS_REQ" 0 gQca_QLL_cisReq}
	{ 0xAF "QLL_LL_ALT_CIS_REQ" "QLL_LL_ALT_CIS_REQ" 0 gQca_QLL_altCisReq}
	{ 0xB0 "QLL_LL_ALT_CIS_RSP" "QLL_LL_ALT_CIS_RSP" }
	{Default "Unknown"          "Unknown"              0   } 
ENDTABLE

GROUP gQca_Q2Q_CtrlData_TerminateIND
{
	FIELD fQca_Q2Q_CtrlData_Reason (Fixed 1 Byte) (Hex) "Reason"
}

GROUP gQca_Q2Q_CtrlData_EstSrvReq
{
	FIELD fQca_Q2Q_CtrlData_SupportKeys (Fixed 4 Bytes) (Hex) "Support Keys"
}

GROUP gQca_Q2Q_CtrlData_EstSrvRsp
{
	FIELD fQca_Q2Q_CtrlData_SupportKeys;
	FIELD fQca_Q2Q_CtrlData_ChaRandom  (Fixed 16 Bytes) (Hex) "Challenge Random Number"
}

GROUP gQca_Q2Q_CtrlData_EstAuthReq
{
	FIELD fQca_Q2Q_CtrlData_ChaRandom;
}

GROUP gQca_Q2Q_CtrlData_EstAuthRsp
{
	FIELD fQca_Q2Q_CtrlData_ChaRsp (Fixed 4 Bytes) (Hex) "Challenge Response"
}

GROUP gQca_QLL_CtrlData_FeatureSet
{
	FIELD fQca_QLL_CtrlData_FeatureSet (Fixed 8 Bytes) (Hex) "QLL Feature Set"
}

GROUP gQca_QLL_PhyMask
{
    Reserved (Fixed 3 bits)
	FIELD fQca_QLL_PhyMask_HS_FSK  (Fixed 1 Bit) (Binary) "QHS PHY shall be used, FSK preferred, PSK allowed"
	FIELD fQca_QLL_PhyMask_HS_PSK  (Fixed 1 Bit) (Binary) "QHS PHY shall be used, PSK preferred, FSK allowed"
	FIELD fQca_QLL_PhyMask_LECODED  (Fixed 1 Bit) (Binary) "LE CODED PHY shall be used"
	FIELD fQca_QLL_PhyMask_LE2M  (Fixed 1 Bit) (Binary) "LE2M PHY shall be used"
	FIELD fQca_QLL_PhyMask_LE1M  (Fixed 1 Bit) (Binary) "LE1M PHY shall be used"
	Reserved (Fixed 8 bits)
}

GROUP gQca_QLL_TxPhyMask "Tx Phy Mask"
{
	GROUP gQca_QLL_PhyMask;
}

GROUP gQca_QLL_RxPhyMask "Rx Phy Mask"
{
	GROUP gQca_QLL_PhyMask;
}

GROUP gQca_QLL_MtoSPhyMask "MtoS Phy Mask"
{
	GROUP gQca_QLL_PhyMask;
}

GROUP gQca_QLL_StoMPhyMask "StoM Phy Mask"
{
	GROUP gQca_QLL_PhyMask;
}

GROUP gQca_QLL_CtrlData_PhyReqRsp
{
	GROUP gQca_QLL_TxPhyMask;
	GROUP gQca_QLL_RxPhyMask;
}

GROUP gQca_QLL_CtrlData_PhyUpdateInd
{
	GROUP gQca_QLL_MtoSPhyMask;
	GROUP gQca_QLL_StoMPhyMask;
	FIELD fQca_QLL_UpdateInstant (Fixed 2 Bytes) (Hex) "Update Instant"
}

GROUP gQca_QLL_CtrlData_PreferredRate
{
	GROUP gQca_QLL_CtrlData_DataRate "QHS Data Rate"
	{
		Reserved (Fixed 3 bits)
		FIELD fQca_QLL_DataRate_HS6M (Fixed 1 Bit) (Binary) "Use QHS 6M"
		FIELD fQca_QLL_DataRate_HS5M  (Fixed 1 Bit) (Binary) "Use QHS 5M"
		FIELD fQca_QLL_DataRate_HS4M  (Fixed 1 Bit) (Binary) "Use QHS 4M"
		FIELD fQca_QLL_DataRate_HS3M  (Fixed 1 Bit) (Binary) "Use QHS 3M"
		FIELD fQca_QLL_DataRate_HS2M  (Fixed 1 Bit) (Binary) "Use QHS 2M"
	}
}

GROUP gQca_QLL_PwrCtrlReq
{
	FIELD fQca_QLL_PwrCtrl_Oper (Fixed 1 Byte) (TABLE tQca_QLL_PwrCtrl_Oper) "Operation"
}

GROUP gQca_QLL_PwrCtrlRsp
{
	FIELD fQca_QLL_PwrCtrl_OperRsp (Fixed 1 Byte) (TABLE tQca_QLL_PwrCtrl_OperRsp) "Response"
}

GROUP gQca_QLL_PwrCtrlInd
{
	FIELD fQca_QLL_PwrCtrl_OperRsp; 
	FIELD fQca_QLL_PwrCtrl_Steps (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Change Steps"
}

GROUP gQca_QLL_ivReqrsp
{
	FIELD fQca_QLL_ivReqrsp_IV (Fixed 4 Bytes) (Hex) "IV"
}

TABLE tQca_QLL_PwrCtrl_Oper
	{ 0x0 "Decrement one level" }
	{ 0x1 "Increment one level" }
	{ 0x2 "Increase to Maximum power" }
	{ 0x3 "No change" }
ENDTABLE

TABLE tQca_QLL_PwrCtrl_OperRsp
	{ 0x0 "Min Power" }
	{ 0x1 "Change N Steps (1 step for pwr_ctrl_rsp)" }
	{ 0x2 "Max Power" }
	{ 0x3 "No change" }
ENDTABLE

GROUP gQca_QLL_CtrlData_LE_phyrate "LE Data Rate"
{
	Reserved (Fixed 5 bits)
	FIELD fQca_QLL_DataRate_LELR  (Fixed 1 Bit) (Binary) "Use LE CODED"
	FIELD fQca_QLL_DataRate_LE2M (Fixed 1 Bit) (Binary) "Use LE 2M"
	FIELD fQca_QLL_DataRate_LE1M (Fixed 1 Bit) (Binary) "Use LE 1M"
}

GROUP gQca_QLL_cisPhyRateM2S "Phy Rate M to S"
{
	GROUP gQca_QLL_CtrlData_LE_phyrate;
	GROUP gQca_QLL_CtrlData_DataRate;
}

GROUP gQca_QLL_cisPhyRateS2M "Phy Rate S to M"
{
	GROUP gQca_QLL_CtrlData_LE_phyrate;
	GROUP gQca_QLL_CtrlData_DataRate;
}

GROUP gQca_QLL_cisParam "CIS parameters"
{
	FIELD fQca_QLL_payloadM2S (Fixed 2 Bytes) (Hex) "Payload Length M_TO_S"
	FIELD fQca_QLL_payloadS2M (Fixed 2 Bytes) (Hex) "Payload Length S_TO_M"
	FIELD fQca_QLL_cisNse (Fixed 1 Byte) (Hex) "Sub Event number"
	FIELD fQca_QLL_subInterval (Fixed 3 Bytes) (Hex) "Sub Event Interval"
	FIELD fQca_QLL_BN_S2M (Fixed 4 bits) (Hex) "Burst number S_TO_M"
	FIELD fQca_QLL_BN_M2S (Fixed 4 bits) (Hex) "Burst number M_TO_S"
	FIELD fQca_QLL_FT_M2S (Fixed 1 Byte) (Hex) "Flush time M_TO_S"
	FIELD fQca_QLL_FT_S2M (Fixed 1 Byte) (Hex) "Flush time S_TO_M"
	FIELD fQca_QLL_isoInterval (Fixed 2 Bytes) (Hex) "ISO interval"
}

GROUP gQca_QLL_cisReq
{
	FIELD fQca_QLL_cigID (Fixed 1 Byte) (Hex) "CIG ID"
	FIELD fQca_QLL_cisID (Fixed 1 Byte) (Hex) "CIS ID"
	GROUP gQca_QLL_cisPhyRateM2S;
	GROUP gQca_QLL_cisPhyRateS2M;
	FIELD fQca_QLL_cisMaxSDUM2S_1 (Fixed 1 Bytes) (Hex) SUPPRESS_DETAIL
	FIELD fQca_QLL_cisFramed (Fixed 1 Bit) (Hex) "Framed"  
	FIELD fQca_QLL_cisMaxSDUM2S_2 (Fixed 7 Bits) (Hex) SUPPRESS_DETAIL
	FIELD fQca_QLL_cisMaxSDUM2S_3 (Fixed 0) RETRIEVE (AddField fQca_QLL_cisMaxSDUM2S_2) ALSO(ShiftLeft 8) (Hex) SUPPRESS_DETAIL
	FIELD fQca_QLL_cisMaxSDUM2S (Fixed 0) RETRIEVE (AddFieldToField fQca_QLL_cisMaxSDUM2S_1 fQca_QLL_cisMaxSDUM2S_3) (Hex) "Max SDU M_TO_S"
	FIELD fQca_QLL_cisMaxSDUS2M (Fixed 2 Bytes) (Hex) "Max SDU S_TO_M"
	FIELD fQca_QLL_cisSDUIntervalM2S (Fixed 24 Bits) (Hex) "SDU Interval M_TO_S"
	FIELD fQca_QLL_cisSDUIntervalS2M (Fixed 24 Bits) (Hex) "SDU Interval S_TO_M"
	GROUP gQca_QLL_cisParam;
	FIELD fQca_QLL_cisOffsetMin (Fixed 3 Bytes) (Hex) "Min Offest"
	FIELD fQca_QLL_cisOffsetMax (Fixed 3 Bytes) (Hex) "Max Offset"
	FIELD fQca_QLL_connEvtCnt (Fixed 2 Bytes) (Hex) "Ref event counter"
}

TABLE tQca_QLL_altCisPhyRate
	{ 0x0 "QHS2 is used" }
	{ 0x1 "QHS3 is used" }
	{ 0x2 "QHS4 is used" }
	{ 0x3 "QHS5 is used" }
	{ 0x4 "QHS6 is used" }
ENDTABLE

GROUP gQca_QLL_altCisReq 
{
	FIELD fQca_QLL_cigID;
	FIELD fQca_QLL_cisID;
	FIELD fQca_QLL_phyRate_S2M (Fixed 4 bits) (TABLE tQca_QLL_altCisPhyRate) "Phy Rate S_TO_M"
	FIELD fQca_QLL_phyRate_M2S (Fixed 4 bits) (TABLE tQca_QLL_altCisPhyRate) "Phy Rate M_TO_S"
	GROUP gQca_QLL_cisParam;
}

GROUP gQca_OTA_QLLCtrlPDU "QLL Ctrl PDU Info"
{
	FIELD fQca_OTA_Handle;
    RESERVED                            (Fixed 2 Bytes)
	FIELD fQca_OTA_LETxAck;
    FIELD fQca_OTA_LEPduLen;
    
    FIELD fQca_OTA_QLLChannel (Fixed 7 bits) (TABLE tQca_QLL_Channel)                  "QLL Channel"
	RESERVED  (Fixed 1 Bit)
	GROUP gQca_OTA_QLL_LC_PDU IF(FieldIs EqualTo 0 fQca_OTA_QLLChannel)
	{
		FIELD fQca_OTA_QLLopCodeLC  (Fixed 1 Byte)  (TABLE tQca_QLL_LC_SpecOpcode)   "Channel LC opcode" 
		BRANCH (FromTable tQca_QLL_LC_SpecOpcode fQca_OTA_QLLopCodeLC)
	}
	GROUP gQca_OTA_QLL_LL_PDU IF(FieldIs EqualTo 1 fQca_OTA_QLLChannel)
	{
		FIELD fQca_OTA_QLLopCodeLL  (Fixed 1 Byte)  (TABLE tQca_QLL_LL_SpecOpcode)  "Channel LL opcode"
		BRANCH (FromTable tQca_QLL_LL_SpecOpcode fQca_OTA_QLLopCodeLL)
	}
	FIELD fQca_OTA_QLLEvtCnter  (Fixed 2 Bytes) (Hex) "Event counter"
}

TABLE tQca_QLMP_MinorType
	{ 0x00 "LMP_ENCAP_MINOR_TYPE_QLMP_ACCEPTED" "LMP_ENCAP_MINOR_TYPE_QLMP_ACCEPTED" 0 gQca_QLMP_Accepted }
	{ 0x01 "LMP_ENCAP_MINOR_TYPE_QLMP_NOT_ACCEPTED" "LMP_ENCAP_MINOR_TYPE_QLMP_NOT_ACCEPTED" 0 gQca_QLMP_NotAccepted }
	{ 0x02 "LMP_ENCAP_MINOR_TYPE_QLMP_FEATURES_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_FEATURES_REQ" 0 gQca_QLMP_FeatureSet }
	{ 0x03 "LMP_ENCAP_MINOR_TYPE_QLMP_FEATURES_RES" "LMP_ENCAP_MINOR_TYPE_QLMP_FEATURES_RES" 0 gQca_QLMP_FeatureSet }
	{ 0x04 "LMP_ENCAP_MINOR_TYPE_QLMP_EST_SERVICE_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_EST_SERVICE_REQ" 0 gQca_Q2Q_CtrlData_EstSrvReq }
	{ 0x05 "LMP_ENCAP_MINOR_TYPE_QLMP_EST_SERVICE_RES" "LMP_ENCAP_MINOR_TYPE_QLMP_EST_SERVICE_RES" 0 gQca_Q2Q_CtrlData_EstSrvRsp}
	{ 0x06 "LMP_ENCAP_MINOR_TYPE_QLMP_EST_AUTH_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_EST_AUTH_REQ" 0 gQca_Q2Q_CtrlData_EstAuthReq}
	{ 0x07 "LMP_ENCAP_MINOR_TYPE_QLMP_EST_AUTH_RES" "LMP_ENCAP_MINOR_TYPE_QLMP_EST_AUTH_RES" 0 gQca_Q2Q_CtrlData_EstAuthRsp}
	{ 0x08 "LMP_ENCAP_MINOR_TYPE_QLMP_ESCO_DTX" "LMP_ENCAP_MINOR_TYPE_QLMP_ESCO_DTX" 0}
	{ 0x09 "LMP_ENCAP_MINOR_TYPE_QLMP_CHANNEL_MESSAGE" "LMP_ENCAP_MINOR_TYPE_QLMP_CHANNEL_MESSAGE" 0}
	{ 0x0A "LMP_ENCAP_MINOR_TYPE_QLMP_PHY_SWITCH_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_PHY_SWITCH_REQ" 0 gQca_QLMP_PhySwitchReq}
	{ 0x0B "LMP_ENCAP_MINOR_TYPE_QLMP_PHY_SWITCH" "LMP_ENCAP_MINOR_TYPE_QLMP_PHY_SWITCH" 0 gQca_QLMP_PhySwitch}
	{ 0x0C "LMP_ENCAP_MINOR_TYPE_QLMP_PREFERRED_RATE" "LMP_ENCAP_MINOR_TYPE_QLMP_PREFERRED_RATE" 0 gQca_QLMP_PreferredRate}
	{ 0x0D "LMP_ENCAP_MINOR_TYPE_QLMP_ACL_SHADOW_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_ACL_SHADOW_REQ" 0 gQca_QLMP_AclShadowReq}
 	{ 0x0E "LMP_ENCAP_MINOR_TYPE_QLMP_ACL_SHADOW_SYNCED" "LMP_ENCAP_MINOR_TYPE_QLMP_ACL_SHADOW_SYNCED" 0 gQca_QLMP_AclShadowSynced}
