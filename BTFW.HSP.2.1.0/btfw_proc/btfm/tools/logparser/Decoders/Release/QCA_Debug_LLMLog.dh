GROUP gQca_LLM_PowerControlInfo "Power Control Info"
{
    FIELD fQca_LLM_PowerControlInfoConnHandle       (Fixed 2 Bytes)     (Decimal) "Connection Handle"
    FIELD fQca_LLM_PowerControlInfoSource           (Fixed 1 Byte)      (TABLE tQca_PLChangeSource) "Source of the Power change"
    GROUP gQca_LLM_PowerControlInfoFlags "Power Control Flags"
    {
        RESERVED    (Fixed 4 Bits)
        FIELD fQca_LLM_PowerControlSupport          (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Power Control Support "
        FIELD fQca_LLM_EnhPowerControlSupport       (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Enhanced Power Control Support "
        FIELD fQca_LLM_ConstPowerLevelCheck         (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Constant Power Support"
        FIELD fQca_LLM_LPAPCSupport                 (Fixed 1 Bit) (TABLE tQca_Power_Status)     "LPAPC Support "
    }
    FIELD fQca_LLM_PowerControlInfoMinPL            (Fixed 1 Byte)      (Decimal) "Minimum PL Index"
    FIELD fQca_LLM_PowerControlInfoMaxPL            (Fixed 1 Byte)      (Decimal) "Maximum PL Index"
    FIELD fQca_LLM_PowerControlInfoiPAMaxPL         (Fixed 1 Byte)      (Decimal) "iPA Max PL Index"
    FIELD fQca_LLM_PowerControlInfoCurrTxPL         (Fixed 1 Byte)      (Decimal) "Current Transmit PL"
    FIELD fQca_LLM_PowerControlInfoCurrTxdBm_BR     (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Current BR Transmit Power in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoCurrTxdBm_EDR    (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Current EDR Transmit Power in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoSAR_BR_LimitdBm  (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "BR SAR Limit in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoSAR_EDR_LimitdBm (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "EDR SAR Limit in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoAvgRSSIdBm       (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Average RSSI dBm"
}

TABLE tQca_PLChangeSource
    {0x00 "Remote"}
    {0x80 "Local"}
    {0x81 "Local Conn Init`"}
    {0x82 "Local Dynamic Control"}
    {0x83 "Local HPA Reset"}
    {0x84 "Local HPA Eval"}
    {0x85 "Local LPA Eval"}
    {0x86 "Local Set to COnstant PL"}
    {0x87 "Local LPA Reset"}
    {Default "Invalid"}
ENDTABLE

TABLE tQca_Power_Status
    {0x00, "Disabled" }
    {0x01, "Enabled" }
ENDTABLE

GROUP gQca_LLM_ESCO_Nego "eSCO Param Negotiation"
{
    FIELD gQca_LLM_ESCO_Nego_handle                 (Fixed 1 Bytes)   (Decimal) "handle"
    FIELD gQca_LLM_ESCO_Nego_rxT                    (Fixed 1 Bytes)   (Decimal) "rxT"
    FIELD gQca_LLM_ESCO_Nego_rxW                    (Fixed 1 Bytes)   (Decimal) "rxW"
    FIELD gQca_LLM_ESCO_Nego_rxD                    (Fixed 1 Bytes)   (Decimal) "rxD"

    FIELD gQca_LLM_ESCO_Nego_rxNegoState            (Fixed 1 Bytes)   (Decimal) "rxNegoState"
    FIELD gQca_LLM_ESCO_Nego_rxCombinationIndex     (Fixed 1 Bytes)   (Decimal) "rxCombinationIndex"
    FIELD gQca_LLM_ESCO_Nego_temp_rxCombinationIndex (Fixed 1 Bytes)   (Decimal) "temp_rxCombinationIndex"
    FIELD gQca_LLM_ESCO_Nego_negoCounter            (Fixed 1 Bytes)   (Decimal) "negoCounter"

    FIELD gQca_LLM_ESCO_Nego_rxPacketTypes          (Fixed 2 Bytes)   (hex) "rxPacketTypes"
    FIELD gQca_LLM_ESCO_Nego_packetTypesPermitted   (Fixed 2 Bytes)   (hex) "packetTypesPermitted"

    GROUP gQca_LLM_ESCO_Nego_Status "Status"    
    {
        reserved (fixed 3 bits)
        FIELD gQca_LLM_ESCO_Nego_Status_USED_COMBI          (Fixed 1 bits)   (Decimal) "used combination"
        FIELD gQca_LLM_ESCO_Nego_Status_LTADDR_PENDING_TX   (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "ltAddr Pending Tx"
        FIELD gQca_LLM_ESCO_Nego_Status_LATENCY_VIOLATE     (Fixed 1 bits)   (Decimal) "latency violate"
        FIELD gQca_LLM_ESCO_Nego_Status_RESERVED_VIOLATE    (Fixed 2 bits)   (Decimal) "reserved slots violate"
    }
    reserved (fixed 3 bytes)
}

TABLE tQca_BufTypeReq
    { 0 "Enable Background Buffer"}
    { 1 "Enable Dedicated Buffer"}
    { 2 "Disable Background Buffer"}
    { 3 "Disable Dedicated Buffer"}
    {default "Invalid"}
ENDTABLE

GROUP gQca_LLM_RtscBuffStatus  "RTSC Buffer Stats"
{
    FIELD Qca_LLM_RtscBuffStatus_rtscFlags           (Fixed 4 Bytes)  (Hex)                    "RTSC Flags"
    FIELD Qca_LLM_RtscBuffStatus_hciHandle           (Fixed 2 Bytes)  (Decimal)                "Hci Handle"
    FIELD Qca_LLM_RtscBuffStatus_curbufOffset        (Fixed 1 Bytes)  (Decimal)                "Current Buffer Offset"
    FIELD Qca_LLM_RtscBuffStatus_bkgdRtscOffset      (Fixed 1 Bytes)  (Decimal)                "Background Buffer Offset"
    FIELD Qca_LLM_RtscBuffStatus_BufTypeReq          (Fixed 1 Bytes)  (TABLE tQca_BufTypeReq)  "Buffer Type Requested"
    RESERVED                                         (Fixed 3 Bytes)
}

GROUP gQca_LLM_LE_Rssi "LE Rssi Data"
{
    FIELD fQca_LEChannelCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE LEChannelCntr

    GROUP gQca_LERawRssi REPEAT COUNT (Fixed 40 Times) "LE Raw RSSI Data"
    {
        GROUP gQca_LERawRssiType
        {
            FIELD fQca_LERawRssiByte          (Fixed 1 Bytes)   RETRIEVE (SignExtension 8)   (DecimalWithFieldLabel LEChannelCntr)      "LE Channel"
        }
        FIELD fQca_LERawChannelIncr (Fixed 0) RETRIEVE (StoreField LEChannelCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE LEChannelCntr
    }
}

TABLE tQca_LLM_VoiceAllocStaus
    {1 "fail"}
    {0 "success"}
ENDTABLE

GROUP gQca_LLM_VoiceAlloc "LLM eSCO Voice Allocation Status"
{    
    FIELD fQca_Voice_SampleBUF_Alloc              (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "SampleBuf Alloc"         //BIT7
    FIELD fQca_Voice_RateAdapt_Alloc              (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "RateAdapt Alloc"         //BIT6
    FIELD fQca_Voice_PLC_Alloc                    (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "PLC Alloc"               //BIT5
    FIELD fQca_Voice_Codec_Alloc                  (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Codec Alloc"             //BIT4
    FIELD fQca_Voice_Timer_Alloc                  (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Timer Alloc"             //BIT3
    FIELD fQca_Voice_Stream_Alloc                 (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Stream Alloc"            //BIT2
    FIELD fQca_Voice_Audio_MEMMGR_LOWER_Alloc     (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "AudioMemmgr lower alloc" //BIT1
    FIELD fQca_Voice_Audio_MEMMGR_UPPER_Alloc     (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "AudioMemmgr upper alloc" //BIT0
    
    RESERVED                                      (Fixed 1 Bit)                                                                  //BIT7
    FIELD fQca_Voice_streamSDU0_Alloc                (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Stream SDU0 alloc"    //BIT6
    FIELD fQca_Voice_GROUP_Alloc                  (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Group alloc"             //BIT5   
    FIELD fQca_Voice_LBCodec_Alloc                (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "LoopbackCodec alloc"     //BIT4
    FIELD fQca_Voice_LBOTA_Alloc                  (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "LoopbackOTA alloc"       //BIT3
    FIELD fQca_Voice_Mute_Alloc                   (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "Mute Alloc"              //BIT2
    FIELD fQca_Voice_EDP_Alloc                    (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "EDP Alloc"               //BIT1
    FIELD fQca_Voice_OTABUF_Alloc                 (Fixed 1 Bit)     (TABLE tQca_LLM_VoiceAllocStaus)   "OTABuf Alloc"            //BIT0
    
    
}
