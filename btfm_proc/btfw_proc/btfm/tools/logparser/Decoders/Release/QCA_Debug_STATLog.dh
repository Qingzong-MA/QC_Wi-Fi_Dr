    FIELD fQca_STAT_AsdStats_rssi_unknown   (Fixed 2 Bytes) IF(FieldIs EqualTo 0 fQca_STAT_AsdStats_acknakType) RETRIEVE (SignExtension 16) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_AsdStats_rssi_nak       (Fixed 2 Bytes) IF(FieldIs EqualTo 1 fQca_STAT_AsdStats_acknakType) RETRIEVE (SignExtension 16) (Decimal) "RSSI"
