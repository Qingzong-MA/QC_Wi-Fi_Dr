    {0x03 "COEX_TRF_MGMT_SHAPE_S_CTS"}
    {0x04 "COEX_TRF_MGMT_SHAPE_OCS"}
    {0x05 "COEX_TRF_MGMT_SHAPE_FIXED_TIME"}
    {0x06 "COEX_TRF_MGMT_SHAPE_NOA"}
    {0x07 "COEX_TRF_MGMT_SHAPE_OCS_CRITICAL"}
    {0x0A "COEX_TRF_MGMT_SHAPE_DYNAMIC"}
    {0xFF "COEX_TRF_MGMT_NONE"}
ENDTABLE

GROUP qQca_CXM_MciGpmAgent_Wlan_Policy_Indication   "WLAN COEX Policy Indication"
{
    FIELD Qca_Cxm_WlanPolicyMode            (Fixed 1 Bytes)  (TABLE tQca_CXM_Policy)      "PolicyMode "
    FIELD Qca_Cxm_WlanPolicyGrant           (Fixed 1 Bytes)  (Decimal)       "PolicyGrant"
    FIELD Qca_Cxm_WlanInterval              (Fixed 1 Bytes)  (Decimal)       "WlanInterval"
    FIELD Qca_Cxm_BtInterval                (Fixed 1 Bytes)  (Decimal)       "BtInterval"
}

/************************************************
 * 0x04FD "LOG_ID_CXM_SCHED_INFO"
************************************************/
GROUP gQca_CXM_schedInfo "coex sched info"
{
    FIELD fQca_cxmSchedStartTime            (Fixed 4 Bytes)            (Hex)        "StartTime in us"
    FIELD fQca_cxmSchedEndTime              (Fixed 4 Bytes)            (Hex)        "EndTime in us"
    FIELD fQca_cxmSchedInfoParse            (Fixed 4 Bytes)             (Hex)       SUPPRESS_DETAIL

    FIELD fQca_cxmtrafficType               (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 0)  ALSO (AndMask 0x07)  (Decimal)   SUPPRESS_DETAIL
    FIELD fQca_cxmSchedLink                 (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 3)  ALSO (AndMask 0xFF)  (Decimal)    "LinkID"
    FIELD fQca_cxmSchedPrio                 (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 11)  ALSO (AndMask 0xFF)  (Decimal)    "MCI PRIO"
    FIELD fQca_cxmSchedtxPower              (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 19)  ALSO (AndMask 0xFF)  (Decimal)    "TxPower/AVGRSSI"
    FIELD fQca_cxmSchedDirection            (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 27)  ALSO (AndMask 0x1)  (Decimal)    "Direction"
    FIELD fQca_cxmSchedTag                  (Fixed 0)  RETRIEVE (StoreField fQca_cxmSchedInfoParse) ALSO (ShiftRight 28)  ALSO (AndMask 0x0f)  (Decimal)    "Tag"
    FIELD fQca_cxmCurrTime                  (Fixed 4 Bytes)            (Hex)        "current time us"
    FIELD fQca_cxmSchedDur                  (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_cxmSchedEndTime fQca_cxmSchedStartTime) (Decimal) "Duration"
}
