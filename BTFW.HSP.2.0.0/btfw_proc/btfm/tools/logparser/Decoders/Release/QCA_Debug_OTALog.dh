            { 0x29 "LE_LL_CHANNEL_STATUS_IND" "LE_LL_CHANNEL_STATUS_IND" 0 gQca_CtrlData_LeChannelStatusInd }
            { 0xB4 "QLL_LE_LL_CHANNEL_REPORTING_IND" "QLL_LE_LL_CHANNEL_REPORTING_IND" 0 gQca_CtrlData_LeChannelReportInd }
            { 0xB5 "QLL_LE_LL_CHANNEL_STATUS_IND" "QLL_LE_LL_CHANNEL_STATUS_IND" 0 gQca_CtrlData_LeChannelStatusInd }
            { 0xF4 "LE_LL_PWR_REPORTS_REQ" "LE_LL_PWR_REPORTS_REQ" 0 gQca_CtrlData_LePowerReportsReq }
            { 0xF5 "LE_LL_PWR_REPORTS_RSP" "LE_LL_PWR_REPORTS_RSP" 0 gQca_CtrlData_LePowerReportsRsp }
            {Default "Unknown"          "Unknown"              0   } 
