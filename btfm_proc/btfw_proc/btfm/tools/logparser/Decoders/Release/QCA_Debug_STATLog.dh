TABLE tQca_RxAgcInfoGain
    {0x00, "GAIN LEVEL 0"}
    {0x01, "GAIN LEVEL 1"}
    {0x02, "GAIN LEVEL 2"}
    {0x03, "GAIN LEVEL 3"}
    {0x04, "GAIN LEVEL 4"}
    {0x05, "GAIN LEVEL 5"}
    {0x06, "GAIN LEVEL 6"}
    {0x07, "GAIN LEVEL 7"}
ENDTABLE
GROUP gQca_STAT_LERxAgcInfo "LE Rx AGC Status"
{
    FIELD fQca_RxAgcCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE RxAgcCntr

    GROUP gQca_LERxAgcStatus REPEAT COUNT (Fixed 8 Times)
    {
        GROUP gQca_LERxAgcGroup LABEL(LabelCount "LE Rx Agc Status #" RxAgcCntr)
        {
            FIELD fQca_RxAgcInfo_sLNA  (Fixed 3 bits) (TABLE tQca_RxAgcInfoGain) "SLNA"
            FIELD fQca_RxAgcInfo_GM  (Fixed 3 bits) (TABLE tQca_RxAgcInfoGain)  "GM"
            FIELD fQca_RxAgcInfo_TIA  (Fixed 2 bits) (TABLE tQca_RxAgcInfoGain) "TIA"
            RESERVED (Fixed 7 bits)
            FIELD fQca_RxAgcInfo_xLNA  (Fixed 1 bit) (TABLE tQca_RxAgcInfoxLNA)  "xLNA"
        }
        /* Increment the Counter */
        FIELD fQca_RxAgcGroupCntr (Fixed 0) RETRIEVE (StoreField RxAgcCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE RxAgcCntr
    }
}

TABLE tLQ_levelsQC
    {0x01 "LOW"}
    {0x02 "MEDIUM"}
    {0x03 "STD"}
    {0x04 "HIGH"}
    {0x05 "UH"}
    {Default "Invalid"}
