    {0x03  "Trigger_Set"  "Trigger_Set" 0    gTracerTrigSet}
    {0x04  "Event_Set"    "Event_Set"   0    gTracerEvtSet}
    {0x05  "Config"       "Config"      0    gTracerConf}
ENDTABLE

TABLE tTracerBusSource
    {0x00  "FM Bus"}
    {0x01  "BT Bus"}
    {0x02  "AMBA Bus"}
    {0x03  "COEX Bus"}
    {0x04  "RTC Bus"}
    {0x05  "RFA Bus"}
    {0x07  "TOP Bus"}
ENDTABLE

GROUP gTracerBusSet  "Tracer Bus Setting"
{
    FIELD  fTrcBusMask   (Fixed 1 Bytes)     (Hex)    "Tracer Bus Byte Swap Mask"
    FIELD fTrcBusBitCntr  (Fixed 0)   RETRIEVE (StoreInteger 0)   (Hex)   SUPPRESS_DETAIL STORE BitCntr
    GROUP gTrcBusBitSel    REPEAT SIZE(Fixed 16 Bytes)   "Tracer Bus Source Select Per Bits"
    {
        GROUP gTrcBusBitIndex LABEL(LabelCount "Bit #" BitCntr)
        {
            FIELD  fTrcBitBusSel   (Fixed 1 Bytes)   (TABLE tTracerBusSource)  "Bus Select"
        }
        /* Increment the Counter */
        FIELD fTrcBitCntrIncr (Fixed 0) RETRIEVE (StoreField BitCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE BitCntr
    }
}

TABLE tTracerTrigCapMode
    {0x00  "Capture Disabled"}
    {0x01  "Capture Every Clock"}
    {0x02  "Capture When Bit Changed"}
ENDTABLE

GROUP gTracerTrigSet    "Tracer Trigger Setting"
{
    FIELD  fTrcTrigIndex   (Fixed 1 Bytes)  (Decimal)    "Tracer Trigger Index"
    GROUP  gTrcTrigWFTSet  IF (FieldIs EqualTo 0x00 fTrcTrigIndex)
    {
        FIELD  fTrcTrigWFTCapMask   (Fixed 2 Bytes)   (Hex)   "WFT capture mask"
        FIELD  fTrcTrigWFTCapMode   (Fixed 1 Bytes)   (TABLE tTracerTrigCapMode)  "WFT Capture Mode"
        FIELD  fTrcTrigWFTCapCnt       (Fixed 2 Bytes)   (Decimal)   "WFT Max Capture Count(val*128)"
        FIELD  fTrcTrigWFTCapNxt       (Fixed 1 Bytes)   (Binary)  "WFT Next Trigger State Enabled TS1 ~ TS5"
        RESERVED                    (Fixed 4 Bytes)
    }
    GROUP  gTrcTrigTSSet   IF (FieldIs  NotEqualTo 0x00  fTrcTrigIndex)
    {
        FIELD  fTrcTrigTSCapMask   (Fixed 2 Bytes)   (Hex)   "TS capture mask"
        FIELD  fTrcTrigTSCapMode   (Fixed 1 Bytes)   (TABLE tTracerTrigCapMode)  "TS Capture Mode"
        FIELD  fTrcTrigTSCapCnt       (Fixed 2 Bytes)   (Decimal)   "TS Max Capture Count(val*128)"
        FIELD  fTrcTrigTSCapNxt       (Fixed 1 Bytes)   (Binary)  "TS Next Trigger State Enabled TS1 ~ TS5"
        FIELD  fTrcTrigTSTrigMask   (Fixed 2 Bytes)   (Hex)  "TS Trigger Event Signal Mask"
        FIELD  fTrcTrigTSTrigVal    (Fixed 2 Bytes)   (Hex)  "TS Trigger Event Signal Value"
    }
}

GROUP  gTracerEvtSet   "Tracer Event Setting"
{
    FIELD   fTrcEvtMask     (Fixed 1 Bytes)   (Binary)   "Event enable - bit0=aci bit1=hci bit2=sw bit3=AON bit4=BT_core bit5=Coex bit6=rtc"
    FIELD   fTrcEvtCrossTrig   (Fixed 1 Bytes)  (Binary)  "Cross trigger enable for the 5 trigger modules"
}

TABLE  tTrcConfClkSel
    {0, "ref Clk"}
    {1, "Soc Clk"}
    {2, "Soc Clk"}
    {3, "64MHz"}
ENDTABLE

TABLE  tTrcConfMode
    {0, "Tracer Mode"}
    {1, "Event Mode"}
ENDTABLE

TABLE  tTrcConfOvwMode
    {0, "Fixed Buffer"}
    {1, "Overwrite Enabled"}
ENDTABLE

GROUP  gTracerConf  "Tracer Configuration"
{
    FIELD   fTrcConfClkSel   (Fixed 1 Bytes)   (TABLE tTrcConfClkSel)    "Tracer Clock Select"
    FIELD   fTrcConfMode     (Fixed 1 Bytes)   (TABLE tTrcConfMode)    "Tracer Mode Select"
    FIELD   fTrcConfInputMask (Fixed 2 Bytes)   (Hex)       "Input Mask"
    FIELD   fTrcConfOvwMode   (Fixed 1 Bytes)   (TABLE tTrcConfOvwMode)   "Tracer Overwrite Mode"
    FIELD   fTrcConfSampRate   (Fixed 2 Bytes)   (Decimal)    "Tracer Sampling Rate"
    FIELD   fTrcConfSampScale  (Fixed 1 Bytes)    (Decimal)   "Tracer Timestamp Scale"
    FIELD   fTrcConfWatermark   (Fixed 2 Bytes)   (Decimal)   "Tracer Interrupt Watermark"
    FIELD   fTrcConfPeriod     (Fixed 4 Bytes)    (Decimal)   "Tracer Monitor Timer Interval In ms"
}

/******************************************************************************
 *                          Decoder for OCF 0xDA                             *
 ******************************************************************************/
GROUP gLinkPowerCtrlCmd
{
    FIELD   fLinkPowerCtrlCmd         (Fixed 1 Bytes)   (TABLE tLinkPowerCtrlOp)    "Sub Opcode"
    BRANCH (FromTable tLinkPowerCtrlOp fLinkPowerCtrlCmd)
    FIELD gLinkPowerCtrl_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

GROUP gLinkPowerCtrlEvt
{
    FIELD   fLinkPowerCtrlEvtStatus  (Fixed 1 Bytes)   (TABLE tTruncPageOffloadStatus) "Return Status"
    FIELD   fLinkPowerCtrlEvt        (Fixed 1 Bytes)   (TABLE tLinkPowerCtrlOp)     "Sub Opcode"
    FIELD   fLinkDataUnParsedEvt     (toendoflayer)    IF(MoreBytes) (stringofhex)  "This is unparsed data"
}

TABLE tLinkPowerCtrlOp
{0x00 "Disable Max A2DP Link Power"}
{0x01 "Enable Max A2DP Link Power"}
{0x02 "Enable ACL link Const Power"}
{0x03 "Disable ACL link Const Power"}
{0x04 "Enable High Power Adaptive mode"}
{0x05 "Disable High Power Adaptive mode"}
{0x06 "HCI_VS_SET_MAX_RADIATED_POWER" "HCI_VS_SET_MAX_RADIATED_POWER" 0 gLinkPowerCtrlSetMaxPowr}
{0x0E "HCI_VS_SET_TECH_BASED_MAX_RADIATED_POWER" "HCI_VS_SET_TECH_BASED_MAX_RADIATED_POWER" 0 gLinkPowerCtrlTechBasedPowr}
{0x13 "HCI_VS_SET_MIN_A2DP_POWER"                "HCI_VS_SET_MIN_A2DP_POWER"                0 gLinkPowerCtrlSetMinPowr}
{Default "Invalid"}
ENDTABLE

GROUP gLinkPowerCtrlSetMaxPowr "Set Max Radiated Power"
{
        FIELD fLinkPowerCtrlSetMaxPowrPout     (Fixed 1 Bytes) (Decimal)       "Maximum allowed Power (in 0.25 dBm unit)"
}

GROUP gLinkPowerCtrlTechBasedPowr "Set Tech.Based Max Radiated Power"
{
        FIELD fLinkPowerCtrlSetTechMaxPowrPairCnt     (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)       "Number of tech. and power pairs"
        GROUP gQCA_LinkPowerCtrlSetTechMaxPowr_Pairs REPEAT COUNT (FromField Times fLinkPowerCtrlSetTechMaxPowrPairCnt)
        {
            Group gQCA_LinkPowerCtrlSetTechMaxPowr_PairsDetail "Pair:"
            {
                FIELD fLinkPowerCtrlSetTechMaxPowrTech     (Fixed 1 Bytes)   (Table tLinkPowerCtrlTech)       "Technology: "
                FIELD fLinkPowerCtrlSetTechMaxPowrPout     (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)       "Maximum allowed Power (in 0.25 dBm unit)"
            }
        }
}

TABLE tLinkPowerCtrlTech
{0x00 "Basic Rate(BR)"}
{0x01 "Enhanced Data Rate(EDR)"}
{0x02 "Low Energy(BLE)"}
{0x03 "Low Energy HS (LEHS)"}
{Default "Invalid"}
ENDTABLE

GROUP gLinkPowerCtrlSetMinPowr "Set Min Power for A2DP"
{
    FIELD fLinkPowerCtrlSetMinPowr     (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)       "Min power level"
}

/******************************************************************************
 *                          Decoder for OCF 0x11C                             *
 ******************************************************************************/
GROUP gLoopbackCmd
{
    FIELD   fLoopbackCmd                  (Fixed 1 Bytes)   (TABLE tLoopbackMode)        "Sub Opcode"
    BRANCH (FromTable tLoopbackMode fLoopbackCmd)
    FIELD   fLoopbackDataUnParsedCmd      (toendoflayer)    IF(MoreBytes) (stringofhex)      "This is unparsed data"
}

GROUP gLoopbackEvt
{
    FIELD   fLoopbackEvtStatus            (Fixed 1 Bytes)   (Hex)                            "Return Status"
    FIELD   fLoopbackEvtMode              (Fixed 1 Bytes)   (TABLE tLoopbackMode)        "Mode"
    FIELD   fgLoopbackEvtDataUnParsed     (toendoflayer)    IF(MoreBytes) (stringofhex)      "This is unparsed data"
}

GROUP gLoopbackBTFMANT
{
    FIELD   fLoopbackDataUnParsedCmdBTFMANT      (toendoflayer)    IF(MoreBytes) (stringofhex)      "This is unparsed data"
}

GROUP gPeriodicAging
{
    FIELD   fPeriodicAgingEnable                       (Fixed 1 Bytes)   (Hex)                            "Enable/Disable"
    FIELD   fPeriodicAgingInterval                     (Fixed 2 Bytes)   (Hex)                            "Interval"
    FIELD   fLoopbackDataUnParsedCmdPeriodicAging      (toendoflayer)    IF(MoreBytes) (stringofhex)      "This is unparsed data"
}

TABLE tLoopbackMode
{0x00 "VSC_LOOPBACK_MODE_DISABLED" "VSC_LOOPBACK_MODE_DISABLED" 0 gLoopbackBTFMANT}
{0x01 "VSC_LOOPBACK_MODE_BT" "VSC_LOOPBACK_MODE_BT" 0 gLoopbackBTFMANT}
{0x02 "VSC_LOOPBACK_MODE_FM" "VSC_LOOPBACK_MODE_FM" 0 gLoopbackBTFMANT}
{0x03 "VSC_LOOPBACK_MODE_BT_FM" "VSC_LOOPBACK_MODE_BT_FM" 0 gLoopbackBTFMANT}
{0x04 "VSC_LOOPBACK_MODE_ANT" "VSC_LOOPBACK_MODE_ANT" 0 gLoopbackBTFMANT}
{0x05 "VSC_LOOPBACK_MODE_BT_ANT" "VSC_LOOPBACK_MODE_BT_ANT" 0 gLoopbackBTFMANT}
{0x06 "VSC_LOOPBACK_MODE_ANT_FM" "VSC_LOOPBACK_MODE_ANT_FM" 0 gLoopbackBTFMANT}
{0x07 "VSC_LOOPBACK_MODE_BT_ANT_FM" "VSC_LOOPBACK_MODE_BT_ANT_FM" 0 gLoopbackBTFMANT}
{0x08 "VSC_LOOPBACK_MODE_TRIGGER_SSR" "VSC_LOOPBACK_MODE_TRIGGER_SSR" 0 gLoopbackBTFMANT}
{0x09 "VSC_LOOPBACK_MODE_MAX" "VSC_LOOPBACK_MODE_MAX" 0 gLoopbackBTFMANT}
{0x0A "VSC_LOOPBACK_CONFIG_PERIODIC_EVENT" "VSC_LOOPBACK_CONFIG_PERIODIC_EVENT" 0 gPeriodicAging}
ENDTABLE

/******************************************************************************
 *                          Decoder for OCF 0x1e9                             *
 ******************************************************************************/
GROUP gTruncPageOffloadCmd
{
     FIELD gTruncPageOffload_opcode (Fixed 1 byte) (Table tTruncPageOffloadOpcodes) "SubOpcode"
     BRANCH (FromTable tTruncPageOffloadOpcodes gTruncPageOffload_opcode)
     FIELD gTruncPageOffload_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE tTruncPageOffloadOpcodes
{0x01 "HCI_VS_Page_Offload_Start" "HCI_VS_Page_Offload_Start" 0 gTruncPageOffloadStart}
{0x02 "HCI_VS_Page_Offload_Cancel" "HCI_VS_Page_Offload_Cancel"}
ENDTABLE

GROUP gTruncPageOffloadStart " Truncated Paging start"
{
    FIELD fTruncpageOffload_Window          (Fixed 2 Bytes)   (Hex)                "Paging Window"
    FIELD fTruncpageOffload_Interval        (Fixed 4 Bytes)   (Hex)                "Paging Interval"
    FIELD fTruncpageOffload_RepeatCnt       (Fixed 2 Bytes)   (Hex)                "Repeat count for timeout"
    FIELD fTruncpageOffload_numDevice       (Fixed 1 Bytes)   (Decimal)            "Number of devices"
    GROUP gQca_TruncpageOffload_BDADDR REPEAT COUNT (FromField Times fTruncpageOffload_numDevice) "Device list"
    {
        FIELD fTruncpageOffload_BDADDR          (Fixed 6 Bytes)   (Hex)                "Bluetooth Address"
        FIELD fTruncpageOffload_Priority        (Fixed 1 Bytes)   (Table tTruncPageOffloadPriority) "Priority"
    }

}

TABLE tTruncPageOffloadPriority
{0x00 "High Priority"}
{0x01 "Low Priority"}
ENDTABLE

/******************************************************************************
 *                          Decoder for OCF 0x1F1                             *
 ******************************************************************************/

GROUP gQca_DBFW_cmd
{
     FIELD fQca_DBFW_subOpcode (Fixed 1 byte) (Table tQca_DBFW_subOpcodes) "SubOpcode"
     BRANCH (FromTable tQca_DBFW_subOpcodes fQca_DBFW_subOpcode)
     FIELD fQca_DBFW_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE tQca_DBFW_subOpcodes
    {0x10 "HCI_VS_DBFW_LINK_LOSS_ENABLE"            "HCI_VS_DBFW_LINK_LOSS_ENABLE"            0 gQca_DBFW_linkLossEnable}
    {0x30 "HCI_VS_DBFW_SET_SCO_DATA_DUMP_MODE"      "HCI_VS_DBFW_SET_SCO_DATA_DUMP_MODE"      0 gQca_DBFW_setScoDataDumpMode}
    {0x31 "HCI_VS_DBFW_SET_SCO_DEBUG_INFO_MODE"     "HCI_VS_DBFW_SET_SCO_DEBUG_INFO_MODE"     0 gQca_DBFW_setScoDbgInfoMode}
    {0x32 "HCI_VS_DBFW_SET_SCO_PACKET_INFO_MODE"    "HCI_VS_DBFW_SET_SCO_PACKET_INFO_MODE"    0 gQca_DBFW_setScoPktInfoMode}
    {0x40 "HCI_VS_DBFW_NOC_RSSI_ENABLE"             "HCI_VS_DBFW_NOC_RSSI_ENABLE"             0 gQca_DBFW_nocRSSIEnable}
ENDTABLE

GROUP gQca_DBFW_linkLossEnable "DBFW Link Loss Enable"
{
     FIELD fQca_DBFW_enable                (Fixed 1 byte)  (TABLE tQca_DBFW_enableMode)         "Mode"
     FIELD fQca_DBFW_connHandle            (Fixed 2 bytes) (Hex)                                "Connection Handle"
}

GROUP gQca_DBFW_setScoDataDumpMode "DBFW Set SCO Data Dump Mode"
{
     FIELD fQca_DBFW_scoDataDumpMode       (Fixed 1 byte)  (TABLE tQca_DBFW_scoDataDumpMode)    "Dump Mode"
     FIELD fQca_DBFW_scoDataDumpDuration   (Fixed 2 bytes) (Decimal) ALSO (Constant "s")        "Dump Duration"
}

GROUP gQca_DBFW_setScoDbgInfoMode "DBFW Set SCO Debug Info Mode"
{
     FIELD fQca_DBFW_scoDbgInfoMode           (Fixed 1 byte)  (TABLE tQca_DBFW_enableMode)         "Mode"
     FIELD fQca_DBFW_scoDbgInfoCountNullPkt   (Fixed 1 byte)  (TABLE tQca_DBFW_enableMode)         "Count NULL Packet as a Missed Packet"
}

GROUP gQca_DBFW_setScoPktInfoMode "DBFW Set SCO Packet Info Mode"
{
     FIELD fQca_DBFW_scoPktInfoMode        (Fixed 1 byte)  (TABLE tQca_DBFW_enableMode)         "Mode"
}

GROUP gQca_DBFW_cmdCompleteEvt "Return Parameters"
{
     FIELD fQca_DBFW_status                (Fixed 1 byte)  (Hex)                            "Status"
}

GROUP gQca_DBFW_nocRSSIEnable "DBFW NOC RSSI Enable"
{
     FIELD fQca_DBFW_enable;
}

TABLE tQca_DBFW_enableMode
    {0x00 "Disable"}
    {0x01 "Enable"}
    {Default "Invalid"}
ENDTABLE

TABLE tQca_DBFW_scoDataDumpMode
    {0x00 "SCO Dump Disable"}
    {0x01 "SCO PCM Tx Data Dump Enable"}
    {0x02 "SCO PCM Rx Data Dump Enable"}
    {0x03 "SCO PCM Tx and Rx Data Dump Enable"}
    {0x04 "SCO ANT Tx Data Dump Enable"}
    {0x05 "SCO ANT Rx Data Dump Enable"}
    {0x06 "SCO ANT Tx and Rx Data Dump Enable"}
    {0x07 "SCO ANT/PCM Tx and Rx Data Dump Enable"}
    {Default "Invalid"}
ENDTABLE


