  FIELD fQca_MciGpmAgent_WLAN_CONNECTION_STATUS_REPORT_chain1_5gStatus_Bit17   (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)  (Table tQca_CXM_WlanConnectionStatus)   "chain1_5gStatus_Scanning"
