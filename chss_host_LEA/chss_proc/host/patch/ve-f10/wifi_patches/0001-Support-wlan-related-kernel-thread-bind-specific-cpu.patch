From 3d34a0227ff8f5c1cd114e8e3e36ccec24826efa Mon Sep 17 00:00:00 2001
From: "nano.wang" <nano.wang@quectel.com>
Date: Wed, 27 Dec 2023 19:04:22 +0800
Subject: [PATCH] Support wlan related kernel thread bind specific cpu

Change-Id: Ib2c61c24eb11c65fc7b493f10f0bf828492a8962
---
 .../qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c     | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/chss_host_LEA/chss_proc/host/AIO/drivers/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c b/chss_host_LEA/chss_proc/host/AIO/drivers/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
index 7f32ccd3..6166cbc1 100644
--- a/chss_host_LEA/chss_proc/host/AIO/drivers/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
+++ b/chss_host_LEA/chss_proc/host/AIO/drivers/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
@@ -129,12 +129,23 @@ qdf_thread_t *qdf_create_thread(int (*thread_handler)(void *data), void *data,
 				const char thread_name[])
 {
 	struct task_struct *task;
+	unsigned int cpu_idx = 0;
 
 	task = kthread_create(thread_handler, data, thread_name);
 
 	if (IS_ERR(task))
 		return NULL;
 
+	/*
+	 * Bind new thread dp_rx_thread_x or scheduler_thread to specific cpu.
+	 * If you want to bind the threads to different cpus, you can select
+	 * the thread by match the value of 'thread_name' with 'thread_0',
+	 * 'thread_1' or others.
+	 */
+	cpu_idx = 1;
+	kthread_bind(task, cpu_idx);
+	wake_up_process(task);
+
 	return task;
 }
 qdf_export_symbol(qdf_create_thread);
-- 
