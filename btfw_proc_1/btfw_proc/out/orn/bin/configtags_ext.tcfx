            <ELEMENTS Name="AOA_2" Default="0x1D" Description="AOA_2" />
            <ELEMENTS Name="AOA_3" Default="0x1E" Description="AOA_3" />
            <ELEMENTS Name="AOA_4" Default="0x1F" Description="AOA_4" />
            <ELEMENTS Name="AOA_5" Default="0x20" Description="AOA_5" />
            <ELEMENTS Name="COEX_SPTA_ACTIVE" Default="0x21" Description="COEX_SPTA_ACTIVE" />
            <ELEMENTS Name="COEX_SPTA_CONFX" Default="0x22" Description="COEX_SPTA_CONFX" />
            <ELEMENTS Name="COEX_SPTA_STATUS" Default="0x23" Description="COEX_SPTA_STATUS" />
            <ELEMENTS Name="COEX_MPTA_ACTIVE" Default="0x24" Description="COEX_MPTA_ACTIVE" />
            <ELEMENTS Name="COEX_MPTA_CONFX" Default="0x25" Description="COEX_MPTA_CONFX" />
