GROUP gQca_LLM_ESCO_Nego "eSCO Param Negotiation"
{
    FIELD gQca_LLM_ESCO_Nego_handle                 (Fixed 1 Bytes)   (Decimal) "handle"
    FIELD gQca_LLM_ESCO_Nego_rxT                    (Fixed 1 Bytes)   (Decimal) "rxT"
    FIELD gQca_LLM_ESCO_Nego_rxW                    (Fixed 1 Bytes)   (Decimal) "rxW"
    FIELD gQca_LLM_ESCO_Nego_rxD                    (Fixed 1 Bytes)   (Decimal) "rxD"

    FIELD gQca_LLM_ESCO_Nego_rxLatency              (Fixed 1 Bytes)   (Decimal) "rxLatency"
    FIELD gQca_LLM_ESCO_Nego_rxTimingCntrlFlags     (Fixed 1 Bytes)   (Decimal) "rxTimingCntrlFlags"
    FIELD gQca_LLM_ESCO_Nego_rxNegoState            (Fixed 1 Bytes)   (Decimal) "rxNegoState"
    FIELD gQca_LLM_ESCO_Nego_rxCombinationIndex     (Fixed 1 Bytes)   (Decimal) "rxCombinationIndex"
    FIELD gQca_LLM_ESCO_Nego_temp_rxCombinationIndex (Fixed 1 Bytes)   (Decimal) "temp_rxCombinationIndex"
    FIELD gQca_LLM_ESCO_Nego_negoCounter            (Fixed 1 Bytes)   (Decimal) "negoCounter"
    FIELD gQca_LLM_ESCO_Nego_rxPacketTypes          (Fixed 1 Bytes)   (hex) "rxPacketTypes"
    GROUP gQca_LLM_ESCO_Nego_Status "flag"
    {
        reserved (fixed 6 bits)
        FIELD gQca_LLM_ESCO_Nego_Flag_USED_COMBI          (Fixed 1 bits)   (Decimal) "used combination"
        FIELD gQca_LLM_ESCO_Nego_Flag_LTADDR_PENDING_TX   (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "ltAddr Pending Tx"
    }
    FIELD gQca_LLM_ESCO_Nego_packetTypesPermitted   (Fixed 2 Bytes)   (hex) "packetTypesPermitted"

    FIELD gQca_LLM_ESCO_Nego_latencyStatus          (Fixed 1 Bytes)   (Decimal) "latencyStatus"
    FIELD gQca_LLM_ESCO_Nego_reservedSlotHardClash  (Fixed 1 Bytes)   (Decimal) "reservedSlotHardClash"
    FIELD gQca_LLM_ESCO_Nego_reservedSlotStatus     (Fixed 1 Bytes)   (TABLE tQca_SlotViolation_Status) "slotViolation"
    reserved (fixed 3 bytes)
}

