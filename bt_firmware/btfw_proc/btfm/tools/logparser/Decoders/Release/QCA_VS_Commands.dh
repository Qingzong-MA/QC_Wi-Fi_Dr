{0x18 "VS_WiPower_HCI_Event"              "VS_WiPower_HCI_Event" 0 gWipowerChargingStatusEvt }
{0x19 "VS_WiPower_HCI_Event"              "VS_WiPower_HCI_Event" 0 gWipowerhandoffEvt }
