    { 0x00 1M }
    { 0x01 2M }
    { 0x02 CODED_125K }
    { 0x03 CODED_500K }
    { 0x04 LEHS}
ENDTABLE

GROUP gQca_LLM_LE_LPA_StateLog "State Log"
{
    reserved (fixed 1 bytes)
    FIELD fQca_LLM_LE_LPA_StateLog_flag             (Fixed 2 Bytes)     (TABLE tQca_LLM_LE_LPA_flag)  "Flag"
    FIELD fQca_LLM_LE_LPA_StateLog_aclHandle        (Fixed 1 Bytes)     (Decimal)  "aclHandle"
    FIELD fQca_LLM_LE_LPA_StateLog_phyrate          (Fixed 1 Bytes)     (TABLE tQca_LE_LPA_PhyRate)  "StreamPHY"
    FIELD fQca_LLM_LE_LPA_StateLog_currPL           (Fixed 1 Bytes)     (Decimal)  "currPL"
    FIELD fQca_LLM_LE_LPA_StateLog_maxPL            (Fixed 1 Bytes)     (Decimal)  "maxPL"
    FIELD fQca_LLM_LE_LPA_StateLog_LPAMinPL         (Fixed 1 Bytes)     (Decimal)  "LPAMinPL"
    reserved (fixed 7 bits)
    FIELD fQca_LLM_LE_LPA_StateLog_supportFeature   (Fixed 1 bit)       PRINT_IF (FieldIs NotEqualTo 0) (Decimal)  "supportPwrCtrl"
    FIELD fQca_LLM_LE_LPA_StateLog_activeStreamCnt  (Fixed 1 Bytes)     (Decimal)  "activeStreamCnt"
    reserved (fixed 1 bytes)
}

GROUP gQca_LLM_LE_LPA_EvalLog "Eval Log"
{
    FIELD fQca_LLM_LE_LPA_EvalLog_timerNum          (Fixed 1 Bytes)     (Decimal)  "timerCnt"
    FIELD fQca_LLM_LE_LPA_EvalLog_powerChanged      (Fixed 2 Bytes)     RETRIEVE (AndMask 0x1) (Decimal)  "powerChanged"
    FIELD fQca_LLM_LE_LPA_EvalLog_aclHandle         (Fixed 1 Bytes)     (Decimal)  "aclHandle"
    FIELD fQca_LLM_LE_LPA_EvalLog_phyrate           (Fixed 1 Bytes)     (TABLE tQca_LE_LPA_PhyRate)  "aclPHY"
    FIELD fQca_LLM_LE_LPA_EvalLog_avgRSSI           (Fixed 1 Bytes)     RETRIEVE (SignExtension 8) (Decimal)  "avgRSSI"
    FIELD fQca_LLM_LE_LPA_EvalLog_cnt               (Fixed 1 Bytes)     (Decimal) "Cnt"

    GROUP gPollscheduler REPEAT COUNT (FromField Times fQca_LLM_LE_LPA_EvalLog_cnt 0) "Count Info"
    {
        GROUP gQca_LLM_LE_LPA_EvalLog_CounterDbg;
    }
}

GROUP gQca_LLM_LE_LPA_EvalLog_CounterDbg
{
    FIELD fQca_LLM_LE_LPA_EvalLog_CounterDbg_phyrate        (Fixed 1 bytes)  (TABLE tQca_LE_LPA_PhyRate) "------ StreamPHY"
    FIELD fQca_LLM_LE_LPA_EvalLog_CounterDbg_currPL         (Fixed 1 bytes)  (Decimal) "currPL"
    FIELD fQca_LLM_LE_LPA_EvalLog_CounterDbg_flag           (Fixed 2 bytes)  (TABLE tQca_LLM_LE_LPA_flag) "Flag"

    Group gQca_LLM_LE_LPA_EvalLog_Counter
    {
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_rxMissCnt     (Fixed 2 bytes)  (Decimal) "rxMissCnt"
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_rxNakCnt      (Fixed 2 bytes)  (Decimal) "rxNakCnt"
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_rxAckCnt      (Fixed 2 bytes)  (Decimal) "rxAckCnt"
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_decCnt        (Fixed 1 bytes)  (Decimal) "decCnt"
        reserved (fixed 1 bytes)
        
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_Calc_Nak      (Fixed 0) RETRIEVE (AddFieldToField fQca_LLM_LE_LPA_EvalLog_Counter_rxNakCnt fQca_LLM_LE_LPA_EvalLog_Counter_rxMissCnt) (Hex) SUPPRESS_DETAIL
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_Calc_Total    (Fixed 0) RETRIEVE (AddFieldToField fQca_LLM_LE_LPA_EvalLog_Counter_Calc_Nak fQca_LLM_LE_LPA_EvalLog_Counter_rxAckCnt) (Hex) SUPPRESS_DETAIL
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_Calc_NakRateTmp (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_LLM_LE_LPA_EvalLog_Counter_Calc_Nak 100) (Hex) SUPPRESS_DETAIL
        FIELD fQca_LLM_LE_LPA_EvalLog_Counter_Calc_NakRate (Fixed 0) RETRIEVE (DivideFieldByField fQca_LLM_LE_LPA_EvalLog_Counter_Calc_NakRateTmp fQca_LLM_LE_LPA_EvalLog_Counter_Calc_Total) (Decimal) "NakRate"
    }
}

