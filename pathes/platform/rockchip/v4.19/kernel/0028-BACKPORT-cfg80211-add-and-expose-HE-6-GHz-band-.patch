From 6fc9d02f9bb6d3b8cb3ec607f13548cccd4fe34d Mon Sep 17 00:00:00 2001
From: "neil.shi" <neil.shi@quectel.com>
Date: Sat, 22 Jul 2023 15:20:06 +0800
Subject: [PATCH 28/33] BACKPORT: cfg80211: add and expose HE 6 GHz band capabilities

Change-Id: Ifea8a4718284db6bb209756e1004d9a4e05bd046
---
 kernel/include/net/cfg80211.h       | 6 ++++++
 kernel/include/uapi/linux/nl80211.h | 3 +++
 kernel/net/wireless/nl80211.c       | 9 ++++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/kernel/include/net/cfg80211.h b/kernel/include/net/cfg80211.h
index 887f64590d..eca945f553 100644
--- a/kernel/include/net/cfg80211.h
+++ b/kernel/include/net/cfg80211.h
@@ -32,6 +32,9 @@
 /* Indicate backport support for 6GHz band */
 #define CFG80211_6GHZ_BAND_SUPPORTED 1
 
+/* Indicate backport support for sband iftype data */
+#define CFG80211_SBAND_IFTYPE_DATA_BACKPORT 1
+
 /* Indicate backport support for processing user cell base hint */
 #define CFG80211_USER_HINT_CELL_BASE_SELF_MANAGED 1
 /* backport support for new cfg80211 ops "update_connect_params" */
@@ -340,10 +343,13 @@ struct ieee80211_sta_he_cap {
  *
  * @types_mask: interface types mask
  * @he_cap: holds the HE capabilities
+ * @he_6ghz_capa: HE 6 GHz capabilities, must be filled in for a
+ *	6 GHz band channel (and 0 may be valid value).
  */
 struct ieee80211_sband_iftype_data {
 	u16 types_mask;
 	struct ieee80211_sta_he_cap he_cap;
+	struct ieee80211_he_6ghz_capa he_6ghz_capa;
 };
 
 /**
diff --git a/kernel/include/uapi/linux/nl80211.h b/kernel/include/uapi/linux/nl80211.h
index e8bca08b26..6c23665a00 100644
--- a/kernel/include/uapi/linux/nl80211.h
+++ b/kernel/include/uapi/linux/nl80211.h
@@ -3377,6 +3377,8 @@ enum nl80211_mpath_info {
  *     defined in HE capabilities IE
  * @NL80211_BAND_IFTYPE_ATTR_MAX: highest band HE capability attribute currently
  *     defined
+ * @NL80211_BAND_IFTYPE_ATTR_HE_6GHZ_CAPA: HE 6GHz band capabilities (__le16),
+ *	given for all 6 GHz band channels
  * @__NL80211_BAND_IFTYPE_ATTR_AFTER_LAST: internal use
  */
 enum nl80211_band_iftype_attr {
@@ -3387,6 +3389,7 @@ enum nl80211_band_iftype_attr {
 	NL80211_BAND_IFTYPE_ATTR_HE_CAP_PHY,
 	NL80211_BAND_IFTYPE_ATTR_HE_CAP_MCS_SET,
 	NL80211_BAND_IFTYPE_ATTR_HE_CAP_PPE,
+	NL80211_BAND_IFTYPE_ATTR_HE_6GHZ_CAPA,
 
 	/* keep last */
 	__NL80211_BAND_IFTYPE_ATTR_AFTER_LAST,
diff --git a/kernel/net/wireless/nl80211.c b/kernel/net/wireless/nl80211.c
index 18bb660560..72bed35252 100644
--- a/kernel/net/wireless/nl80211.c
+++ b/kernel/net/wireless/nl80211.c
@@ -1380,6 +1380,7 @@ static int nl80211_send_coalesce(struct sk_buff *msg,
 
 static int
 nl80211_send_iftype_data(struct sk_buff *msg,
+			 const struct ieee80211_supported_band *sband,
 			 const struct ieee80211_sband_iftype_data *iftdata)
 {
 	const struct ieee80211_sta_he_cap *he_cap = &iftdata->he_cap;
@@ -1403,6 +1404,12 @@ nl80211_send_iftype_data(struct sk_buff *msg,
 			return -ENOBUFS;
 	}
 
+	if (sband->band == NL80211_BAND_6GHZ &&
+	    nla_put(msg, NL80211_BAND_IFTYPE_ATTR_HE_6GHZ_CAPA,
+		    sizeof(iftdata->he_6ghz_capa),
+		    &iftdata->he_6ghz_capa))
+		return -ENOBUFS;
+
 	return 0;
 }
 
@@ -1450,7 +1457,7 @@ static int nl80211_send_band_rateinfo(struct sk_buff *msg,
 			if (!iftdata)
 				return -ENOBUFS;
 
-			err = nl80211_send_iftype_data(msg,
+			err = nl80211_send_iftype_data(msg, sband,
 						       &sband->iftype_data[i]);
 			if (err)
 				return err;
-- 
2.17.1

