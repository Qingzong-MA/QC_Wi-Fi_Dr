GROUP  gQca_STAT_AsdStats "ASDStats"
{
    FIELD fQca_STAT_AsdStats_pClk              (Fixed 4 Bytes) (Hex)               "pClk"
    FIELD fQca_STAT_AsdStats_connInASD      (Fixed 4 Bytes) (Hex)               "connInASD"
