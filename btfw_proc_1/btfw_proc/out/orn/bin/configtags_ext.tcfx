          <ELEMENTS Name="LE2M_ANT_LELR" Default="0x2" Start="0" End="2" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for other than BCA mode.  0x0: USE_2- Use 2 p_in samples. 0x1: USE_4 - Use 4 p_in samples.  0x2: USE_8 - Use 8 p_in samples. 0x3: USE_16 - Use 16 p_in samples. 0x4: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="BTC_FULL_SCAN" Default="0x2" Start="4" End="6" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for other than BCA mode.  0x0: USE_2- Use 2 p_in samples. 0x1: USE_4 - Use 4 p_in samples.  0x2: USE_8 - Use 8 p_in samples. 0x3: USE_16 - Use 16 p_in samples. 0x4: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="LE1M_QHS_DUAL_SCAN" Default="0x2" Start="8" End="10" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for other than BCA mode.  0x0: USE_2- Use 2 p_in samples. 0x1: USE_4 - Use 4 p_in samples.  0x2: USE_8 - Use 8 p_in samples. 0x3: USE_16 - Use 16 p_in samples. 0x4: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="BCA_PARTIAL_SCAN" Default="0x2" Start="24" End="26" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for other than BCA mode.  0x0: USE_2- Use 2 p_in samples. 0x1: USE_4 - Use 4 p_in samples.  0x2: USE_8 - Use 8 p_in samples. 0x3: USE_16 - Use 16 p_in samples. 0x4: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="AGC_PSK_2M_LPF_BYPASS" Default="0x0" Start="28" End="28" Description="Bypass PSK 2 MHz mode LPF." />
        </ELEMENTS>
        <ELEMENTS Name="newRssiWeight" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x3" Signed="false" Description="Weight given to new RSSI in calculation of moving average is 1 / pow(2,newRssiWeight)" />
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved3" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
      </ELEMENTS>
