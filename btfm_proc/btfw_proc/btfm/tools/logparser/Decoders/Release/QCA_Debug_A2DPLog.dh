    {0x0945 "LOG_ID_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID" "LOG_ID_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID"  0 gQca_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID}
    {0x0946 "LOG_ID_VOICE_TRANSPARENT_SB_NOT_ACTIVE"            "LOG_ID_VOICE_TRANSPARENT_SB_NOT_ACTIVE"  0 gQca_VOICE_TRANSPARENT_SLIMBUS_NOT_ACTIVE}
    {0x0947 "LOG_ID_VOICE_TRANSPARENT_PRIMER_RETRY"             "LOG_ID_VOICE_TRANSPARENT_PRIMER_RETRY"  0 gQca_VOICE_TRANSPARENT_PRIMER_RETRY}
