GROUP gEvt_Cmd_Cmpl
{
     GROUP event_0e;

     GROUP gVS_Evt_CC IF(FieldIs EqualTo 0x3f ogf) "Return Parameters"
     {
         GROUP  gQC_VS_Event ;
     }
}

GROUP gEvt_Noc
{
    GROUP event_13;

    GROUP gConnection "Vendor Data"
    {
        FIELD fConnection_RSSIlvl START_BIT (Move -3 Bytes) (Fixed 4 Bits) (Decimal) "RSSI level"
        FIELD fDummy (Fixed 20 bits) (Hex) SUPPRESS_DETAIL
    }
}

GROUP gEvt_CmdStatus
{
        FIELD gCmdStatusStatus        (Fixed 1 byte) (TABLE tHCI_status) "Status"
        FIELD gCmdStatusNumHCIcmdPkts (Fixed 1 byte) (Decimal) "Num_HCI_Command_Packets"
        FIELD gCmdStatusOpcode        (Fixed 2 Bytes)(TABLE tCommandOCFs) "OpCode"
}


GROUP gQC_VS_HCIEvents
{
     FIELD hcievent_type (Fixed 1) (TABLE tHciEvents) IN_SUMMARY Event Event TAG (Tag "HCI:Event")
     BRANCH (FromTable tHciEvents hcievent_type)
     FIELD DataHCIEvents (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data "
}


GROUP gQC_VS_Event
{
     FIELD QC_VS_evt_ocf START_BIT (Move -14 Bits) (Fixed 2) RETRIEVE (AndMask 0x3ff) (Constant "OCF:") ALSO (Hex) IN_SUMMARY "Opcode Command" Command VERIFY (FieldIsBetween 0x0000 0x03FF AsHex) TAG (Tag "HCI:Command")
     FIELD cmd_tot_len ;
     FIELD Event_OCFs (fixed 0) RETRIEVE(Storefield opcode) (table tEventOCFs) IN_SUMMARY "Opcode Command" "Op Code"
     BRANCH (FromTable tEventOCFs Event_OCFs)
     FIELD DataVSEvents (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data "
}


GROUP gQC_VS_Command
{
     FIELD QC_VS_cmd_ocf START_BIT (Move -14 Bits) (Fixed 2) RETRIEVE (AndMask 0x3ff) (Constant "Vendor Cmd.") ALSO (Hex) IN_SUMMARY "Opcode Command" Command VERIFY (FieldIsBetween 0x0000 0x03FF AsHex) TAG (Tag "HCI:Command")
     FIELD cmd_tot_len ;
     FIELD Command_OCFs (fixed 0) RETRIEVE(Storefield opcode) (table tCommandOCFs) IN_SUMMARY "Opcode Command" "Op Code"
     BRANCH (FromTable tCommandOCFs Command_OCFs)
     FIELD DataVSCmd (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data "
}

GROUP gDoUndecodedOpCode "Unknown Data"
{
     FIELD DataUnk (toendoflayer) (stringofhex) "Unknown Data"
}

GROUP gNoOp
{
}


/******************************************************************************
 *                          Decoder for OCF 0x023                            *
 ******************************************************************************/
GROUP gBCAudCmd
{
     FIELD gBCAudCmd_opcode (Fixed 1 byte) (Table tBCAudSubOpcodes) "SubOpcode"
     BRANCH (FromTable tBCAudSubOpcodes gBCAudCmd_opcode)
     FIELD gBCAud_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}
GROUP gBCAudEvt
{
     FIELD gBCAud_status (Fixed 1 byte) (Decimal) "Status"
     FIELD gBCAud_opcode (Fixed 1 Bytes) (Table tBCAudSubOpcodes) "SubOpcode"
     FIELD gBCAudEvt_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}


TABLE tBCAudSubOpcodes
{0x01 "HCI_VS_TX_CONFIG" "HCI_VS_TX_CONFIG" 0 gBCAUDConfig}
{0x02 "HCI_VS_VOL" "HCI_VS_VOL" 0 gBCAud_Vol}
{0x04 "HCI_VS_RX_CONFIG" "HCI_VS_RX_CONFIG" 0 gBCAUDRxConfig}
ENDTABLE

GROUP gBCAud_Vol "CSB Volume"
{
     FIELD gBCAudVolume (Fixed 1 byte) (Decimal) "BCAud Volume"
}

GROUP gBCAUDConfig "BCAUD Tx Configuration"
{
    FIELD fBCAUD_StreamID        (Fixed 1 Bytes)   (TABLE tBCAUDStreamID)   "Stream ID"
    FIELD fBCAUD_LTAddr          (Fixed 1 Bytes)   (Decimal)                "LT Address"
    FIELD fBCAUD_AudioCodec      (Fixed 1 Bytes)   (TABLE tBCAUDCodec)      "Codec"
    FIELD fBCAUD_SampleRate      (Fixed 1 Bytes)   (TABLE tBCAUDSampleRate) "Sample Rate"
    FIELD fBCAUD_MaxPktSize      (Fixed 2 Bytes)   (Decimal)                "Max Packet Size"
    FIELD fBCAUD_EncodingScheme  (Fixed 1 Bytes)   (TABLE tBCAUDEncoding)   "Encoding Scheme"
    FIELD fBCAUD_TTPOffset       (Fixed 4 Bytes)   (Decimal)                "TTP Offset in uS"
    FIELD fBCAUD_Key             (Fixed 16 Bytes)  (stringofhex)            "private key"
    FIELD fBCAUD_IVs             (Fixed 8 Bytes)   (stringofhex)            "Init. Vectors"
    FIELD fBCAUD_Volume          (Fixed 1 Byte)    (Decimal)                "Volume"
    FIELD fBCAUD_TxPower         (Fixed 1 Byte)    (Decimal)                "Transmission power"
    FIELD fBCAUD_SampleSize      (Fixed 2 Bytes)   (Decimal)                "PCM samples per frame"
}

TABLE tBCAUDStreamID
    {0x01,  "Valid"}
    {0xff,  "Invalid"}
    {Default  "Unknown"}
ENDTABLE

TABLE tBCAUDSampleRate
    {0x00,  "44100Hz"}
    {0x01,  "48000Hz"}
    {Default  "Invalid"}
ENDTABLE

TABLE tBCAUDEncoding
    {0x00,  "2:5 EC Encoding"}
    {Default  "Invalid"}
ENDTABLE

TABLE tBCAUDCodec
    {0x00,  "CELT Codec"}
    {Default  "Invalid"}
ENDTABLE

TABLE tBCAUDRxState
    {0x00, "Disable"}
    {0x01, "Idle"}
    {0x02, "Start"}
ENDTABLE

GROUP gBCAUDRxConfig "BCAUD Rx Configuration"
{
    FIELD fBCAUD_RxLTAddr          (Fixed 1 Bytes)   (Decimal)                "LT Address"
    FIELD fBCAUD_RxState           (Fixed 1 Bytes)   (TABLE tBCAUDRxState)    "Rx State"
    FIELD fBCAUD_RxCodec           (Fixed 1 Bytes)   (TABLE tBCAUDCodec)      "Codec"
    FIELD fBCAUD_RxSampleRate      (Fixed 1 Bytes)   (TABLE tBCAUDSampleRate) "Sample Rate"
    FIELD fBCAUD_RxEncodingScheme  (Fixed 1 Bytes)   (TABLE tBCAUDEncoding)   "Encoding Scheme"
    FIELD fBCAUD_RxKey             (Fixed 16 Bytes)  (stringofhex)            "Private key"
    FIELD fBCAUD_RxIVs             (Fixed 8 Bytes)   (stringofhex)            "Init Vectors"
    FIELD fBCAUD_RxAFHScanTO       (Fixed 2 Bytes)   (stringofhex)            "AFH Scan Timeout"
    FIELD fBCAUD_RxAFHScanWindow   (Fixed 2 Bytes)   (stringofhex)            "AFH Scan Window"
    FIELD fBCAUD_RxAFHScanInterval (Fixed 2 Bytes)   (stringofhex)            "AFH Scan Interval"
}

/******************************************************************************
 *                          Decoder for OCF 0x24                             *
 ******************************************************************************/
GROUP gQca_OEM_scoLoopbackCmd  "SCO Loopback Enable"
{
     FIELD fQca_OEM_scoLoopbackMode     (Fixed 1 Bytes)     (Table tQca_OEM_scoLoopbackMode) "SCO Loopback Mode"
}

GROUP gQca_OEM_scoLoopbackEvt "Return Parameters"
{
     FIELD fQca_OEM_returnStatus                (Fixed 1 byte)  (Hex)                            "Status"
}

TABLE  tQca_OEM_scoLoopbackMode
    {0x00, "Disable"}
    {0x01, "Mode 1"}
    {0x02, "Mode 2"}
ENDTABLE

/******************************************************************************
 *                          Decoder for OCF 0x0051                            *
 ******************************************************************************/
GROUP gQbceCmd
{
     FIELD gQbceCmd_opcode (Fixed 1 byte) (Table tQbceSubOpcodes) "SubOpcode"
     BRANCH (FromTable tQbceSubOpcodes gQbceCmd_opcode)
     FIELD gQbce_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE tQbceSubOpcodes
    {0x01 "HCI_VS_QBCE_SET_QHS_HOST_MODE" 			"HCI_VS_QBCE_SET_QHS_HOST_MODE" 			0 	gQbceSetHostMode}
    {0x02 "HCI_VS_QBCE_QCM_SWITCH_PHY" 				"HCI_VS_QBCE_QCM_SWITCH_PHY" 				0 	gQbceQcmPhySwitch}
/*    {0x03 "HCI_VS_QBCE_QLE_SET_PHY" 				"HCI_VS_QBCE_QLE_SET_PHY"				0 	gQbceQleSetPhy}
    {0x04 "HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS" 			"HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS" 			0 	gQbceSetCigPara} */
    {0x05 "HCI_VS_QBCE_QLE_SET_CIG_ALT_PARAMETERS" 		"HCI_VS_QBCE_QLE_SET_CIG_ALT_PARAMETERS"		0 	gQbceSetCigAltPara}
/*    {0x06 "HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS_TEST" 		"HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS_TEST" 		0 	gQbceSetCigParaTest}    */
    {0x09 "HCI_VS_QBCE_READ_LOCAL_QLM_SUPPORTED_FEATURES" 	"HCI_VS_QBCE_READ_LOCAL_QLM_SUPPORTED_FEATURES" 	0 	gQbceReadLocalFeat}
    {0x0A "HCI_VS_QBCE_READ_REMOTE_QLM_SUPPORTED_FEATURES" 	"HCI_VS_QBCE_READ_REMOTE_QLM_SUPPORTED_FEATURES" 	0 	gQbceReadRemoteFeat}
    {0x0B "HCI_VS_QBCE_READ_LOCAL_QLL_SUPPORTED_FEATURES" 	"HCI_VS_QBCE_READ_LOCAL_QLL_SUPPORTED_FEATURES" 	0 	gQbceReadLocalFeat}
    {0x0C "HCI_VS_QBCE_READ_REMOTE_QLL_SUPPORTED_FEATURES" 	"HCI_VS_QBCE_READ_REMOTE_QLL_SUPPORTED_FEATURES" 	0 	gQbceReadRemoteFeat}
    {0x0F "HCI_VS_QBCE_SET_QLM_EVENT_MASK" 			"HCI_VS_QBCE_SET_QLM_EVENT_MASK" 			0 	gQbceSetEvtMask}
    {0x10 "HCI_VS_QBCE_SET_QLL_EVENT_MASK" 			"HCI_VS_QBCE_SET_QLL_EVENT_MASK" 			0 	gQbceSetEvtMask}
    {0x14 "HCI_VS_QBCE_QLE_SET_HOST_FEATURE" 			"HCI_VS_QBCE_QLE_SET_HOST_FEATURE" 			0 	gQbceQleSetHostFeature}
ENDTABLE

TABLE tQbceEvtSubOpcodes
    {0x01 "HCI_VS_QBCE_SET_QHS_HOST_MODE" 			"HCI_VS_QBCE_SET_QHS_HOST_MODE" 			0 	gQbceEvtSetHostMode}
    {0x04 "HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS" 			"HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS" 			0 	gQbceEvtSetCigPara}
    {0x05 "HCI_VS_QBCE_QLE_SET_CIG_ALT_PARAMETERS" 		"HCI_VS_QBCE_QLE_SET_CIG_ALT_PARAMETERS" 		0 	gQbceEvtSetCigPara}
    {0x06 "HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS_TEST" 		"HCI_VS_QBCE_QLE_SET_CIG_PARAMETERS_TEST" 		0 	gQbceEvtSetCigPara}    
    {0x09 "HCI_VS_QBCE_READ_LOCAL_QLM_SUPPORTED_FEATURES" 	"HCI_VS_QBCE_READ_LOCAL_QLM_SUPPORTED_FEATURES" 	0 	gQbceEvtReadLocalQlmFeat}
    {0x0B "HCI_VS_QBCE_READ_LOCAL_QLL_SUPPORTED_FEATURES"	"HCI_VS_QBCE_READ_LOCAL_QLL_SUPPORTED_FEATURES" 	0 	gQbceEvtReadLocalQllFeat}
    {Default "HCI_VS_QBCE" "HCI_VS_QBCE" 0 gQbceEvtDefault}
ENDTABLE

GROUP gQbceSetHostMode "Set QHS Host Mode"
{
    FIELD fQbce_transport (Fixed 1 Bytes)  (TABLE tQbce_transport) "Transport"
    FIELD fQbce_hostMode (Fixed 1 Bytes)    (TABLE tQbce_hostMode) "Host Mode"
}

TABLE tQbce_transport
    { 0x00, "Classic" }
    { 0x01, "LE" }
    { 0x02, "LE Iso" }
    { Default, "Invalid"}
ENDTABLE

TABLE tQbce_hostMode
    { 0x00, "QHS disabled" }
    { 0x01, "Substitute QHS for LE2M and Classic" }
    { 0x02, "Substitute QHS for LE1M, LE2M and Classic" }
    { 0x03, "Host aware of QHS"}
    { Default, "Invalid"}
ENDTABLE

GROUP gQbceQcmPhySwitch "QCM Phy Switch"
{
    FIELD fQbce_connHandle (Fixed 2 Bytes)  (Hex)  "Connection Handle"
    FIELD fQbce_phyMode (Fixed 1 Bytes) (TABLE tQbce_phyMode) "Phy Mode"
