ENDTABLE

/************************************************
 * 0x0400 "LOG_ID_CXM_MCI_INT_RAW"
************************************************/
GROUP gQca_CXM_MciIntRaw "MCI Int Raw"
{
    FIELD fQca_MciIntRawBit7                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "TX_HW_MSG_FAIL"
    FIELD fQca_MciIntRawBit6                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "N/A"
    FIELD fQca_MciIntRawBit5                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_SW_MSG_FAIL"
    FIELD fQca_MciIntRawBit4                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_HW_MSG_FAIL"
    FIELD fQca_MciIntRawBit3                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_INVALID_HDR"
    FIELD fQca_MciIntRawBit2                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_CRC8_FAIL"
    FIELD fQca_MciIntRawBit1                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "CPU_INT_MSG"
    FIELD fQca_MciIntRawBit0                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "SW_MSG_DONE"

    FIELD fQca_MciIntRawBit15               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_CMD_FULL_ERR"
    FIELD fQca_MciIntRawBit14               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "STRUCT_ERR"
    FIELD fQca_MciIntRawBit13               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "PARITY_ERR"
    FIELD fQca_MciIntRawBit12               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_ILLEGAL_HDR"
    FIELD fQca_MciIntRawBit11               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_TIMEOUT_RST"
    FIELD fQca_MciIntRawBit10               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "REMOTE_SLEEP_UPDATE"
    FIELD fQca_MciIntRawBit9                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_MSG"
    FIELD fQca_MciIntRawBit8                (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "TX_SW_MSG_FAIL"

    FIELD fQca_MciIntRawBit19   START_BIT   (Move 4 Bits)            (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)       "WSIS_OUT_SYNC"
    FIELD fQca_MciIntRawBit18               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "WSIS_IN_SYNC"
    FIELD fQca_MciIntRawBit17               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_AHB_ERR"
    FIELD fQca_MciIntRawBit16               (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "RX_DATA_FULL_ERR"

    FIELD fQca_MciIntRawBit24               (Fixed 8 Bits)PRINT_IF (FieldIs EqualTo 1)  (Hex) SUPRESS_DETAIL
}

TABLE tQca_CXM_EnabledBit
    {0 "DIS"}
    {1 "EN"}
ENDTABLE

/************************************************
 * 0x0410 "LOG_ID_CXM_MCI_RX"
 * 0x0420 "LOG_ID_CXM_MCI_TX"
************************************************/
TABLE tQca_CXMMciMsgType                                    //Header
    {0x00 "MCI_RESERVED"}
    {0x10 "MCI_BT_LNA_LOCK"}
    {0x20 "MCI_CONT_NACK"}
    {0x30 "MCI_CONT_INFO"}
    {0x40 "MCI_CONT_RST"}
    {0x50 "MCI_SCHED_INFO" "MCI_SCHED_INFO" 0 gQca_CXM_MciSchedInfo}
    {0x60 "MCI_CPU_INT"}
    {0x70 "MCI_SYS_WAKING"}
    {0x80 "MCI_GPM" "MCI_GPM" 0 gQca_CXM_MciGpm}
    {0x90 "MCI_LNA_INFO"}
    {0x94 "MCI_LNA_STATE"}
    {0x98 "MCI_LNA_TAKE"}
    {0x9C "MCI_LNA_TRANS"}
    {0xA0 "MCI_SYS_SLEEPING"}
    {0xC0 "MCI_REQ_WAKE"}
    {0xD0 "MCI_WCI2"}
    {0xD4 "MCI_WCI2_TYPE0"}
    {0xFE "MCI_DEBUG_16"}
    {0xFF "MCI_REMOTE_RESET"}
    {Default "Invalid"}
ENDTABLE

GROUP gQca_CXM_MciMsg "MCI"
{
    FIELD fQca_MciMsg_Header                (Fixed 1 Byte)      (TABLE tQca_CXMMciMsgType)          "MciType"   //Header
    GROUP gQca_MciMsg_more IF (MoreBytes)
    {
        FIELD fQca_MciMsg_Header_pad        (Fixed 3 Bytes)     (Hex) SUPPRESS_DETAIL                           //Header padding
        BRANCH (FromTable   tQca_CXMMciMsgType   fQca_MciMsg_Header)
        FIELD fQca_MciMsg_pad (ToEndOfLayer) IF(MoreBytes) (Hex) SUPPRESS_DETAIL                                //Padding if any
    }
}

/* 0x50 "MCI_SCHED_INFO" */
GROUP gQca_CXM_MciSchedInfo "MCI SCHED INFO"
{
    FIELD fQca_MciSchedInfoType_Start       (Fixed 4 Bytes)     (Hex)           "Start"
    FIELD fQca_MciSchedInfoType_End         (Fixed 4 Bytes)     (Hex)           "End"
    FIELD fQca_MciSchedInfoType_Rsvd        (Fixed 2 Bits)      (Hex) SUPPRESS_DETAIL
    FIELD fQca_MciSchedInfoType_LinkID      (Fixed 1 Byte)      (Binary)        "LinkID"
    FIELD fQca_MciSchedInfoType_Le          (Fixed 1 Bit)       (TABLE tQca_CXM_LeBit)  "ConnType"
    FIELD fQca_MciSchedInfoType_Priority    (Fixed 1 Byte)      (Binary)        "Priority"
    FIELD fQca_MciSchedInfoType_RSSI_TxPwr  (Fixed 1 Byte)      (Binary)        "RSSI/TxPwr"
    FIELD fQca_MciSchedInfoType_Direction   (Fixed 1 Bit)       (TABLE tQca_CXM_Direction)       "Direction"
    FIELD fQca_MciSchedInfoType_Tag         (Fixed 4 Bits)      (Binary)        "Tag"
    FIELD fQca_MciSchedInfoType_LatchCurCLK (Fixed 4 Bytes)     (Hex)           "LatchCurCLK"
}

TABLE tQca_CXM_LeBit
    {0 "BR/EDR"}
    {1 "LE"}
ENDTABLE

TABLE tQca_CXM_Direction
    {0 "Rx"}
    {1 "Tx"}
ENDTABLE

/* 0x80 "MCI_GPM" */
GROUP gQca_CXM_MciGpm "MCI GPM"
{
    FIELD fQca_MciTxGpm_T1                  (Fixed 4 Bytes)     (Hex)                               "T1"            //B0-B3
    FIELD fQca_MciTxGpm_SubType             (Fixed 1 Byte)      (TABLE tQca_CXMMciGPMType)          "GpmType"       //B4-GPM Type
    BRANCH (FromTable   tQca_CXMMciGPMType   fQca_MciTxGpm_SubType)
}

TABLE tQca_CXMMciGPMType                            //B4-GPM Type
    {0x00 "MCI_GPM_BT_CAL_REQ"}
    {0x01 "MCI_GPM_BT_CAL_GRANT"}
    {0x02 "MCI_GPM_BT_CAL_DONE"}
    {0x03 "MCI_GPM_WLAN_CAL_REQ"}
    {0x04 "MCI_GPM_WLAN_CAL_GRANT"}
    {0x05 "MCI_GPM_WLAN_CAL_DONE"}
    {0x06 "MCI_GPM_WLAN_CLK"}
    {0x08 "MCI_GPM_WLAN_SYNC" "MCI_GPM_WLAN_SYNC" 0 gQca_CXM_MciGpm_WLAN_SYNC}
    {0x0C "MCI_GPM_COEX_AGENT" "MCI_GPM_COEX_AGENT" 0 gQca_CXM_MciGpm_COEX_AGENT}
    {0x0D "MCI_GPM_ANT"}
    {0xFF "MCI_GPM_BT_DEBUG" "MCI_GPM_BT_DEBUG" 0 gQca_CXM_MciGpm_BT_DEBUG}
    {Default "Invalid"}
ENDTABLE

/* 0xFF "MCI_GPM_BT_DEBUG" */
GROUP gQca_CXM_MciGpm_BT_DEBUG "BT DEBUG"
{
    FIELD fQca_CXM_MciGpmBtDebug_ASCIIArray                     (Fixed 7 Bytes) (StringOfAscii) "ASCII"
    FIELD fQca_CXM_MciGpmBtDebug_ValueArray                     (Fixed 4 Bytes) (Hex)           "Value"
}

/* 0x08 "MCI_GPM_WLAN_SYNC" */
GROUP gQca_CXM_MciGpm_WLAN_SYNC "WLAN SYNC"
{
    FIELD fQca_CXM_MciGpmWlanSync             (Fixed 1 Byte)      (TABLE tQca_CXMMciGPMWlanSyncType)     "Opcode"
    BRANCH (FromTable   tQca_CXMMciGPMWlanSyncType   fQca_CXM_MciGpmWlanSync)
}

/* 0x0C "MCI_GPM_COEX_AGENT" */
GROUP gQca_CXM_MciGpm_COEX_AGENT "COEX AGENT"
{
    FIELD fQca_CXM_MciGpm             (Fixed 1 Byte)      (TABLE tQca_CXMMciGPMAgentType)     "Opcode"
    BRANCH (FromTable   tQca_CXMMciGPMAgentType   fQca_CXM_MciGpm)
}

TABLE tQca_CXMMciGPMWlanSyncType                       //B5-MCI_GPM_WLAN_SYNC Opcode
    {0x01 "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_TRIGGER" "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_TRIGGER" 0 gQca_CXM_MciGpmWlanSync_TMT}
    {0x02 "BT/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG" "BT/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG" 0 gQca_CXM_MciGpmWlanSync_TM}
    {0x03 "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_END" "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_END" 0 gQca_CXM_MciGpmWlanSync_TME}
    {Default "Invalid"}
ENDTABLE

/* 0x01 "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_TRIGGER" */
GROUP gQca_CXM_MciGpmWlanSync_TMT "TIMESTAMP MSG TRIGGER"
{
    FIELD fQca_MciGpmWlanSync_TMT_Reserved              (Fixed 10 Byte)  (Hex)   SUPPRESS_DETAIL
}

/* 0x02 "BT/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG" */
GROUP gQca_CXM_MciGpmWlanSync_TM "TIMESTAMP MSG"
{
    FIELD fQca_MciGpmWlanSync_TM_Duration          (Fixed 2 Byte)  (Hex)   "Duration"
    FIELD fQca_MciGpmWlanSync_TM_Timestamp         (Fixed 4 Byte)  (Hex)   "Timestamp"
/*    FIELD fQca_MciGpmWlanSync_TM_RSP_Reserved      (Fixed 4 Byte)  (Hex)   SUPPRESS_DETAIL */
}

/* 0x03 "WL/MCI_GPM_WLAN_SYNC_TIMESTAMP_MSG_END" */
GROUP gQca_CXM_MciGpmWlanSync_TME "TIMESTAMP MSG END"
{
    FIELD fQca_MciGpmWlanSync_TME_Reserved          (Fixed 10 Byte)  (Hex)   SUPPRESS_DETAIL
}

