    FIELD fQca_PConv_Restore_RxBN     (Fixed 1 Byte)   (Hex) "Rx BN"
    FIELD fQca_PConv_Restore_TxFT     (Fixed 1 Byte)   (Hex) "Tx FT"
    FIELD fQca_PConv_Restore_RxFT     (Fixed 1 Byte)   (Hex) "Rx FT"
    FIELD fQca_PConv_Restore_TxPL     (Fixed 2 Byte)   (Hex) "Tx PL"
    FIELD fQca_PConv_Restore_RxPL     (Fixed 2 Byte)   (Hex) "Rx PL"
    FIELD fQca_PConv_Restore_PTO      (Fixed 1 Byte)   (Hex) "PTO (BIG only)"
    FIELD fQca_PConv_Restore_IRC      (Fixed 1 Byte)   (Hex) "IRC (BIG only)"
    FIELD fQca_PConv_Restore_PT       (Fixed 1 Byte)   (Hex) "PT (BIG only)"
}

GROUP gQca_LLM_PConv_Done "PConv_Done"
{
    FIELD fQca_PConv_Done       (Fixed 4 Byte)   (Hex) "bOk"
    FIELD fQca_PConv_IsoInt     (Fixed 4 Byte)   (Hex) "Iso Interval (in frame)"
