    FIELD fQca_VoiceTransparentPrimerSM_AciSampleCount   (Fixed 2 Bytes)     (Decimal)    "ACI Sample Count"
    FIELD fQca_VoiceTransparentPrimerSM_AciFrameCount    (Fixed 2 Bytes)     (Decimal)    "ACI Frame Count"
    FIELD fQca_VoiceTransparentPrimerSM_deltaSampleCount (Fixed 2 Bytes)     (Decimal)    "delta Sample Count"
    FIELD fQca_VoiceTransparentPrimerSM_deltaFrameCount  (Fixed 2 Bytes)     (Decimal)    "delta Frame Count"
    FIELD fQca_VoiceTransparentPrimerSM_txOtaCount       (Fixed 2 Bytes)     (Decimal)    "TxFromAirCount"
    FIELD fQca_VoiceTransparentPrimerSM_TxSBCount        (Fixed 2 Bytes)     (Decimal)    "TxSBCount"
    FIELD fQca_VoiceTransparentPrimerSM_txOtaWrong       (Fixed 2 Bytes)     (Decimal)    "TxFromAirWrongCount"
    FIELD fQca_VoiceTransparentPrimerSM_TxSBWrong        (Fixed 2 Bytes)     (Decimal)    "TxSBWrongCount"
    FIELD fQca_VoiceTransparentPrimerSM_otaDrop          (Fixed 2 Bytes)     (Decimal)    "DropFromAirCount"
    FIELD fQca_VoiceTransparentPrimerSM_sbOF        	 (Fixed 2 Bytes)     (Decimal)    "sbOverflow"
}

GROUP gQca_VOICE_TRANSPARENT_PRIMER_RETRY "Voice Transparent Primer Retry Info"
{
    FIELD fQca_VoiceTransparentPrimerRetry_Count                (Fixed 2 Bytes)     (Decimal)    "Retry Count"
    FIELD fQca_VoiceTransparentPrimerRetry_AciSampleCount       (Fixed 2 Bytes)     (Decimal)    "ACI Sample Count"
    FIELD fQca_VoiceTransparentPrimerRetry_AciFrameCount        (Fixed 2 Bytes)     (Decimal)    "ACI Frame Count"
    FIELD fQca_VoiceTransparentPrimerRetry_txOtaCount       	(Fixed 2 Bytes)     (Decimal)    "TxFromAirCount"
    FIELD fQca_VoiceTransparentPrimerRetry_TxSBCount        	(Fixed 2 Bytes)     (Decimal)    "TxSBCount"
    FIELD fQca_VoiceTransparentPrimerRetry_txOtaWrong        	(Fixed 2 Bytes)     (Decimal)    "TxFromAirWrongCount"
    FIELD fQca_VoiceTransparentPrimerRetry_TxSBWrong       		(Fixed 2 Bytes)     (Decimal)    "TxSBWrongCount"
    FIELD fQca_VoiceTransparentPrimerRetry_otaDrop        		(Fixed 2 Bytes)     (Decimal)    "DropFromAirCount"
    FIELD fQca_VoiceTransparentPrimerRetry_sbOF      		  	(Fixed 2 Bytes)     (Decimal)    "sbOverflowCount"
}

GROUP gQca_VOICE_TRANSPARENT_PRIMER_HISTORY "Voice Transparent Primer History"
{
    FIELD fQca_VoiceTransparentPrimerHist0                      (Fixed 4 Bytes)     RETRIEVE (SignExtension 32) (Decimal)    "Timing Offset 0"
    FIELD fQca_VoiceTransparentPrimerHist1                      (Fixed 4 Bytes)     RETRIEVE (SignExtension 32) (Decimal)    "Timing Offset 1"
    FIELD fQca_VoiceTransparentPrimerHist2                      (Fixed 4 Bytes)     RETRIEVE (SignExtension 32) (Decimal)    "Timing Offset 2"
    FIELD fQca_VoiceTransparentPrimerHist3                      (Fixed 4 Bytes)     RETRIEVE (SignExtension 32) (Decimal)    "Timing Offset 3"
    FIELD fQca_VoiceTransparentPrimerHist4                      (Fixed 4 Bytes)     RETRIEVE (SignExtension 32) (Decimal)    "Timing Offset 4"
    FIELD fQca_VoiceTransparentPrimerHistLogIdx                 (Fixed 1 Byte)     (Decimal)    "Last Log Index Updated"
    FIELD fQca_VoiceTransparentPrimerHist_rsvd                  (Fixed 3 Bytes)     (Decimal)    SUPPRESS_DETAIL
}

TABLE tFromAirPathType
    {0, "PRIMARY"}
    {1, "SECONDARY"}
ENDTABLE

GROUP gQca_VOICE_TRANSPARENT_FROM_AIR_PATH_SWITCH "Voice Transparent From Air Path Switch"
{
    FIELD fQca_VoiceTransparentFromAirPathNew                   (Fixed 1 Byte)      (TABLE tFromAirPathType)    "New Path"
}

TABLE tLQ_levels
{0x00 "GOOD"}
{0x01 "MEDIUM"}
{0x02 "BAD"}
{0x03 "VERYBAD"}
{Default "Invalid"}
ENDTABLE

GROUP gQca_A2DP_SALF_LQ
{
    FIELD fQca_A2DP_SALF_LQ	(Fixed 1 Bytes)		(TABLE tLQ_levels)	"Link Quality"
}

TABLE tLQ_levelsQC
    {0x01 "LOW"}
    {0x02 "MEDIUM"}
    {0x03 "STD"}
    {0x04 "HIGH"}
    {0x05 "UH"}
    {Default "Invalid"}
ENDTABLE

TABLE t_BufferState
   {0x00 "EMPTY"}
   {0x01 "FULL"}
ENDTABLE

GROUP gSalfDebug_stats
{
     FIELD fQca_gSalfDebug_stats_flow            (Fixed 4 Bytes)    (Decimal)                "Flow On Off Gap"
     FIELD fQca_gSalfDebug_stats_MA              (Fixed 2 Bytes)    (Decimal)                "Moving Average"
     FIELD fQca_gSalfDebug_stats_numFlowOn       (Fixed 2 Bytes)    (Decimal)                "Number of Flow On"
     FIELD fQca_gSalfDebug_stats_initLQ          (Fixed 1 Bytes)    (TABLE tLQ_levelsQC)     "Initial Link Quality"
     FIELD fQca_gSalfDebug_stats_LQ              (Fixed 1 Bytes)    (TABLE tLQ_levelsQC)     "Final Link Quality"
     FIELD fQca_gSalfDebug_stats_BufferStatus    (Fixed 1 Bytes)    (TABLE t_BufferState)    "Buffer status"
     FIELD fQca_gSalfDebug_stats_curr_LQ_QC      (Fixed 1 Byte)     (TABLE tLQ_levelsQC)     "Current Link Quality"
     FIELD fQca_gSalfDebug_stats_rsvd_bits       (Fixed 6 Bits)     (Decimal)                SUPPRESS_DETAIL
     FIELD fQca_gSalfDebug_stats_force_LQ        (Fixed 1 Bits)     (Decimal)                "Force LQ"
     FIELD fQca_gSalfDebug_stats_3M_Allowed      (Fixed 1 Bits)		(Decimal)                "3M Pkt Type Allowed"
     RESERVED                                    (Fixed 3 Bytes)
}
