From 1caa3a52cdac63645407b2426e80445df4dd4f97 Mon Sep 17 00:00:00 2001
From: bings <bings@codeaurora.org>
Date: Fri, 3 Apr 2020 23:29:32 +0800
Subject: [PATCH] [cfg80211]: fixing dfs master issue

removing wrong dfs checks and adding correct
---
 net/wireless/chan.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/net/wireless/chan.c b/net/wireless/chan.c
index 8d85179..35444a0 100644
--- a/net/wireless/chan.c
+++ b/net/wireless/chan.c
@@ -422,8 +422,7 @@ static int cfg80211_get_chans_dfs_required(struct wiphy *wiphy,
 		if (!c)
 			return -EINVAL;
 
-		if ((c->flags & IEEE80211_CHAN_RADAR) &&
-		    !(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD))
+		if (c->flags & IEEE80211_CHAN_RADAR)
 			return 1;
 	}
 	return 0;
@@ -703,8 +702,7 @@ static bool cfg80211_get_chans_dfs_available(struct wiphy *wiphy,
 		if (c->flags & IEEE80211_CHAN_DISABLED)
 			return false;
 
-		if (!(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD) &&
-		    (c->flags & IEEE80211_CHAN_RADAR)  &&
+		if ((c->flags & IEEE80211_CHAN_RADAR)  &&
 		    (c->dfs_state != NL80211_DFS_AVAILABLE) &&
 		    !(c->dfs_state == NL80211_DFS_USABLE && dfs_offload))
 			return false;
-- 
