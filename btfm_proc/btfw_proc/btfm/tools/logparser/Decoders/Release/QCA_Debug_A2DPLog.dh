TABLE tEdpErrCode
    {0x00 "EDP_STATUS_GOOD"}
    {0x01 "EDP_STATUS_CRC_FAIL_ONE"}
    {0x02 "EDP_STATUS_CRC_FAIL_MULT"}
    {0x03 "EDP_STATUS_LOST "}
ENDTABLE


TABLE tDecodeLenErrCode
    {0x00    "VS_DECODE_SYNC_ERR"}
    {0x78    "VS_DECODE_SUCC"}
    {0x79    "VS_DECODE_PKTLOST_ERR"}
    {0xFFFC  "VS_DECODE_CRC_ERR"}
    {Default "VS_UNKNOWN_ERR"}
ENDTABLE

GROUP gQca_VOICE_VSDecodeError "VS Decode Error"
{
    FIELD fQca_VS_pClk                         (Fixed 4 Bytes)     (Hex)                          	   "pClk"
    FIELD fQca_VS_DecodedLen                   (Fixed 2 Bytes)     (TABLE tDecodeLenErrCode)          "status"
    FIELD fQca_VS_decodeMask                   (Fixed 2 Bytes)     (Hex)  				               "mask"
    FIELD fQca_VS_outData                      (Fixed 240 Bytes)   (HEX)          					   "outData"

	GROUP gQca_VOICE_decFrameInfo "savedFrame"
	{
		FIELD fQca_VS_wbCnt                        (Fixed 2 Bytes)     (Decimal)                          "WeakbitCount"
		FIELD fQca_VS_inData                       (Fixed 28 Bytes)    (HEX)          					  "inData"
		FIELD fQca_VS_quality                      (Fixed 28 Bytes)    (HEX)          					  "quality"
		FIELD fQca_VS_decodeEdpStatus              (Fixed 1 Bytes)     (TABLE tEdpErrCode)                "decodeEdpStatus"
		RESERVED                         		   (Fixed 1 Bytes)
	}

	GROUP gQca_VOICE_anotherFrameInfo "F0"
	{
		FIELD fQca_VS_wbCnt1                       (Fixed 2 Bytes)     (Decimal)                          "f0WeakbitCount"
		FIELD fQca_VS_inData1                      (Fixed 28 Bytes)    (HEX)          					   "f0inData"
		FIELD fQca_VS_quality1                     (Fixed 28 Bytes)    (HEX)          					   "f0quality"
		FIELD fQca_VS_decodeEdpStatus1             (Fixed 1 Bytes)     (TABLE tEdpErrCode)                "f0decodeEdpStatus"
		RESERVED                                   (Fixed 1 Bytes)
	}
}

GROUP gQca_VOICE_VSErr "VS Error"
{
	FIELD fQca_VS_note 						(Fixed 16 Bytes)	(Hex)							"note"
    FIELD fQca_VS_1    						(Fixed 4 Bytes)     (Hex)                           "p1"
    FIELD fQca_VS_2    						(Fixed 4 Bytes)     (Hex)                           "p2"
    FIELD fQca_VS_3    						(Fixed 4 Bytes)     (Hex)                           "p3"
    FIELD fQca_VS_4    						(Fixed 4 Bytes)     (Hex)                           "p4"
}

TABLE tTransportRole
    {0, "Source"}
    {1, "Sink"}
ENDTABLE

TABLE tTransportState
    {0, "TRANSPORT_STOPPED"}
    {1, "TRANSPORT_IDLE"}
    {2, "TRANSPORT_ALIVE"}
    {3, "TRANSPORT_ACTIVE"}
ENDTABLE


GROUP gQca_VOICE_IsoTransportState "Voice Transport State"
{
    FIELD fQca_VOICE_IsoTransportState_role    (Fixed 1 Byte)      (TABLE tTransportRole)         "Transport Role" 
    FIELD fQca_VOICE_IsoTransportState_state   (Fixed 1 Byte)      (TABLE tTransportState)        "Transport State"
    FIELD fQca_VOICE_IsoTransportState_primerRetryCtr         (Fixed 2 Byte) IF(MoreBytes) (Decimal) "primerRetryCtr"
    FIELD fQca_VOICE_IsoTransportState_txSBCtr                (Fixed 2 Byte) IF(MoreBytes) (Decimal) "txSBCtr"
    FIELD fQca_VOICE_IsoTransportState_rxSampleCount          (Fixed 2 Byte) IF(MoreBytes) (Decimal) "rxSampleCount"
    FIELD fQca_VOICE_IsoTransportState_rxFrameCount           (Fixed 2 Byte) IF(MoreBytes) (Decimal) "rxFrameCount"
    FIELD fQca_VOICE_IsoTransportState_rxCopSyncWordCount     (Fixed 2 Byte) IF(MoreBytes) (Decimal) "rxCopSyncWordCount"
    GROUP fQca_VOICE_IsoTransportState_rxErrStatus   IF(MoreBytes)  "IOPErrStatus(SWB/ISO)"
    {
        RESERVED (Fixed 3 bits)
        FIELD fQca_VOICE_IsoTransportState_rxErrStatus_BIT4_EndMarkerInvalid    (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "EndMarkerInvalid"
        FIELD fQca_VOICE_IsoTransportState_rxErrStatus_BIT3_ZeroLenFrame        (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "ZeroLenFrame"
        FIELD fQca_VOICE_IsoTransportState_rxErrStatus_BIT2_UnsupportedNframes  (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedNframes"
        FIELD fQca_VOICE_IsoTransportState_rxErrStatus_BIT1_UnsupportedVer      (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedVer"
        FIELD fQca_VOICE_IsoTransportState_rxErrStatus_BIT0_Busy                (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "Busy"
        RESERVED (Fixed 1 Bytes)
    }
    FIELD fQca_VOICE_IsoTransportState_toAirIOPDropCnt        (Fixed 1 Byte) IF(MoreBytes) (Decimal) "toAirIOPDropCnt"
    FIELD fQca_VOICE_IsoTransportState_activeStreamNdx        (Fixed 1 Byte) IF(MoreBytes) (Decimal) "activeStreamNdx"
    FIELD fQca_VOICE_IsoTransportState_txSampleCount          (Fixed 2 Byte) IF(MoreBytes) (Decimal) "txSampleCount"
    FIELD fQca_VOICE_IsoTransportState_more                   (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

GROUP gQca_VOICE_IsoPrimer "Voice ISO Primer info"
{
    FIELD gQca_VOICE_IsoPrimer_FrameTiming     (Fixed 4 Byte)      (Hex)                           "Frame Timing: CE Time"
    FIELD gQca_VOICE_IsoPrimer_FrameInterval   (Fixed 2 Byte)      (Decimal)                       "Frame Interval in usec"
    FIELD gQca_VOICE_IsoPrimer_FrameSize       (Fixed 2 Byte)      (Decimal)                       "Frame Size"
}

GROUP gQca_A2DP_PktTimerExpired "Stereo ACI IOP Data"
{
    FIELD fQca_IOP_btClkCapture                (Fixed 4 Bytes)     (Hex)                           "btClkCapture"
    FIELD fQca_IOP_configClkDivisor            (Fixed 2 Bytes)     (Hex)                           "configClkDivisor"
    FIELD fQca_IOP_status                      (Fixed 2 Bytes)     (Hex)                           "status"
    FIELD fQca_IOP_pDataBlock                  (Fixed 2 Bytes)     (Hex)                           "pDataBlock"
    FIELD fQca_IOP_pStart                      (Fixed 2 Bytes)     (Hex)                           "pStart"
    FIELD fQca_IOP_pEnd                        (Fixed 2 Bytes)     (Hex)                           "pEnd"
    FIELD fQca_IOP_pHead                       (Fixed 2 Bytes)     (Hex)                           "pHead"
    FIELD fQca_IOP_pTail                       (Fixed 2 Bytes)     (Hex)                           "pTail"
    FIELD fQca_IOP_dropCount                   (Fixed 2 Bytes)     (Hex)                           "drop Count"
    FIELD fQca_IOP_sampleHolder                (Fixed 2 Bytes)     (Hex)                           "sampleHolder"
    FIELD fQca_IOP_numSubframeCount            (Fixed 2 Bytes)     (Hex)                           "numSubframeCount"
    FIELD fQca_IOP_currHeader                  (Fixed 2 Bytes)     (Hex)                           "currHeader"
    FIELD fQca_IOP_currSubframeLength          (Fixed 2 Bytes)     (Hex)                           "currSubframeLength"
    FIELD fQca_IOP_ringBufferHeadSave          (Fixed 2 Bytes)     (Hex)                           "ringBufferHeadSave"
    FIELD fQca_IOP_scratchpad_1                (Fixed 2 Bytes)     (Hex)                           "scratchpad_1"
    FIELD fQca_IOP_scratchpad_2                (Fixed 2 Bytes)     (Hex)                           "scratchpad_2"
    FIELD fQca_IOP_scratchpad_3                (Fixed 2 Bytes)     (Hex)                           "scratchpad_3"
    FIELD fQca_IOP_scratchpad_4                (Fixed 2 Bytes)     (Hex)                           "scratchpad_4"
    FIELD fQca_IOP_sampleCount                 (Fixed 2 Bytes)     (Hex)                           "sampleCount"
    FIELD fQca_IOP_totalFrameLength_Bytes      (Fixed 2 Bytes)     (Hex)                           "totalFrameLength_Bytes"
    FIELD fQca_IOP_numSubframes                (Fixed 2 Bytes)     (Hex)                           "numSubframes"
    FIELD fQca_IOP_encodedFrameLength          (Fixed 2 Bytes)     (Hex)                           "encodedFrameLength"
    FIELD fQca_IOP_debugWord_1                 (Fixed 2 Bytes)     (Hex)                           "debugWord_1"
    FIELD fQca_IOP_debugWord_2                 (Fixed 2 Bytes)     (Hex)                           "debugWord_2"
    FIELD fQca_IOP_numRxSyncWords              (Fixed 2 Bytes)     (Hex)                           "numRxSyncWords"
    FIELD fQca_IOP_numRxFrames                 (Fixed 2 Bytes)     (Hex)                           "numRxFrames"
    FIELD fQca_IOP_configControlReg            (Fixed 1 Bytes)     (Hex)                           "configControlReg"
    FIELD fQca_IOP_configFrameDivisor          (Fixed 1 Bytes)     (Hex)                           "configFrameDivisor"
    FIELD fQca_IOP_configSlotWidth             (Fixed 1 Bytes)     (Hex)                           "configSlotWidth"
    FIELD fQca_IOP_configDataWidth             (Fixed 1 Bytes)     (Hex)                           "configDataWidth"
    FIELD fQca_IOP_configFlag                  (Fixed 1 Bytes)     (Hex)                           "configFlag"
    FIELD fQca_IOP_flag                        (Fixed 1 Bytes)     (Hex)                           "flag"
    FIELD fQca_IOP_currState                   (Fixed 1 Bytes)     (Hex)                           "currState"
}

GROUP gQca_A2DP_SampleBufOverflow "Overflow Count"
{
    FIELD fQca_A2DP_OverflowCount              (Fixed 2 Bytes)     (Decimal)                       "Overflow Count"
}


TABLE tWifiActivity
{0x00 "no wifi 2.4G"}
{0x01 "wifi on 2.4G"}
ENDTABLE

TABLE tGenericEncodeSubId
{0x01 "scan status" "scan status" 0 gQca_SB_Generic_SubSB_scanStatus}
{0x02 "QHS support" "QHS support" 0 gQca_SB_Generic_SubSB_QHSSupport}
{0x03 "ULL support" "ULL support" 0 gQca_SB_Generic_SubSB_ULLSupport}
{0x04 "sink battery level" "sink battery level" 0 gQca_SB_Generic_SubSB_BatteryLevel}
{0x05 "CQDDR support" "CQDDR support" 0 gQca_SB_Generic_SubSB_CQDDR}
ENDTABLE

GROUP gQca_SB_Generic_SubSB_scanStatus
{
    FIELD fQca_SB_Generic_SubSB_scanStatus_1   (Fixed 1 Byte)   (Hex)  "pageScan"
    FIELD fQca_SB_Generic_SubSB_scanStatus_2   (Fixed 1 Byte)   (Hex)  "LEScan"
}

GROUP gQca_SB_Generic_SubSB_QHSSupport
{
    FIELD fQca_SB_Generic_SubSB_QHSSupport_1   (Fixed 1 Byte)   (Hex)  "QHS support"
}

GROUP gQca_SB_Generic_SubSB_ULLSupport
{
    FIELD fQca_SB_Generic_SubSB_ULLSupport_1   (Fixed 1 Byte)   (Hex)  "ULL support"
}

GROUP gQca_SB_Generic_SubSB_BatteryLevel
{
    FIELD fQca_SB_Generic_SubSB_BatteryLevel_1   (Fixed 1 Byte)   (Decimal)  "battery level"
}

TABLE tPrefRate
{0 "2M"}
{1 "3M"}
{DEFAULT "BLE"}
ENDTABLE

GROUP gQca_SB_Generic_SubSB_CQDDR
{
    FIELD fQca_SB_Generic_SubSB_CQDDR_1   (Fixed 1 Byte)   (TABLE tPrefRate)  "preferRate"
    FIELD fQca_SB_Generic_SubSB_CQDDR_2   (Fixed 1 Byte)   (Decimal)  "preferSlots"
}

GROUP gQca_Audio_SB_encodeMode
{
    FIELD fQca_COP_encodeMode   (FromField Bytes sbLen)    (Hex)  "data"
}

GROUP gQca_Audio_SB_Rssi
{
    FIELD fQca_COP_Rssi      (Fixed 1 Byte)    RETRIEVE (SignExtension 8) (Decimal)  "RSSI"
}

GROUP gQca_Audio_SB_otherLinksNum
{
    FIELD fQca_COP_SB_otherLinksNum_num   (Fixed 1 Byte)    (Decimal)  "number of other links"
}

GROUP gQca_Audio_SB_wifiActivity
{
    FIELD fQca_COP_SB_wifiActivity   (Fixed 1 Byte)    (TABLE tWifiActivity)  "wifiActivity"
}

GROUP gQca_Audio_SB_genericEncode
{
    FIELD fQca_COP_SB_genericEncode_SubId   (Fixed 1 Byte)    (TABLE tGenericEncodeSubId)  "subSBid"
    FIELD fQca_COP_SB_genericEncode_dataLen (Fixed 0) RETRIEVE (SubtractFieldMinusInteger sbLen 1) (Decimal) SUPPRESS_DETAIL
    BRANCH (FromTable tGenericEncodeSubId fQca_COP_SB_genericEncode_SubId)
}

GROUP gQca_Audio_COPv1_SB_Quality
{
    FIELD fQca_COPv1_SB_Quality_MaskLen   (Fixed 0) RETRIEVE (SubtractFieldMinusInteger sbLen 3) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_COPv1_SB_Quality_Weakbits  (Fixed 2 Bytes) RETRIEVE (AndMask 0x3FFF) ALSO (ShiftRight 0) (Decimal) "Num of Weak bits" NO_MOVE
    FIELD fQca_COPv1_SB_Quality_Status    (Fixed 2 Bytes) RETRIEVE (AndMask 0xC000) ALSO (ShiftRight 14) (Table EDP_STATUS) "Status"
    FIELD fQca_COPv1_SB_Quality_Mask      (FromField Bytes fQca_COPv1_SB_Quality_MaskLen) (HEX)  "Quality Mask"
}

GROUP gQca_Audio_COPv2_SB_Quality
{
    FIELD fQca_COPv2_SB_Quality_MaskLen   (Fixed 0) RETRIEVE (SubtractFieldMinusInteger sbLen 3) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_COPv2_SB_Quality_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_COPv2_SB_Quality_Weakbits  (Fixed 2 Bytes) RETRIEVE (AndMask 0x3FFF) ALSO (ShiftRight 0) (Decimal) "Num of Weak bits" NO_MOVE
    FIELD fQca_COPv2_SB_Quality_Status    (Fixed 2 Bytes) RETRIEVE (AndMask 0xC000) ALSO (ShiftRight 14) (Table EDP_STATUS) "Status"
    FIELD fQca_COPv2_SB_Quality_Mask      (FromField Bytes fQca_COPv2_SB_Quality_MaskLen) (HEX)  "Quality Mask"
}

GROUP gQca_Audio_SB_QualityFB
{
    FIELD fQca_COP_SB_QualityFB_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_COP_SB_QualityFB_quality   (Fixed 1 Byte)    (Decimal)  "quality"
    FIELD fQca_COP_SB_QualityFB_rssi      (Fixed 1 Byte)    RETRIEVE (SignExtension 8) (Decimal)  "RSSI"
}

GROUP gQca_LE_Audio_EncoderReady
{
    FIELD fQca_COP_SB_EncReady_CodecId          (Fixed 1 Byte)      (Hex)      "CodecId"
    FIELD fQca_COP_SB_EncReady_Ver              (Fixed 2 Byte)      (Decimal)  "Version"
    FIELD fQca_COP_SB_EncReady_Metadata         (Fixed 5 Bytes)     (Hex)      "Metadata"
}

GROUP gQca_Audio_SB_Primer
{
    FIELD fQca_Audio_SB_Primer_1     (Fixed 4 Bytes)    RETRIEVE (SignExtension 32)(Decimal)  "timeOffset"
    FIELD fQca_Audio_SB_Primer_2     (Fixed 2 Bytes)    (Decimal)  "interval"
    FIELD fQca_Audio_SB_Primer_3     (Fixed 1 Bytes)    (Decimal)  "size"
}

GROUP gQca_Audio_SB_Primer_v2
{
    FIELD fQca_Audio_SB_Primer_v2_1     (Fixed 4 Bytes)    RETRIEVE (SignExtension 32)(Decimal)  "timeOffset"
    FIELD fQca_Audio_SB_Primer_v2_2     (Fixed 2 Bytes)    (Decimal)  "interval"
    FIELD fQca_Audio_SB_Primer_v2_3     (Fixed 2 Bytes)    (Decimal)  "size"
}

GROUP gQca_Audio_SB_drift
{
    FIELD fQca_Audio_SB_drift     (Fixed 1 Bytes)    RETRIEVE (SignExtension 8)(Decimal)  "drift"
}
GROUP gQca_Audio_SB_sequence
{
    FIELD fQca_Audio_SB_sequence_1     (Fixed 2 Bytes)    (Decimal)  "Sequence"
}

GROUP gQca_Audio_SB_sampleCnt
{
    FIELD fQca_Audio_SB_sampleCnt_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_Audio_SB_sampleCnt_cnt       (Fixed 2 Bytes)    (Decimal)  "sampleCnt"
}

GROUP gQca_COP_SB "SideBand"
{
    FIELD fQca_COP_SB_Id        (Fixed 1 Byte)     (TABLE tSbIds)   "SideBand ID"
    GROUP gQca_COP_SBLen_len1 IF(FieldIs EqualTo 0x1 copVer)
    {
        FIELD fQca_COP_SB_Len1       (Fixed 1 Byte)     (Decimal)        "SideBand Length" STORE sbLen
    }
    GROUP gQca_COP_SBLen_len2 IF(FieldIs EqualTo 0x2 copVer)
    {
        FIELD fQca_COP_SB_Len2       (Fixed 2 Byte)     (Decimal)        "SideBand Length" STORE sbLen
    }
    BRANCH (FromTable tSbIds fQca_COP_SB_Id)

    /*FIELD fQca_COP_SB_Pld       (ToEndOfLayer) (HEX)  "SideBand Data" */
}

GROUP gQca_COPv2_SDU "SDU"
{
    FIELD fQca_COPv2_SDU_StrId  (Fixed 1 Bytes) (Decimal) "Stream ID"
    FIELD fQca_COPv2_SDU_Len    (Fixed 2 Bytes) (Decimal) "SDU Length"
    FIELD fQca_COPv2_SDU_Pld    (FromField Bytes fQca_COPv2_SDU_Len) (HEX) "SDU Data"
}

GROUP gQca_COP_Pkt "COP Pkt"
{
    FIELD fQca_Audio_COP_Header1_1  (Fixed 5 Bits)    (Hex)    SUPPRESS_DETAIL //"fmt_id_l4"
    FIELD fQca_Audio_COP_Header_SB  (Fixed 1 Bit)     (Hex)    "sidebandPresense"
    FIELD fQca_Audio_COP_Header_version  (Fixed 2 Bits)    (Hex)    "version"
    GROUP gQca_Audio_COPv1_quality IF(FieldIs EqualTo 0x1 fQca_Audio_COP_Header_version)
    {
        FIELD fQca_Audio_COPv1_Header2_1  (Fixed 7 Bits)    (Hex)    "Quality"
    }
    GROUP gQca_Audio_COPv2_Header2_1 IF(FieldIs EqualTo 02 fQca_Audio_COP_Header_version)
    {
        FIELD fQca_Audio_COPv2_Header2_1  (Fixed 7 Bits)    (Hex)    SUPPRESS_DETAIL
    }
    FIELD fQca_Audio_COP_Header2_2  (Fixed 1 Bits)    (Hex)    SUPPRESS_DETAIL  //"fmt_id_h5"
    FIELD fQca_Audio_COPv2_Length     (Fixed 2 Bytes) (Decimal) "Length" NO_MOVE
    FIELD fQca_Audio_COPv2_Length_odd      (Fixed 2 Bytes) RETRIEVE (AndMask 0x1) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL
    
    GROUP fQca_Audio_COPv2_SB IF(FieldIs EqualTo 0x1 fQca_Audio_COP_Header_SB)
    {
        FIELD fQca_Audio_COPv2_SB_Num     (Fixed 1 Bytes) (Decimal) "SideBand Num"

        GROUP gQca_COP_SB_Loop REPEAT COUNT (FromField Times fQca_Audio_COPv2_SB_Num 0)
        {
            GROUP gQca_COP_SB;
        }
    }

    GROUP gQca_Audio_COPv2_odd IF(FieldIs EqualTo 0x1 fQca_Audio_COPv2_Length_odd)
    {
        GROUP gQca_Audio_COPv2_SDU_LoopOdd    REPEAT SIZE (ToEndOfLayer 3)
        {
            GROUP gQca_COPv2_SDU;
        }
    }

    GROUP gQca_Audio_COPv2_even IF(FieldIs EqualTo 0x0 fQca_Audio_COPv2_Length_odd)
    {
        GROUP gQca_Audio_COPv2_SDU_LoopEven    REPEAT SIZE (ToEndOfLayer 2)
        {
            GROUP gQca_COPv2_SDU;
        }
    }
}

GROUP gQca_AUDIO_BUFFER_DATA "Audio Data"
{
    FIELD fQca_Audio_Pkt_Sqn_No                 (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Audio_Pkt_Len_                   (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"
    FIELD fQca_Audio_IOP_Data                   (FromField Bytes fQca_Audio_Pkt_Len_)   (HEX)                               "Audio Data"
}

GROUP gQca_AUDIO_BUFFER_DATA_COP_TO_ADSP "Audio Data (COP)"
{
    FIELD fQca_Cop_Audio_Pkt_Sqn_No_TA      (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Cop_Audio_Pkt_Len_TA         (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"

    GROUP fQca_Audio_COPv2_TO_ADSP
    {
        GROUP gQca_COPFeedbackInfo;
    }

    FIELD fQca_Cop_Audio_Pkt_Dummy_TA       (toendoflayer) (Hex)  SUPPRESS_DETAIL
}

GROUP gQca_Audio_COPv0_Header
{
    FIELD fQca_Audio_COPv0_Header_ver  (Fixed 2 Bits)     (Hex)    "version"
    FIELD fQca_Audio_COPv0_Header_err  (Fixed 1 Bit)      PRINT_IF (FieldIs NotEqualTo 0x0) (Hex)    "error" 
    FIELD fQca_Audio_COPv0_Header_fmt  (Fixed 6 Bits)     (Hex)    "fmtId" 
    FIELD fQca_Audio_COPv0_Header1_1   (Fixed 7 Bits)     (Hex)    SUPPRESS_DETAIL
}

GROUP gQca_AUDIO_BUFFER_DATA_COP_FROM_ADSP "Audio Data (COP)"
{
    FIELD fQca_Cop_Audio_Pkt_Sqn_No_FA     (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Cop_Audio_Pkt_Len_FA        (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"

    /* 6B Timestamp */
    FIELD fQca_Audio_TStamp_FA             (Fixed 6 Bytes) RETRIEVE (AndMask 0xFFFFFFFFFFFF) ALSO (ShiftRight 4) (Decimal) "Timestamp (us)"
    FIELD fQca_Audio_COP_Header_Ver_FA     (Fixed 2 Bytes) RETRIEVE (AndMask 0x3) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL NO_MOVE STORE copVer
    
    GROUP Qca_Audio_BigFrame_FROM_ADSP IF(FieldIs GreaterThan 0x400 fQca_Cop_Audio_Pkt_Len_FA)
    {
        FIELD fQca_Cop_Audio_LogBuf_size       (Fixed 0)    RETRIEVE (SubtractFieldMinusInteger fQca_Cop_Audio_Pkt_Len_FA 1024)   (Decimal)  "Frame_length exceeded logging buffer by :"    
    }    

    GROUP Qca_Audio_COPv0_FROM_ADSP IF(FieldIs EqualTo 0x0 fQca_Audio_COP_Header_Ver_FA)
    {
        GROUP gQca_Audio_COPv0_Header;
        FIELD fQca_Audio_COPv0_fLen          (Fixed 2 Bytes)     (Decimal)    "flen" NO_MOVE
        FIELD fQca_Audio_COPv0_fLen_odd      (Fixed 2 Bytes) RETRIEVE (AndMask 0x1) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_Cop_Audio_IOP_Data_FA     (FromField Bytes fQca_Audio_COPv0_fLen)   (HEX)      "Audio Data"
        GROUP gQca_Audio_COPv0_zeroPad  IF(FieldIs EqualTo 0x1 fQca_Audio_COPv0_fLen_odd)
        {
            FIELD fQca_Audio_COPv0_zeroPad (Fixed 1 Byte) (Hex)  SUPPRESS_DETAIL
        }
        FIELD fQca_Audio_COPv0_zeroStuffLen (Fixed 2 Bytes) (Decimal) "zeroStuffLen"
    }

    /* COP Ver 1 or 2 */
    GROUP fQca_Audio_COPv2_FROM_ADSP IF(FieldIs NotEqualTo 0x0 fQca_Audio_COP_Header_Ver_FA)
    {
        GROUP gQca_COP_Pkt;
    }

    FIELD fQca_Cop_Audio_Pkt_Dummy_FA      (toendoflayer) (Hex)  SUPPRESS_DETAIL
}

GROUP gQca_ISO_RX_SDU_DUMP "ISO RX SDU Dump"
{
    FIELD fQca_Iso_Rx_Sdu_Dump_Sdu_Seq_No   (Fixed 4 Bytes)                         (Decimal)                           "SDU Sequence No"
    FIELD fQca_Iso_Rx_Sdu_Dump_Event_Count  (Fixed 2 Bytes)                         (Decimal)                           "ISO event counter"
    FIELD fQca_Iso_Rx_Sdu_Dump_Sdu_Len      (Fixed 2 Bytes)                         (Decimal)                           "SDU Length"
    FIELD fQca_Iso_Rx_Sdu_Dump_Sdu_Data     (toendoflayer)                          (Hex)                               "SDU Data..."
}

GROUP gQca_VOICE_ISO_LATENCY "ISO Latency"
{
    FIELD fQca_VOICE_ISO_Latency_LogId         (Fixed 1 Bytes) (TABLE LogIDTable) SUPPRESS_DETAIL

    GROUP fQca_Voice_ISO_Latency_TimeArrival IF(FieldIs EqualTo 0x00 fQca_VOICE_ISO_Latency_LogId) "ToAir SDU Arrival Time"
    {
        RESERVED                               (Fixed 1 Bytes)

        FIELD fQca_ISO_T_Arrival_Length        (Fixed 2 Bytes) (Decimal) "Length"
        FIELD fQca_ISO_T_Arrival_Expected      (Fixed 4 Bytes) (Hex) "Expected Time (ToAir ISR Start)"
        FIELD fQca_ISO_T_Arrival_COP_Tstamp    (Fixed 4 Bytes) (Hex) "COP Pkt Timestamp"

        FIELD fQca_ISO_T_Arrival_Tmp1          (Fixed 0) RETRIEVE (AddFieldToInteger fQca_ISO_T_Arrival_Length 8) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_Tmp2          (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_ISO_T_Arrival_Tmp1 1000) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_Tmp3          (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_ISO_T_Arrival_Tmp2 384) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_COP_Arrival   (Fixed 0) RETRIEVE (AddFieldToField fQca_ISO_T_Arrival_COP_Tstamp fQca_ISO_T_Arrival_Tmp3) ALSO (AndMask 0xFFFFFFF)  (Hex) "COP Arrival Time"

        FIELD fQca_ISO_T_Arrival_Delta         (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_ISO_T_Arrival_Expected fQca_ISO_T_Arrival_COP_Arrival) ALSO (AndMask 0xFFFFFFFF)  (Decimal) "Delta (Expected_Time - COP_Arrival_Time)"
    }

    GROUP fQca_Voice_ISO_Latency_SetupTx IF(FieldIs EqualTo 0x01 fQca_VOICE_ISO_Latency_LogId) "ToAir PDU Setup Time"
    {
        FIELD fQca_ISO_T_SetupTx_CisHandle     (Fixed 1 Bytes) (Decimal) "CIS Handle"
        FIELD fQca_ISO_T_SetupTx_TxPduSeqn     (Fixed 1 Bytes) (Decimal) "Tx PDU Seqn"
        FIELD fQca_ISO_T_SetupTx_TxSduSeqn     (Fixed 1 Bytes) (Decimal) "Tx SDU Seqn"
        FIELD fQca_ISO_T_SetupTx_Length        (Fixed 2 Bytes) (Decimal) "PDU Length"

        FIELD fQca_ISO_T_SetupTx_Anchor        (Fixed 4 Bytes) (Hex) "Anchor Time"
        FIELD fQca_ISO_T_SetupTx_Current       (Fixed 4 Bytes) (Hex) "Current Time"

	/* COP Timestamp */
        FIELD fQca_ISO_T_SetupTx_ArrivalTime   (Fixed 4 Bytes) (Hex) "Arrival Time"
	/* ToAir ISR Timestamp */
        FIELD fQca_ISO_T_SetupTx_ProcessTime   (Fixed 4 Bytes) (Hex) "Process Time"

        FIELD fQca_ISO_T_SetupTx_Delta         (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_ISO_T_SetupTx_Anchor fQca_ISO_T_SetupTx_ArrivalTime) ALSO (AndMask 0xFFFFFFFF)  (Decimal) "Delta (Anchor - SDU_Arrival_Time)"
        FIELD fQca_ISO_T_SetupTx_Delta2        (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_ISO_T_SetupTx_ProcessTime fQca_ISO_T_SetupTx_ArrivalTime) ALSO (AndMask 0xFFFFFFFF)  (Decimal) "Delta (SDU_Process_Time - SDU_Arrival_Time)"

	FIELD fQca_ISO_T_SetupTx_MoreData      (toendoflayer) IF(MoreBytes) (stringofhex) "Some PDU data"
    }


    FIELD fQca_ISO_Latency_More                (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE LogIDTable
    {0, "ToAir SDU Arrival Time"}
    {1, "ToAir PDU Setup Time"}
ENDTABLE

TABLE tSidebandId
    {0x0A, "COP_V2 Drift"}
    {0x0D, "COP_V2 Primer Ack"}
    {0x10, "COP_V2 Primer"}
    {0x11, "COP_V2 Link Quality"}
    {0x13, "COP_V2 Generic Encoder Feedback"}
    {0x14, "COP_V2 Encoder Ready"}
    {0x15, "COP_V2 LE ISO Link Quality"}
    {0x16, "COP_V2 Codec Metadata"}
    {0x17, "COP_V2 Codec Metadata ACK"}
ENDTABLE

TABLE tGenericEncoderFeedbackSubId
    {1, "QHS Capability"}
    {2, "BT WIFI Activity"}
    {3, "CIG QHS map"}
    {4, "Set Encoder Limits"}
    {5, "HID Report"}
    {6, "ASE VS Metadata"}
    {7, "CIG QHS map Ext"}
ENDTABLE

TABLE tCodecMetadataSubId
    {1, "Config Update"}
ENDTABLE

GROUP gQca_VOICE_ISO_COP_SIDEBAND "Sideband Info"
{
    FIELD fQca_SidebandInfo_Id                  (Fixed 1 Byte)                          (TABLE tSidebandId)         "Sideband Id"
    FIELD fQca_SidebandInfo_Len                 (Fixed 2 Byte)                          (Decimal)                   "Sideband Length"
    GROUP gQca_SidebandPrimer                   IF(FieldIs EqualTo 0x10 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandPrimerTimeOffset     (Fixed 4 Bytes)                         (Hex)                       "Exp Arrival Time(Native Clk)"
        FIELD fQca_SidebandPrimerInterval       (Fixed 2 Bytes)                         (Decimal)                   "Frame interval in usec"
        FIELD fQca_SidebandPrimerFrameSize      (Fixed 2 Bytes)                         (Decimal)                   "Frame size"
    }
    GROUP gQca_SidebandLinkQuality              IF(FieldIs EqualTo 0x11 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandLinkQualityStreamId  (Fixed 1 Byte)                          (Hex)                       "Stream Id"
        FIELD fQca_SidebandLinkQualityLevel     (Fixed 1 Byte)                          (Decimal)                   "Link Quality level"
        FIELD fQca_SidebandLinkQualityRssi      (Fixed 1 Byte) RETRIEVE (SignExtension 8)   (Decimal)               "RSSI(dbm)"
    }
    GROUP gQca_SidebandGenericEncoderFeedback   IF(FieldIs EqualTo 0x13 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandGEFStreamId          (Fixed 1 Byte)              (Hex)                                   "Stream Id"
        FIELD fQca_SidebandGEFSubId             (Fixed 1 Byte)              (TABLE tGenericEncoderFeedbackSubId)    "Sub Sideband Id"
        GROUP gQca_SidebandGEFQHSCapability     IF(FieldIs EqualTo 1 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFQHSCapabilityQHS6Support          (Fixed 1 bit)  (Binary)                         "QHS6"
            FIELD fQca_SidebandGEFQHSCapabilityQHS5Support          (Fixed 1 bit)  (Binary)                         "QHS5"
            FIELD fQca_SidebandGEFQHSCapabilityQHS4Support          (Fixed 1 bit)  (Binary)                         "QHS4"
            FIELD fQca_SidebandGEFQHSCapabilityQHS3Support          (Fixed 1 bit)  (Binary)                         "QHS3"
            FIELD fQca_SidebandGEFQHSCapabilityQHS2Support          (Fixed 1 bit)  (Binary)                         "QHS2"
            FIELD fQca_SidebandGEFQHSCapabilityBnVarationSupport    (Fixed 1 bit)  (Binary)                         "BN Variation"
            FIELD fQca_SidebandGEFQHSCapabilityFtChangeSupport      (Fixed 1 bit)  (Binary)                         "FT Varitaion"
            FIELD fQca_SidebandGEFQHSCapabilityExtIsoSupport        (Fixed 1 bit)  (Binary)                         "Extended ISO"
            RESERVED                                                (Fixed 8 bits)
        }
        GROUP gQca_SidebandGEFBtWifiActivity    IF(FieldIs EqualTo 2 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFBtWifiActivityHighSpeedLinks      (Fixed 1 Byte)      (Hex)                       "Num High Speed BT Links"
            FIELD fQca_SidebandGEFBtWifiActivityBrEdrScanStatus     (Fixed 1 Byte)      (Hex)                       "BR/EDR Scan Status"
            FIELD fQca_SidebandGEFBtWifiActivityLeScanStatus        (Fixed 1 Byte)      (Hex)                       "LE Scan Status"
            FIELD fQca_SidebandGEFBtWifiActivityWifiActivity        (Fixed 2 Bytes)     (Hex)                       "WIFI Acitvity"
        }
        GROUP gQca_SidebandGEFCigQhsMap   IF(FieldIs EqualTo 3 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFCigQhsMapCigId                    (Fixed 1 Byte)      (Decimal)                   "CIG Id"
            FIELD fQca_SidebandGEFCigQhsMapFlags                    (Fixed 1 Byte)      (Decimal)                   "Flags"
            FIELD fQca_SidebandGEFCigQhsMapCisCount                 (Fixed 1 Byte)      (Decimal)                   "CIS Count"
            GROUP gQca_SidebandGEFCigQhsMapArray REPEAT COUNT (FromField Times fQca_SidebandGEFCigQhsMapCisCount)
            {
                FIELD gQca_SidebandGEFCigQhsMapArrayCisHandle       (Fixed 1 Byte)      (Decimal)                   "CIS Id"
                FIELD gQca_SidebandGEFCigQhsMapArrayPdu2PQhs6       (Fixed 2 Bytes)     (Decimal)                   "QHS6 PDU size Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayPduP2CQhs6      (Fixed 2 Bytes)     (Decimal)                   "QHS6 PDU size Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnC2PQhs6       (Fixed 1 Byte)      (Decimal)                   "QHS6 BN Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnP2CQhs6       (Fixed 1 Byte)      (Decimal)                   "QHS6 BN Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayPdu2PQhs5       (Fixed 2 Bytes)     (Decimal)                   "QHS5 PDU size Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayPduP2CQhs5      (Fixed 2 Bytes)     (Decimal)                   "QHS5 PDU size Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnC2PQhs5       (Fixed 1 Byte)      (Decimal)                   "QHS5 BN Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnP2CQhs5       (Fixed 1 Byte)      (Decimal)                   "QHS5 BN Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayPdu2PQhs4       (Fixed 2 Bytes)     (Decimal)                   "QHS4 PDU size Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayPduP2CQhs4      (Fixed 2 Bytes)     (Decimal)                   "QHS4 PDU size Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnC2PQhs4       (Fixed 1 Byte)      (Decimal)                   "QHS4 BN Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnP2CQhs4       (Fixed 1 Byte)      (Decimal)                   "QHS4 BN Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayPdu2PQhs3       (Fixed 2 Bytes)     (Decimal)                   "QHS3 PDU size Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayPduP2CQhs3      (Fixed 2 Bytes)     (Decimal)                   "QHS3 PDU size Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnC2PQhs3       (Fixed 1 Byte)      (Decimal)                   "QHS3 BN Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnP2CQhs3       (Fixed 1 Byte)      (Decimal)                   "QHS3 BN Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayPdu2PQhs2       (Fixed 2 Bytes)     (Decimal)                   "QHS2 PDU size Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayPduP2CQhs2      (Fixed 2 Bytes)     (Decimal)                   "QHS2 PDU size Slave to Master"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnC2PQhs2       (Fixed 1 Byte)      (Decimal)                   "QHS2 BN Master to Slave"
                FIELD gQca_SidebandGEFCigQhsMapArrayBnP2CQhs2       (Fixed 1 Byte)      (Decimal)                   "QHS2 BN Slave to Master"
            }
        }
        GROUP gQca_SidebandGEFSetEncoderLimits   IF(FieldIs EqualTo 4 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFSetEncoderLimitsCigId             (Fixed 1 Byte)          (Decimal)               "CIG Id"
            FIELD fQca_SidebandGEFSetEncoderLimitsNumLimits         (Fixed 1 Byte)          (Decimal)               "Num Limits"
            FIELD fQca_SidebandGEFSetEncoderLimitsTLVArray  (toendoflayer) IF(MoreBytes)    (stringofhex)           "TLV Array"
        }
        GROUP gQca_SidebandGEFHidReport   IF(FieldIs EqualTo 5 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFHidReportNumReports               (Fixed 1 Byte)      (Decimal)                   "Num Reports"
            FIELD fQca_SidebandGEFHidReportArray    (toendoflayer) IF(MoreBytes)        (stringofhex)               "Array of ReportLen and Report"
        }
        GROUP gQca_SidebandGEFAseVsMetadata   IF(FieldIs EqualTo 6 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFAseVsMetadataCigId    (Fixed 1 Byte)      (Decimal)                               "CIG Id"
            FIELD fQca_SidebandGEFAseVsMetadataLen      (Fixed 1 Byte)      (Decimal)                               "VS metadata Len"
            FIELD fQca_SidebandGEFAseVsMetadata         (FromField Bytes fQca_SidebandGEFAseVsMetadataLen)  (Hex)   "VS metadata"
        }
        GROUP gQca_SidebandGEFCigQhsMapExt   IF(FieldIs EqualTo 7 fQca_SidebandGEFSubId)
        {
            FIELD fQca_SidebandGEFCigQhsMapExtISOInt     (Fixed 2 Byte)      (Decimal)                               SUPPRESS_DETAIL
            FIELD fQca_SidebandGEFCigQhsMapExtISOIntTmp1 (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_SidebandGEFCigQhsMapExtISOInt 1250) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_SidebandGEFCigQhsMapExtISOIntTmp2 (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_SidebandGEFCigQhsMapExtISOIntTmp1 1000) (Decimal) "ISO Interval(ms)"
            FIELD fQca_SidebandGEFCigQhsMapExtMaxFT      (Fixed 1 Byte)      (Decimal)                               "Max FT"
            FIELD fQca_SidebandGEFCigQhsMapExtNominalFT  (Fixed 1 Bytes)     (Decimal)                               "Nominal FT"
            FIELD fQca_SidebandGEFCigQhsMapExtNSE        (Fixed 1 Bytes)     (Decimal)                               "NSE"
        }         
    }
    GROUP gQca_SidebandEncoderReady             IF(FieldIs EqualTo 0x14 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandEncoderReadyCodecId          (Fixed 1 Byte)                  (Hex)                       "Codec ID"
        FIELD fQca_SidebandEncoderReadyCodecVersion     (Fixed 2 Bytes)                 (Decimal)                   "Codec version"
        FIELD fQca_SidebandEncoderReadyCodecMetadata    (Fixed 5 Bytes)                 (Hex)                       "Codec metadata"
    }
    GROUP gQca_SidebandIsoLinkQuality           IF(FieldIs EqualTo 0x15 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandIsoLinkQualityStreamId           (Fixed 1 Byte)              (Hex)                       "Stream Id"
        FIELD fQca_SidebandIsoLinkQualityRssi               (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal)     "RSSI(dbm)"
        FIELD fQca_SidebandIsoLinkQualitySduSize            (Fixed 2 Bytes)             (Decimal)                   "recommend SDU Size"
        FIELD fQca_SidebandIsoLinkQualityTxUnACKed          (Fixed 4 Bytes)             (Decimal)                   "Tx UnACKed Packets"
        FIELD fQca_SidebandIsoLinkQualityTxFlushed          (Fixed 4 Bytes)             (Decimal)                   "Tx Flushed Packets"
        FIELD fQca_SidebandIsoLinkQualityTxLastSubEvtPkts   (Fixed 4 Bytes)             (Decimal)                   "Tx Last Subevent Packets"
        FIELD fQca_SidebandIsoLinkQualityRetransPkts        (Fixed 4 Bytes)             (Decimal)                   "Retransmitted Packets"
        FIELD fQca_SidebandIsoLinkQualityCRCErrPkts         (Fixed 4 Bytes)             (Decimal)                   "CRC error Packets"
        FIELD fQca_SidebandIsoLinkQualityRxUnreceivedPkts   (Fixed 4 Bytes)             (Decimal)                   "Rx Unreceived Packets"
        FIELD fQca_SidebandIsoLinkQualityDuplicatePkts      (Fixed 4 Bytes)             (Decimal)                   "Duplicate Packets"
    }
    GROUP gQca_SidebandCodecMetadata            IF(FieldIs EqualTo 0x16 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandCodecMetadataStreamId        (Fixed 1 Byte)                  (Hex)                       "Stream Id"
        FIELD fQca_SidebandCodecMetadataSubId           (Fixed 1 Byte)                  (TABLE tCodecMetadataSubId) "Sub Sideband Id"
        GROUP gQca_SidebandCodecMetadataConfigUpdate    IF(FieldIs EqualTo 1 fQca_SidebandCodecMetadataSubId)
        {
            FIELD fQca_SidebandCodecMetadataConfigUpdateFormat          (Fixed 1 Byte)  (Decimal)                   "Format"
            FIELD fQca_SidebandCodecMetadataConfigUpdateFtC2P           (Fixed 1 Byte)  (Decimal)                   "FT Mater to Slave"
            FIELD fQca_SidebandCodecMetadataConfigUpdateFtP2C           (Fixed 1 Byte)  (Decimal)                   "FT Slave to Master"
            FIELD fQca_SidebandCodecMetadataConfigUpdateTtpAdjRate      (Fixed 1 Byte)  (Decimal)                   "TTP Adj Rate"
            FIELD fQca_SidebandCodecMetadataConfigUpdateQhsModulation   (Fixed 1 Byte)  (Decimal)                   "QHS modulation"
            FIELD fQca_SidebandCodecMetadataConfigUpdateNse             (Fixed 1 Byte)  (Decimal)                   "NSE"
        }
    }
    GROUP gQca_SidebandCodecMetadataAck         IF(FieldIs EqualTo 0x17 fQca_SidebandInfo_Id)
    {
        FIELD fQca_SidebandCodecMetadataAckStreamId     (Fixed 1 Byte)                  (Hex)                       "Stream Id"
        FIELD fQca_SidebandCodecMetadataAckSubId        (Fixed 1 Byte)                  (TABLE tCodecMetadataSubId) "Sub Sideband Id"
        GROUP gQca_SidebandCodecMetadataAckConfigUpdate    IF(FieldIs EqualTo 1 fQca_SidebandCodecMetadataAckSubId)
        {
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateFormat               (Fixed 1 Byte)  (Decimal)           "Format"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateStatus               (Fixed 1 Byte)  (Decimal)           "Status"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateFtC2P                (Fixed 1 Byte)  (Decimal)           "FT Mater to Slave"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateFtP2C                (Fixed 1 Byte)  (Decimal)           "FT Slave to Master"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateCurCisEventCount     (Fixed 2 Bytes) (Decimal)           "Current CIS Event Count"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateFtChangeEventCount   (Fixed 2 Bytes) (Decimal)           "FT Change Event Count"
            FIELD fQca_SidebandCodecMetadataAckConfigUpdateQhsModulation        (Fixed 1 Byte)  (Decimal)           "QHS modulation"
        }
    }
}

TABLE tRBFullCase
    {1, "Overflow"}
    {2, "OverflowAddr1Null"}
    {3, "OverflowAddr2Null"}
    {4, "Flush"}
    {5, "PktLate"}
ENDTABLE
GROUP gQca_AUDIO_DATA_RINGBUFFER_FULL "RingbufferFull"
{
    FIELD fQca_Rbfull1                    (Fixed 4 Bytes)                          (TABLE tRBFullCase)                 "case"
    GROUP gQca_RINGBUF_Overflow IF(FieldIs Lessthan 4 fQca_Rbfull1)
	{
	    FIELD fQca_Rbfull11                (Fixed 4 Bytes)                          (Decimal)                           "available"
    	FIELD fQca_Rbfull12                (Fixed 4 Bytes)                          (Decimal)                           "required"
    	FIELD fQca_Rbfull13                (Fixed 4 Bytes)                          (Decimal)                           "clkN"
	}
    GROUP gQca_RINGBUF_FLUSH IF(FieldIs EqualTo 4 fQca_Rbfull1)
	{
	    FIELD fQca_Rbfull21                (Fixed 4 Bytes)                         (Decimal)                           "flushCnt"
	    FIELD fQca_Rbfull22                (Fixed 4 Bytes)                         (Decimal)                           "flushBytes"
    	FIELD fQca_Rbfull23                (Fixed 4 Bytes)                         (Decimal)                           "LatencyMs"
	}
    GROUP gQca_RINGBUF_PKTLATE IF(FieldIs EqualTo 4 fQca_Rbfull1)
	{
	    FIELD fQca_Rbfull31                (Fixed 4 Bytes)                         (Decimal)                           "flushCnt"
	    FIELD fQca_Rbfull32                (Fixed 4 Bytes)                         (Decimal)                           "arrClkN"
    	FIELD fQca_Rbfull33                (Fixed 4 Bytes)                         (Decimal)                           "clkN"
	}
}

