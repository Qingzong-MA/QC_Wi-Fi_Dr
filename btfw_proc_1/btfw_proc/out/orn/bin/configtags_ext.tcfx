        <ELEMENTS Name="nominalToHighGainFactor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Obsoleted for Rome. Used to adjust RM RSSI to RSSI_raw if in nominal gain = 10^(16/20)" />
        <ELEMENTS Name="RssiGainFactor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x9F" Signed="false" Description="used to convert RSSI_raw to dBm" />
