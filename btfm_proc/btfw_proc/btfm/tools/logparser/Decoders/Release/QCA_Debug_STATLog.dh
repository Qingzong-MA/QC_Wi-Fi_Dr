GROUP gQca_STAT_LALF "LE Audio Link Feedback Info"
{
    FIELD fQca_CIS_ID                            (Fixed 1 Byte)     (Hex)                "CIS handle"
    FIELD fQca_Mode                                (Fixed 1 Byte)     (Decimal)            "LALF enabled"
    FIELD fQca_ConfigEventPath                     (Fixed 1 Byte)     (Decimal)            "event path"
    FIELD fQca_ConfigWeightFactor                 (Fixed 1 Byte)     (Decimal)            "weight factor"
    FIELD fQca_ConfigEvaluationPeriod             (Fixed 1 Byte)     (Decimal)            "evalutaion period"
    FIELD fQca_ConfigRetransThresLow             (Fixed 1 Byte)     (Decimal)            "retrans threshold low"
    FIELD fQca_ConfigRetransThresHigh             (Fixed 1 Byte)     (Decimal)            "retrans threshold high"
    FIELD fQca_ConfigBoundaryLow                 (Fixed 1 Byte)     (Decimal)            "boundary low"
    FIELD fQca_ConfigBoundaryHigh                 (Fixed 1 Byte)     (Decimal)            "boundary high"
    RESERVED                                    (Fixed 1 Byte)
    FIELD fQca_txRetransCnt                     (Fixed 2 Bytes)     (Decimal)           "retransmission count"
    FIELD fQca_txPacketCnt                         (Fixed 2 Bytes)     (Decimal)           "transmit succeed count"
    FIELD fQca_txUnackedCnt                     (Fixed 2 Bytes)     (Decimal)           "unacked packet count"
    FIELD fQca_txFlushedCnt                     (Fixed 2 Bytes)     (Decimal)           "flushed packet count"
    FIELD fQca_avgRetransRate                     (Fixed 2 Bytes)     (Decimal)           "Avg retransmission rate"
    FIELD fQca_qualityLvl                         (Fixed 1 Byte)      (Decimal)           "quality level"
    RESERVED                                    (Fixed 3 Bytes)
    FIELD fQca_evaluateEndClk                     (Fixed 4 Bytes)     (Decimal)             "evaluation end clk"
    FIELD fQca_txRetransCntLastSecond             (Fixed 4 Bytes)     (Decimal)            "retransmission count last second"
    FIELD fQca_txPacketCntLastSecond            (Fixed 4 Bytes)     (Decimal)            "transmit succeed count last second"
    FIELD fQca_txUnackedLastSecond                 (Fixed 4 Bytes)     (Decimal)            "unacked count last second"
    FIELD fQca_txFlushedLastSecond                (Fixed 4 Bytes)     (Decimal)            "flushed count last second"
    FIELD fQca_retransCntToHost                 (Fixed 2 Bytes)     (Decimal)            "retransmission packet count to host"
    FIELD fQca_packetCntToHost                     (Fixed 2 Bytes)     (Decimal)            "transmit packet count to host"
    FIELD fQca_unackedCntToHost                 (Fixed 2 Bytes)     (Decimal)            "unacked packet count to host"
    FIELD fQca_flushedCntToHost                 (Fixed 2 Bytes)     (Decimal)            "flushed packet count to host"
    FIELD fQca_oneSecondTimer                     (Fixed 4 Bytes)     (Decimal)            "One second timer"
    FIELD fQca_curBitRate                         (Fixed 2 Bytes)     (Decimal)            "current bit rate"
