    {0x095B "LOG_ID_AUDIO_TX_PORT_CONGESTION"  		"LOG_ID_AUDIO_TX_PORT_CONGESTION"           0   gQca_AUDIO_TX_PORT_CONGESTION}
    {0x095C "LOG_ID_VOICE_ISO_TOAIR_SDU_SIZE"       "LOG_ID_VOICE_ISO_TOAIR_SDU_SIZE"           0   gQca_ChangeInSDUSize}
    {0x095D "LOG_ID_AUDIO_SESSION_ERROR"            "LOG_ID_AUDIO_SESSION_ERROR"                0   gQca_AUDIO_SESSION_ERROR}
    {0x095E "LOG_ID_SBC_FRAGMENT"                   "LOG_ID_SBC_FRAGMENT"                       0   gQca_SBC_Fragment}
