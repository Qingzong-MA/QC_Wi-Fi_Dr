		RESERVED                         		   (Fixed 1 Bytes)
	}

	GROUP gQca_VOICE_anotherFrameInfo "F0"
	{
		FIELD fQca_VS_wbCnt1                       (Fixed 2 Bytes)     (Decimal)                          "f0WeakbitCount"
		FIELD fQca_VS_inData1                      (Fixed 28 Bytes)    (HEX)          					   "f0inData"
		FIELD fQca_VS_quality1                     (Fixed 28 Bytes)    (HEX)          					   "f0quality"
		FIELD fQca_VS_decodeEdpStatus1             (Fixed 1 Bytes)     (TABLE tEdpErrCode)                "f0decodeEdpStatus"
