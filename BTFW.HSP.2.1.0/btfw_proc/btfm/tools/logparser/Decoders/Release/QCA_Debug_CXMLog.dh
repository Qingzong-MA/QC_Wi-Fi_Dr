    {0x04E4 "LOG_ID_CXM_INFO_PFAL_COEX_MCI_VI"      "LOG_ID_CXM_INFO_PFAL_COEX_MCI_VI"      0 gQca_CXM_Info}
    {0x04E5 "LOG_ID_CXM_INFO_LLM_RMCDCOMMAND"       "LOG_ID_CXM_INFO_LLM_RMCDCOMMAND"       0 gQca_CXM_Info}
    {0x04E6 "LOG_ID_CXM_INFO_SLC_DISPATCHER"        "LOG_ID_CXM_INFO_SLC_DISPATCHER"        0 gQca_CXM_Info}
    {0x04E7 "LOG_ID_CXM_INFO_PFAL_COEX_MCI_GPM"     "LOG_ID_CXM_INFO_PFAL_COEX_MCI_GPM"     0 gQca_CXM_Info}
