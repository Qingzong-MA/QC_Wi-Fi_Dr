From bff156a6bbf472c9ce8f38da33ea5dd6cd835c10 Mon Sep 17 00:00:00 2001
From: Bing Sun <quic_bings@quicinc.com>
Date: Tue, 12 Jul 2022 11:16:47 +0800
Subject: [PATCH] openwrt: fixing issues on x86

fixing issues on x86
---
 package/base-files/files/etc/rc.common             |  2 +-
 package/base-files/files/lib/functions.sh          |  2 +-
 package/base-files/files/sbin/wifi                 | 48 ++++++++++++++++------
 .../network/config/netifd/files/etc/init.d/network |  2 +-
 .../config/netifd/files/lib/network/config.sh      |  2 +-
 .../network/services/dnsmasq/files/dnsmasq.init    |  2 +-
 6 files changed, 40 insertions(+), 18 deletions(-)

diff --git a/package/base-files/files/etc/rc.common b/package/base-files/files/etc/rc.common
index e0de073..bdde408 100755
--- a/package/base-files/files/etc/rc.common
+++ b/package/base-files/files/etc/rc.common
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 # Copyright (C) 2006-2012 OpenWrt.org
 
 . $IPKG_INSTROOT/lib/functions.sh
diff --git a/package/base-files/files/lib/functions.sh b/package/base-files/files/lib/functions.sh
index da2bd6d..81aeb27 100755
--- a/package/base-files/files/lib/functions.sh
+++ b/package/base-files/files/lib/functions.sh
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 # Copyright (C) 2006-2014 OpenWrt.org
 # Copyright (C) 2006 Fokus Fraunhofer <carsten.tittel@fokus.fraunhofer.de>
 # Copyright (C) 2010 Vertical Communications
diff --git a/package/base-files/files/sbin/wifi b/package/base-files/files/sbin/wifi
index a37c9c9..34f808c 100755
--- a/package/base-files/files/sbin/wifi
+++ b/package/base-files/files/sbin/wifi
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 # Copyright (C) 2006 OpenWrt.org
 
 . /lib/functions.sh
@@ -12,6 +12,10 @@ EOF
 	exit 1
 }
 
+__wifi_info() {
+    logger -t wifi -p user.info "$1"
+}
+
 ubus_wifi_cmd() {
 	local cmd="$1"
 	local dev="$2"
@@ -107,33 +111,51 @@ wifi_fixup_hwmode() {
 	config_set "$device" hwmode "$hwmode"
 }
 
+__wifi_restart_map() {
+    sleep 10
+    PID=$(ps -fe | grep "wsplcd" | grep -v grep | awk '{print $2}')
+    if [ -n "$PID" ]; then
+	__wifi_info "__wifi_restart_map restart wsplcd"
+        /etc/init.d/wsplcd restart
+    fi
+    PID=$(ps -fe | grep "ezmesh" | grep -v grep | awk '{print $2}')
+    if [ -n "$PID" ]; then
+	__wifi_info "__wifi_restart_map restart ezmesh"
+        /etc/init.d/ezmesh restart
+    fi
+}
 _wifi_updown() {
-	for driver in ${DRIVERS}; do (
-		if eval "type pre_${driver}" 2>/dev/null >/dev/null; then
-			eval "pre_${driver}" ${1}
-		fi
-	); done
+#	for driver in ${DRIVERS}; do (
+#		if eval "type pre_${driver}" 2>/dev/null >/dev/null; then
+#			eval "pre_${driver}" ${1}
+#		fi
+#	); done
 
 	for device in ${2:-$DEVICES}; do (
 		config_get disabled "$device" disabled
 		[ "$disabled" = "1" ] && {
-			echo "'$device' is disabled"
+			__wifi_info "'$device' is disabled"
 			set disable
 		}
 		config_get iftype "$device" type
+		__wifi_info "device $device ${1}_$iftype"
 		if eval "type ${1}_$iftype" 2>/dev/null >/dev/null; then
 			eval "scan_$iftype '$device'"
 			eval "${1}_$iftype '$device' '$3'" || echo "$device($iftype): ${1} failed"
 		elif [ ! -f /lib/netifd/wireless/$iftype.sh ]; then
-			echo "$device($iftype): Interface type not supported"
+			__wifi_info "$device($iftype): Interface type not supported"
 		fi
 	); done
 
-	for driver in ${DRIVERS}; do (
-		if eval "type post_${driver}" 2>/dev/null >/dev/null; then
-			eval "post_${driver}" ${1} "$2" "$3"
-		fi
-	); done
+#	for driver in ${DRIVERS}; do (
+#		if eval "type post_${driver}" 2>/dev/null >/dev/null; then
+#			eval "post_${driver}" ${1} "$2" "$3"
+#		fi
+#	); done
+	if [ enable = "$1" ]; then
+	    __wifi_info "_wifi_updown $1"
+            __wifi_restart_map
+	fi
 }
 
 wifi_updown() {
