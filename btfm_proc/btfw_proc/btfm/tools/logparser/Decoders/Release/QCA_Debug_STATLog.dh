GROUP gQca_STAT_A2dpConnStats "A2DP Stall Connection Stats"
{
    FIELD fQca_A2DPPktNo                (Fixed 1 Byte)  (Decimal)  "PktNo"
    FIELD fQca_A2DPConnHandle           (Fixed 1 Byte)  (Decimal)  "ConnHandle"
    FIELD fQca_A2DPpktType              (Fixed 1 Byte)  (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2DPltType               (Fixed 1 Byte)  RETRIEVE   (MultiplyInteger 16) ALSO (AddField fQca_A2DPpktType) (Table ACL_PACKETTYPE) "pktType"

    FIELD fQca_A2DPTxPower              (Fixed 1 Byte)  RETRIEVE (SignExtension 8)(Decimal)  "Tx Power(dBM)"
    FIELD fQca_A2DPAvgRSSI              (Fixed 1 Byte)  RETRIEVE (SignExtension 8) (Decimal)  "avgRSSIdBm"
    GROUP fQCA_A2DPFlags "flags"
    {
        Reserved (fixed 4 bits)
        FIELD fQCA_A2DPFlags_BIT3_delayDetected  (Fixed 1 bit)  (TABLE t_truefalse)     "delayDetected"
        FIELD fQCA_A2DPFlags_BIT2_a2dpRole       (Fixed 1 bit)  (TABLE t_a2dpRole)      "a2dpRole"
        FIELD fQCA_A2DPFlags_BIT1_a2dpRoleDetect (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 1) (TABLE t_truefalse)     "a2dpRoleDetected"
        FIELD fQCA_A2DPFlags_BIT0_linkRole       (Fixed 1 bit)  (TABLE t_linkRole)      "linkRole"
    }
    FIELD fQca_A2DPTxPowerLevel         (Fixed 1 Byte)  (Decimal)  "Tx Power Level"

    GROUP gQca_STAT_ACLPerPktStats;
    FIELD fQca_A2dpOverflowCount        (Fixed 2 Bytes) (Decimal) "OverflowCount"
    FIELD fQca_A2dpFlushCount           (Fixed 2 Bytes) (Decimal) "FlushCount"
    FIELD fQca_A2dpPiconetClock         (Fixed 4 Bytes) (Hex)      "PiconetClock"
    FIELD fQca_A2dpClockOffset          (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpAckInstant           (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpAckInstantPnet       (Fixed 0)       RETRIEVE   (AddFieldToField fQca_A2dpAckInstant fQca_A2dpClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "AckInstant"
    FIELD fQca_A2dpArrivalTime          (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpArrivalTimePnet      (Fixed 0)       RETRIEVE   (AddFieldToField fQca_A2dpArrivalTime fQca_A2dpClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "ArrivalTime"
    FIELD fQca_A2dpSchedInstant         (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedInstantPnet     (Fixed 0)       RETRIEVE   (AddFieldToField fQca_A2dpSchedInstant fQca_A2dpClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "SchedInstant"
    FIELD fQca_A2dpLastTxAckInstant     (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpLastTxAckInstantPnet (Fixed 0)       RETRIEVE   (AddFieldToField fQca_A2dpLastTxAckInstant fQca_A2dpClockOffset)ALSO (AndMask 0xFFFFFFF) (Hex) "LastTxAckInstant"

    /* Do not display if the clock values are invalid */
    FIELD fQca_A2dpLastFlowOffClk       (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL

    /* Do not display if the clock values are invalid */
    FIELD fQca_A2dpLastFlowOnClk        (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL

    FIELD fQca_A2dpAckInstantPnetROMask (Fixed 0)       RETRIEVE (StoreField fQca_A2dpAckInstantPnet) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpPrevtoCurrAckDelay   (Fixed 0)       RETRIEVE (SubtractFieldMinusField fQca_A2dpAckInstantPnetROMask fQca_A2dpLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF)   (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2dpPrevtoCurrAckDelay1  (Fixed 0)       RETRIEVE (MultiplyFieldByInteger fQca_A2dpPrevtoCurrAckDelay 625)           (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2dpPrevtoCurrAckDelay2  (Fixed 0)       RETRIEVE (DivideFieldByInteger fQca_A2dpPrevtoCurrAckDelay1 2000)           (Decimal)  "PrevToCurrPktAckDelay(ms)"

    FIELD fQca_A2dpLastFlowOffClkPnet   (Fixed 0)       IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpLastFlowOffClk) ELSE_SKIP (FIXED 0) RETRIEVE (AddFieldToField fQca_A2dpLastFlowOffClk fQca_A2dpClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "LastFlowOffClk"
    FIELD fQca_A2dpLastFlowOnPnet       (Fixed 0)       IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE (AddFieldToField fQca_A2dpLastFlowOnClk fQca_A2dpClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "LastFlowOnClk"

    /* Do no display if the clock values are invalid */
    FIELD fQca_A2dpCoexCriticalPriorityClk  (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "CoexCriticalPriorityClk"
    FIELD fQca_A2dpCoexNormalPriorityClk    (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "CoexNormalPriorityClk"
    FIELD fQca_A2dpWBtime                   (Fixed 4 Bytes) (Hex)      "WBtime"
    FIELD fQca_LastA2dpPktFlushClk          (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "Last ACL PKT FLush CLK"
    FIELD fQca_TxAbortByCoexAbortCntr       (Fixed 4 Bytes) (Hex)      "TxCoexAbortCounterAfterCoexGrantedFirst"
    FIELD fQca_A2DPMediaSeqn                (Fixed 2 Bytes) PRINT_IF   (FieldIs NotEqualTo 0) (Decimal)  "MediaSeqn"
    FIELD fQca_flowAccessLatency            (Fixed 2 Bytes) (Decimal)    "flowAccessLatency"

    GROUP gQca_SegmentLatency;

    FIELD fQca_A2dp_numChain        (FIXED 1 BYTES) (DECIMAL) SUPPRESS_DETAIL

    FIELD fQca_A2dpMaxpowerCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE A2dpMaxpowerCntr
    GROUP gQca_A2dp_SAR_MAX_POWER REPEAT COUNT (FromField Times fQca_A2dp_numChain) "SAR Max Power(dBM)"
    {
        GROUP gQca_A2dpMaxPower
        {
            FIELD fQca_A2dp_Max_power        (Fixed 1 Bytes) PRINT_IF (FieldIs NotEqualTo -1)  RETRIEVE (SignExtension 8) (DecimalWithFieldLabel A2dpMaxpowerCntr) "Antenna"
        }
        FIELD fQca_A2dpMaxpowerCntrIncr (Fixed 0) RETRIEVE (StoreField A2dpMaxpowerCntr) ALSO (AddInteger 1) (Hex) SUPPRESS_DETAIL STORE A2dpMaxpowercntr
    }
    RESERVED                                (Fixed 1 Byte)
    FIELD fQca_A2dparrTimeMs     (Fixed 4 Bytes) (Decimal)      "arrTimeMs"
    FIELD fQca_A2dpSinkDelayUs   (Fixed 4 Bytes) (Decimal)      "sinkDelayUs"
    FIELD fQca_A2dpPktDutUs      (Fixed 4 Bytes) (Decimal)      "pktDurUs"
    FIELD fQca_A2dpRemoteBufUs   (Fixed 4 Bytes) (Decimal)      "remoteBufUs"
    FIELD fQca_A2dpGlitchDurUs   (Fixed 4 Bytes) (Decimal)      "glitchDurUs"
    FIELD fQca_A2dpTtpAdj        (Fixed 4 Bytes) (Decimal)      SUPPRESS_DETAIL STORE a2dpTtpAdj
    FIELD fQca_A2dpStartTtp      (Fixed 4 Bytes) (Decimal)      SUPPRESS_DETAIL STORE a2dpStartTtp
    FIELD fQca_A2dpCurrTtp       (Fixed 4 Bytes) (Decimal)      SUPPRESS_DETAIL STORE a2dpCurrTtp 
    FIELD fQca_A2dpUseTtp        (Fixed 1 Bytes) (hex)          "useTtp"
    
    GROUP gQca_A2dpUseTtp IF(FieldIs EqualTo 0x01 fQca_A2dpUseTtp) "useTtp"
    {
        FIELD fQca_A2dpTtpAdj1        (Fixed 0) RETRIEVE (StoreField fQca_A2dpTtpAdj)   (Decimal)  "ttpAdjUs"
        FIELD fQca_A2dpStartTtp1      (Fixed 0) PRINT_IF (FieldIs NotEqualTo 0xffffffff) RETRIEVE (StoreField fQca_A2dpStartTtp) (Decimal)    "glitchStartTtpUs"
        FIELD fQca_A2dpCurrTtp1       (Fixed 0) PRINT_IF (FieldIs NotEqualTo 0xffffffff) RETRIEVE (StoreField fQca_A2dpCurrTtp)  (Decimal)    "glitchEndTtpUs"  
    }
    GROUP gQca_A2dpUseBuf IF(FieldIs EqualTo 0x00 fQca_A2dpUseTtp)
    {
        FIELD fQca_A2dpAckInt1        (Fixed 0) RETRIEVE (StoreField fQca_A2dpTtpAdj)   (Decimal)  "ackIntUs"
        FIELD fQca_A2dpPrevAck1       (Fixed 0) RETRIEVE (StoreField fQca_A2dpStartTtp) (Decimal)  "prevAckIUs"
        FIELD fQca_A2dpCurrAck1       (Fixed 0) RETRIEVE (StoreField fQca_A2dpCurrTtp)  (Decimal)  "currAckUs"  
    }
}

GROUP gQca_SegmentLatency "SegmentationLatency"
{
    FIELD fQca_A2dpArrivePacketLatency              (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpArrivalTimePnet fQca_A2dpLastTxAckInstantPnet) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpArrivePacketLatencyTemp          (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpArrivePacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpPacketArriveLatencyInMillisec    (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpArrivePacketLatencyTemp 16) (Decimal) "L1. Arrival Latency from PrevAck(ms)"

    FIELD fQca_A2dpSchedInstantPnetROMask           (Fixed 0) RETRIEVE (StoreField fQca_A2dpSchedInstantPnet) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpSchedInstantPnetROMask fQca_A2dpArrivalTimePnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpSchedulePacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpSchedulePacketLatencyTemp 16) (Decimal) "L2. Schedule Latency from Arrival(ms)"

    FIELD fQca_A2dpSchedulePacketLatency1            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpSchedInstantPnetROMask fQca_A2dpLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyTemp1        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpSchedulePacketLatency1 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyInMillisec1  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpSchedulePacketLatencyTemp1 16) (Decimal) "L2-1. Schedule Latency from LastAck(ms)"

    FIELD fQca_A2dpSchedulePacketLatency2            (Fixed 0) IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpSchedInstantPnetROMask fQca_A2dpLastFlowOnPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyTemp2        (Fixed 0) IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpSchedulePacketLatency2 625) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpSchedulePacketLatencyInMillisec2  (Fixed 0) IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE (DivideFieldByInteger fQca_A2dpSchedulePacketLatencyTemp2 2) (Decimal) "L2-2. Schedule Latency from LastFlowOnClk(usec)"

    FIELD fQca_A2dpTxPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpAckInstantPnetROMask fQca_A2dpSchedInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpTxPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpTxPacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpTxPacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpTxPacketLatencyTemp 16) (Decimal) "L3. OTA Latency from Schedule(ms)"

    FIELD fQca_A2dpToPrevPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpAckInstantPnetROMask fQca_A2dpLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpToPrevPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpToPrevPacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpToPrevPacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpToPrevPacketLatencyTemp 16) (Decimal) "Latency(L1 + L2 + L3) (ms)"

    FIELD fQca_A2dpPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpAckInstantPnetROMask fQca_A2dpArrivalTimePnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpPacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpPacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpPacketLatencyTemp 16) (Decimal) "A2DP Packet Latency(L2 + L3) (ms)"
}


GROUP gQca_STAT_PrefRateStats "Pref Rate Stats"
{
    FIELD fQca_PrefRateConnHandle                               (Fixed 2 Bytes)     (Hex)           "ConnHandle"
    GROUP gQca_STAT_PrefPacketTypes;
    FIELD fQca_MaxSlots                                         (Fixed 1 Byte)      (Hex)           "MaxSlots"
    FIELD fQca_PrefRateReason                                   (Fixed 1 Byte)      (TABLE tQca_PrefRateType)    "Reason"
}

TABLE tQca_BtQhsRate
    { 0x02 2QHD }
    { 0x03 3QHD }
    { 0x04 4QHD }
    { 0x05 5QHD }
    { 0x06 6QHD }
ENDTABLE

GROUP gQca_LLM_QhsPrefRate "QHS Pref Rate Stats"
{
    FIELD fQca_QhsConnHandle       (Fixed 2 Bytes)   (Hex)                        "ConnHandle"
    FIELD fQca_QhsPrefRate         (Fixed 1 Bytes)   (TABLE tQca_BtQhsRate)       "QHS Rate"
    FIELD fQca_QhsPrefPktLen       (Fixed 1 Bytes)   (Decimal)                    "Pkt Len in slots "
    FIELD fQca_QhsPrefRateReason   (Fixed 2 Byte)    (TABLE tQca_PrefRateType)    "Reason"
    FIELD fQca_QhsCqddrPer         (Fixed 2 Bytes)   (Decimal)                    "PER"
}

GROUP gQca_STAT_PrefPacketTypes "Local Tx Preferred PacketType"
{
/* LSB of the PacketTypes from BIT7 to BIT0*/
    RESERVED            (Fixed 1 Bit)
    FIELD fQca_AUX      (Fixed 1 Bit)   (Binary)        "AUX  "
    FIELD fQca_DV       (Fixed 1 Bit)   (Binary)        "DV   "
    FIELD fQca_DH1      (Fixed 1 Bit)   (Binary)        "DH1  "
    FIELD fQca_DM1      (Fixed 1 Bit)   (Binary)        "DM1  "
    FIELD fQca_3DH1     (Fixed 1 Bit)   (Binary)        "3-DH1"
    FIELD fQca_2DH1     (Fixed 1 Bit)   (Binary)        "2-DH1"
    RESERVED            (Fixed 1 Bit)

/* MSB of the PacketTypes from BIT15 to BIT8 */
    FIELD fQca_DH5      (Fixed 1 Bit)   (Binary)        "DH5  "
    FIELD fQca_DM5      (Fixed 1 Bit)   (Binary)        "DM5  "
    FIELD fQca_3DH5     (Fixed 1 Bit)   (Binary)        "3-DH5"
    FIELD fQca_2DH5     (Fixed 1 Bit)   (Binary)        "2-DH5"
    FIELD fQca_DH3      (Fixed 1 Bit)   (Binary)        "DH3  "
    FIELD fQca_DM3      (Fixed 1 Bit)   (Binary)        "DM3  "
    FIELD fQca_3DH3     (Fixed 1 Bit)   (Binary)        "3-DH3"
    FIELD fQca_2DH3     (Fixed 1 Bit)   (Binary)        "2-DH3"
}

GROUP gQca_STAT_PollMngrStats "Poll Manager Stats"
{
    FIELD fQca_ACLSlots             (Fixed 2 Bytes) (Decimal)   "ACL Slots"
    FIELD fQca_A2DPSlots            (Fixed 2 Bytes) (Decimal)   "A2DP Slots"
    FIELD fQca_PageSlots            (Fixed 2 Bytes) (Decimal)   "Page Slots"
    FIELD fQca_InquirySlots         (Fixed 2 Bytes) (Decimal)   "Inquiry Slots"
    FIELD fQca_AdvSlots             (Fixed 2 Bytes) (Decimal)   "Advertising Slots"
    FIELD fQca_ScanSlots            (Fixed 2 Bytes) (Decimal)   "Scanning Slots"
    FIELD fQca_initSlots            (Fixed 2 Bytes) (Decimal)   "inittating Slots"
    FIELD fQca_TotalSlots           (Fixed 2 Bytes) (Decimal)   "Total Slots"
}

/******************** Half LSTO Stats ********************/

GROUP gQca_STAT_HalfLstoStats "Half LSTO Stats"
{
    FIELD  fQca_StatConnHandle              (Fixed 2 bytes)      (Decimal)     "Connection Handle"
    FIELD  fQca_StatTimeSinceSync           (Fixed 2 bytes)      (Hex)         "Time since sync"
    FIELD fQca_StatTxPower                  (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal) "TxPower(dBM)"

    FIELD fQca_Stats_numChain        (FIXED 1 BYTES) (DECIMAL) SUPPRESS_DETAIL

    FIELD fQca_StatMaxpowerCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE StatMaxpowerCntr
    GROUP gQca_SCO_SAR_MAX_POWER REPEAT COUNT (FromField Times fQca_Stats_numChain) "SAR Max Power(dBM)"
    {
        GROUP gQca_StatMaxPower
        {
            FIELD fQca_Stat_Max_power        (Fixed 1 Bytes) PRINT_IF (FieldIs NotEqualTo -1)  RETRIEVE (SignExtension 8) (DecimalWithFieldLabel StatMaxpowerCntr) "Antenna"
        }
        FIELD fQca_StatMaxpowerCntrIncr (Fixed 0) RETRIEVE (StoreField StatMaxpowerCntr) ALSO (AddInteger 1) (Hex) SUPPRESS_DETAIL STORE StatMaxpowercntr
    }

}


/* Sniff stats */
