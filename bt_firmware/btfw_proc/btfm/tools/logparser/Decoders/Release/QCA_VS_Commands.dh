GROUP gA2dpCmd_WriteA2dpCfg "Write A2DP Configurations"
{
     FIELD gA2dpCmd_WriteA2dpCfg_Codec                          (Fixed 1 Byte) (TABLE tA2dpCodecType) "Codec"
     FIELD gA2dpCmd_WriteA2dpCfg_Transport                      (Fixed 1 Byte) (TABLE tA2dpTransportType) "Transport"
     FIELD gA2dpCmd_WriteA2dpCfg_StreamFormat                   (Fixed 1 Byte) (TABLE tA2dpStreamType) "Stream Format"
     FIELD gA2dpCmd_WriteA2dpCfg_A2dpHandle                     (Fixed 1 Byte) (Decimal) "A2DP Handle"
     FIELD gA2dpCmd_WriteA2dpCfg_MaxLatency                     (Fixed 1 Byte) (Decimal) "Max Latency"
     FIELD gA2dpCmd_WriteA2dpCfg_DelayReportEnable              (Fixed 1 Byte) (Decimal) "Delay Report Enable"
     FIELD gA2dpCmd_WriteA2dpCfg_ScmsT_Enable                   (Fixed 1 Byte) (Decimal) "SCMS_T Enable"
     FIELD gA2dpCmd_WriteA2dpCfg_ScmsT_Header                   (Fixed 1 Byte) (Decimal) "SCMS_T Header"
     FIELD gA2dpCmd_WriteA2dpCfg_SamplingFreq                   (Fixed 2 Byte) (TABLE tSamplingFreq) "Sampling Freq"
     FIELD gA2dpCmd_WriteA2dpCfg_HciConnHandle                  (Fixed 2 Byte) (Decimal) "Hci Conn Handle"
     FIELD gA2dpCmd_WriteA2dpCfg_L2capCID                       (Fixed 2 Byte) (Decimal) "L2CAP CID"
     FIELD gA2dpCmd_WriteA2dpCfg_L2capMTU                       (Fixed 2 Byte) (Decimal) "L2CAP MTU"
     FIELD gA2dpCmd_WriteA2dpCfg_StartStream                    (Fixed 1 Byte) (Decimal) "Start Streaming"
     FIELD gA2dpCmd_WriteA2dpCfg_TWS_Enable                     (Fixed 1 Byte) (Decimal)  "TWS Enable"
     FIELD gA2dpCmd_WriteA2dpCfg_ChannelMode                    (Fixed 1 Byte) (TABLE tA2dpChannelModeType) "Channel Mode"
     FIELD gA2dpCmd_WriteA2dpCfg_TTP_Offset                     (Fixed 2 Byte) (Decimal)  "TTP Offset"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_LOSC                 (Fixed 1 Byte) (Hex) "LOSC"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_MediaType            (Fixed 1 Byte) (Hex) "Media type"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec                (Fixed 1 Byte) (Hex) "Codec"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_SampleRate           (Fixed 4 Bits) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tSBCSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_ChanMode             (Fixed 4 Bits) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0x0F) (TABLE tSBCChannelMode) "ChannelMode"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_BlkLen               (Fixed 4 Bits) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0x0F) (TABLE tSBCBlockLength) "BlockLength"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_Subband              (Fixed 4 Bits) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0x0C) (TABLE tSBCSubband) "Subband"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_MinBitpool           (Fixed 1 Byte) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Decimal) "Minimum Bitpool"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_MaxBitpool           (Fixed 1 Byte) IF (Fieldis Equalto 0 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Decimal) "Maximum Bitpool"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACObjectType        (Fixed 4 Bits)  IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0x0F) (TABLE tAACObjectType) "ObjectType"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACreserved          (Fixed 4 Bits)  IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Hex) SUPPRESS_DETAIL
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACInfo              (Fixed 2 Bytes) IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Hex) SUPPRESS_DETAIL
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACSampleRate        (Fixed 0) IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (StoreField gA2dpCmd_WriteA2dpCfg_CodecInfo_AACInfo) ALSO (AndMask 0xF0FF) (TABLE tAACSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACChanMode          (Fixed 0) IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (StoreField gA2dpCmd_WriteA2dpCfg_CodecInfo_AACInfo) ALSO (AndMask 0x0F00) ALSO (ShiftRight 8) (TABLE tAACChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_VendorId             (Fixed 4 Byte) IF (Fieldis Equalto 0xFF gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Hex) "NonA2DP_CodecType Vendor Id"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_CodecId              (Fixed 2 Byte) IF (Fieldis Equalto 0xFF gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) (Hex) "NonA2DP_CodecType Codec Id"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxClassicSampleRate   (Fixed 4 Bits) IF (Fieldis Equalto 0x08 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tAptxClassicSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxClassicChanMode     (Fixed 4 Bits) IF (Fieldis Equalto 0x08 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) (TABLE tAptxClassicChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxHDSampleRate        (Fixed 4 Bits) IF (Fieldis Equalto 0x09 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tAptxHDSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxHDChanMode          (Fixed 4 Bits) IF (Fieldis Equalto 0x09 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) (TABLE tAptxHDChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxAdaptiveSampleRate  (Fixed 1 Byte) IF (Fieldis Equalto 0x0A gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0xFF) (TABLE tAptxAdaptiveSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxAdaptiveChanMode    (Fixed 1 Byte) IF (Fieldis Equalto 0x0A gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0xFF) (TABLE tAptxAdaptiveChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxTWSSampleRate        (Fixed 4 Bits) IF (Fieldis Equalto 0x0B gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tAptxTWSSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AptxTWSChanMode          (Fixed 4 Bits) IF (Fieldis Equalto 0x0B gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0x0F) (TABLE tAptxTWSChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_LDACSampleRate          (Fixed 1 Byte) IF (Fieldis Equalto 0x04 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0xFF) (TABLE tLDACSampleRate) "SampleRate"
     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_LDACChanMode            (Fixed 1 Byte) IF (Fieldis Equalto 0x04 gA2dpCmd_WriteA2dpCfg_Codec) RETRIEVE (AndMask 0xFF) (TABLE tLDACChannelMode) "ChannelMode"

     FIELD gA2dpCmd_WriteA2dpCfg_CodecInfo_AACVBRInfo              (Fixed 1 Bytes) IF (Fieldis Equalto 2 gA2dpCmd_WriteA2dpCfg_CodecInfo_Codec) RETRIEVE (AndMask 0xF0) (TABLE tA2dpAACVBR) "VBR"
     FIELD gA2dpCmd_WriteA2dpCfg_1 (toendoflayer) IF(MoreBytes) (stringofhex)   "This is unparsed data"
}


