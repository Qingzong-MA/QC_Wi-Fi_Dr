          <ELEMENTS Name="FEM_4" Default="0x0" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_2G_CH1_0T7, bit mask 0xF" />
          <ELEMENTS Name="FEM_5" Default="0x66400000" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_2G_CH0_8T15, , bit mask 0xFFF00000" />
          <ELEMENTS Name="FEM_6" Default="0x2A75116" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_2G_CH0_16T23, , bit mask 0xFFFFFFFF" />
          <ELEMENTS Name="FEM_7" Default="0x66400000" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_2G_CH1_8T15, bit mask 0xFFF00000" />
          <ELEMENTS Name="FEM_8" Default="0x2A75116" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_2G_CH1_16T23, , bit mask 0xFFFFFFFF" />
          <ELEMENTS Name="FEM_9" Default="0x154" Description="Writes to AON_XFEM_CFG_XFEM_CTRL_BT_CH0" />
        </ELEMENTS>
