From 82d63533fe0808dca2a2b50c898321baf22768b9 Mon Sep 17 00:00:00 2001
From: "nano.wang" <nano.wang@quectel.com>
Date: Fri, 25 Apr 2025 14:44:07 +0800
Subject: [PATCH 1/7] cfg80211: Use new wiphy flag WIPHY_FLAG_DFS_OFFLOAD

Change-Id: I344b63920a40235f6e8a1c1b4a1497b661dc1708
---
 kernel-5.10/include/net/cfg80211.h | 2 ++
 kernel-5.10/net/wireless/chan.c    | 6 ++++--
 kernel-5.10/net/wireless/nl80211.c | 3 +++
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/kernel-5.10/include/net/cfg80211.h b/kernel-5.10/include/net/cfg80211.h
index bb86217d85..1d1530a123 100644
--- a/kernel-5.10/include/net/cfg80211.h
+++ b/kernel-5.10/include/net/cfg80211.h
@@ -4353,6 +4353,7 @@ struct cfg80211_ops {
  * @WIPHY_FLAG_HAS_STATIC_WEP: The device supports static WEP key installation
  *	before connection.
  * @WIPHY_FLAG_SUPPORTS_EXT_KEK_KCK: The device supports bigger kek and kck keys
+ * @WIPHY_FLAG_DFS_OFFLOAD: The driver handles all the DFS related operations.
  */
 enum wiphy_flags {
 	WIPHY_FLAG_SUPPORTS_EXT_KEK_KCK		= BIT(0),
@@ -4379,6 +4380,7 @@ enum wiphy_flags {
 	WIPHY_FLAG_SUPPORTS_5_10_MHZ		= BIT(22),
 	WIPHY_FLAG_HAS_CHANNEL_SWITCH		= BIT(23),
 	WIPHY_FLAG_HAS_STATIC_WEP		= BIT(24),
+	WIPHY_FLAG_DFS_OFFLOAD          = BIT(25),
 };
 
 /**
diff --git a/kernel-5.10/net/wireless/chan.c b/kernel-5.10/net/wireless/chan.c
index 22d1779ab2..b6552b23c5 100644
--- a/kernel-5.10/net/wireless/chan.c
+++ b/kernel-5.10/net/wireless/chan.c
@@ -479,7 +479,8 @@ static int cfg80211_get_chans_dfs_required(struct wiphy *wiphy,
 		if (!c)
 			return -EINVAL;
 
-		if (c->flags & IEEE80211_CHAN_RADAR)
+		if ((c->flags & IEEE80211_CHAN_RADAR) &&
+			!(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD))
 			return 1;
 	}
 	return 0;
@@ -760,7 +761,8 @@ static bool cfg80211_get_chans_dfs_available(struct wiphy *wiphy,
 		if (c->flags & IEEE80211_CHAN_DISABLED)
 			return false;
 
-		if ((c->flags & IEEE80211_CHAN_RADAR) &&
+		if (!(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD) &&
+			(c->flags & IEEE80211_CHAN_RADAR) &&
 		    (c->dfs_state != NL80211_DFS_AVAILABLE) &&
 		    !(c->dfs_state == NL80211_DFS_USABLE && dfs_offload))
 			return false;
diff --git a/kernel-5.10/net/wireless/nl80211.c b/kernel-5.10/net/wireless/nl80211.c
index 5d8959a5e7..5e850e02f3 100644
--- a/kernel-5.10/net/wireless/nl80211.c
+++ b/kernel-5.10/net/wireless/nl80211.c
@@ -8889,6 +8889,9 @@ static int nl80211_start_radar_detection(struct sk_buff *skb,
 	if (err)
 		return err;
 
+	if (rdev->wiphy.flags & WIPHY_FLAG_DFS_OFFLOAD)
+		return -EOPNOTSUPP;
+
 	if (netif_carrier_ok(dev))
 		return -EBUSY;
 
-- 
2.17.1

