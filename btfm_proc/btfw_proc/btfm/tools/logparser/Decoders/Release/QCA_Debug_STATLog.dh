GROUP gQca_STAT_LEActiveConnStats_ULM "LE Active Connection Stats ULM"
{
    GROUP gQca_STAT_LEPktStatsTx_ULM;
    GROUP gQca_STAT_LEPktStatsRx_ULM;
    GROUP gQca_STAT_LEConnStats_ULM;
    FIELD fQca_ULEActiveConnBBStat  (Fixed 4 Bytes)      (Hex)           "BBStats"

    FIELD fQca_ULEActiveConnBBStat_parse1  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 0)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_1"
    FIELD fQca_ULEActiveConnBBStat_parse2  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 4)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_2"
    FIELD fQca_ULEActiveConnBBStat_parse3  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 8)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_3"
    FIELD fQca_ULEActiveConnBBStat_parse4  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 12) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_4"
    FIELD fQca_ULEActiveConnBBStat_parse5  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 16) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_5"
    FIELD fQca_ULEActiveConnBBStat_parse6  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 20) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_6"
    FIELD fQca_ULEActiveConnBBStat_parse7  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 24) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_7"
    FIELD fQca_ULEActiveConnBBStat_parse8  (Fixed 0)  RETRIEVE (StoreField fQca_ULEActiveConnBBStat) ALSO (ShiftRight 28) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_8"

    FIELD fQca_ULECoexNormalPriorityClk       (Fixed 4 Bytes)      PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)                     "CoexNormalPriorityClk"
    FIELD fQca_ULECoexCriticalPriorityClk     (Fixed 4 Bytes)      PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)                     "CoexCriticalPriorityClk"
    FIELD fQca_ULECurrEventCounter            (Fixed 2 Bytes)      (Decimal)                       "CurrEventCounter"
    FIELD fQca_ULELastSuccessEvent            (Fixed 2 Bytes)      (Decimal)                       "LastSuccessEvent"
    FIELD fQca_ULECurrCoexPriority            (Fixed 1 Byte)       PRINT_IF (FieldIs NotEqualTo 0xFF) (TABLE tQca_COEX_STATE)         "CurrCoexPriority"
    FIELD fQca_ULELastRSSIdBm                 (Fixed 1 Byte)       RETRIEVE (SignExtension 8)         (Decimal)                        "LastRSSIdBm"
    RESERVED                                  (Fixed 2 Bytes)
}

