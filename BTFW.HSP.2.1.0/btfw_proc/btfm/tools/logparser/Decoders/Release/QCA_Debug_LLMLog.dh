    {0x020A "LOG_ID_LLM_LP_MODE_STATUS"     "LOG_ID_LLM_LP_MODE_STATUS"     0   gQca_DefaultPrint}
    {0x020B "LOG_ID_LLM_RMCDCMD"            "llm_rmcdCommand.c"             0   gQca_DefaultPrint}
    {0x020C "LOG_ID_LLM_SET_REP_ATTEMPTS"   "LOG_ID_LLM_SET_REP_ATTEMPTS"   0   gQca_LLM_AuthenRetry}
    {0x020D "LOG_ID_LLM_UPDATE_REP_ATTEMPTS" "LOG_ID_LLM_UPDATE_REP_ATTEMPTS" 0   gQca_LLM_AuthenRetry}
