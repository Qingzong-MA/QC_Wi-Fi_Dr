    <TAG Number="249" Name="Dedicated chain configuration">
      <DESCRIPTION>All the configurations that are used while using dedicated chain and antenna for Tx and Rx.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Dedicated chain configuration" Type="STRUCTURE" Size="12">
        <ELEMENTS Name="all_PL_offset_0p25dB" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0x0" Signed="true" Description="When dedicated chain is used for Tx, a constant offset (mostly back-off) is applied to each PL when compared to shared chain usage." />
        <ELEMENTS Name="max_PL" Type="INTEGER" Size="1" Min="0x0" Max="0xA" Default="0xA" Signed="false" Description="The max power level value to be used in dedicated chain configuration." />
        <ELEMENTS Name="SoftAGC_TestMode_Enable" Type="INTEGER" Size="1" Min="0x0" Max="0x1" Default="0x0" Signed="false" Description="identify test mode enable/disable softAGC logic on dedicate antenna" />
        <ELEMENTS Name="SoftAGC_RSSI_Threshold" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0xA4" Signed="true" Description="Tunning threshold under FTM add WLAN 15dBm interfernece and 25dB isolation" />
        <ELEMENTS Name="FEM_SWITCHING_PIO" Type="STRUCTURE" Size="4">
          <ELEMENTS Name="PIO_NUM" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFF" Signed="false" Description="PIO number used for FEM Switching. This is set to 0xff to indicate that this entry is invalid." />
          <ELEMENTS Name="GPIO_ACTIVE_STATE" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="0 - Active HIGH (GPIO is toggled from LOW to HIGH to deactivate the FEM). 1 - Active LOW (GPIO is toggled from HIGH to LOW, to deactivate the FEM)" />
          <ELEMENTS Name="PIO_BLOCK" Type="ENUM" Size="1" Default="0x0" Signed="false">
            <ELEMENTS Name="XFEM_PIN" Default="0x0" Description="XFEM pins are used to control dedicated antenna switch." />
            <ELEMENTS Name="GPIO" Default="0x1" Description="GPIOs are used to control dedicated antenna switch." />
          </ELEMENTS>
          <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        </ELEMENTS>
        <ELEMENTS Name="DPD_ENABLE" Type="INTEGER" Size="1" Min="0x0" Max="0x1" Default="0x0" Signed="false" Description="0 to Disable the DPD in 1x1 Mode. 1 to Enable the DPD in 1x1 Mode" />
        <ELEMENTS Name="LPRX_ENABLE" Type="INTEGER" Size="1" Min="0x0" Max="0x1" Default="0x1" Signed="false" Description="0 to Disable the LPRX  in 1x1 Mode. 1 to Enable the LPRX  in 1x1 Mode" />
        <ELEMENTS Name="FEATURE_ENABLE" Type="BITFIELD" Size="1">
          <ELEMENTS Name="DLL" Default="0xF" Start="0" End="3" Description="Enable background Inquiry Scan, page scan, LE adv scan, channel assess. Individual bits are identified as per tag 225 defined for DLL enablers." />
        </ELEMENTS>
        <ELEMENTS Name="GOLDEN_RANGE_OFFSET" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x14" Signed="false" Description="DBAM mode, BT need increase golden range to ask remote increase power" />
      </ELEMENTS>
