          <ELEMENTS Name="Neg_3" Default="0x0" Start="2" End="2" Description="" />
          <ELEMENTS Name="Neg_4" Default="0x0" Start="3" End="3" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="Starting Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x9" Signed="false" Description="" />
        <ELEMENTS Name="GFSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="" />
        <ELEMENTS Name="DQPSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="This value is used to report the DQPSK Max Power Status." />
        <ELEMENTS Name="8DPSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="This value is used to report the 8DPSK Max Power Status." />
        <ELEMENTS Name="DQPSK Min Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x0" Signed="false" Description="This value is used to report the DQPSK Min Power Status." />
        <ELEMENTS Name="8DPSK Min Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x0" Signed="false" Description="This value is used to report the 8DPSK Min Power Status." />
        <ELEMENTS Name="Broadcast Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x9" Signed="false" Description="" />
        <ELEMENTS Name="Class 2 Fallback Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x8" Signed="false" Description="" />
        <ELEMENTS Name="Power Class" Type="ENUM" Size="1" Default="0x1" Signed="false">
          <ELEMENTS Name="Class_1" Default="0x1" Description="Power Class 1" />
          <ELEMENTS Name="Class_2" Default="0x2" Description="Power Class 2" />
          <ELEMENTS Name="Class_3" Default="0x3" Description="Power Class 3" />
          <ELEMENTS Name="Class_1_5" Default="0x4" Description="Power Class 1.5" />
        </ELEMENTS>
        <ELEMENTS Name="Platform Power Fine Adjust BR" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="This value is used for fine adjusting POUT for BR. Step size is selected between 1db and 0.25db." />
        <ELEMENTS Name="Platform Power Fine Adjust EDR" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="This value is used for fine adjusting POUT for EDR. Step size is selected between 1db and 0.25db." />
        <ELEMENTS Name="Platform Power Fine Adjust BLE" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="his value is used for fine adjusting POUT for BLE. Step size is selected between 1db and 0.25db." />
        <ELEMENTS Name="Platform Power Fine Adjust HS" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="his value is used for fine adjusting POUT for HS. Step size is selected between 1db and 0.25db." />
        <ELEMENTS Name="RF power adjust" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="RF attenuation, range 0 to 2dB in 0.25dB steps. Unsigned number." />
        <ELEMENTS Name="Flags" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LimitMaxPowerNonAFHTestMode" Default="0x0" Start="0" End="0" Description="value '1' of the bit will ensure that maximum power level for remote nonAFH device is SDB_PWR_INDEX_MAX_NO_AFH in DUT" />
          <ELEMENTS Name="BIT1_RESERVED" Default="0x0" Start="1" End="1" Description="not used in this project" />
          <ELEMENTS Name="CLASS_2_FALLBACK_DYNAMIC_POWER_CONTROL" Default="0x1" Start="2" End="2" Description="If Remote doesn't support power control feature, then DUT's power level can be controlled based on remote avgRSSI value" />
          <ELEMENTS Name="FEM override enable" Default="0x0" Start="3" End="3" Description="Enable FEM overrides 0 1 2 and 3" />
          <ELEMENTS Name="HIGH POWER ADAPTIVE CONTROL" Default="0x0" Start="5" End="5" Description="Select between 1db and 0.25db steps for platform power fine adjust. 1 = 0.25db, 0 = 1db." />
        </ELEMENTS>
        <ELEMENTS Name="Non AFH Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x8" Signed="false" Description="For non-AFH device, maximum allowed power level. This should not be more than Max. AFH Power Level. 0 means no specific restriction for  non-AFH. For ETSI compliant, this value should be 8." />
        <ELEMENTS Name="IPA_MAX_POWER_LEVEL" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xA" Signed="false" Description="Max Power Level that just use BT interval PA (Normally xPA shared with WLAN)" />
        <ELEMENTS Name="FEM overrides" Type="FIXED_ARRAY" ElementSize="4" Size="40" Min="0x0" Max="0xFFFFFFFF" Signed="false" Description="Writes to AON_XFEM_CFG_XFEM_BT" VariableName="FEM">
