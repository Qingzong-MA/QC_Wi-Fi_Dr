    {0x0238 "LOG_ID_LLM_LE_AFH_ASSESSMENT"  "LOG_ID_LLM_LE_AFH_ASSESSMENT"  0   gQca_LLM_LE_AFHEvalInfo }
    {0x0239 "LOG_ID_LLM_PAST_INVALID_HANDLE" "LOG_ID_LLM_PAST_INVALID_HANDLE" 0 gQca_LLM_PAST_invalidHandle }
    {0x023A "LOG_ID_LLM_RTSC_BUFF_STATUS"   "LOG_ID_LLM_RTSC_BUFF_STATUS"  0 gQca_LLM_RtscBuffStatus }
