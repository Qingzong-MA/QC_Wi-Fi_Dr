// Decode LMP
GROUP gProcessLmp_QCA IF (IntraframeStaticExists QCA_LMP_FLAG)
{
    // This group is defined Teledyne's Wireless Protocol Suite decoders
    GROUP gDecodeLMP;
}

FIELD fQca_EnqTS (Fixed 4 Bytes) IF(MoreBytes) (Hex) "EnQ TimeStamp"