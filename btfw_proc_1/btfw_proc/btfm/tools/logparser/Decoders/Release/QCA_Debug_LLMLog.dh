    FIELD fQca_PConv_Save_PT       (Fixed 1 Byte)   (Hex) "PT (BIG only)"
}

GROUP gQca_LLM_PConv_Restore "PConv_Restore"
{
    FIELD fQca_PConv_Restore_IsoInt   (Fixed 2 Byte)   (Hex) "Iso Interval (in frame)"
