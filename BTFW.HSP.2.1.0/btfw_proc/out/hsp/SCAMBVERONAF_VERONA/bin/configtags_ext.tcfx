            <ELEMENTS Name="FINE_GAIN_SETTING" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0xFFFF" Signed="false" Description="LUT[XLNA_SETTING, SLNA_SETTING, GM_SETTING, TIA_SETTING]" />
