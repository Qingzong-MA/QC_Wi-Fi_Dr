TABLE tQca_Pool_Section
    {0 "low heap"}
    {1 "Upper heap"}
    {2 "NVM section"}
    {Default "Undefined Section"}
ENDTABLE

GROUP gQca_PFAL_MemPoolAllocFail "FMB Pool Alloc Fail"
{
    FIELD fQca_PFAL_POOL_ID             (Fixed 4 Bytes)      (Hex)                              "current pool"
    FIELD fQca_PFAL_POOL_returnAddress  (Fixed 4 Bytes)      (Hex)                              "return address"
    FIELD fQca_PFAL_POOL_SECTION        (Fixed 2 Bytes)      (TABLE tQca_Pool_Section)          "pool section"
    FIELD fQca_PFAL_POOL_COUNT          (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Hex)       "pool count"

    GROUP gQCA_FmbPoolDbgINFO IF (FieldIs NotEqualTo 0 fQca_PFAL_POOL_COUNT)
    {
        /* Init the Counter to 0 */
        FIELD fQca_PFAL_PoolCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE PoolCntr

        /* Loop through the end of the frame to capture all the generic pool info Packets in the Frame */
        GROUP gQCA_GMENPoolInfos IF (FieldIs EqualTo 1 fQca_PFAL_POOL_SECTION)
        {
            /* Init the Counter to 0 */
            FIELD fQca_PFAL_GmenPoolCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE GmenPoolCntr

            GROUP gQCA_PFAL_GmenPoolInfo REPEAT COUNT (Fixed 16 times)
            {
                GROUP gQCA_PFAL_GMENPool LABEL(LabelCount "Genric Pool #" GmenPoolCntr )
                {
                    FIELD fQca_PFAL_GMENPOOL_nFree          (Fixed 1 Byte)      (Hex)            "nFree"
                    FIELD fQca_PFAL_GMENPOOL_nReserved      (Fixed 1 Byte)      (Hex)            "nReserved"
                    FIELD fQca_PFAL_GMENPOOL_nFailed        (Fixed 1 Byte)      (Hex)            "nFailed"
                    FIELD fQca_PFAL_GMENPOOL_nWatermark     (Fixed 1 Byte)      (Hex)            "nWatermark"
                }
                /* Increment the Counter */
                FIELD fQca_PFAL_GmenPoolCntrIncr (Fixed 0) RETRIEVE (StoreField GmenPoolCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE GmenPoolCntr
            }
}

        GROUP gQCA_PFAL_PoolInfos REPEAT SIZE (ToEndOfLayer)
        {
            GROUP gQCA_PoolInfo LABEL(LabelCount "Static Pool #" poolCntr )
            {
                FIELD fQca_PFAL_POOL_nFree          (Fixed 1 Byte)      (Hex)            "nFree"
                FIELD fQca_PFAL_POOL_nReserved      (Fixed 1 Byte)      (Hex)            "nReserved"
                FIELD fQca_PFAL_POOL_nFailed        (Fixed 1 Byte)      (Hex)            "nFailed"
                FIELD fQca_PFAL_POOL_nWatermark     (Fixed 1 Byte)      (Hex)            "nWatermark"
            }
            /* Increment the Counter */
            FIELD fQca_PFAL_PoolCntrIncr (Fixed 0) RETRIEVE (StoreField PoolCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE PoolCntr
        }
    }
}

