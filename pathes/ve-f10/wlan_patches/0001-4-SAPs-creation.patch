 .../inc/wlan_policy_mgr_public_struct.h       |  4 +++
 .../policy_mgr/src/wlan_policy_mgr_pcl.c      | 28 ++++++++++++++++++-
 .../src/wlan_policy_mgr_tables_2x2_dbs_i.h    | 11 ++++++++
 .../qcacld-3.0/configs/default_defconfig      |  5 ++++
 .../qcacld-3.0/core/hdd/inc/hdd_config.h      |  4 +--
 .../core/mac/inc/wlan_tgt_def_config.h        |  2 ++
 .../qcacld-3.0/core/wma/src/wma_main.c        | 15 +++++-----
 8 files changed, 61 insertions(+), 12 deletions(-)

