    FIELD gQca_LLM_AfhStateChangeInfoConnHandle     (Fixed 2 Bytes)   (Hex)                     "Connection Handle"
    FIELD gQca_LLM_AfhStateChangeInfoCurrState      (Fixed 1 Bytes)   (TABLE tQca_AFH_State)    "currState"
    FIELD gQca_LLM_AfhStateChangeInfoNewState       (Fixed 1 Bytes)   (TABLE tQca_AFH_State)    "newState"
    FIELD gQca_LLM_AfhStateChangeInfoMode           (Fixed 1 Bytes)   (TABLE tQca_AFH_Mode)     "Mode"
    FIELD gQca_LLM_AfhStateChangeInfoContext        (Fixed 1 Bytes)   (TABLE tQca_AFH_Context)  "Context"
}

GROUP gQca_LLM_AfhEventInfo "AFH Event Info"
{
    FIELD gQca_LLM_AfhEventInfoConnHandle     (Fixed 4 Bytes)   (Hex)                     "Connection Handle"
    FIELD gQca_LLM_AfhEventInfoState          (Fixed 4 Bytes)   (TABLE tQca_AFH_State)    "State"
    FIELD gQca_LLM_AfhEventInfoMode           (Fixed 4 Bytes)   (TABLE tQca_AFH_Mode)     "Mode"
