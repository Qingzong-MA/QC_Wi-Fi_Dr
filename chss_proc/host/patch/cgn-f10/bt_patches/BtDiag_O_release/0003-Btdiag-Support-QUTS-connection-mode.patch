 hciattach_rome.h |  4 ++++
 privateMembers.c | 71 ++++++++++++++++++++++++++++++++++++++++++++++++--------
 privateMembers.h | 10 +++++++-
 uart.h           |  6 +++++
 9 files changed, 110 insertions(+), 23 deletions(-)

diff --git a/Btdiag.c b/Btdiag.c
index 156c7568a8cf..c0416788456a 100755
