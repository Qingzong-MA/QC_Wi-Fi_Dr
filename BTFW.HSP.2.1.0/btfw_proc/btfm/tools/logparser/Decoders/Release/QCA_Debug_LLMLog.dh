    {0x0213 "LOG_ID_LLM_POWER_LEVEL"        "LOG_ID_LLM_POWER_LEVEL"        0   gQca_LLM_LMPowerLevelInfo}
    {0x0214 "LOG_ID_LLM_FORCE_2PAGE"        "LOG_ID_LLM_FORCE_2PAGE"        0   gQca_LLM_Force_2PageInfo}
    {0x0215 "LOG_ID_LLM_PSCAN_INFO"         "LOG_ID_LLM_PSCAN_INFO"         0   gQca_LLM_PscanInfo}
    {0x0216 "LOG_ID_LLM_AFH_RSSIDATA"       "LOG_ID_LLM_AFH_RSSIDATA"       0   gQca_LLM_AFHRssiData}
