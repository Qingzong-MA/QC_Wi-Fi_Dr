Subject: [PATCH 4/7] cfg80211: Add macros to indicate backport support for
 FILS

Change-Id: Id9c52fce15c82b5abd2bb73de0df643a69ef8449
---
 kernel-5.10/include/net/cfg80211.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/kernel-5.10/include/net/cfg80211.h b/kernel-5.10/include/net/cfg80211.h
index 0a6f05e88c..bbcb4e44ec 100644
--- a/kernel-5.10/include/net/cfg80211.h
+++ b/kernel-5.10/include/net/cfg80211.h
@@ -60,6 +60,13 @@
  * structures here describe these capabilities in detail.
  */
 
+/* Indicate backport support for the new connect done api */
+#define CFG80211_CONNECT_DONE 1
+/* Indicate backport support for FILS SK offload in cfg80211 */
+#define CFG80211_FILS_SK_OFFLOAD_SUPPORT 1
+/* Indicate support for new cfg80211_connect_bss api */
+#define CFG80211_CONNECT_BSS 1
+
 struct wiphy;
 
