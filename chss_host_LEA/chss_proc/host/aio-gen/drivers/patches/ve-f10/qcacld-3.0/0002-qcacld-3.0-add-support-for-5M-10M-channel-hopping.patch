From 5eed743f7237d0c56e4583d3ab7bac7272662a04 Mon Sep 17 00:00:00 2001
From: Yu Wang <quic_yyuwang@quicinc.com>
Date: Thu, 21 Mar 2024 18:26:01 +0800
Subject: [PATCH] qcacld-3.0: add support for 5M/10M channel hopping

5M/10M channel hopping is triggered by DCS WLAN_IM.

Change-Id: Ia5d6e6b15f97539cd4848c20b0b47fd50771e069
Signed-off-by: Yu Wang <quic_yyuwang@quicinc.com>
---
 core/hdd/src/wlan_hdd_dcs.c | 225 ++++++++++++++++++++++++++++++++++++
 core/wma/src/wma_dev_if.c   |  17 +--
 2 files changed, 235 insertions(+), 7 deletions(-)

diff --git a/core/hdd/src/wlan_hdd_dcs.c b/core/hdd/src/wlan_hdd_dcs.c
index e121f7ba95..a9574b907d 100644
--- a/core/hdd/src/wlan_hdd_dcs.c
+++ b/core/hdd/src/wlan_hdd_dcs.c
@@ -25,6 +25,224 @@
 #include <wlan_hdd_dcs.h>
 #include <wlan_hdd_includes.h>
 #include <wlan_dcs_ucfg_api.h>
+
+#ifdef WLAN_POLICY_MGR_ENABLE
+/**
+ * wlan_dcs_get_pcl_for_sap() - get preferred channel list for SAP
+ * @vdev: vdev ptr
+ * @cur_freq: center freq of the current operation channel
+ * @freq_list: Pointer to PCL
+ * @freq_list_sz: Max size of PCL
+ * @next_freq: to return the next freq of the current operation
+ * channel in PCL
+ *
+ * Return: number of channels in PCL(exclude the current operation channel)
+ */
+static uint32_t hdd_dcs_get_pcl_for_sap(struct wlan_objmgr_vdev *vdev,
+					qdf_freq_t cur_freq,
+					qdf_freq_t *freq_list,
+					uint32_t freq_list_sz,
+					qdf_freq_t *next_freq)
+{
+	struct wlan_objmgr_psoc *psoc;
+	struct wlan_objmgr_pdev *pdev;
+	struct policy_mgr_pcl_list *pcl;
+	qdf_freq_t freq;
+	enum channel_state state;
+	QDF_STATUS status;
+	int i, j, idx_of_cur = 0;
+	uint32_t weight_len;
+
+	psoc = wlan_vdev_get_psoc(vdev);
+	if (!psoc)
+		return 0;
+
+	pdev = wlan_vdev_get_pdev(vdev);
+	if (!pdev)
+		return 0;
+
+	pcl = qdf_mem_malloc(sizeof(*pcl));
+	if (!pcl)
+		return 0;
+
+	weight_len = QDF_ARRAY_SIZE(pcl->weight_list);
+	status = policy_mgr_get_pcl_for_vdev_id(psoc, PM_SAP_MODE,
+						pcl->pcl_list,
+						&pcl->pcl_len,
+						pcl->weight_list,
+						weight_len,
+						wlan_vdev_get_id(vdev));
+	if (QDF_IS_STATUS_ERROR(status) || !pcl->pcl_len) {
+		qdf_mem_free(pcl);
+		return 0;
+	}
+
+	for (i = 0, j = 0; i < pcl->pcl_len && i < freq_list_sz; i++) {
+		freq = (qdf_freq_t)pcl->pcl_list[i];
+		/**
+		 * skip the current freq and record the index to
+		 * indicate the next freq.
+		 */
+		if (freq == cur_freq) {
+			idx_of_cur = j;
+			continue;
+		}
+
+		state = wlan_reg_get_channel_state_for_freq(pdev, freq);
+		if (state != CHANNEL_STATE_ENABLE ||
+		    !WLAN_REG_IS_SAME_BAND_FREQS(freq, cur_freq))
+			continue;
+
+		freq_list[j++] = freq;
+	}
+
+	/**
+	 * if current freq is in the cur list and not the last one,
+	 * pick the next one of the current freq; otherwise, pick the
+	 * first one in the list.
+	 */
+	if (idx_of_cur >= j)
+		idx_of_cur = 0;
+
+	*next_freq = freq_list[idx_of_cur];
+
+	qdf_mem_free(pcl);
+	return j;
+}
+#else /* WLAN_POLICY_MGR_ENABLE */
+static uint32_t hdd_dcs_get_pcl_for_sap(struct wlan_objmgr_vdev *vdev,
+					qdf_freq_t cur_freq,
+					qdf_freq_t *freq_list,
+					uint32_t freq_list_sz,
+					qdf_freq_t *next_freq)
+{
+	struct wlan_objmgr_pdev *pdev;
+	struct regulatory_channel *cur_chan_list;
+	qdf_freq_t freq;
+	enum channel_state state;
+	uint8_t band_mask;
+	int i, j, idx_of_cur = 0;
+	uint16_t cur_chan_num;
+
+	pdev = wlan_vdev_get_pdev(vdev);
+	if (!pdev)
+		return 0;
+
+	if (WLAN_REG_IS_24GHZ_CH_FREQ(cur_freq))
+		band_mask = BIT(REG_BAND_2G);
+	else if (WLAN_REG_IS_5GHZ_CH_FREQ(cur_freq))
+		band_mask = BIT(REG_BAND_5G);
+	else if (WLAN_REG_IS_6GHZ_CHAN_FREQ(cur_freq))
+		band_mask = BIT(REG_BAND_6G);
+	else {
+		hdd_err("invalid cur freq: %u", cur_freq);
+		return 0;
+	}
+
+	cur_chan_list = qdf_mem_malloc(NUM_CHANNELS *
+				       sizeof(struct regulatory_channel));
+	if (!cur_chan_list)
+		return 0;
+
+	cur_chan_num = wlan_reg_get_band_channel_list(pdev, band_mask,
+						      cur_chan_list);
+	if (!cur_chan_num) {
+		hdd_err("no channel for the band mask: 0x%x", band_mask);
+		qdf_mem_free(cur_chan_list);
+		return 0;
+	}
+
+	for (i = 0, j = 0; i < cur_chan_num && i < freq_list_sz; i++) {
+		freq = cur_chan_list[i].center_freq;
+		if (freq == cur_freq) {
+			idx_of_cur = j;
+			continue;
+		}
+
+		state = wlan_reg_get_channel_state_for_freq(pdev, freq);
+		if (state != CHANNEL_STATE_ENABLE)
+			continue;
+
+		freq_list[j++] = freq;
+	}
+
+	/**
+	 * if current freq is in the cur list and not the last one,
+	 * pick the next one of the current freq; otherwise, pick the
+	 * first one in the list.
+	 */
+	if (idx_of_cur >= j)
+		idx_of_cur = 0;
+
+	*next_freq = freq_list[idx_of_cur];
+
+	qdf_mem_free(cur_chan_list);
+	return j;
+}
+#endif /* WLAN_POLICY_MGR_ENABLE */
+
+/**
+ * hdd_dcs_blind_ch_hopping() - try blind channel hopping
+ * @adapter: pointer to hdd adapter
+ * @mac_id: mac id
+ * @random: hop to a random channel or just the next
+ *
+ * Return: QDF_STATUS_E_ABORTED if blind channel hopping is not enabled,
+ *         QDF_STATUS_SUCCESS otherwise.
+ */
+static QDF_STATUS
+hdd_dcs_blind_ch_hopping(struct hdd_adapter *adapter,
+			 uint8_t mac_id, bool random)
+{
+	qdf_freq_t *freq_list = NULL;
+	uint16_t freq_num;
+	struct wlan_objmgr_vdev *vdev;
+	qdf_freq_t cur_freq, selected_freq = 0;
+	uint32_t random_chan_idx;
+
+	if (!cds_is_sub_20_mhz_enabled()) {
+		hdd_debug("Only support 5M/10M so far");
+		return QDF_STATUS_E_ABORTED;
+	}
+
+	vdev = adapter->vdev;
+	wlan_objmgr_vdev_get_ref(vdev, WLAN_HDD_ID_OBJ_MGR);
+	cur_freq = wlan_get_operation_chan_freq(vdev);
+	if (!cur_freq) {
+		hdd_err("Can not get cur channel freq");
+		goto out;
+	}
+
+	freq_list = qdf_mem_malloc(sizeof(*freq_list) * NUM_CHANNELS);
+	if (!freq_list)
+		goto out;
+
+	freq_num = hdd_dcs_get_pcl_for_sap(vdev, cur_freq, freq_list,
+					   NUM_CHANNELS, &selected_freq);
+	if (!freq_num) {
+		hdd_err("empty PCL for sap");
+		goto out;
+	}
+
+	if (random) {
+		qdf_get_random_bytes(&random_chan_idx, sizeof(random_chan_idx));
+		random_chan_idx = random_chan_idx % freq_num;
+		selected_freq = freq_list[random_chan_idx];
+	}
+
+out:
+	qdf_mem_free(freq_list);
+	hdd_debug("selected freq[random %d]: %d", random, selected_freq);
+	if (selected_freq)
+		hdd_dcs_hostapd_set_chan(adapter->hdd_ctx,
+					 wlan_vdev_get_id(vdev),
+					 selected_freq);
+
+	ucfg_config_dcs_event_data(adapter->hdd_ctx->psoc, mac_id, true);
+	wlan_objmgr_vdev_release_ref(vdev, WLAN_HDD_ID_OBJ_MGR);
+	return QDF_STATUS_SUCCESS;
+}
+
 /**
  * hdd_dcs_cb() - hdd dcs specific callback
  * @psoc: psoc
@@ -44,6 +262,7 @@ static void hdd_dcs_cb(struct wlan_objmgr_psoc *psoc, uint8_t mac_id,
 	uint32_t count;
 	uint32_t list[MAX_NUMBER_OF_CONC_CONNECTIONS];
 	uint32_t index;
+	QDF_STATUS status;
 
 	/*
 	 * so far CAP_DCS_CWIM interference mitigation is not supported
@@ -72,10 +291,16 @@ static void hdd_dcs_cb(struct wlan_objmgr_psoc *psoc, uint8_t mac_id,
 			return;
 		}
 
+		/* Try blind channel hopping and return if success */
+		status = hdd_dcs_blind_ch_hopping(adapter, mac_id, false);
+		if (QDF_IS_STATUS_SUCCESS(status))
+			return;
+
 		if (wlansap_dcs_is_wlan_interference_mitigation_enabled(
 			WLAN_HDD_GET_SAP_CTX_PTR(adapter))) {
 			hdd_debug("DCS triggers ACS on vdev_id=%u, mac_id=%u",
 				  list[index], mac_id);
+
 			wlan_hdd_cfg80211_start_acs(adapter);
 			return;
 		}
diff --git a/core/wma/src/wma_dev_if.c b/core/wma/src/wma_dev_if.c
index fff83ebdab..f80a03112c 100644
--- a/core/wma/src/wma_dev_if.c
+++ b/core/wma/src/wma_dev_if.c
@@ -1066,26 +1066,29 @@ static void wma_dcs_wlan_interference_mitigation_enable(
 	int vdev_index;
 	uint32_t list[MAX_NUMBER_OF_CONC_CONNECTIONS];
 	uint32_t count;
-	bool wlan_interference_mitigation_enable =
-			mac_ctx->sap.dcs_info.
+	bool wlan_im_enable = mac_ctx->sap.dcs_info.
 			wlan_interference_mitigation_enable[rsp->vdev_id];
 
+	/* WLAN IM is required if 5M/10M channel width is enabled */
+	wlan_im_enable = wlan_im_enable || cds_is_sub_20_mhz_enabled();
+
 	count = policy_mgr_get_sap_go_count_on_mac(
 			mac_ctx->psoc, list, mac_id);
 
-	for (vdev_index = 0; vdev_index < count; vdev_index++) {
+	for (vdev_index = 0; vdev_index < count && !wlan_im_enable;
+	     vdev_index++) {
 		if (mac_ctx->sap.dcs_info.is_vdev_starting[list[vdev_index]]) {
 			wma_err("vdev %d: does not finish restart",
 				 list[vdev_index]);
 			return;
 		}
-		wlan_interference_mitigation_enable =
-			wlan_interference_mitigation_enable ||
-		mac_ctx->sap.dcs_info.
+
+		wlan_im_enable = wlan_im_enable ||
+			mac_ctx->sap.dcs_info.
 			wlan_interference_mitigation_enable[list[vdev_index]];
 	}
 
-	if (wlan_interference_mitigation_enable)
+	if (wlan_im_enable)
 		ucfg_config_dcs_event_data(mac_ctx->psoc, mac_id, true);
 
 	if (rsp->resp_type == WMI_HOST_VDEV_START_RESP_EVENT) {
-- 
2.17.1

