GROUP gQca_GenericShuffledMapParams
{
    FIELD fQca_ArgCntrst  (Fixed 0)   RETRIEVE (StoreInteger 1)   (Hex)   SUPPRESS_DETAIL STORE ArgCntrst
    GROUP gQca_ArgLoopst  REPEAT SIZE (FromField Bytes fQca_Pkt_Len) 
    {
        GROUP gQca_ArgValst LABEL(LabelCount "#P"ArgCntrst)
        {
            FIELD fQca_ArgValst         (Fixed 1 Byte)      (Hex) "Val"
        }
        /* Increment the Counter */
        FIELD fQca_ArgCntrIncrst (Fixed 0) RETRIEVE (StoreField ArgCntrst) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE ArgCntrst
    }
}

