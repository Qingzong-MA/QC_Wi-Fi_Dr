 *                          Decoder for OCF 0x15D                            *
 ******************************************************************************/

GROUP gA2dpOffloadCmd
{
     FIELD gA2dpOffloadCmd_opcode (Fixed 1 byte) (Table tA2dpOffloadSubOpcodes) "SubOpcode"
     BRANCH (FromTable tA2dpOffloadSubOpcodes gA2dpOffloadCmd_opcode)
     FIELD gA2dpOffload_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE tA2dpOffloadSubOpcodes
    {0x01 "HCI_VS_START_A2DP_OFFLOAD" "HCI_VS_START_A2DP_OFFLOAD" 0 gA2dpOffloadCmd_StartA2dpOffload}
    {0x02 "HCI_VS_STOP_A2DP_OFFLOAD" "HCI_VS_STOP_A2DP_OFFLOAD" 0 gA2dpOffloadCmd_StopA2dpOffload}
    {Default "Invalid subOpcode"}
ENDTABLE

TABLE tA2dpOffloadEvtSubOpcodes
    {0x01 "HCI_VS_START_A2DP_OFFLOAD"}
    {0x02 "HCI_VS_STOP_A2DP_OFFLOAD"}
    {Default "Invalid subOpcode"}
ENDTABLE

TABLE tA2dpOffloadCodecType
    {1, "SBC"}
    {2, "AAC"}
    {4, "APT-X"}
    {8, "APT-X HD"}
    {16,"LDAC"}
    {64, "LHDC"}
    {Default "Invalid Codec Type"}
ENDTABLE

TABLE tA2dpOffloadSamplingFreq
    {1, "44100"}
    {2, "48000"}
    {4, "88200"}
    {8, "96000"}
    {Default "Invalid Sampling Rate"}
ENDTABLE

TABLE tA2dpOffloadBitsPerSample
    {1, "16"}
    {2, "24"}
    {4, "32"}
    {Default "Invalid Bits Per sample"}
ENDTABLE

TABLE tA2dpOffloadChannelMode
    {1, "Mono"}
    {2, "Stereo"}
    {Default "Invalid Channel Mode"}
ENDTABLE

TABLE tA2dpAACVBR
    {0x80, "Supported"}
    {0x00, "Not supported"}
ENDTABLE

GROUP gA2dpOffloadCmd_StartA2dpOffload "Start A2DP Offload"
{
     FIELD gA2dpCmd_StartA2dpOffload_Codec                      (Fixed 4 byte) (TABLE tA2dpOffloadCodecType) "Codec"
     FIELD gA2dpCmd_StartA2dpOffload_MaxLatency                 (Fixed 2 byte) (Decimal) "Max Latency"
     FIELD gA2dpCmd_StartA2dpOffload_ScmsT_Enable               (Fixed 2 byte) (Hex) "SCMS_T Enable"
     FIELD gA2dpCmd_StartA2dpOffload_SamplingFreq               (Fixed 4 byte) (TABLE tA2dpOffloadSamplingFreq) "Sampling Freq"
     FIELD gA2dpCmd_StartA2dpOffload_BitsPerSample              (Fixed 1 byte) (TABLE tA2dpOffloadBitsPerSample) "Bits Per Sample"
     FIELD gA2dpCmd_StartA2dpOffload_ChannelMode                (Fixed 1 byte) (TABLE tA2dpOffloadChannelMode) "Channel Mode"
     FIELD gA2dpCmd_StartA2dpOffload_EncAudioBitrate            (Fixed 4 byte) (Hex) "Encoded Audio Bitrate"
     FIELD gA2dpCmd_StartA2dpOffload_HciConnHandle              (Fixed 2 byte) (Decimal) "Hci Conn Handle"
     FIELD gA2dpCmd_StartA2dpOffload_L2capCID                   (Fixed 2 byte) (Decimal) "L2CAP CID"
     FIELD gA2dpCmd_StartA2dpOffload_L2capMTU                   (Fixed 2 byte) (Decimal) "L2CAP MTU"
     FIELD gA2dpCmd_StartA2dpOffload_AACByte1                   (Fixed 1 byte) IF (Fieldis Equalto 2 gA2dpCmd_StartA2dpOffload_Codec) (Hex) SUPPRESS_DETAIL
     FIELD gA2dpCmd_StartA2dpOffload_AACVBRInfo                 (Fixed 1 byte) IF (Fieldis Equalto 2 gA2dpCmd_StartA2dpOffload_Codec) RETRIEVE (AndMask 0xF0) (TABLE tA2dpAACVBR) "VBR"
     FIELD gA2dpCmd_StartA2dpOffload_CodecInfoAAC               (Fixed 30 bytes) IF (Fieldis Equalto 2 gA2dpCmd_StartA2dpOffload_Codec) (Hex) "Codec Info"
     FIELD gA2dpCmd_StartA2dpOffload_CodecInfo                  (Fixed 32 bytes) IF (Fieldis NotEqualto 2 gA2dpCmd_StartA2dpOffload_Codec) (Hex) "Codec Info"
}

