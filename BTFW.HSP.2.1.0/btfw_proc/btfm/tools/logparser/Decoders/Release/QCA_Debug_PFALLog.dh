GROUP  gQca_PFAL_AsdInfo "ASDInfo"
{
    FIELD fQca_PFAL_AsdInfo_asdStatus    (Fixed 1 Byte)   (TABLE tQca_PFAL_AsdInfo_Status)   "ASD Status"
    FIELD fQca_PFAL_AsdInfo_connHandle   (Fixed 1 Byte)   (Hex)   "Conn Handle"
	FIELD fQca_PFAL_AsdInfo_slope0  	 (Fixed 2 Bytes)  (Decimal)   		"skewSlope0"
	FIELD fQca_PFAL_AsdInfo_slope0t		 (Fixed 0 Byte)    RETRIEVE (MultiplyFieldByInteger fQca_PFAL_AsdInfo_slope0 100)(Decimal) SUPPRESS_DETAIL
	FIELD fQca_PFAL_AsdInfo_slope0f 	 (Fixed 0 Byte)    RETRIEVE (DivideFieldByInteger fQca_PFAL_AsdInfo_slope0t 16384) (Decimal)   "skewSlope0(*100)"
	FIELD fQca_PFAL_AsdInfo_slope1  	 (Fixed 2 Bytes)  (Decimal)   		"skewSlope1"
	FIELD fQca_PFAL_AsdInfo_slope1t		 (Fixed 0 Byte)    RETRIEVE (MultiplyFieldByInteger fQca_PFAL_AsdInfo_slope1 100)(Decimal) SUPPRESS_DETAIL
	FIELD fQca_PFAL_AsdInfo_slope1f 	 (Fixed 0 Byte)    RETRIEVE (DivideFieldByInteger fQca_PFAL_AsdInfo_slope1t 16384) (Decimal)   "skewSlope1(*100)"
	FIELD fQca_PFAL_AsdInfo_slope2  	 (Fixed 2 Bytes)  (Decimal)   		"skewSlope2"
	FIELD fQca_PFAL_AsdInfo_slope2t		 (Fixed 0 Byte)    RETRIEVE (MultiplyFieldByInteger fQca_PFAL_AsdInfo_slope2 100)(Decimal) SUPPRESS_DETAIL
	FIELD fQca_PFAL_AsdInfo_slope2f 	 (Fixed 0 Byte)    RETRIEVE (DivideFieldByInteger fQca_PFAL_AsdInfo_slope2t 16384) (Decimal)   "skewSlope2(*100)"
    FIELD fQca_PFAL_AsdInfo_skewInit     (Fixed 1 Byte)   (Hex)   "skewInitiated"
    RESERVED                             (Fixed 1 Bytes)
}

