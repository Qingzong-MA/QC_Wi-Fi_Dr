From 2e4d13cff8274f312c885d830f07c86446c87180 Mon Sep 17 00:00:00 2001
From: "nano.wang" <nano.wang@quectel.com>
Date: Wed, 22 May 2024 13:26:35 +0800
Subject: [PATCH] add judgement of the flag of require_ht in Assoc event

Change-Id: Id72a703f32639da84e024a8f09ff8c6722641016
---
 .../host/AIO/apps/hostap/src/ap/drv_callbacks.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/chss_host_LEA/chss_proc/host/AIO/apps/hostap/src/ap/drv_callbacks.c b/chss_host_LEA/chss_proc/host/AIO/apps/hostap/src/ap/drv_callbacks.c
index ec5abf16..aebc9d80 100644
--- a/chss_host_LEA/chss_proc/host/AIO/apps/hostap/src/ap/drv_callbacks.c
+++ b/chss_host_LEA/chss_proc/host/AIO/apps/hostap/src/ap/drv_callbacks.c
@@ -222,6 +222,23 @@ int hostapd_notif_assoc(struct hostapd_data *hapd, const u8 *addr,
 	}
 	sta->flags &= ~(WLAN_STA_WPS | WLAN_STA_MAYBE_WPS | WLAN_STA_WPS2);
 
+	/*
+	 * If we process the (Re)Associated Request in WLAN driver,
+	 * we can only determine whether it is working in 11N only
+	 * mode in the processing of events reported by the driver.
+	 */
+	if (elems.ht_capabilities) {
+		wpa_printf(MSG_DEBUG, "STA HT Capabilities IE in (Re)AssocReq");
+		sta->flags |= WLAN_STA_HT;
+	}
+
+	if (hapd->iconf->ieee80211n && hapd->iconf->require_ht &&
+			!(sta->flags & WLAN_STA_HT)) {
+		wpa_printf(MSG_DEBUG, "Require HT IE in (Re)AssocReq");
+		reason = WLAN_REASON_INVALID_IE;
+		status = WLAN_STATUS_INVALID_IE;
+		goto fail;
+	}
 	/*
 	 * ACL configurations to the drivers (implementing AP SME and ACL
 	 * offload) without hostapd's knowledge, can result in a disconnection
-- 
