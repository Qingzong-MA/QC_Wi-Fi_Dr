    <TAG Number="78" Name="Bluetooth Version Information">
      <DESCRIPTION>This tag contains the Bluetooth HCI Version and Link Manager Version Parameters</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="BluetoothVersion" Type="STRUCTURE" Size="2">
        <ELEMENTS Name="HCI_Version" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xD" Signed="false" Description="Bluetooth HCI Version - Bluetooth Core Specification 5.4" />
        <ELEMENTS Name="LMP_Version" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xD" Signed="false" Description="Bluetooth LMP Version - Bluetooth Core Specification 5.4" />
      </ELEMENTS>
    </TAG>
    <TAG Number="80" Name="RF Chain">
      <DESCRIPTION>RF Chain Configuration</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="RF Chain" Type="STRUCTURE" Size="92">
        <ELEMENTS Name="Num BT Antennas" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x1" Signed="false" Description="Number of Platform Antenna's (AoA)" />
        <ELEMENTS Name="Main RX Chain" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Selects Rx chain using PP register: SYS_CMD_x_RX_CTRL_RX_SEL_CH bit rx_sel_ch, when MRC is disabled, and chain is not forced from test commands" />
        <ELEMENTS Name="Main TX Chain" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Selects Tx chain using PP register SC_SYS_CMD_x_TX_DIV_CTRL bit fields 7 and 15 when iBF is disabled, and chain is not forced from test commands." />
        <ELEMENTS Name="SYNTH_SEL" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Synthesizer select, Register HZ_RS_RS_SYNTH_CONFIG, used when DLL is disabled 0: Synth B - Phy0, Synth A - Phy 0 1: Synth B - Phy0, Synth A - Phy 1 2: Synth B - Phy1, Synth A - Phy 0 3: Synth B - Phy1, Synth A - Phy 1." />
        <ELEMENTS Name="LNA_SEL_CH0" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Selects BT dedicated LNA for Chain 0. Register BT_HTOP_RX_CONFIG_0 bit BT_LNA_SEL_CH0." />
        <ELEMENTS Name="PA_SEL_CH0" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Selects BT dedicated PA for Chain 0. Register BT_HTOP_TX_CONFIG_0 bit TX_BT_ANT_CFG_CH0." />
        <ELEMENTS Name="LNA_SEL_CH2" Type="INTEGER" Size="1" Min="0x0" Max="0x2" Default="0x0" Signed="false" Description="Decides the LNA to be used by the aux Rx chain (chain 2). 0: WLAN shared chain 0 LNA; 1: BT dedicated chain 0 LNA; 2: WLAN shared chain 1 LNA; 3: reserved." />
        <ELEMENTS Name="CH_SEL_MODE" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x7" Signed="false" Description="Selects modem MRC behavior during Rx packet. Register HZ_MDM_BT_RX_CHAN_EST_CTRL bit ch_sel_mode." />
        <ELEMENTS Name="DEFAULT_ANTENNA_SELECT" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Register HZ_RS_RS_CH_ANT_CONFIG.  This is the default antenna select that will be driven on hz_btss_antenna_select and hz_btss_rfa_antenna_select_to_rfa outside of AoA extension period." />
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="AO_SYSCTRL_SOC_TLMM_CTRL" Type="BITFIELD" Size="2">
          <ELEMENTS Name="AO_SYSCTRL_SOC_TLMM_CTRL_PAD_PULL_CFG_EN" Default="0x0" Start="0" End="4" Description="" />
          <ELEMENTS Name="AO_SYSCTRL_SOC_TLMM_CTRL_BT_XFEM_SWAP_EN" Default="0x0" Start="8" End="8" Description="" />
          <ELEMENTS Name="AO_SYSCTRL_SOC_TLMM_CTRL_BT_XFEM_SWAP_FLAG" Default="0x0" Start="9" End="9" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="MODE_SEL" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x410" Signed="false" Description="Register HZ_RS_RS_PHY2RFA_CH_MAPPING, used when DLL is disabled; Bits 1:0 Modem chain number for RF CH0; Bits 3:2 LINK number for RF CH0; Bits 5:4 Modem chain number for RF CH1; Bits 7:6 LINK number for RF CH1; Bits 9:8 Modem chain number for RF CH2; Bits 11:10 LINK number for RF CH2;" />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved3" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="AOA_PIN_MUX_REG" Type="FIXED_ARRAY" ElementSize="4" Size="8" Min="0x0" Max="0xFFFFFFFF" Signed="false" Description="Element description" VariableName="AOA_PIN_MUX_REG">
          <ELEMENTS Name="AOA_PIN_MUX_REG_0" Default="0x0" Description="BIT pattern for AoA Select pins Mux configuration to enable corresponding Antenna" />
          <ELEMENTS Name="AOA_PIN_MUX_REG_1" Default="0x0" Description="BIT pattern for AoA Select pins Mux configuration to enable corresponding Antenna" />
        </ELEMENTS>
        <ELEMENTS Name="AntennaID to Mux Config LUT" Type="FIXED_ARRAY" ElementSize="1" Size="64" Min="0x0" Max="0x0" Signed="false" Description="" VariableName="Antenna">
          <ELEMENTS Name="Antenna_0" Default="0x0" Description="BIT pattern for AoA Select pins Mux configuration to enable corresponding Antenna" />
          <ELEMENTS Name="Antenna_1" Default="0x1" Description="BIT pattern for AoA Select pins Mux configuration to enable corresponding Antenna" />
