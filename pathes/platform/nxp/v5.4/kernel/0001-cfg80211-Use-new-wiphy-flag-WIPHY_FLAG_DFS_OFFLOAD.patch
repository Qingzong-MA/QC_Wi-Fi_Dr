From 82be8a14d1151c8dcd9d77f0ba4545c25238e6bf Mon Sep 17 00:00:00 2001
From: bings <bings@codeaurora.org>
Date: Fri, 3 Apr 2020 21:16:03 +0800
Subject: [PATCH] cfg80211: Use new wiphy flag WIPHY_FLAG_DFS_OFFLOAD

When flag WIPHY_FLAG_DFS_OFFLOAD is defined, the driver would handle
all the DFS related operations. Therefore the kernel needs to ignore
the DFS state that it uses to block the userspace calls to the driver
through cfg80211 APIs. Also it should treat the userspace calls to
start radar detection as a no-op
---
 include/net/cfg80211.h | 2 ++
 net/wireless/chan.c    | 6 ++++--
 net/wireless/nl80211.c | 3 +++
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/include/net/cfg80211.h b/include/net/cfg80211.h
index 4ab2c49..2977f7e 100644
--- a/include/net/cfg80211.h
+++ b/include/net/cfg80211.h
@@ -3991,6 +3991,7 @@ struct cfg80211_ops {
  *	beaconing mode (AP, IBSS, Mesh, ...).
  * @WIPHY_FLAG_HAS_STATIC_WEP: The device supports static WEP key installation
  *	before connection.
+ *  @WIPHY_FLAG_DFS_OFFLOAD: The driver handles all the DFS related operations.
  */
 enum wiphy_flags {
 	/* use hole at 0 */
diff --git a/net/wireless/chan.c b/net/wireless/chan.c
index fcac5c6..8d85179 100644
--- a/net/wireless/chan.c
+++ b/net/wireless/chan.c
@@ -422,7 +422,8 @@ static int cfg80211_get_chans_dfs_required(struct wiphy *wiphy,
 		if (!c)
 			return -EINVAL;
 
-		if (c->flags & IEEE80211_CHAN_RADAR)
+		if ((c->flags & IEEE80211_CHAN_RADAR) &&
+		    !(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD))
 			return 1;
 	}
 	return 0;
@@ -702,7 +703,8 @@ static bool cfg80211_get_chans_dfs_available(struct wiphy *wiphy,
 		if (c->flags & IEEE80211_CHAN_DISABLED)
 			return false;
 
-		if ((c->flags & IEEE80211_CHAN_RADAR) &&
+		if (!(wiphy->flags & WIPHY_FLAG_DFS_OFFLOAD) &&
+		    (c->flags & IEEE80211_CHAN_RADAR)  &&
 		    (c->dfs_state != NL80211_DFS_AVAILABLE) &&
 		    !(c->dfs_state == NL80211_DFS_USABLE && dfs_offload))
 			return false;
diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
index 7b72286..3f30276 100644
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -8337,6 +8337,9 @@ static int nl80211_start_radar_detection(struct sk_buff *skb,
 	if (err)
 		return err;
 
+	if (rdev->wiphy.flags & WIPHY_FLAG_DFS_OFFLOAD)
+		return -EOPNOTSUPP;
+
 	if (netif_carrier_ok(dev))
 		return -EBUSY;
 
-- 
2.7.4

