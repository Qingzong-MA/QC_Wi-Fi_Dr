    FIELD fQca_STAT_AsdStats_dsrAllocB4Skewf (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_dsrAllocB4Skewt 16384) (Decimal)   IN_SUMMARY "dsrAlloc0B4Skew(%)" "dsrAlloc0B4Skew(%)"

    FIELD fQca_STAT_AsdStats_iirRssi0      (Fixed 2 Bytes) RETRIEVE (SignExtension 16) (Decimal)   "iirRssi0Raw"
    FIELD fQca_STAT_AsdStats_iirRssi0f  (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_iirRssi0 128) (Decimal)   IN_SUMMARY "IIRRSSI0" "IIRRSSI0"
    FIELD fQca_STAT_AsdStats_iirRssi1      (Fixed 2 Bytes) RETRIEVE (SignExtension 16) (Decimal)   "iirRssi1Raw"
    FIELD fQca_STAT_AsdStats_iirRssi1f  (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_iirRssi1 128) (Decimal)   IN_SUMMARY "IIRRSSI1" "IIRRSSI1"
    FIELD fQca_STAT_AsdStats_isAck          (Fixed 1 Bytes) (Decimal)           "ACK"
