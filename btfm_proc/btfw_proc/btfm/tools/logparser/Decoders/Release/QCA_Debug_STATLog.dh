        FIELD fQca_STAT_RxErrStatus_BIT3_ZeroLenFrame        (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "ZeroLenFrame"
        FIELD fQca_STAT_RxErrStatus_BIT2_UnsupportedNframes  (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedNframes"
        FIELD fQca_STAT_RxErrStatus_BIT1_UnsupportedVer      (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedVer"
        FIELD fQca_STAT_RxErrStatus_BIT0_Busy                (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "Busy"
        RESERVED (Fixed 1 Bytes)
    }
    FIELD fQca_STAT_TxSampleCnt                     (Fixed 2 Bytes)   (Decimal)   "ACI Tx Sample Count"
    FIELD fQca_STAT_Sense                           (Fixed 2 Bytes)   (Hex)       "Sense"
}

