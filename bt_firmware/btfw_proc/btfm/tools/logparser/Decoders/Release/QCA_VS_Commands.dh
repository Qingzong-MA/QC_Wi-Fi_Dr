    FIELD fBQRCmd_Mask_QualityMonitor       (Fixed 1 Bit)       (Binary)  "Quality Monitor"

    RESERVED                                (Fixed 1 byte)

    /*report mask from MSB to LSB */
    RESERVED                                 (Fixed 5 Bit)
    FIELD fBQRCmd_Mask_DebugInfo             (Fixed 1 Bit)       (Binary)  "Controller Debug Information"
    FIELD fBQRCmd_Mask_MultiLinkCoexSchedule (Fixed 1 Bit)       (Binary)  "Multi-link/Coex scheduling trace"
    FIELD fBQRCmd_Mask_LMPMsgTrace           (Fixed 1 Bit)       (Binary)  "LMP message trace"

    FIELD fBQRCmd_Mask_VendorSpecific        (Fixed 1 Bit)       (Binary)  "Connection Fail"
    FIELD fBQRCmd_Mask_TX_PL_Change          (Fixed 1 Bit)       (Binary)  "TX PL change"
    RESERVED                                 (Fixed 6 Bit)
}


