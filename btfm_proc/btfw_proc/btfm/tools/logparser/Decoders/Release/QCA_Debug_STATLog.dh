    FIELD fQca_STAT_AsdStats_iirAck0f     (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_iirAck0t 16384) (Decimal)  IN_SUMMARY "IIRAck0(%)" "IIRAck0(%)"
    FIELD fQca_STAT_AsdStats_iirAck1     (Fixed 4 Bytes) (Decimal)   "IIRAck1"
    FIELD fQca_STAT_AsdStats_iirAck1t    (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_STAT_AsdStats_iirAck1 100)(Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_AsdStats_iirAck1f     (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_iirAck1t 16384) (Decimal)   IN_SUMMARY "IIRAck1(%)" "IIRAck1(%)"
    FIELD fQca_STAT_AsdStats_desiredAlloc   (Fixed 4 Bytes) (Decimal)                   "Desired Allocation"
    FIELD fQca_STAT_AsdStats_desiredAlloct    (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_STAT_AsdStats_desiredAlloc 100)(Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_AsdStats_desiredAllocf     (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_desiredAlloct 16384) (Decimal)   IN_SUMMARY "DsrAlloc(%)" "DsrAlloc(%)"
    FIELD fQca_STAT_AsdStats_dsrAllocAck    (Fixed 4 Bytes) (Decimal)           "Desired AllocAck"
