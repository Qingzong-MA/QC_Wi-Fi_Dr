            <ELEMENTS Name="COEX_TXD" Default="0xE" Description="LTE Coex" />
            <ELEMENTS Name="SWR_CLK" Default="0xF" Description="Soundwire Clock" />
            <ELEMENTS Name="SWR_DATA" Default="0x10" Description="Soundwire Data" />
            <ELEMENTS Name="COEX_CLK" Default="0x11" Description="WSI for Coex" />
            <ELEMENTS Name="COEX_DATA" Default="0x12" Description="WSI for Coex" />
            <ELEMENTS Name="I2C_SCK" Default="0x13" Description="I2C Master CLOCK" />
            <ELEMENTS Name="I2C_SDA" Default="0x14" Description="I2C Master DATA" />
            <ELEMENTS Name="SPIM_CLK" Default="0x15" Description="BT_SPIM_CLK" />
            <ELEMENTS Name="SPIM_CS" Default="0x16" Description="BT_SPIM_CS" />
