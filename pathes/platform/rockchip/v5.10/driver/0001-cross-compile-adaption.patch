From: "nano.wang" <nano.wang@quectel.com>
Date: Fri, 25 Apr 2025 10:50:09 +0800
Subject: [PATCH] cross-compile adaption

---
 chss_host_LEA/chss_proc/host/AIO/build/Makefile            | 7 ++++++-
 .../chss_proc/host/AIO/build/scripts/ve-f10/config.ve-f10  | 6 +++---
 .../AIO/drivers/core_tech_modules/unified_wlan_cnsscore.h  | 1 +
 chss_host_LEA/chss_proc/host/AIO/drivers/qcacld-3.0/Kbuild | 4 ++--
 chss_host_LEA/chss_proc/host/tools/Qcmbr/Qcmbr.h           | 2 +-
 chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/Makefile  | 2 +-
 .../chss_proc/host/tools/cnssdiag_lite/cld-fwlog-netlink.c | 5 ++---
 7 files changed, 16 insertions(+), 11 deletions(-)

diff --git a/chss_host_LEA/chss_proc/host/AIO/build/Makefile b/chss_host_LEA/chss_proc/host/AIO/build/Makefile
index b6072d221..688d7b9cf 100755
--- a/chss_host_LEA/chss_proc/host/AIO/build/Makefile
+++ b/chss_host_LEA/chss_proc/host/AIO/build/Makefile
@@ -1,7 +1,11 @@
 #
 # Main Makefile
 #
-export ATH_TOPDIR=$(shell pwd)/..
+BUILD_TIME:=$(shell date +%s)
+AIO_TOPDIR:=$(shell pwd)/../../AIO
+$(shell ln -sf ${AIO_TOPDIR} /tmp/AIO_${BUILD_TIME})
+export ATH_TOPDIR=/tmp/AIO_${BUILD_TIME}
+
 export BACKPORT_PWD=$(shell pwd)/backports
 # different customer want to use different wpa_supplicant
 # in board_type config file, we can override it
@@ -111,6 +115,7 @@ drivers: rootfs_prep
 	cp -fr $(INSTALL_ROOT)/lib/modules $(INSTALL_ROOT)/lib/unstripped_modules
 	@echo Strip modules
 	@cd ${INSTALL_ROOT}/lib/modules && ${TOOLPREFIX}strip --strip-unneeded *.ko
+	rm ${ATH_TOPDIR} -rf
 
 
 drivers_firmware: rootfs_prep
diff --git a/chss_host_LEA/chss_proc/host/AIO/build/scripts/ve-f10/config.ve-f10 b/chss_host_LEA/chss_proc/host/AIO/build/scripts/ve-f10/config.ve-f10
index 4d4412c15..08f5939a8 100755
--- a/chss_host_LEA/chss_proc/host/AIO/build/scripts/ve-f10/config.ve-f10
+++ b/chss_host_LEA/chss_proc/host/AIO/build/scripts/ve-f10/config.ve-f10
@@ -1,12 +1,12 @@
 #
 # Please modify KERNELPATH, KERNELARCH and TOOLPREFIX to meet your environment
 #
-export KERNELPATH=/lib/modules/${shell uname -r}/build
+#export KERNELPATH=/lib/modules/${shell uname -r}/build
 #export TOOLCHAIN=/home/haotian/work/project/rtk/rtk_qca6390/RTK_SDK_0421/rtk_linuxSDK/output-a32hf/host/bin
 
-export KERNELARCH=x86_64
+#export KERNELARCH=x86_64
 #export CROSS_COMPILE=${TOOLCHAIN}/arm-linux-gnueabihf-
-#export TOOLPREFIX=${CROSS_COMPILE}
+export TOOLPREFIX=${CROSS_COMPILE}
 #export BTPATH=<set the bt path>
 
 # for backports
diff --git a/chss_host_LEA/chss_proc/host/AIO/drivers/core_tech_modules/unified_wlan_cnsscore.h b/chss_host_LEA/chss_proc/host/AIO/drivers/core_tech_modules/unified_wlan_cnsscore.h
index 71bc6a83b..48cc5c1d0 100755
--- a/chss_host_LEA/chss_proc/host/AIO/drivers/core_tech_modules/unified_wlan_cnsscore.h
+++ b/chss_host_LEA/chss_proc/host/AIO/drivers/core_tech_modules/unified_wlan_cnsscore.h
@@ -38,6 +38,7 @@ void qmi_interface_deinit(void);
 void msm_ipc_router_hsic_xprt_deinit(void);
 void ipc_router_mhi_xprt_deinit(void);
 void msm_ipc_router_deinit(void);
+MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
 
 #ifdef CONFIG_SINGLE_KO_FEATURE
 int hdd_module_init(void);
diff --git a/chss_host_LEA/chss_proc/host/AIO/drivers/qcacld-3.0/Kbuild b/chss_host_LEA/chss_proc/host/AIO/drivers/qcacld-3.0/Kbuild
index 0087b724f..ff331e98c 100755
--- a/chss_host_LEA/chss_proc/host/AIO/drivers/qcacld-3.0/Kbuild
+++ b/chss_host_LEA/chss_proc/host/AIO/drivers/qcacld-3.0/Kbuild
@@ -2661,11 +2661,11 @@ ifeq ($(CONFIG_WLAN_FEATURE_DP_RX_THREADS), y)
 OBJS += $(TXRX3.0_OBJS)
 endif
 
-ccflags-y += $(INCS)
+ccflags-y += $(INCS)  -Wno-error
 
 cppflags-y +=	-DANI_OS_TYPE_ANDROID=6 \
 		-Wall\
-		-Werror\
+		-Wno-error \
 		-D__linux__
 
 cppflags-$(CONFIG_PTT_SOCK_SVC_ENABLE) += -DPTT_SOCK_SVC_ENABLE
diff --git a/chss_host_LEA/chss_proc/host/tools/Qcmbr/Qcmbr.h b/chss_host_LEA/chss_proc/host/tools/Qcmbr/Qcmbr.h
index 708a3eedc..8ca403126 100755
--- a/chss_host_LEA/chss_proc/host/tools/Qcmbr/Qcmbr.h
+++ b/chss_host_LEA/chss_proc/host/tools/Qcmbr/Qcmbr.h
@@ -113,7 +113,7 @@ typedef int64_t                 s64;
 
 #define DEVDRVIF_API 
 
-void (*rx_cb)(void *buf);
+//void (*rx_cb)(void *buf);
 
 #define Sleep     sleep
 
diff --git a/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/Makefile b/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/Makefile
index 7dcffffb3..470bf9ae1 100755
--- a/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/Makefile
+++ b/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/Makefile
@@ -1,4 +1,4 @@
-CC := $(ATH_CROSS_COMPILE_TYPE)gcc
+CC := $(ATH_CROSS_COMPILE_TYPE)
 TARGET_TYPE ?= AR9888
 TARGET_VERS ?= v2
 
diff --git a/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/cld-fwlog-netlink.c b/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/cld-fwlog-netlink.c
index a7a0d1fce..114fdbc47 100755
--- a/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/cld-fwlog-netlink.c
+++ b/chss_host_LEA/chss_proc/host/tools/cnssdiag_lite/cld-fwlog-netlink.c
@@ -1255,8 +1255,7 @@ void create_genl_sock_thread()
 	pthread_create(&genl_thread, NULL, genl_thread_routine, NULL);
 }
 #endif
-
-int32_t fw_log_mask = MASK_LOW_LEVEL;
+int32_t fw_log_mask_q = MASK_LOW_LEVEL;
 int terminated = 0;
 void sig_handler(int signo)
 {
@@ -1309,7 +1308,7 @@ int32_t main(int32_t argc, char *argv[])
 			optionflag |= CONSOLE_FLAG;
 			fw_hdl.enable = TRUE;
                         if (optarg != NULL) {
-				fw_log_mask = atoi(optarg);
+				fw_log_mask_q = atoi(optarg);
 				diag_msg_mask_set = 1;
 			}
 			break;
