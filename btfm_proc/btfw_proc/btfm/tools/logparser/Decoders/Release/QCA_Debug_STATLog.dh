TABLE t_ISO_SduTxStatus
    {0  "Not Transmitted"}
    {1  "Stuff SDU"}
    {2  "Datapath Disabled"}
    {3  "No Memory"}
    {4  "Exceed Max SDU Limitation"}
    {5  "Drop Late SDU"}
    {6  "SUCCESS"}
    {7  "FAIL"}
ENDTABLE

TABLE t_ISO_SduRxStatus
    {0x00 "Success"}
    {0x01 "Miss"}
    {0x02 "MissSync"}
    {0x03 "FailSeqn"}
    {0x04 "Unexpected Length"}
ENDTABLE

TABLE t_ISO_PduTxStatus
    {0x00 "Not Scheduled"}
    {0x01 "Command Late"}
    {0x02 "COEX Abort"}
    {0x03 "NULL PDU"}
    {0x04 "PDU"}
ENDTABLE

TABLE t_ISO_PduRxStatus
    {0x00 "Not Scheduled"}
    {0x01 "Command Late"}
    {0x02 "COEX Abort"}
    {0x03 "No Rx"}
    {0x04 "Access Code Error"}
    {0x05 "CRC Error"}
    {0x06 "NULL PDU"}
    {0x07 "Empty PDU"}
    {0x08 "Retransmission PDU"}
    {0x09 "New PDU"}
ENDTABLE

GROUP gQca_STAT_IsoSduTxDbg "ISO SDU Tx Dbg"
{
    FIELD fQca_STAT_IsoSduDbg_handle          (Fixed 2 Bytes) (Decimal)                                            "Handle"
    FIELD fQca_IsoType;
    FIELD fQca_STAT_IsoSduDbg_txSduStatus     (Fixed 1 Bytes) (Table t_ISO_SduTxStatus)                            "Status"
    FIELD fQca_STAT_IsoSduDbg_sduSeqn         (Fixed 2 Bytes) (Decimal)                                            "SDU Sequence"
    FIELD fQca_STAT_IsoSduDbg_sduLength       (Fixed 2 Bytes) (Decimal)                                            "SDU Length"
    FIELD fQca_STAT_IsoSduDbg_arrivalTime     (Fixed 4 Bytes) (Decimal) ALSO (Constant "us")                       "Arrival Time"
    //FIELD fQca_STAT_IsoSduDbg_scheduleTime    (Fixed 4 Bytes) (Decimal) ALSO (Constant "us")                       "Schedule Time"
    FIELD fQca_STAT_IsoSduDbg_flushTime       (Fixed 4 Bytes) (Decimal) ALSO (Constant "us")                       "Flushed Time"
    FIELD fQca_STAT_IsoSduDbg_flushTimeN      (Fixed 4 Bytes) (HEX)                                                "Flushed CLKN"
    FIELD fQca_STAT_IsoSduDbg_flushTimeEvent  (Fixed 2 Bytes) (Decimal)                                            "Flushed EventCount"
    FIELD fQca_STAT_IsoSduDbg_beginPduSeqn    (Fixed 1 Bytes) (Decimal)                                            "Begin Pdu Sequence"
    FIELD fQca_STAT_IsoSduDbg_endPduSeqn      (Fixed 1 Bytes) (Decimal)                                            "End Pdu Sequence"
    FIELD fQca_STAT_IsoSduDbg_headEvent       (Fixed 2 Bytes) (Decimal)                                            "Head EventCount"
    FIELD fQca_STAT_IsoSduDbg_headSubEvent    (Fixed 1 Bytes) RETRIEVE(AddInteger 1) (Decimal)                     "Head SubEvent"
    Reserved                                  (Fixed 6 Bits)
    FIELD fQca_STAT_IsoSduDbg_rxAvailable     (Fixed 1 Bits)  (Decimal)     SUPPRESS_DETAIL
    FIELD fQca_STAT_IsoSduDbg_txAvailable     (Fixed 1 Bits)  (Decimal)     SUPPRESS_DETAIL
    FIELD fQca_STAT_IsoSduDbg_NSE             (Fixed 1 Bytes) (Decimal)                                            "NSE"
    FIELD fQca_STAT_IsoSduDbg_count           (Fixed 1 Bytes) (Decimal)                                            "Count"
    Reserved                                  (Fixed 2 bytes)
    FIELD fQca_STAT_IsoSduDbg_eventInit       (Fixed 0) RETRIEVE(StoreField fQca_STAT_IsoSduDbg_headEvent) (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_event
    FIELD fQca_STAT_IsoSduDbg_subEventInit    (Fixed 0) RETRIEVE(StoreField fQca_STAT_IsoSduDbg_headSubEvent) (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_subEvent
    FIELD fQca_STAT_IsoSduDbg_txOffsetInit    (Fixed 0) RETRIEVE(MultiplyIntegerByField 2 fQca_STAT_IsoSduDbg_count) (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_txOffset
    FIELD fQca_STAT_IsoSduDbg_rxOffsetInit    (Fixed 0) RETRIEVE(StoreInteger 0) (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_rxOffset

    GROUP gQca_STAT_IsoSduDbg_seStatus REPEAT COUNT (FromField Times fQca_STAT_IsoSduDbg_count) "SubEvent Status"
    {
        FIELD fQca_STAT_IsoSduDbg_eventPrint  (Fixed 0) IF (Fieldis EqualTo 0 fQca_STAT_IsoSduDbg_subEvent) RETRIEVE (StoreField fQca_STAT_IsoSduDbg_event) (Decimal)  "##########EventCount"
        FIELD fQca_STAT_IsoSduDbg_subEventRollback (Fixed 0) IF (Fieldis EqualTo 0 fQca_STAT_IsoSduDbg_subEvent)RETRIEVE(StoreField fQca_STAT_IsoSduDbg_nse)
                                                   (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_subEvent
        FIELD fQca_STAT_IsoSduDbg_subEventPrint  (Fixed 0) RETRIEVE(StoreField fQca_STAT_IsoSduDbg_subEvent) (Decimal)      "----------SubEvent"

        GROUP gQca_STAT_IsoSduDbg_seTxStatus IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduDbg_txAvailable) "Tx"
        {
            FIELD fQca_STAT_IsoSduDbg_txOffsetUpdate  (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduDbg_txOffset) ALSO (AddInteger 2)(Hex) SUPPRESS_DETAIL
                                                      STORE fQca_STAT_IsoSduDbg_txOffset

            FIELD fQca_STAT_IsoSduDbg_moveToTx        START_BIT (FromEndSizeFromField fQca_STAT_IsoSduDbg_txOffset) (Fixed 0) (HEX) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduDbg_pduSeqn         (Fixed 1 Bytes) (Decimal)                       "PDU Sequence"
            FIELD fQca_STAT_IsoSduDbg_txStatus        (Fixed 4 Bits)  (Table t_ISO_PduTxStatus)       "Status"
            Reserved                                  (Fixed 2 Bits)
            FIELD fQca_STAT_IsoSduDbg_CIE             (Fixed 1 Bits)  (Decimal)                       "CIE"
            Reserved                                  (Fixed 1 Bits)
        }

        GROUP gQca_STAT_IsoSduDbg_seRxStatus IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduDbg_rxAvailable) "Rx"
        {
            FIELD fQca_STAT_IsoSduDbg_rxOffsetUpdate  (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduDbg_rxOffset) ALSO (AddInteger 2)(Hex) SUPPRESS_DETAIL
                                                      STORE fQca_STAT_IsoSduDbg_rxOffset

            FIELD fQca_STAT_IsoSduDbg_moveToRx        START_BIT (FromEndSizeFromField fQca_STAT_IsoSduDbg_rxOffset) (Fixed 0) (HEX) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduDbg_pduSeqn;
            FIELD fQca_STAT_IsoSduDbg_rxStatus        (Fixed 4 Bits)  (Table t_ISO_PduRxStatus)       "Status"
            Reserved                                  (Fixed 2 Bits)
            FIELD fQca_STAT_IsoSduDbg_CIE;
            FIELD fQca_STAT_IsoSduDbg_ACK             (Fixed 1 Bits)  (Decimal)                       "ACK"
        }

        FIELD fQca_STAT_IsoSduDbg_subEventDec    (Fixed 0) RETRIEVE(StoreField fQca_STAT_IsoSduDbg_subEvent)ALSO(SubtractInteger 1) (HEX)  SUPPRESS_DETAIL
                                                  STORE  fQca_STAT_IsoSduDbg_subEvent
        FIELD fQca_STAT_IsoSduDbg_eventDec  (Fixed 0) IF (Fieldis EqualTo 0 fQca_STAT_IsoSduDbg_subEvent) RETRIEVE (StoreField fQca_STAT_IsoSduDbg_event)
                                            ALSO (SubtractInteger 1) ALSO (AndMask 0xffff) (HEX) SUPPRESS_DETAIL STORE fQca_STAT_IsoSduDbg_event
    }

    FIELD fQca_STAT_IsoSduDbg_moveToEnd START_BIT (FromEnd 0 Bytes) (Fixed 0) (HEX) SUPPRESS_DETAIL
}

GROUP gQca_STAT_IsoSduRxDbg "ISO SDU Rx Dbg"
{
    FIELD fQca_STAT_IsoSduDbg_handle;
    FIELD fQca_IsoType;
    FIELD fQca_STAT_IsoSduDbg_rxSduStatus     (Fixed 1 Bytes) (Table t_ISO_SduRxStatus)       "Status"
    FIELD fQca_STAT_IsoSduDbg_sduSeqn;
    FIELD fQca_STAT_IsoSduDbg_sduLength;
    Reserved                                  (Fixed 4 Bytes)
    //FIELD fQca_STAT_IsoSduDbg_scheduleTime;
    FIELD fQca_STAT_IsoSduDbg_flushTime;
    FIELD fQca_STAT_IsoSduDbg_flushTimeN;
    FIELD fQca_STAT_IsoSduDbg_flushTimeEvent;
    FIELD fQca_STAT_IsoSduDbg_beginPduSeqn;
    FIELD fQca_STAT_IsoSduDbg_endPduSeqn;
    FIELD fQca_STAT_IsoSduDbg_headEvent;
    FIELD fQca_STAT_IsoSduDbg_headSubEvent;
    Reserved                                  (Fixed 6 Bits)
    FIELD fQca_STAT_IsoSduDbg_rxAvailable;
    FIELD fQca_STAT_IsoSduDbg_txAvailable;
    FIELD fQca_STAT_IsoSduDbg_NSE;
    FIELD fQca_STAT_IsoSduDbg_count;
    Reserved                                  (Fixed 2 bytes)
    FIELD fQca_STAT_IsoSduDbg_eventInit;
    FIELD fQca_STAT_IsoSduDbg_subEventInit;
    FIELD fQca_STAT_IsoSduDbg_txOffsetInit;
    FIELD fQca_STAT_IsoSduDbg_rxOffsetInit;

    GROUP gQca_STAT_IsoSduDbg_seStatus;
    FIELD fQca_STAT_IsoSduDbg_moveToEnd;
}

GROUP gQca_STAT_ACLFlushStats "ACL/A2DP Flush Stats based on Naks"
{
    FIELD fQca_FlushPktPktNo                (Fixed 1 Byte)  (Decimal)  "PktNo"
    FIELD fQca_FlushPktConnHandle           (Fixed 1 Byte)  (Decimal)  "ConnHandle"
    FIELD fQca_FlushPktType                 (Fixed 1 Byte)  (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_FlushPktltType               (Fixed 1 Byte)  RETRIEVE   (MultiplyInteger 16) ALSO (AddField fQca_FlushPktType) (Table ACL_PACKETTYPE) "pktType"

    FIELD fQca_FlushPktTxPower              (Fixed 1 Byte)  RETRIEVE (SignExtension 8)(Decimal)  "Tx Power(dBM)"
    FIELD fQca_FlushPktAvgRSSI              (Fixed 1 Byte)  RETRIEVE (SignExtension 8) (Decimal)  "avgRSSIdBm"
    GROUP fQca_FlushPktFlags "flags"
    {
        Reserved (fixed 6 bits)
        FIELD fQca_FlushPktFlags_BIT1_ICBType        (Fixed 1 bit)  (TABLE t_ICBType)       "ACL/Split A2DP Packet"
        FIELD fQca_FlushPktFlags_BIT0_linkRole       (Fixed 1 bit)  (TABLE t_linkRole)      "linkRole"
    }
    FIELD fQca_FlushTxPwrLv                 (Fixed 1 Byte)  (Decimal)  "Tx Power Level"

    GROUP gQca_STAT_ACLPerPktStats;
    FIELD fQca_FlushPktOverflowCount        (Fixed 2 Bytes) PRINT_IF   (FieldIs NotEqualTo 0) (Decimal) "OverflowCount"
    FIELD fQca_FlushPktFlushCount           (Fixed 2 Bytes) PRINT_IF   (FieldIs NotEqualTo 0) (Decimal) "FlushCount"
    FIELD fQca_FlushPktPiconetClock         (Fixed 4 Bytes) (Hex)      "PiconetClock"
    FIELD fQca_FlushPktClockOffset          (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktAckInstant           (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktArrivalTime          (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktArrivalTimePnet      (Fixed 0)       RETRIEVE   (AddFieldToField fQca_FlushPktArrivalTime fQca_FlushPktClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "ArrivalTime"
    FIELD fQca_FlushPktSchedInstant         (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktSchedInstantPnet     (Fixed 0)       RETRIEVE   (AddFieldToField fQca_FlushPktSchedInstant fQca_FlushPktClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "SchedInstant"
    FIELD fQca_FlushPktLastTxAckInstant     (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktLastTxAckInstantPnet (Fixed 0)       RETRIEVE   (AddFieldToField fQca_FlushPktLastTxAckInstant fQca_FlushPktClockOffset)ALSO (AndMask 0xFFFFFFF) (Hex) "LastTxAckInstant"

    /* Do not display if the clock values are invalid */
    FIELD fQca_FlushPktLastFlowOffClk       (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL

    /* Do not display if the clock values are invalid */
    FIELD fQca_FlushPktLastFlowOnClk        (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL

    FIELD fQca_FlushPktInstantPnetROMask (Fixed 0)       RETRIEVE (StoreField fQca_FlushPktPiconetClock) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktPrevtoCurrPktDelay   (Fixed 0)       RETRIEVE (SubtractFieldMinusField fQca_FlushPktInstantPnetROMask fQca_FlushPktLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF)   (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_FlushPktPrevtoCurrPktDelay1  (Fixed 0)       RETRIEVE (MultiplyFieldByInteger fQca_FlushPktPrevtoCurrPktDelay 625)           (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_FlushPktPrevtoCurrPktDelay2  (Fixed 0)       RETRIEVE (DivideFieldByInteger fQca_FlushPktPrevtoCurrPktDelay1 2000)           (Decimal)  "PrevToCurrPktAckDelay(ms)"

    FIELD fQca_FlushPktLastFlowOffClkPnet   (Fixed 0)       IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_FlushPktLastFlowOffClk) ELSE_SKIP (FIXED 0) RETRIEVE (AddFieldToField fQca_FlushPktLastFlowOffClk fQca_FlushPktClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "LastFlowOffClk"
    FIELD fQca_FlushPktLastFlowOnPnet       (Fixed 0)       IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_FlushPktLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE (AddFieldToField fQca_FlushPktLastFlowOnClk fQca_FlushPktClockOffset) ALSO (AndMask 0xFFFFFFF) (Hex) "LastFlowOnClk"

    /* Do no display if the clock values are invalid */
    FIELD fQca_FlushPktCoexCriticalPriorityClk  (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "CoexCriticalPriorityClk"
    FIELD fQca_FlushPktCoexNormalPriorityClk    (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "CoexNormalPriorityClk"
    FIELD fQca_FlushPktWBtime                   (Fixed 4 Bytes) (Hex)      "WBtime"
    FIELD fQca_LastPktFlushClk                  (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF) (Hex)      "FlushTimestamp"
    FIELD fQca_TxAbortByCoexAbortCounter        (Fixed 4 Bytes) (Hex)      SUPPRESS_DETAIL

    FIELD fQca_FlushMediaSeqn                   (Fixed 2 Bytes) PRINT_IF   (FieldIs NotEqualTo 0) (Decimal)  "MediaSeqn"
    RESERVED                                    (Fixed 2 Bytes)
    GROUP gQca_FlushSegmentLatency;

    FIELD fQca_Acl_numChain        (FIXED 1 BYTES) (DECIMAL) SUPPRESS_DETAIL

    FIELD fQca_aclMaxpowerCntr (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE aclMaxpowerCntr
    GROUP gQca_ACL_SAR_MAX_POWER REPEAT COUNT (FromField Times fQca_Acl_numChain) "SAR Max Power(dBM)"
    {
        GROUP gQca_aclMaxPower
        {
            FIELD fQca_acl_Max_power        (Fixed 1 Bytes) PRINT_IF (FieldIs NotEqualTo -1)  RETRIEVE (SignExtension 8) (DecimalWithFieldLabel aclMaxpowerCntr) "Antenna"
        }
        FIELD fQca_aclMaxpowerCntrIncr (Fixed 0) RETRIEVE (StoreField aclMaxpowerCntr) ALSO (AddInteger 1) (Hex) SUPPRESS_DETAIL STORE aclMaxpowercntr
    }
}

TABLE t_ICBType
    {0, "ACL packet"}
    {1, "Split A2DP packet"}
ENDTABLE

GROUP gQca_FlushSegmentLatency "Segmentation Latency"
{
    FIELD fQca_FlushPktArrivalLatency              (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktArrivalTimePnet fQca_FlushPktLastTxAckInstantPnet) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushPktArrivalLatencyTemp          (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushPktArrivalLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushPktPacketArrivalLatencyInMillisec    (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushPktArrivalLatencyTemp 16) (Decimal) "L1. Arrival Latency from PrevAck(ms)"

    FIELD fQca_FlushPktSchedInstantPnetROMask           (Fixed 0) RETRIEVE (StoreField fQca_FlushPktSchedInstantPnet) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktSchedInstantPnetROMask fQca_FlushPktArrivalTimePnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushPktScheduleLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushPktScheduleLatencyTemp 16) (Decimal) "L2. Schedule Latency from Arrival(ms)"

    FIELD fQca_FlushPktSchedInstantPnetROMask1           (Fixed 0) RETRIEVE (StoreField fQca_FlushPktSchedInstantPnet) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatency1            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktSchedInstantPnetROMask1 fQca_FlushPktLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatencyTemp1        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushPktScheduleLatency1 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushPktScheduleLatencyInMillisec1  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushPktScheduleLatencyTemp1 16) (Decimal) "L3. Schedule Latency from Last Ack(ms)"

    FIELD fQca_FlushPktTxLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktInstantPnetROMask fQca_FlushPktSchedInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushPktTxLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushPktTxLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushPktTxLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushPktTxLatencyTemp 16) (Decimal) "L4. OTA Latency from Schedule(ms)"

    FIELD fQca_FlushToPrevPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktInstantPnetROMask fQca_FlushPktLastTxAckInstantPnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushToPrevPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushToPrevPacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushToPrevPacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushToPrevPacketLatencyTemp 16) (Decimal) "Latency(L1 + L2 + L4) (ms)"

    FIELD fQca_FlushPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_FlushPktInstantPnetROMask fQca_FlushPktArrivalTimePnet) ALSO (AndMask 0xFFFFFFF) (Hex) SUPPRESS_DETAIL
    FIELD fQca_FlushPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_FlushPacketLatency 5) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_FlushPacketLatencyInMillisec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_FlushPacketLatencyTemp 16) (Decimal) "A2DP Packet Latency(L2 + L4) (ms)"
}

