     BRANCH (FromTable tBQRCmd_ActionID fBQRCmd_ActionID)
}

TABLE tBQRCmd_ActionID
{0x00 "ADD"  "ADD"  0 gBQRCmd_Action_Add}
{0x01 "DELETE" "DELETE" 0 gBQRCmd_Action_Delete}
{0x02 "CLEAR" "CLEAR" 0 gBQRCmd_Action_Clear}
