}

Table tQbceSubEvtSubOpcodes
    {0x01 "QCM_PHY_Changed Event" "QCM_PHY_Changed Event" 0 gQbceEvtQcmPhyChange}
    {0x05 "Read_Remote_Supported_QLMP_Features_Complete" "Read_Remote_Supported_QLMP_Features_Complete" 0 gQbceReadRemoteQlmFeatureComp }
    {0x06 "Read_Remote_Supported_QLL_Features_Complete" "Read_Remote_Supported_QLL_Features_Complete" 0 gQbceReadRemoteQllFeatureComp }
    {0x08 "QLM_Connection_Complete Event" "QLM_Connection_Complete Event" 0 gQbceQlmConnComp }
    {0x09 "QLL_Connection_Complete Event" "QLL_Connection_Complete Event" 0 gQbceQlmConnComp }
    {0x0A "BCAUD_RX_Packet_Info_Event" "BCAUD_RX_Packet_Info_Event" 0 gQbceEvtRxPktInfo }
ENDTABLE

TABLE tQbce_source 
    {0x0, "Local"}
    {0x1, "Remote"}
    {Default, Invalid}
ENDTABLE

