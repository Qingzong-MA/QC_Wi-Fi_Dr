{0xE0 "VS_Audio_Offload_Event"            "VS_Audio_Offload_Event"    0 gAudioOffloadVSEvt }
{0xD1 "VS_TimeSync_Event"				  "VS_TimeSync_Event"		  0	gTimeSyncEvt}
ENDTABLE

