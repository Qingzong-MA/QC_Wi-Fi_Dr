    FIELD fQca_PFAL_synth_type       (Fixed 2 Byte)  RETRIEVE (SignExtension 16) (Decimal)  "Synth Index"
    FIELD fQca_PFAL_power_I          (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Power I"
    FIELD fQca_PFAL_cross_IQ         (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Cross IQ"
    FIELD fQca_PFAL_power_Q          (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Power Q"
    FIELD fQca_PFAL_power_I2         (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Power I2"
    FIELD fQca_PFAL_cross_IQ2        (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Cross IQ2"
    FIELD fQca_PFAL_power_Q2         (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "Power Q2"
    FIELD fQca_PFAL_R1               (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "R1"
    FIELD fQca_PFAL_R2               (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "R2"
    FIELD fQca_PFAL_R3               (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "R3"
    FIELD fQca_PFAL_R4               (Fixed 4 Byte)  RETRIEVE (SignExtension 32) (Decimal)  "R4"
