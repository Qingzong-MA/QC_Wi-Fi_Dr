diff --git a/privateMembers.c b/privateMembers.c
index 12c716c490cf..3d866c4daaa1 100755
--- a/privateMembers.c
+++ b/privateMembers.c
@@ -34,6 +34,8 @@ Confidential and Proprietary - Qualcomm Technologies, Inc.
 #include "hciattach_rome.h"
 #endif
 
+#include "uart.h"
+
 //#include "global.h"
 
 const BYTE DIAG_TERM_CHAR = 0x7E;
@@ -276,7 +278,7 @@ void DiagPrintToStream(BYTE response[], int Length, bool check)
 		{
 			if (client_sock != -1)
 	        {
-	            if( send(client_sock , messageToSend , messageToSend_Length , 0) < 0)
+	            if( send(client_sock , messageToSend , modifiedResponseMsg_Length + 1 , 0) < 0)
 	            {
 	                puts("Send failed");
 	                return;
@@ -292,10 +294,13 @@ void DiagPrintToStream(BYTE response[], int Length, bool check)
 	}
 }
 
-int processDiagPacket(BYTE inputDIAGMsg[])
+int processDiagPacket(BYTE inputDIAGMsg[], int x_len)
 {	
     int i=0;
-	
+
+	BYTE modifiedInputMsg[1024];
+	int lengthofmodifiedInputMsg = 0;
+
     switch (inputDIAGMsg[0])
     {
         case 0X73:  //logmask respons
@@ -308,6 +313,11 @@ int processDiagPacket(BYTE inputDIAGMsg[])
             {
                 DiagPrintToStream(logMaskResponseSecondMsg, sizeof(logMaskResponseSecondMsg), false);
             }
+			else if (inputDIAGMsg[4] == 3)
+			{
+                DiagPrintToStream(logMaskResponseFirstMsg, sizeof(logMaskResponseFirstMsg), false);
+			}
+
             return 1;
         case 0X0:  //verResponseMsg
             printf("echo for version \n");
@@ -333,27 +343,60 @@ int processDiagPacket(BYTE inputDIAGMsg[])
             printf("\n>SubsystemDispatch Diag packet received of type 0x%02x\n", inputDIAGMsg[0]);                    
             printf("\n");
 
-            DiagPrintToStream(inputDIAGMsg, TCP_BUF_LENGTH, false);
+			//4B 12 29 00 31 32 33 00 1A 9C 7E, this command is added for QUTS to avoid the  modem ready failures, it requires 8 byte time stamp before 0x31,0x32,0x33
+			if (inputDIAGMsg[0] == 0x4B && inputDIAGMsg[1]== 0x12 && inputDIAGMsg[2] == 0x29 && inputDIAGMsg[3]==00 && inputDIAGMsg[4]==0x31 && inputDIAGMsg[5] ==0x32
+				&& inputDIAGMsg[6]==0x33 && inputDIAGMsg[7]==00 && inputDIAGMsg[8] ==0x1A && inputDIAGMsg[9] == 0x9C && inputDIAGMsg[10] ==0x7E)
+			{
+				 BYTE res[] = { 0x4B, 0x12, 0x29, 0x00, 0xD7, 0x45, 0xBF, 0x70, 0xBB, 0x1F, 0x00, 0x00, 0x31, 0x32, 0x33, 0x00, 0x00 };
+				// ntwStream.Write(res, 0, res.Length);
+				DiagPrintToStream(res, sizeof(res), true);
+				return 1;
+			}
+
+            DiagPrintToStream(inputDIAGMsg, x_len, true);
+
+			for (int i = 0; i < (x_len - 1); i++)
+			 {
+				 if ((inputDIAGMsg[i] == 0x7D) && inputDIAGMsg[i + 1] == 0x5E)
+				 {
+					 modifiedInputMsg[lengthofmodifiedInputMsg] = 0x7e;
+					 i++;
+				 }
+				 else if ((inputDIAGMsg[i] == 0x7D) && inputDIAGMsg[i + 1] == 0x5D)
+				 {
+					 modifiedInputMsg[lengthofmodifiedInputMsg] = 0x7D;
+					 i++;
+				 }
+				 else
+				 {
+					 modifiedInputMsg[lengthofmodifiedInputMsg] = inputDIAGMsg[i];
+				 }
+				 lengthofmodifiedInputMsg++;
+			 }
+
+
             //check for BT 4B packet and type Bluetooth
-            if ((inputDIAGMsg[10] == 1) && (inputDIAGMsg[1] == 11) && (inputDIAGMsg[2] == 4) && (inputDIAGMsg[3] == 0))//check 4B packet           
+            if ((modifiedInputMsg[10] == 1) && (modifiedInputMsg[1] == 11) && (modifiedInputMsg[2] == 4) && (modifiedInputMsg[3] == 0))//check 4B packet           
             {
                 //check for length from 6th byte and copy payload from 10th byte
-                int lengthOfPayload = inputDIAGMsg[6];
-                BYTE msgToDUT[lengthOfPayload];
+                int lengthOfPayload = modifiedInputMsg[6];
+                BYTE msgToDUT[1024];
 
                 //check if 7E was replaced                        
                 int index = 0;
 				int payloadIndex = 10;
                 for (payloadIndex = 10; payloadIndex < (10 + lengthOfPayload); payloadIndex++)
                 {
-                    if ((inputDIAGMsg[payloadIndex] == 0x7D) || (inputDIAGMsg[payloadIndex + 1] == 0x5E))
+#if 0
+					if ((inputDIAGMsg[payloadIndex] == 0x7D) || (inputDIAGMsg[payloadIndex + 1] == 0x5E))
                     {
                         msgToDUT[index] = 0x7e;
                         payloadIndex++;
                     }
                     else
+#endif
                     {
-                        msgToDUT[index] = inputDIAGMsg[payloadIndex];
+                        msgToDUT[index] = modifiedInputMsg[payloadIndex];
                     }
                     index++;
                 }
@@ -403,7 +446,7 @@ int processDiagPacket(BYTE inputDIAGMsg[])
             //look for 7E to calculate length
             int indexOf7E = 0;
 
-            for (i = 0; i < TCP_BUF_LENGTH; i++)
+            for (i = 0; i < x_len; i++)
             {
                 if (inputDIAGMsg[i] == 0x7E)
                 {
@@ -440,8 +483,16 @@ int processDiagPacket(BYTE inputDIAGMsg[])
             printf("echo for extendedBuildID\n");
             DiagPrintToStream(extendedBuildIDRespMsg, sizeof(extendedBuildIDRespMsg), false);
             return 1; 
+        case 0x7E:  //PacketForNonHDLC
+			send(client_sock , inputDIAGMsg , x_len , 0);
+		    return 1;
+
         default:
             printf("In default\n");
+			lengthofmodifiedInputMsg = x_len + 1;
+            modifiedInputMsg[0] = 0x13;
+            memcpy(&modifiedInputMsg[1], inputDIAGMsg, x_len);
+            DiagPrintToStream(modifiedInputMsg, lengthofmodifiedInputMsg, true);
             return 1;
     }
 }
