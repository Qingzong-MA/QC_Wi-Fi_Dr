            <ELEMENTS Name="FINE_GAIN_SETTING" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x5" Signed="false" Description="LUT[XLNA_SETTING, SLNA_SETTING, GM_SETTING, TIA_SETTING]" />
