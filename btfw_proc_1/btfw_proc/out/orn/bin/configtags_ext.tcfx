    <TAG Number="39" Name="Tx Power Level Mapping">
      <DESCRIPTION>This Tag contains the Tx Power level to dBM values in Step Size 0.25dBm which are used for calculations like Average Step size and other SAR related validations. These values are depend on the platform</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Tx Power Level Mapping" Type="STRUCTURE" Size="61">
        <ELEMENTS Name="Coarse Power Table" Type="FIXED_ARRAY" ElementSize="1" Size="12" Min="0x80" Max="0x7F" Signed="true" Description="Coarse power for each power level. Unit is dbm" VariableName="Coarse Power PL">
          <ELEMENTS Name="Coarse Power PL0" Default="0xE4" Description="Coarse power at power level 0. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL1" Default="0xE9" Description="Coarse power at power level 1. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL2" Default="0xEE" Description="Coarse power at power level 2. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL3" Default="0xF3" Description="Coarse power at power level 3. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL4" Default="0xF6" Description="Coarse power at power level 4. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL5" Default="0xFA" Description="Coarse power at power level 5. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL6" Default="0xFF" Description="Coarse power at power level 6. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL7" Default="0x4" Description="Coarse power at power level 7. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL8" Default="0x9" Description="Coarse power at power level 8. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL9" Default="0xE" Description="Coarse power at power level 9. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL10" Default="0x11" Description="Coarse power at power level 10. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL11" Default="0x14" Description="Coarse power at each power level 11. Unit is dbm" />
        </ELEMENTS>
        <ELEMENTS Name="Fine Power Adjust Per Packet Type" Type="STRUCT_ARRAY" Size="48" VariableName="Fine Power Adjust">
          <ELEMENTS Name="BR Packet" Type="STRUCTURE" Size="12">
            <ELEMENTS Name="Fine Power Adjust PL0" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0xFF" Signed="true" Description="Fine Power Adjust for PL0.Unit is 0.25dbm. It is the difference between the observed max transmit power and coarse power at power level 0.  Fine Power Adjust PL0 = Actual Power PL0 - 4 * Coarse Power PL0." />
