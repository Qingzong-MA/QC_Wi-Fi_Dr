GROUP gQca_EDPHHist "EDPH history"
{
/*
	FIELD fQca_edphIdxCntr0 (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE IdxCntr
    GROUP gQCA_EDPHRecords REPEAT COUNT (Fixed 10 Times)
	{
		GROUP gQCA_EDPHRecord LABEL(LabelCount "Record #" IdxCntr )
		{
			FIELD fQca_EDPH_record  (Fixed 4 Bytes)   (Hex) SUPPRESS_DETAIL
			FIELD fQca_edph_rawhdr  (Fixed 0)  RETRIEVE    (StoreField  fQca_EDPH_record) ALSO (AndMask 0x0003ffff) (Hex) "RawHdr"
			FIELD fQca_edph_ErrCnt  (Fixed 0)  RETRIEVE    (StoreField  fQca_EDPH_record) ALSO (ShiftRight 24) ALSO (AndMask 0x0f) (Hex) "ErrCnt"
			FIELD fQca_EDPH_regHec  (Fixed 2 Bytes)        (Hex)            "regHec"
			FIELD fQca_EDPH_regInt0  (Fixed 1 Byte)        (Hex)            "regInt0"
			FIELD fQca_EDPH_regRx  (Fixed 1 Byte)          (Hex)            "regRx"
			FIELD fQca_EDPH_piconetClk  (Fixed 4 Bytes)    (Hex)            "piconetClk"
			FIELD fQca_edph_ErrType1(Fixed 0)  RETRIEVE    (StoreField  fQca_EDPH_record) ALSO (ShiftRight 18) ALSO (AndMask 0x3f) (Binary) "Err:HEC|SEQ|ARQ|xFLOW|TYPE|xLTADDR"
		}
		FIELD fQca_edphIdxCntrIncr (Fixed 0) RETRIEVE (StoreField IdxCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE IdxCntr
	}
    FIELD fQca_EDPH_histIdx                      (Fixed 1 Byte)      (Hex)             "idx"
*/
    FIELD fQca_EDPH_lt_addr                      (Fixed 1 Byte)      (Decimal)        "lt_addr"
    FIELD fQca_EDPH_UAP                          (Fixed 1 Byte)      (Hex)            "UAP"
    FIELD fQca_EDPH_streamHandle                 (Fixed 1 Byte)      (Hex)            "streamHandle"
    FIELD fQca_EDPH_totalEnCnt                   (Fixed 2 Bytes)     (Decimal)        "totalEnCnt"
    FIELD fQca_EDPH_hecGoodnCnt                  (Fixed 2 Bytes)     (Decimal)        "hecGoodCnt"
    FIELD fQca_EDPH_nakCnt                       (Fixed 2 Bytes)     (Decimal)        "nakCnt"
    FIELD fQca_EDPH_noRspCnt                      (Fixed 2 Bytes)     (Decimal)        "noRspCnt"
    FIELD fQca_EDPH_succCnt                      (Fixed 2 Bytes)     (Decimal)        "succCnt"
    FIELD fQca_EDPH_failCnt                      (Fixed 2 Bytes)     (Decimal)        "failCnt"
    FIELD fQca_EDPH_expHdr0                      (Fixed 4 Bytes)     (Hex)            "expSeq0"
    FIELD fQca_EDPH_expHdr1                      (Fixed 4 Bytes)     (Hex)            "expSeq1"
	GROUP fQca_EDPH_errTypeCnt   "errTypeCnt"
	{
		FIELD fQca_EDPH_errHEC                      (Fixed 2 Bytes)     (Decimal)        "errHecCnt"
		FIELD fQca_EDPH_errSeq                      (Fixed 2 Bytes)     (Decimal)        "errSeqCnt"
		FIELD fQca_EDPH_errArq                      (Fixed 2 Bytes)     (Decimal)        "errArqCnt"
		FIELD fQca_EDPH_errFlow                     (Fixed 2 Bytes)     (Decimal)        "errFlowCnt"
		FIELD fQca_EDPH_errType                     (Fixed 2 Bytes)     (Decimal)        "errPktTypeCnt"
		FIELD fQca_EDPH_errLtaddr                   (Fixed 2 Bytes)     (Decimal)        "errLtaddrCnt"
	}
	FIELD fQca_edphErrIdxCntr0 (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE IdxCntr
    GROUP gQCA_EDPHErrcntRecords REPEAT COUNT (Fixed 19 Times)
	{
		FIELD fQca_EDPH_errCnti                      (Fixed 2 Bytes)     (DecimalWithFieldLabel IdxCntr)      "ERR"
		FIELD fQca_edphErrIdxCntrIncr (Fixed 0) RETRIEVE (StoreField IdxCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE IdxCntr
	}
    FIELD fQca_EDPH_RSSI                            (Fixed 1 Bytes)       RETRIEVE (SignExtension 8) (Decimal)   "RSSI"      
    FIELD fQca_EDPH_TxPowerLevel                    (Fixed 1 Bytes)      (Decimal)                               "txPowerLevel"
	FIELD fQca_EDPH_lastAccess                      (Fixed 4 Bytes)      (Hex)                               "lastAccess"
	FIELD fQca_EDPH_lastRxHdr                       (Fixed 4 Bytes)      (Hex)                               "lastRxHdr"
	FIELD fQca_EDPH_lasthecReg                      (Fixed 4 Bytes)      (Hex)                               "lasthecReg"
	FIELD fQca_EDPH_abortCfg                        (Fixed 4 Bytes)      (Hex)                            "abortRegCfg. 0-abort;0x0f-notAbort"
	FIELD fQca_EDPH_rxStatus                        (Fixed 4 Bytes)      (Hex)                               "rxStatus"
}
GROUP gQca_EDPHCfg "EDPH config"
{
    RESERVED                                        (Fixed 1 Byte)
    FIELD fQca_EDPHCfg_Classic_MV_Threshold         (Fixed 1 Byte)     (Hex)            "Classic_MV_Threshold"
    FIELD fQca_EDPHCfg_Difference_Threshold         (Fixed 1 Byte)     (Hex)            "Cfg_Difference_Threshold"
    FIELD fQca_EDPHCfg_Packet_Header_Mask           (Fixed 4 Bytes)    (Hex)            "Cfg_Packet_Header_Mask"
}

TABLE tICBType
	{0x00 "ACL"}
	{0x01 "SPLIT A2DP"}
ENDTABLE

GROUP gQca_FlushStats "ACL packet Flush" 
{
	FIELD fQca_clkoff             (Fixed 4 Bytes)                (Hex)                     "clk offset"
	FIELD fQca_flushhandle        (Fixed 2 Bytes)                (Hex)                     "HCI Handle"
	FIELD fQca_flushType          (Fixed 1 Byte)                 (TABLE tICBType)          "Type"
	FIELD fQca_flushPacketType    (fixed 1 bytes)                (TABLE ACL_PACKETTYPE)    "flushed packet"
}

GROUP gQca_STAT_DbgPSA "DbgPSA"
{
	FIELD fQca_DbgPSA_cnt                      	(Fixed 2 Bytes)     (Decimal)        "cnt"
	FIELD fQca_DbgPSA_hdl                      	(Fixed 2 Bytes)     (Decimal)        "hciHandle"
	FIELD fQca_DbgPSAIdxCntr0 (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE IdxCntr
    GROUP gQCA_DbgPSARecords REPEAT COUNT (Fixed 10 Times)
	{
		GROUP gQCA_DbgPSARecord LABEL(LabelCount "Record #" IdxCntr )
		{
			FIELD fQca_DbgPSA_pClk                     (Fixed 4 Bytes)    (Hex)         "PClk"
			FIELD fQca_DbgPSA_lasTxPClk               (Fixed 4 Bytes)    (Hex)  		 "lastTxClk"
			FIELD fQca_DbgPSA_l2caplen                 (Fixed 2 Bytes)    (Decimal)     "l2capLen"
			FIELD fQca_DbgPSA_curLen                   (Fixed 1 Byte)     (Decimal)     "curentLen"
			FIELD fQca_DbgPSA_isA2DPSink               (Fixed 1 Byte)     (Decimal)     "isA2DPSink"
			
			FIELD fQca_DbgPSA_pClk1      (Fixed 0)   RETRIEVE (StoreField fQca_DbgPSA_pClk) ALSO (OrMask 0x10000000)      (Hex)      SUPPRESS_DETAIL
			FIELD fQca_DbgPSA_clkDelta   (Fixed 0)   RETRIEVE (SubtractFieldMinusField fQca_DbgPSA_pClk1 fQca_DbgPSA_lasTxPClk) ALSO (AndMask 0xFFFFFFF)   (Decimal)  SUPPRESS_DETAIL
			FIELD fQca_DbgPSA_clkDelta1  (Fixed 0)   RETRIEVE (MultiplyFieldByInteger fQca_DbgPSA_clkDelta 625)           (Decimal)  SUPPRESS_DETAIL
			FIELD fQca_DbgPSA_clkDelta2  (Fixed 0)   RETRIEVE (DivideFieldByInteger fQca_DbgPSA_clkDelta1 2000)           (Decimal)  "PrevToCurrPktDelay(ms)"
		}
		FIELD fQca_DbgPSAIdxCntrIncr (Fixed 0) RETRIEVE (StoreField IdxCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE IdxCntr
	}

}

