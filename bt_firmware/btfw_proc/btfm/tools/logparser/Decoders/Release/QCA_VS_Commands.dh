{0x1C "ERR_SCO_INTERVAL_REJECTED"}
{0x1D "ERR_AIR_MODE_REJECTED"}
{0x1E "ERR_INVALID_LMP_PARAM"}
{0x1F "ERR_UNSPECIFIED "}
{0x20 "ERR_UNSUPPORTED_LMP_PARAM_VALUE"}
{0x21 "ERR_SWITCH_NOT_ALLOWED"}
{0x22 "ERR_LMP_RESPONSE_TIMEOUT"}
{0x23 "ERR_LMP_ERROR_TRANS_COLLISION"}
{0x24 "ERR_PDU_NOT_ALLOWED"}
{0x25 "ERR_ENCRYPTION_MODE_NOT_ACCEPTABLE"}
{0x26 "ERR_UNIT_KEY_USED"}
