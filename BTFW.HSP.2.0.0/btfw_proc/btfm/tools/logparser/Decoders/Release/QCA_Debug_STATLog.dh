    FIELD fQca_Sniffindex3BBStat          (Fixed 4 Bytes)    (Hex)           "index3:BBStats:"
    FIELD fQca_Sniffindex4BBStat          (Fixed 4 Bytes)    (Hex)           "index4:BBStats:"
    FIELD fQca_Sniffindex5BBStat          (Fixed 4 Bytes)    (Hex)           "index5:BBStats:"
    FIELD fQca_Sniffindex6BBStat          (Fixed 4 Bytes)    (Hex)           "index6:BBStats:"
    FIELD fQca_Sniffindex7BBStat          (Fixed 4 Bytes)    (Hex)           "index7:BBStats:"
    FIELD fQca_Sniffindex8BBStat          (Fixed 4 Bytes)    (Hex)           "index8:BBStats:"
}


/* CSB audio stats */
GROUP gQca_STAT_BCAUD "CSB Audio Stats"
{
    FIELD fQca_BCAECSegmentsQueued     (Fixed 2 Bytes)      (Decimal)          "EC Queued"
    FIELD fQca_BCAECSegmentsTx         (Fixed 2 Bytes)      (Decimal)          "EC Tx"
    FIELD fQca_BCAECSegmentsDrop       (Fixed 2 Bytes)      (Decimal)          "EC Dropped"
    FIELD fQca_BCAAudioFrameOverflow   (Fixed 2 Bytes)      (Decimal)          "Frame Dropped"
    FIELD fQca_BCAFMBUnavailable       (Fixed 2 Bytes)      (Decimal)          "FMB unavailable"
    FIELD fQca_BCASmallerBAPakcet      (Fixed 2 Bytes)      (Decimal)          "Small BA Pakcets"
    FIELD fQca_BCAAudioFrameTimeout    (Fixed 2 Bytes)      (Decimal)          "Audio Frame Timout"
    FIELD fQca_BCAFullBAPacket         (Fixed 2 Bytes)      (Decimal)          "Full BA Packet"
    FIELD fQca_BCAAudioFramesReceived  (Fixed 2 Bytes)      (Decimal)          "NumAudioFramesRx"
    FIELD fQca_BCACxMDenials           (Fixed 2 Bytes)      (Decimal)          "CxM Denials"
    FIELD fQca_BCALCLateCommands       (Fixed 2 Bytes)      (Decimal)          "LC Late commands"
    RESERVED                           (Fixed 2 Bytes)
}
GROUP gQca_TruncPageStats "Trunc Page Offload Stats"
{
    FIELD fQca_TPOCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE TPOCntr

    GROUP gQca_TruncPageStatsDevTxSlot REPEAT COUNT (Fixed 5 Times) "# Tx Slots for each device"
    {
        GROUP gQca_TruncPageStatsDevTxSlotCnt
        {
            FIELD fQca_runcPageStatsDevTxSlot              (Fixed 4 Bytes)   (DecimalWithFieldLabel TPOCntr)    "# Tx slots for device"
        }
        /* Increment the Counter */
        FIELD fQca_TruncDeviceTxCnt (Fixed 0) RETRIEVE (StoreField TPOCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE TPOCntr
    }

    FIELD fQca_TruncCxmSlots                 (Fixed 4 Bytes)        (Decimal)          "Cxm denied Slots"

    FIELD fQca_TPOSWCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE TPOSWCntr
    GROUP gQca_TruncPageStatsDevSwitchSlot REPEAT COUNT (Fixed 5 Times) " # times switched to each device "
    {
        GROUP gQca_TruncPageStatsDevSwitchSlotCnt
        {
            FIELD fQca_runcPageStatsDevSwitchSlot            (Fixed 2 Bytes)         (DecimalWithFieldLabel TPOSWCntr)    " # times switched to device"
        }
        /* Increment the Counter */
        FIELD fQca_TruncDeviceSwitchCnt (Fixed 0) RETRIEVE (StoreField TPOSWCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE TPOSWCntr
    }
    FIELD fQca_TruncpagelastCnt              (Fixed 2 Bytes)       (Decimal)          "Paging slots in last interval"
    FIELD fQca_TruncCycleslineNo             (Fixed 2 Bytes)       (Decimal)                "Line No"
    FIELD fQca_TruncOldState                 (Fixed 1 Bytes)       (TABLE tTruncPageState)   "Old state"
    FIELD fQca_TruncNewState                 (Fixed 1 Bytes)       (TABLE tTruncPageState)   "New State"
    FIELD fQca_TruncErrReason                (Fixed 1 Bytes)       (Decimal)                "ErrorReason"
}


TABLE tTruncPageState
    { 0 "Disabled"}
    { 1 "Paused"}
    { 2 "Started (but element not in SLC)"}
    { 3 "Running"}
    { 4 "Terminating"}
    {default "Invalid"}
ENDTABLE

TABLE tQca_IsoType
    { 0 "CIS Master"}
    { 1 "CIS Slave"}
    { 2 "BIS Broadcaster"}
    { 3 "BIS Sync"}
    {default "Invalid"}
ENDTABLE

GROUP gQca_STAT_IsoConnStats "ISO Stats"
{
    FIELD fQca_IsoType                            (Fixed 1 Bytes)       (TABLE tQca_IsoType)        "ISO Type"
    FIELD fQca_IsoStatsHandle                     (Fixed 1 Bytes)       (Decimal)                   "Connection Handle"
	RESERVED                                      (Fixed 1 Bytes)
    FIELD fQca_IsoStatsCxmDenials                 (Fixed 1 Bytes)       (Decimal)                   "Coex Manager Denials"
    GROUP gQca_STAT_CisStats IF (FieldIs LessThanOrEqualTo 1 fQca_IsoType) 
    {
        GROUP gQca_STAT_CisTxStats "TX"
        {
            FIELD fQca_IsoStatsAcked                  (Fixed 4 Bytes)       (Decimal)          "Acked"
            FIELD fQca_IsoStatsTxFlush                (Fixed 4 Bytes)       (Decimal)          "Flush"
            FIELD fQca_IsoStatsUnacked                (Fixed 4 Bytes)       (Decimal)          "Unacked"
            FIELD fQca_IsoStatsLastSub                (Fixed 4 Bytes)       (Decimal)          "Tx In Last Subevent"
            FIELD fQca_IsoStatsRetrans                (Fixed 4 Bytes)       (Decimal)          "Retransmission"
        }
        GROUP gQca_STAT_CisRxStats "RX"
        {
            FIELD fQca_IsoStatsGood                   (Fixed 4 Bytes)       (Decimal)          "Good"
            FIELD fQca_IsoStatsRxFlush                (Fixed 4 Bytes)       (Decimal)          "Flush"
            FIELD fQca_IsoStatsMiss                   (Fixed 4 Bytes)       (Decimal)          "Missing(No Packet Received)"
            FIELD fQca_IsoStatsAbort                  (Fixed 4 Bytes)       (Decimal)          "Abort(Due to Unexpected Length)"
            FIELD fQca_IsoStatsCrcBad                 (Fixed 4 Bytes)       (Decimal)          "CRC Bad"
            FIELD fQca_IsoStatsDuplicate              (Fixed 4 Bytes)       (Decimal)          "Retransmission"
        }
    }

    GROUP gQca_STAT_BisBroadcasterStats IF (FieldIs EqualTo 2 fQca_IsoType) 
    {
        GROUP gQca_STAT_BisTxStats "TX"
        {
            FIELD fQca_IsoStatsTxReserved             (Fixed 4 Bytes)       (Decimal)          "Reserved"
            FIELD fQca_IsoStatsTxFlush;
            RESERVED                                  (Fixed 8 Bytes)
            FIELD fQca_IsoStatsRetrans;
            RESERVED                                  (Fixed 24 Bytes)
        }
    }

    GROUP gQca_STAT_BisSyncStats IF (FieldIs EqualTo 3 fQca_IsoType) 
    {
        GROUP gQca_STAT_BisRxStats "RX"
        {
            RESERVED                                  (Fixed 20 Bytes)
            FIELD fQca_IsoStatsGood;
            FIELD fQca_IsoStatsRxFlush;
            FIELD fQca_IsoStatsMiss;
            FIELD fQca_IsoStatsAbort;
            FIELD fQca_IsoStatsCrcBad;
            RESERVED                                  (Fixed 4 Bytes)
        }
    }
}

GROUP gQca_StatRetranPktStatus "RetransPkt Stats"
{
	FIELD fQca_statRxCryptoReg        					(Fixed 2 Bytes)     (Hex)      "RxCryptoReg"
    FIELD fQca_stat0				   					(Fixed 2 Bytes)     (Hex)      "HWIO_PP_BTC_SC_INT_RAW_STAT_0_IN"
    FIELD fQca_statCmdDone      	  					(Fixed 2 Bytes)     (Hex)      "CmdDone"
    FIELD fQca_statrxFifoLen      	  					(Fixed 2 Bytes)     (Hex)      "RxLen expect2"
    FIELD fQca_statrxPayloadCnt      					(Fixed 2 Bytes)     (Hex)      "rxPayloadCnt(0/1)"
    FIELD fQca_statRxStatus						      	(Fixed 2 Bytes)     (Hex)      "RxStatus"
}

GROUP gQca_OBEX_bbBwReport "OBEX baseband bandwidth report"
{
	FIELD fQca_bbBwReport_handle;
	FIELD fQca_bbBwReport_type;
	FIELD fQca_bbBwReport_dir;
	RESERVED (Fixed 1 Bytes)
	FIELD fQca_bbBwReport_empty;
	FIELD fQca_bbBwReport_overall;
	FIELD fQca_bbBwReport_overallretrans;
	FIELD fQca_bbBwReport_slotsUsed;
	GROUP gQca_OBEX_bbBwReport_edrStat IF (FieldIs EqualTo 0x00 fQca_bbBwReport_type) "EDR packet statistics"
	{
		FIELD fQca_bbBwReport_edr1Slot;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr2slot;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr3slot;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr4slot;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr5slot;
		RESERVED (Fixed 2 Bytes)
	}
	GROUP gQca_OBEX_bbBwReport_QHSStat IF (FieldIs EqualTo 0x01 fQca_bbBwReport_type) "QHS packet statistics"
	{
		FIELD fQca_bbBwReport_qhs2M_s1;
		FIELD fQca_bbBwReport_qhs2M_s3;
		FIELD fQca_bbBwReport_qhs3M_s1;
		FIELD fQca_bbBwReport_qhs3M_s3;
		FIELD fQca_bbBwReport_qhs4M_s1;
		FIELD fQca_bbBwReport_qhs4M_s3;
		FIELD fQca_bbBwReport_qhs5M_s1;
		FIELD fQca_bbBwReport_qhs5M_s3;
		FIELD fQca_bbBwReport_qhs6M_s1;
		FIELD fQca_bbBwReport_qhs6M_s3;
	}
	FIELD fQca_bbBwReport_retrans;
	GROUP gQca_OBEX_bbBwReport_edrStatRetrans IF (FieldIs EqualTo 0x00 fQca_bbBwReport_type) "EDR Retrans packet statistics"
	{
		FIELD fQca_bbBwReport_edr1SlotRetrans;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr2slotRetrans;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr3slotRetrans;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr4slotRetrans;
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr5slotRetrans;
		RESERVED (Fixed 2 Bytes)
	}
	GROUP gQca_OBEX_bbBwReport_QHSStatRetrans IF (FieldIs EqualTo 0x01 fQca_bbBwReport_type) "QHS packet Retrans statistics"
	{
		FIELD fQca_bbBwReport_qhs2M_s1Retrans;
		FIELD fQca_bbBwReport_qhs2M_s3Retrans;
		FIELD fQca_bbBwReport_qhs3M_s1Retrans;
		FIELD fQca_bbBwReport_qhs3M_s3Retrans;
		FIELD fQca_bbBwReport_qhs4M_s1Retrans;
		FIELD fQca_bbBwReport_qhs4M_s3Retrans;
		FIELD fQca_bbBwReport_qhs5M_s1Retrans;
		FIELD fQca_bbBwReport_qhs5M_s3Retrans;
		FIELD fQca_bbBwReport_qhs6M_s1Retrans;
		FIELD fQca_bbBwReport_qhs6M_s3Retrans;
	}
	GROUP gQca_OBEX_bbBwReport_TxerrorStatus IF (FieldIs EqualTo 0x00 fQca_bbBwReport_dir)
	{
		FIELD fQca_bbBwReport_RfLoss;
		FIELD fQca_bbBwReport_Nak;
		FIELD fQca_bbBwReport_txAbort;
		FIELD fQca_bbBwReport_txDenial;
	}
	GROUP gQca_OBEX_bbBwReport_RxerrorStatus IF (FieldIs EqualTo 0x01 fQca_bbBwReport_dir)
	{
		FIELD fQca_bbBwReport_errNoAec;
		FIELD fQca_bbBwReport_errHecBad;
		FIELD fQca_bbBwReport_errCrcBad;
		FIELD fQca_bbBwReport_errPhyError;
	}
	FIELD fQca_bbBwReport_txPwr;
}

TABLE tackankType
    {0 "INVALID"}
    {1 "Explicit NAK"}
    {2 "Implicit NAK"}
    {3 "ACK"}
ENDTABLE

GROUP  gQca_STAT_AsdStats "ASDStats"
{
	FIELD fQca_STAT_AsdStats_iirAck0 		(Fixed 4 Bytes) (Decimal)   		"ANT0 IIR Ack"
    FIELD fQca_STAT_AsdStats_iirRssi0  		(Fixed 4 Bytes) (Decimal)   		"ANT0 IIR RSSI"
    FIELD fQca_STAT_AsdStats_ackNakCnt0 	(Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)   "ANT0 ACK/NAK count"
	RESERVED (Fixed 3 Bytes)	
	FIELD fQca_STAT_AsdStats_iirAck1 		(Fixed 4 Bytes) (Decimal)   		"ANT1 IIR Ack"
    FIELD fQca_STAT_AsdStats_iirRssi1  		(Fixed 4 Bytes) (Decimal)   		"ANT1 IIR RSSI"
    FIELD fQca_STAT_AsdStats_ackNakCnt1 	(Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)   "ANT1 ACK/NAK count"	
	FIELD fQca_STAT_AsdStats_isAck  		(Fixed 1 Bytes) (Decimal)   		"ACK"
	
	/* Make sure acknakType is present 23 bytes ahead of isACK in SDB_LOG_ACTIVE_ASD_STATS_TYPE structure for proper decoding */
	FIELD fQca_STAT_AsdStats_acknakTypedummy START_BIT (Move 23 Bytes) (Fixed 1 Bytes) (Decimal) SUPPRESS_DETAIL NO_MOVE	
	FIELD fQca_STAT_AsdStats_rssi  		    (Fixed 2 Bytes) IF(FieldIs NotEqualTo 2 fQca_STAT_AsdStats_acknakTypedummy) RETRIEVE (SignExtension 16) (Decimal)  		"RSSI" 
	FIELD fQca_STAT_AsdStats_rssi2  	    (Fixed 2 Bytes) IF(FieldIs EqualTo 2 fQca_STAT_AsdStats_acknakTypedummy)    RETRIEVE (SignExtension 16) (Decimal) SUPPRESS_DETAIL 
	FIELD fQca_STAT_AsdStats_isShadowState  (Fixed 1 Bytes) (Decimal)   		"Shadowing State"
	RESERVED (Fixed 1 Bytes)	
	FIELD fQca_STAT_AsdStats_alloc0  		(Fixed 2 Bytes) (Decimal)   		"Allocation0"
	FIELD fQca_STAT_AsdStats_selAntenna  	(Fixed 1 Bytes) (Decimal)   		"Selected Antenna"
	FIELD fQca_STAT_AsdStats_calcAntenna  	(Fixed 1 Bytes) (Decimal)   		"Calculated Antenna"
	FIELD fQca_STAT_AsdStats_targetLoss  	(Fixed 2 Bytes) (Decimal)   		"Target Loss"	
	FIELD fQca_STAT_AsdStats_desiredAlloc  	(Fixed 4 Bytes) (Decimal)   		"Desired Allocation"
	FIELD fQca_STAT_AsdStats_allocError 	(Fixed 4 Bytes) RETRIEVE (SignExtension 32) (Decimal)   		"Allocation Error"
	FIELD fQca_STAT_AsdStats_mu			 	(Fixed 2 Bytes) (Decimal)   		"MU"
	FIELD fQca_STAT_AsdStats_decCnt		 	(Fixed 2 Bytes) RETRIEVE (SignExtension 16) (Decimal)   		"Decremental Count"
	FIELD fQca_STAT_AsdStats_connHandle  	(Fixed 1 Bytes) (Decimal)   		"ConnHandle"
	FIELD fQca_STAT_AsdStats_acknakType		(Fixed 1 Bytes) (TABLE tackankType) "ACK NAK type"	
	FIELD fQca_STAT_AsdStats_frameAntenna	(Fixed 1 Bytes) (Decimal)   		"Frame Antenna"		

}

GROUP gQca_STAT_AsdStatsExt "ASDStats Ext"
{
    FIELD fQca_STAT_AsdStats_pClk  	        (Fixed 4 Bytes) (Hex)   		                    "PiconetClk"
	FIELD fQca_STAT_AsdStats_rxFailCnt  	(Fixed 1 Bytes) (Decimal)   		                "RxFailContinousCount"    
    FIELD fQca_STAT_AsdStats_TxASDGranted  	(Fixed 1 Bytes) (Decimal)   		                "TxASDGranted"
    FIELD fQca_STAT_AsdStats_RxASDGranted  	(Fixed 1 Bytes) (Decimal)   		                "RxASDGranted"
    FIELD fQca_STAT_AsdStats_MCI_STATE  	(Fixed 1 Bytes) (Table tQca_CXM_CoexMciState_Type)  "MCI STATE"
    FIELD fQca_STAT_AsdStats_remoteSleepState  	(Fixed 1 Bytes) (Decimal)   		            "remoteSleepState"
    FIELD fQca_STAT_AsdStats_is2GConnected  	(Fixed 1 Bytes) (Decimal)                       "is2GConnected"
    FIELD fQca_STAT_AsdStats_is2GScanning  	    (Fixed 1 Bytes) (Decimal)                       "is2GScanning"
}

GROUP gQca_STAT_A2dpSinkConnStats "A2DP Sink Stall Connection Stats"
{
    FIELD fQca_A2DPSinkPktNo                   (Fixed 1 Byte)                                                                                           (Decimal)  "PktNo"
    FIELD fQca_A2DPSinkConnHandle              (Fixed 1 Byte)                                                                                           (Decimal)  "ConnHandle"
    FIELD fQca_A2DPSinkpktType                 (Fixed 1 Byte)                                                                                           (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2DPSinkltType                  (Fixed 1 Byte)  RETRIEVE (MultiplyInteger 16) ALSO (AddField fQca_A2DPSinkpktType) (Table ACL_PACKETTYPE)           "pktType"
    GROUP gQca_STAT_ACLPerPktStats;
    FIELD fQca_A2dpSinkRxLength                (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0)                                                          (Decimal)  "Rx Length"
    FIELD fQca_A2dpSinkRSSI                    (Fixed 2 Bytes) RETRIEVE (SignExtension 8)                                                               (Decimal)  "RSSI"
    FIELD fQca_A2dpSinkPiconetClock            (Fixed 4 Bytes)                                                                                          (Hex)      "PiconetClock"
    FIELD fQca_A2dpSinkClockOffset             (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkTimeLastAck             (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkTimeLastAck1            (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkTimeLastAck) ALSO (OrMask 0x10000000)             (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkTimeLastAck2            (Fixed 0)       RETRIEVE       (AddFieldToField fQca_A2dpSinkTimeLastAck1 fQca_A2dpSinkClockOffset)       (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkArrivalTime             (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkArrivalTime1            (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkArrivalTime) ALSO (OrMask 0x10000000)            (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkArrivalTime2            (Fixed 0)       RETRIEVE       (AddFieldToField fQca_A2dpSinkArrivalTime1 fQca_A2dpSinkClockOffset)      (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkSchedInstant            (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkSchedInstant1           (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkSchedInstant) ALSO (OrMask 0x10000000)           (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkSchedInstant2           (Fixed 0)       RETRIEVE       (AddFieldToField fQca_A2dpSinkSchedInstant1 fQca_A2dpSinkClockOffset)     (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastAckInstant        (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastAckInstant1       (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkLastAckInstant) ALSO (OrMask 0x10000000)       (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastAckInstant2       (Fixed 0)       RETRIEVE       (AddFieldToField fQca_A2dpSinkLastAckInstant1 fQca_A2dpSinkClockOffset) (Hex)      SUPPRESS_DETAIL

    /* Do not display if the clock values are invalid */
    FIELD fQca_A2dpSinkLastFlowOffClk          (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastFlowOffClk1         (Fixed 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOffClk) ELSE_SKIP (FIXED 0) RETRIEVE (StoreField fQca_A2dpSinkLastFlowOffClk) ALSO (OrMask 0x10000000)   (Hex) SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastFlowOffClk2         (Fixed 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOffClk) ELSE_SKIP (FIXED 0) RETRIEVE (AddFieldToField fQca_A2dpSinkLastFlowOffClk1 fQca_A2dpSinkClockOffset) (Hex) SUPPRESS_DETAIL

    /* Do not display if the clock values are invalid */
    FIELD fQca_A2dpSinkLastFlowOnClk           (Fixed 4 Bytes)                                                                                          (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastFlowOnClk1          (Fixed 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE   (StoreField fQca_A2dpSinkLastFlowOnClk) ALSO (OrMask 0x10000000)    (Hex)  SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastFlowOnClk2          (Fixed 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOnClk) ELSE_SKIP (FIXED 0) RETRIEVE   (AddFieldToField fQca_A2dpSinkLastFlowOnClk1 fQca_A2dpSinkClockOffset)  (Hex)  SUPPRESS_DETAIL

    FIELD fQca_A2dpSinkAckInstantPnet          (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkTimeLastAck2) ALSO (OrMask 0x10000000)                (Hex)      "AckInstant"
    FIELD fQca_A2dpSinkArrivalTimePnet         (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkArrivalTime2) ALSO (OrMask 0x10000000)               (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkSchedInstantPnet        (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkSchedInstant2) ALSO (OrMask 0x10000000)              (Hex)      SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkLastTxAckInstantPnet    (Fixed 0)       RETRIEVE       (StoreField fQca_A2dpSinkLastAckInstant2) ALSO (OrMask 0x10000000)          (Hex)      "LastTxAckInstant"

    FIELD fQca_A2dpSinkPrevtoCurrAckDelay      (Fixed 0)       RETRIEVE       (SubtractFieldMinusField fQca_A2dpSinkTimeLastAck fQca_A2dpSinkLastAckInstant)   (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkPrevtoCurrAckDelay1     (Fixed 0)       RETRIEVE       (MultiplyFieldByInteger fQca_A2dpSinkPrevtoCurrAckDelay 625)                  (Decimal)  SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkPrevtoCurrAckDelay2     (Fixed 0)       RETRIEVE       (DivideFieldByInteger fQca_A2dpSinkPrevtoCurrAckDelay1 2000)                  (Decimal)  "PrevToCurrPktAckDelay(ms)"

    FIELD fQca_A2dpSinkLastFlowOffClkPnet      (FIXED 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOffClk) ELSE_SKIP (FIXED 0) RETRIEVE  (StoreField fQca_A2dpSinkLastFlowOffClk) ALSO (OrMask 0x10000000) (Hex) "LastFlowOffClk"
    FIELD fQca_A2dpSinkLastFlowOnClkPnet       (Fixed 0)   IF (FieldIs NotEqualTo 0xFFFFFFFF fQca_A2dpSinkLastFlowOnClk)  ELSE_SKIP (FIXED 0) RETRIEVE  (StoreField fQca_A2dpSinkLastFlowOnClk2) ALSO (OrMask 0x10000000) (Hex) "LastFlowOnClk"

    /* Do not display if the clock values are invalid */
    FIELD fQca_A2dpSinkCoexCriticalPriorityClk (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF)                                                 (Hex)      "CoexCriticalPriorityClk"
    FIELD fQca_A2dpSinkCoexNormalPriorityClk   (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0xFFFFFFFF)                                                 (Hex)      "CoexNormalPriorityClk"
    FIELD fQca_A2dpSinkWBtime                  (Fixed 4 Bytes)                                                                                          (Hex)      "WBtime"

    FIELD fQca_A2dpSinkPacketLatency            (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_A2dpSinkTimeLastAck fQca_A2dpSinkArrivalTime2) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkPacketLatencyTemp        (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_A2dpSinkPacketLatency 625) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_A2dpSinkPacketLatencyInMicrosec  (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_A2dpSinkPacketLatencyTemp 2) (Decimal) SUPPRESS_DETAIL
}
