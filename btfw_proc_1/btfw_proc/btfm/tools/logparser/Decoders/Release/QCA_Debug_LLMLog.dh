    FIELD fQca_BigParamsPto                  (Fixed 1 Bytes)      (Decimal)                                 "PTO"
    FIELD fQca_BigParamsEnc                  (Fixed 1 Bytes)      (Decimal)                                 "Encryption"
    FIELD fQca_BigParamsPwrLvl               (Fixed 1 Bytes)      (Decimal)                                 "Tx Power Level"

    FIELD fQca_BigParamsBrctCode             (Fixed 16 Bytes)     (Hex)                                     "Broadcast Code"

    FIELD fQca_IsoParamsMaxPdu;
    FIELD fQca_IsoParamsMaxSdu;

    FIELD fQca_IsoParamsIsoInterval;
    RESERVED                                 (Fixed 2 Bytes)

