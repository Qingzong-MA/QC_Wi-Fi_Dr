From 273372d2e659503b69da52f3f85c4ba393a9f8a0 Mon Sep 17 00:00:00 2001
From: "hardy.zhang" <hardy.zhang@quectel.com>
Date: Tue, 23 Apr 2024 16:13:04 +0800
Subject: [PATCH 1/1] add VHT and HE in sta flags which can find by hostapd_cli
 command

---
 .../wpa_supplicant_8/src/ap/drv_callbacks.c     | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/source/quectel/wlan/wpa_supplicant_8/src/ap/drv_callbacks.c b/source/quectel/wlan/wpa_supplicant_8/src/ap/drv_callbacks.c
index ec5abf166..88bff09ca 100644
--- a/source/quectel/wlan/wpa_supplicant_8/src/ap/drv_callbacks.c
+++ b/source/quectel/wlan/wpa_supplicant_8/src/ap/drv_callbacks.c
@@ -222,6 +222,23 @@ int hostapd_notif_assoc(struct hostapd_data *hapd, const u8 *addr,
 	}
 	sta->flags &= ~(WLAN_STA_WPS | WLAN_STA_MAYBE_WPS | WLAN_STA_WPS2);
 
+	//add by quectel
+	if(elems.ht_capabilities){
+		wpa_printf(MSG_DEBUG, "STA HT Capabilities IE in (Re)AssocReq");
+		sta->flags |= WLAN_STA_HT;
+	}
+
+	if(elems.vht_capabilities){
+		wpa_printf(MSG_DEBUG, "STA VHT Capabilities IE in (Re)AssocReq");
+		sta->flags |= WLAN_STA_VHT;
+	}
+
+	if(elems.he_capabilities){
+		wpa_printf(MSG_DEBUG, "STA HE Capabilities IE in (Re)AssocReq");
+		sta->flags |= WLAN_STA_HE;
+	}
+	//end by quectel
+
 	/*
 	 * ACL configurations to the drivers (implementing AP SME and ACL
 	 * offload) without hostapd's knowledge, can result in a disconnection
-- 
