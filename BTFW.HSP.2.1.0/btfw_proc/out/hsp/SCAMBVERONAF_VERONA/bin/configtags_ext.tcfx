    <TAG Number="42" Name="Radio Gain Setting Override">
      <DESCRIPTION>This tag provides Radio Gain information including raw data values for certain dBm values.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="RM_GAIN_FACTOR_TABLE" Type="STRUCTURE" Size="56">
        <ELEMENTS Name="dBm_Golden_Lower" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0xCE" Signed="true" Description="Golden Range lower threshold in dBm" />
        <ELEMENTS Name="dBm_Golden_Upper" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0xDD" Signed="true" Description="Golden Range upper threshold in dBm" />
        <ELEMENTS Name="dBm_EDR_ACL_CQDDR" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0xB2" Signed="true" Description="EDR ACL CQDDR Switching Threashold in dBM (default -78)" />
        <ELEMENTS Name="Reserved_0" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="" />
        <ELEMENTS Name="XlnaFactorsx256" Type="FIXED_ARRAY" ElementSize="2" Size="22" Min="0x0" Max="0xFFFF" Signed="false" Description="XLNA Factor premultiplied by 256" VariableName="XLNA Factor">
          <ELEMENTS Name="XLNA Factor_0" Default="0x100" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_1" Default="0x11F" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_2" Default="0x142" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_3" Default="0x169" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_4" Default="0x195" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_5" Default="0x1C7" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_6" Default="0x1FE" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_7" Default="0x23D" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_8" Default="0x283" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_9" Default="0x2D1" Description="XLNA Factor premultiplied by 256" />
          <ELEMENTS Name="XLNA Factor_10" Default="0x329" Description="XLNA Factor premultiplied by 256" />
        </ELEMENTS>
        <ELEMENTS Name="XlnaDisabledFactorx256" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0xA00" Signed="false" Description="XLNA factor when xlna is disabled premultiplied by 256" />
        <ELEMENTS Name="GainFactorsx16" Type="FIXED_ARRAY" ElementSize="2" Size="16" Min="0x0" Max="0xFFFF" Signed="false" Description="Gain Factor premultiplied by 16" VariableName="Gain Factor">
          <ELEMENTS Name="Gain Factor_0" Default="0x10" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_1" Default="0x1F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_2" Default="0x3F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_3" Default="0x7F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_4" Default="0xFD" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_5" Default="0x1F9" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_6" Default="0x3F1" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_7" Default="0x7DE" Description="Gain Factor premultiplied by 16" />
        </ELEMENTS>
        <ELEMENTS Name="lowToHighGainFactor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Obsoleted for Rome. Used to adjust RM RSSI to RSSI_raw if in low gain = 10^(37/20)" />
        <ELEMENTS Name="nominalToHighGainFactor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Obsoleted for Rome. Used to adjust RM RSSI to RSSI_raw if in nominal gain = 10^(16/20)" />
        <ELEMENTS Name="RssiGainFactor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x9F" Signed="false" Description="used to convert RSSI_raw to dBm" />
        <ELEMENTS Name="RSSI_Calculations" Type="ENUM" Size="1" Default="0x1" Signed="false">
          <ELEMENTS Name="Iris" Default="0x0" Description="RSSI calculations for IRIS" />
          <ELEMENTS Name="Rome" Default="0x1" Description="RSSI calculations for Rome" />
        </ELEMENTS>
        <ELEMENTS Name="TIA_MAX" Type="INTEGER" Size="1" Min="0x0" Max="0x3" Default="0x3" Signed="false" Description="Parameter used for RSSI calculation." />
        <ELEMENTS Name="GM_MAX" Type="INTEGER" Size="1" Min="0x0" Max="0x7" Default="0x7" Signed="false" Description="Parameter used for RSSI calculation." />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="2" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Rx_RSSI_DBM_Ctrl" Type="BITFIELD" Size="4">
          <ELEMENTS Name="Average_Default_Config" Default="0x1" Start="0" End="1" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for BR and EDR modes.  0x0: USE_4 - Use 4 p_in samples. 0x1: USE_8 - Use 8 p_in samples.  0x2: USE_16 - Use 16 p_in samples. 0x3: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="Reserved1" Default="0x0" Start="4" End="5" Description="" />
          <ELEMENTS Name="Reserved2" Default="0x0" Start="8" End="9" Description="" />
          <ELEMENTS Name="Average_Partial_Config" Default="0x1" Start="12" End="13" Description="Number of AGC p_in samples to calculate averaged RSSI in dBm for RX partial mode. 0x0: USE_4 - Use 4 p_in samples. 0x1: USE_8 - Use 8 p_in samples. 0x2: USE_16 - Use 16 p_in samples. 0x3: USE_32 - Use 32 p_in samples." />
          <ELEMENTS Name="RSSI_Interface_Type" Default="0x0" Start="16" End="16" Description="AGC RSSI interface type between modem and packet processor. 0x0: LINEAR - Linear RSSI interface type, in which the timing of RSSI value captured by packet processor is driven by linear RSSI calculation. 0x1: AVERAGED_DBM - Averaged RSSI in dBm interface type, in which the timing of RSSI value captured by packet processor is driven by averaged RSSI in dBm calculation." />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
