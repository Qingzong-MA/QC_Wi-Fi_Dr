GROUP gQca_ConfigDataPathVendorInfo "Config Data Path Vendor Info"
{
    GROUP gQca_bitMapOfVendorDataFields "Bitmap of Valid fields"
    {
        FIELD fQca_bitMapOfVendorFields_byte0_bit7 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit7 : Codec ID"
        FIELD fQca_bitMapOfVendorFields_byte0_bit6 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit6 : HCI connection handle"
        FIELD fQca_bitMapOfVendorFields_byte0_bit5 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit5 : Slimbus Transport Rate"
        FIELD fQca_bitMapOfVendorFields_byte0_bit4 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit4 : Preferred RX QHS Phy"
        FIELD fQca_bitMapOfVendorFields_byte0_bit3 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit3 : Preferred TX QHS Phy"
        FIELD fQca_bitMapOfVendorFields_byte0_bit2 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit2 : Use case Identifier"
        FIELD fQca_bitMapOfVendorFields_byte0_bit1 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit1 : Sampling frequency"
        FIELD fQca_bitMapOfVendorFields_byte0_bit0 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte0 Bit0 : Codec version"

        FIELD fQca_bitMapOfVendorFields_byte1_bit7 (Fixed 1 Bit) (Hex)              "Byte1 Bit7 : Reserved"
        FIELD fQca_bitMapOfVendorFields_byte1_bit6 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit6 : Minimum FT"
        FIELD fQca_bitMapOfVendorFields_byte1_bit5 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit5 : Maximum FT"
        FIELD fQca_bitMapOfVendorFields_byte1_bit4 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit4 : CIS Relay info"
        FIELD fQca_bitMapOfVendorFields_byte1_bit3 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit3 : MPC Info"
        FIELD fQca_bitMapOfVendorFields_byte1_bit2 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit2 : Transport Sample Width"
        FIELD fQca_bitMapOfVendorFields_byte1_bit1 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit1 : Controller delay in microseconds"
        FIELD fQca_bitMapOfVendorFields_byte1_bit0 (Fixed 1 Bit) (TABLE tQca_Valid) "Byte1 Bit0 : Transport Data Format"

        FIELD fQca_bitMapOfVendorFields_resbytes (Fixed 6 Bytes) (Hex) "Reserved"
    }
    FIELD fQca_rsvd                     (Fixed 4 Bytes) (Hex) "Reserved"
    FIELD fQca_controllerDelayInUs      (Fixed 4 Bytes) (Decimal) "Controller delay in microseconds"
    FIELD fQca_companyId                (Fixed 2 Bytes) (TABLE tQca_companyID) "Company ID"
    FIELD fQca_vendorCodecId            (Fixed 2 Bytes) (TABLE tQca_VendorCodecID) "Vendor Codec ID"
    FIELD fQca_hci_ConnHandle           (Fixed 2 Bytes) (Hex) "HCI connection handle"
    FIELD fQca_codingFormat             (Fixed 1 Byte)  (TABLE tQca_CodecFormat) "Coding Format"
    FIELD fQca_codecVersion             (Fixed 1 Byte)  (Decimal) "Codec Version"
    FIELD fQca_sampling_Frequency       (Fixed 1 Byte)  (TABLE tQca_sampleFrequency) "Sampling frequency"
    FIELD fQca_usecaseID                (Fixed 1 Byte)  (TABLE tQca_UseCaseID) "Use case Identifier"
    FIELD fQca_prefTxQHSPhy             (Fixed 1 Byte)  (TABLE tQca_QHSrate) "Preferred TX QHS Phy"
    FIELD fQca_prefRxQHSPhy             (Fixed 1 Byte)  (TABLE tQca_QHSrate) "Preferred RX QHS Phy"
    FIELD fQca_mpcInfo_version          (Fixed 1 Byte)  (Hex) "MPC Info Version"
    FIELD fQca_mpcInfo_cigId            (Fixed 1 Byte)  (Hex) "MPC Info CIG ID"
    GROUP gQca_cisRelayInfo "CIS Relay Info" 
    {
        FIELD fQca_cisRelayInfo_bit7  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit6  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit5  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit4  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit3  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit2  (Fixed 1 Bit) (Hex) "Reserved"
        FIELD fQca_cisRelayInfo_bit1  (Fixed 1 Bit) (TABLE tQca_Enabled) "Bit1 : CIS ownership has to be transferred to new Connected Peripheral during a Primary-Secondary switch"
        FIELD fQca_cisRelayInfo_bit0  (Fixed 1 Bit) (TABLE tQca_Enabled) "Bit0 : CIS Will be relayed"
    }
    FIELD fQca_transportDataFormat      (Fixed 1 Byte) (TABLE tQca_TransportDataFormat) "Transport Data Format"
    FIELD fQca_transportSampleWidth     (Fixed 1 Byte) (Decimal) "Transport Sample Width"
    FIELD fQca_maxFT                    (Fixed 1 Byte) (Decimal) "Maximum FT"
    FIELD fQca_minFT                    (Fixed 1 Byte) (Decimal) "Minimum FT"
    FIELD fQca_slimbusTransportRate     (Fixed 1 Byte) (TABLE tQca_slimbusTransportRate) "Slimbus Transport Rate"
}

