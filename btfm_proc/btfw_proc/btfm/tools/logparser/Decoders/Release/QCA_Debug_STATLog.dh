{
    FIELD fQca_BredrGenInqIDsTx                  (Fixed 2 Bytes)     (Decimal)       "InqIDsTx"
    FIELD fQca_BredrGenInqIDsCxmAbort            (Fixed 2 Bytes)     (Decimal)       "InqIDsCxmAbort"
    FIELD fQca_BredrGenPageIDsTx                 (Fixed 2 Bytes)     (Decimal)       "PageIDsTx"
    FIELD fQca_BredrGenPageIDsCxmAbort           (Fixed 2 Bytes)     (Decimal)       "PageIDsCxmAbort"
    FIELD fQca_BredrGenPScanSlots                (Fixed 2 Bytes)     (Decimal)       "PScanSlots"
    FIELD fQca_BredrGenPScanCxmAbort             (Fixed 2 Bytes)     (Decimal)       "PScanCxmAbort"
    FIELD fQca_BredrGenPScanAborts               (Fixed 2 Bytes)     (Decimal)       "PScanAborts"
    FIELD fQca_BredrGenPScanLateCommands         (Fixed 2 Bytes)     (Decimal)       "PScanLateCommands"
    FIELD fQca_BredrGenIScanSlots                (Fixed 2 Bytes)     (Decimal)       "IScanSlots"
    FIELD fQca_BredrGenIScanCxmAbort             (Fixed 2 Bytes)     (Decimal)       "IScanCxmAbort"
    FIELD fQca_BredrGenIScanAborts               (Fixed 2 Bytes)     (Decimal)       "IScanAborts"
    FIELD fQca_BredrGenIScanLateCommands         (Fixed 2 Bytes)     (Decimal)       "IScanLateCommands"
    FIELD fQca_BredrGenMACLConnCount             (Fixed 1 Byte)      (Decimal)       "ACLMConnCount"
    FIELD fQca_BredrGenSACLConnCount             (Fixed 1 Byte)      (Decimal)       "ACLSConnCount"
    FIELD fQca_BredrGenPscanBTConnCount          (Fixed 1 Byte)      (Decimal)       "PscanBTConnCount"
    FIELD fQca_BredrGenSCOConnCount              (Fixed 1 Byte)      (Decimal)       "SCOConnCount"

}

GROUP gQca_STAT_ActiveConnSummary "Active Connection Summary"
{
    GROUP gQca_STAT_ConnStats;
    FIELD fQca_ActiveConnPiconetClock       (Fixed 4 Bytes)     (Hex)           "PiconetClock"
    FIELD fQca_ActiveConnLastAckClk         (Fixed 4 Bytes)     (Hex)           "LastAckClk"
    FIELD fQca_ActiveConnConnHandle         (Fixed 2 Bytes)     (Decimal)       "ConnHandle"
    FIELD fQca_ActiveConnLSTO               (Fixed 2 Bytes)     (Decimal)       "LSTO"
    FIELD fQca_ActiveConnConnInterval       (Fixed 2 Bytes)     (Decimal)       "ConnInterval"
    FIELD fQca_ActiveConnConnType           (Fixed 1 Byte)      (TABLE tQca_STATConnType)    "ConnType"
    FIELD fQca_ActiveConnRole               (Fixed 1 Byte)      (TABLE tQca_DeviceRole)      "Role"
    FIELD fQca_ActiveConnState              (Fixed 1 Byte)      (TABLE tQca_ConnState)       "State"
    FIELD fQca_ActiveL2capProfiles          (Fixed 1 Byte)      (Hex)           "L2CAP Profiles"
    FIELD fQca_ActiveObexProfiles           (Fixed 1 Byte)      (Hex)           "OBEX Profiles"
    Group gQca_activeConnStatsWarAttrMask;
}

GROUP gQca_STAT_CoexAbortReason "Coex Abort Reason Stats"
{
    FIELD fQca_LTE_Count                    (Fixed 2 Bytes)     (Decimal)       "LTECount"
    FIELD fQca_sPTA_Count                   (Fixed 2 Bytes)     (Decimal)       "sPTACount"
    FIELD fQca_WLAN_Count                   (Fixed 2 Bytes)     (Decimal)       "WLANCount"
    FIELD fQca_internalarbitration_Count    (Fixed 2 Bytes)     (Decimal)       "internalarbitrationCount"
    FIELD fQca_UWBNakCount_Count            (Fixed 2 Bytes)     (Decimal)       "UWBCount"
    FIELD fQca_paBlank_Count                (Fixed 2 Bytes)     (Decimal)       "PA Blank Count"
    FIELD fQca_paMute_Count                 (Fixed 2 Bytes)     (Decimal)       "PA Mute Count"
    Reserved                                (Fixed 2 Bytes)
}

GROUP gQca_STAT_ActiveConnStats "Active Connection Stats"
{
    FIELD fQca_ActiveSlotsAlloc             (Fixed 4 Bytes)     (Decimal)       "SlotsAlloc"
    FIELD fQca_ActiveSlotsUsed              (Fixed 4 Bytes)     (Decimal)       "SlotsUsed"
    FIELD fQca_ActiveCxmDenials             (Fixed 2 Bytes)     (Decimal)       "CxmDenials"
    FIELD fQca_ActiveLocalRetrans           (Fixed 2 Bytes)     (Decimal)       "LocalRetrans"
    FIELD fQca_ActiveRemoteRetrans          (Fixed 2 Bytes) IF NOT (FieldIs EqualTo 5 fQca_sMainVer)  (Decimal)  "RemoteRetrans"
    FIELD fQca_ActiveTxSkip                 (Fixed 2 Bytes)     (Decimal)       "TxSkip"
    FIELD fQca_ActiveRfloss                 (Fixed 2 Bytes) IF NOT (FieldIs EqualTo 5 fQca_sMainVer)  (Decimal)  "RFLoss"
    FIELD fQca_ActiveDispatcherMisses       (Fixed 1 Bytes)     (Decimal)       "DispatcherMisses"
    FIELD fQca_LastAckRSSIdBm               (Fixed 1 Bytes)      RETRIEVE (SignExtension 8) (Decimal)   "LastAckRSSIdBm"
    GROUP gQca_STAT_CoexAbortReason;
    FIELD fQca_LnaChangedAfterLockCh0       (Fixed 2 Bytes)     (Decimal)       "LnaChangedAfterLockCh0"
    FIELD fQca_RxpktCount                   (Fixed 2 Bytes)     (Decimal)       "Rx Packet Count"
}

TABLE tQca_BBStats
    {0x0001 "Sync"}
    {0x0002 "Rx Data"}
    {0x0003 "Tx Success"}
    {0x0004 "Tx Abort"}
    {0x0005 "Cxm Denial"}
    {0x0006 "Tx Cmd late"}
    {0x0007 "Rx Cmd Late"}
    {0x0008 "Rx HEC"}
    {0x0009 "Rx CRC"}
    {0x000A "LE MIC Fail"}
    {0x000B "Rx Abort"}
    {0x000C "No Rx"}
    {0x000D "Abort Connection"}
    {0x000E "SW Late OR LE_RX_SKIP_SETUP"}
    {0x000F "Max OR LE_RX_NO_BUFF"}
    {default "Invalid"}
ENDTABLE

GROUP qQCA_STAT_coexAbortReason  "Coex Abort Reason"
{
    FIELD  fQca_ulmcoexAbortReasonwlanNakCount              (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "wlanNakCount"
    FIELD  fQca_ulmcoexAbortReasonlteNakCount               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "lteNakCount"
    FIELD  fQca_ulmcoexAbortReasonintArbitrationNakCount    (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "intArbitrationNakCount"
    FIELD  fQca_ulmcoexAbortReasonsPTANakCount              (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "sPTANakCount"
    FIELD  fQca_ulmcoexAbortReasonuwbNakCount               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "uwbNakCount"
    FIELD  fQca_ulmcoexAbortReasonwlanCalInProgress         (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "wlanCalInProgress"
    FIELD  fQca_ulmcoexAbortReasonstxAbortCount             (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "stxAbortCount"
    FIELD  fQca_ulmcoexAbortReasonsBlankCount               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "PA Blank count"
    FIELD  fQca_ulmcoexAbortReasonMuteCount                 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)     (Decimal)       "PA Mute Count"
    RESERVED                                                (Fixed 2 Bytes)
}

GROUP gQca_STAT_ConnStats_ULM "Connection Stats"
{
    GROUP gQca_STAT_ActiveConnStatsTx_ULM;
    GROUP gQca_STAT_ActiveConnStatsRx_ULM;
    /* Get Packet Stats Based on the ConnType */
    /* Read the Connection Type ahead to dynamically select the proper group for packet stats */
    /* When you are updating make sure all the Connection type groups are updated to same size */
    /* Also adjust this offset if any parameters are added before ConnType */
    FIELD fQca_ulmActiveConnType  START_BIT (Move 144 Bytes)   (Fixed 1 Byte) (Hex) SUPPRESS_DETAIL NO_MOVE
    BRANCH (FromTable   tQca_STATConnType_ULM   fQca_ulmActiveConnType)

    FIELD fQca_ulmActiveConnAclAckInstant             (Fixed 4 Bytes)      (Hex)     "AclAckInstant"
    FIELD fQca_ulmActiveConnA2DPAckInstant            (Fixed 4 Bytes)      (Hex)     "A2DPAckInstant"
    FIELD fQca_ulmActiveConnCoexNormalPriorityClk     (Fixed 4 Bytes)      (Hex)     "CoexNormalPriorityClk"
    FIELD fQca_ulmActiveConnCoexCriticalPriorityClk   (Fixed 4 Bytes)      (Hex)     "CoexCriticalPriorityClock"
    FIELD fQca_ulmActiveConnBBStat                    (Fixed 4 Bytes)      (Hex)     "BBStats"
    FIELD fQca_ulmActiveConnLastAclFlushClk           (Fixed 4 Bytes)      (Hex)     "lastAclFlushClk"

    FIELD fQca_UActiveConnBBStat_parse1  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 0)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_1"
    FIELD fQca_UActiveConnBBStat_parse2  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 4)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_2"
    FIELD fQca_UActiveConnBBStat_parse3  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 8)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_3"
    FIELD fQca_UActiveConnBBStat_parse4  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 12) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_4"
    FIELD fQca_UActiveConnBBStat_parse5  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 16) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_5"
    FIELD fQca_UActiveConnBBStat_parse6  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 20) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_6"
    FIELD fQca_UActiveConnBBStat_parse7  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 24) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_7"
    FIELD fQca_UActiveConnBBStat_parse8  (Fixed 0)  RETRIEVE (StoreField fQca_ulmActiveConnBBStat) ALSO (ShiftRight 28) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_8"
}

GROUP gQca_STAT_ConnStats "Connection Stats"
{
    GROUP gQca_STAT_ActiveConnStats;

    /* Get Packet Stats Based on the ConnType */
    /* Read the Connection Type ahead to dynamically select the proper group for packet stats */
    /* When you are updating make sure all the Connection type groups are updated to same size */
    FIELD fQca_ActiveConnType   START_BIT (Move 118 Bytes)   (Fixed 1 Byte) (Hex) SUPPRESS_DETAIL NO_MOVE
    BRANCH (FromTable   tQca_STATConnType   fQca_ActiveConnType)

    FIELD fQca_ActiveConnBBStat         (Fixed 4 Bytes)   (Hex)      "BBStats"

    FIELD fQca_ActiveConnBBStat_parse1  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 0)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_1"
    FIELD fQca_ActiveConnBBStat_parse2  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 4)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_2"
    FIELD fQca_ActiveConnBBStat_parse3  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 8)  ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_3"
    FIELD fQca_ActiveConnBBStat_parse4  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 12) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_4"
    FIELD fQca_ActiveConnBBStat_parse5  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 16) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_5"
    FIELD fQca_ActiveConnBBStat_parse6  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 20) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_6"
    FIELD fQca_ActiveConnBBStat_parse7  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 24) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_7"
    FIELD fQca_ActiveConnBBStat_parse8  (Fixed 0)  RETRIEVE (StoreField fQca_ActiveConnBBStat) ALSO (ShiftRight 28) ALSO (AndMask 0x000f)  (Table tQca_BBStats)   "BBStatus_8"
}

