          <ELEMENTS Name="Gain Factor_1" Default="0x1F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_2" Default="0x3F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_3" Default="0x7F" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_4" Default="0xFD" Description="Gain Factor premultiplied by 16" />
          <ELEMENTS Name="Gain Factor_5" Default="0x1F9" Description="Gain Factor premultiplied by 16" />
