    GROUP gProd_TestEvt_TestInfo_QHS_SupportedRates "QHS_SupportedRates"
    {
      GROUP gProd_TestEvt_TestInfo_QHS_SupportedRatesPSK "QHS_PSK"
      {
        FIELD fQHS_HS_P4_RX  (Fixed 1 Bit) (Binary) "HS PSK 4M RX"
        FIELD fQHS_HS_P3_RX  (Fixed 1 Bit) (Binary) "HS PSK 3M RX"
        FIELD fQHS_HS_P2_RX  (Fixed 1 Bit) (Binary) "HS PSK 2M RX"
        FIELD fQHS_HS_P6_TX  (Fixed 1 Bit) (Binary) "HS PSK 6M TX"
        FIELD fQHS_HS_P5_TX  (Fixed 1 Bit) (Binary) "HS PSK 5M TX"
        FIELD fQHS_HS_P4_TX  (Fixed 1 Bit) (Binary) "HS PSK 4M TX"
        FIELD fQHS_HS_P3_TX  (Fixed 1 Bit) (Binary) "HS PSK 3M TX"
        FIELD fQHS_HS_P2_TX  (Fixed 1 Bit) (Binary) "HS PSK 2M TX"
        RESERVED (Fixed 6 Bits)
        FIELD fQHS_HS_P6_RX  (Fixed 1 Bit) (Binary) "HS PSK 6M RX"
        FIELD fQHS_HS_P5_RX  (Fixed 1 Bit) (Binary) "HS PSK 5M RX"
      }
      GROUP gProd_TestEvt_TestInfo_QHS_SupportedRatesFSK "QHS_FSK"
      {
        FIELD fQHS_HS_F4_RX  (Fixed 1 Bit) (Binary) "HS FSK 4M RX"
        FIELD fQHS_HS_F3_RX  (Fixed 1 Bit) (Binary) "HS FSK 3M RX"
        FIELD fQHS_HS_F2_RX  (Fixed 1 Bit) (Binary) "HS FSK 2M RX"
        FIELD fQHS_HS_F6_TX  (Fixed 1 Bit) (Binary) "HS FSK 6M TX"
        FIELD fQHS_HS_F5_TX  (Fixed 1 Bit) (Binary) "HS FSK 5M TX"
        FIELD fQHS_HS_F4_TX  (Fixed 1 Bit) (Binary) "HS FSK 4M TX"
        FIELD fQHS_HS_F3_TX  (Fixed 1 Bit) (Binary) "HS FSK 3M TX"
