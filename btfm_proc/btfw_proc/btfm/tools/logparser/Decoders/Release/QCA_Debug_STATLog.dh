    FIELD fQca_ACLTxTypeACL               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Tx Counts ACL"
    FIELD fQca_ACLTxTypeVoice             (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Tx Counts Voice"
    FIELD fQca_ACLRxTypeEmpty             (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Rx Counts Empty"
    FIELD fQca_ACLRxTypeACL               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Rx Counts ACL"
    FIELD fQca_ACLRxTypeVoice             (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Rx Counts Voice"
    FIELD fQca_ACLRxUndetHecErr           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "Rx Counts Undetected hec error"
}

GROUP gQca_STAT_ACLPerPktStatsTx_ULM "ACL Tx Per Pkt Stats"
{
    GROUP gQca_STAT_QHSTxPerPktStats_ULM;
    FIELD fQca_TxACLCxMTxDenials            (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "CxMHwDenials"
    FIELD fQca_TxACLLateCommands            (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "LateCommands"
    FIELD fQca_TxACLCxMTxAborts             (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "CxMSwDenials"
    FIELD fQca_TxACLCxMRxCriticalAborts     (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "CxmCriticalDenials"
    FIELD fQca_TxACLRetransCount            (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "RetransCount"
    FIELD fQca_TxACLNoRxCount               (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "NoRxCount"
    FIELD fQca_TxACLBBNakCount              (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "BBNakCount"
    FIELD fQca_TxACLSkips                   (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "txSkips"
    FIELD fQca_TxACLflowOffCount            (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "flowOffCountPktLevel"
    FIELD fQca_TxACLPktNo                   (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "PktNo"
    FIELD fQca_TxACLpktType                 (Fixed 1 Byte)                                     (Decimal)   SUPPRESS_DETAIL
    FIELD fQca_TxACLpltType                 (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)    RETRIEVE   (MultiplyInteger 16) ALSO (AddField fQca_TxACLpktType) (Table ACL_PACKETTYPE) "pktType"
    FIELD fQca_TxACLpktLch                  (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)   (TABLE tQca_PKT_INFO)     "Pktlch"
    FIELD fQca_TxActivetransmitPwrIndBm     (Fixed 1 Byte)   RETRIEVE (SignExtension 8)        (Decimal)   "transmitPwrIndBm"
    FIELD fQca_TxACLQueLen                  (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "aclTxQueueLen"
    FIELD fQca_TxACLFlushCount              (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "aclFlushCountPktLevel"
    FIELD fQca_TxACLpayloadFlowOffCount     (Fixed 1 Byte)   PRINT_IF (FieldIs NotEqualTo 0)   (Decimal)   "payloadFlowOffCountPktLevel"
    RESERVED                                (Fixed 2 Bytes)
}
