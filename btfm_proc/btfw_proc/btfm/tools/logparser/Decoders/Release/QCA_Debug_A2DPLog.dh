GROUP gQca_ISO_sduMissDbg_stats "SDU miss debug stats"
{
	FIELD fQca_ISO_Periodic_stats1   (Fixed 4 Byte)      (Decimal)         "TxQctr"
    FIELD fQca_ISO_Periodic_stats2   (Fixed 4 Byte)      (Decimal)         "TxDoneCtr"
    FIELD fQca_ISO_Periodic_stats3   (Fixed 4 Byte)      (Decimal)         "RxCtr"
    FIELD fQca_ISO_Periodic_stats4   (Fixed 4 Byte)      (Decimal)         "NoRxCtr"
    FIELD fQca_ISO_Periodic_stats5   (Fixed 4 Byte)      (Decimal)         "driftDetectedCtr"
    FIELD fQca_ISO_Periodic_stats6   (Fixed 4 Byte)      (Decimal)         "txPktQueueOverflowCtr"
    FIELD fQca_ISO_Periodic_stats7   (Fixed 2 Byte)      (Decimal)         "rxPktToIntMin"
    FIELD fQca_ISO_Periodic_stats8   (Fixed 2 Byte)      (Decimal)         "rxPktLateCtr"    
}

GROUP gQca_voiceBadAlloc ""
{
    FIELD fQca_sizeReq                         (Fixed 2 Bytes)     (Decimal)                               "Requested_size"
    FIELD fQca_URsize                          (Fixed 2 Bytes)     (Decimal)                               "UpperRamPoolSize"
    FIELD fQca_LRSize                          (Fixed 2 Bytes)     (Decimal)                               "LowerRamPoolSize"
}

