From 7cf89cea17905fd2b8284d025724008df3ff5fb4 Mon Sep 17 00:00:00 2001
From: Tim Jiang <tjiang@qti.qualcomm.com>
Date: Tue, 15 Nov 2022 18:05:21 +0800
Subject: [PATCH] add support dynamic config bt interval and window for bredr
 and ble

---
 bta/dm/bta_dm_act.c     | 15 +++++++------
 stack/btm/btm_ble_gap.c | 50 ++++++++++++++++++++++++++++++++++++-----
 stack/btm/btm_devctl.c  |  8 +++++--
 stack/btm/btm_inq.c     |  8 +++++--
 stack/btm/btm_main.c    | 27 +++++++++++++++++++++-
 5 files changed, 90 insertions(+), 18 deletions(-)

diff --git a/bta/dm/bta_dm_act.c b/bta/dm/bta_dm_act.c
index deee12396..a75291715 100644
--- a/bta/dm/bta_dm_act.c
+++ b/bta/dm/bta_dm_act.c
@@ -643,13 +643,14 @@ void bta_dm_set_dev_le_name (tBTA_DM_MSG *p_data)
 *******************************************************************************/
 void bta_dm_set_visibility(tBTA_DM_MSG *p_data)
 {
-    UINT16 window, interval;
+    UINT16 disc_window, disc_interval;
+    UINT16 conn_window, conn_interval;
 #if (defined(BTA_GATT_INCLUDED) && BTA_GATT_INCLUDED)
     UINT16 le_disc_mode = BTM_BleReadDiscoverability();
     UINT16 le_conn_mode = BTM_BleReadConnectability();
 #endif  // (defined(BTA_GATT_INCLUDED) && BTA_GATT_INCLUDED)
-    UINT16 disc_mode = BTM_ReadDiscoverability(&window, &interval);
-    UINT16 conn_mode = BTM_ReadConnectability(&window, &interval);
+    UINT16 disc_mode = BTM_ReadDiscoverability(&disc_window, &disc_interval);
+    UINT16 conn_mode = BTM_ReadConnectability(&conn_window, &conn_interval);
 
     /* set modes for Discoverability and connectability if not ignore */
     if (p_data->set_visibility.disc_mode != (BTA_DM_IGNORE | BTA_DM_LE_IGNORE))
@@ -664,8 +665,8 @@ void bta_dm_set_visibility(tBTA_DM_MSG *p_data)
                 ((p_data->set_visibility.disc_mode & ~BTA_DM_IGNORE) | disc_mode);
 
         BTM_SetDiscoverability(p_data->set_visibility.disc_mode,
-                                bta_dm_cb.inquiry_scan_window,
-                                bta_dm_cb.inquiry_scan_interval);
+                                disc_window,
+                                disc_interval);
     }
 
     if (p_data->set_visibility.conn_mode != (BTA_DM_IGNORE | BTA_DM_LE_IGNORE))
@@ -680,8 +681,8 @@ void bta_dm_set_visibility(tBTA_DM_MSG *p_data)
                 ((p_data->set_visibility.conn_mode & ~BTA_DM_IGNORE) | conn_mode);
 
         BTM_SetConnectability(p_data->set_visibility.conn_mode,
-                                bta_dm_cb.page_scan_window,
-                                bta_dm_cb.page_scan_interval);
+                                conn_window,
+                                conn_interval);
     }
 
     /* Send False or True if not ignore */
diff --git a/stack/btm/btm_ble_gap.c b/stack/btm/btm_ble_gap.c
index aeda301e8..338098cbb 100644
--- a/stack/btm/btm_ble_gap.c
+++ b/stack/btm/btm_ble_gap.c
@@ -46,6 +46,7 @@
 #include "l2c_int.h"
 #include "osi/include/log.h"
 #include "osi/include/time.h"
+#include "stack_config.h"
 
 #define BTM_BLE_NAME_SHORT                  0x01
 #define BTM_BLE_NAME_CMPL                   0x02
@@ -2110,6 +2111,10 @@ tBTM_STATUS btm_ble_start_inquiry (UINT8 mode, UINT8   duration)
     tBTM_BLE_CB *p_ble_cb = &btm_cb.ble_ctr_cb;
     tBTM_INQUIRY_VAR_ST      *p_inq = &btm_cb.btm_inq_vars;
 
+	UINT16 scan_interval = !p_ble_cb->inq_var.scan_interval ? BTM_BLE_LOW_LATENCY_SCAN_INT : p_ble_cb->inq_var.scan_interval;
+    UINT16 scan_window = !p_ble_cb->inq_var.scan_window ? BTM_BLE_LOW_LATENCY_SCAN_WIN : p_ble_cb->inq_var.scan_window;
+
+ 
     BTM_TRACE_DEBUG("btm_ble_start_inquiry: mode = %02x inq_active = 0x%02x", mode, btm_cb.btm_inq_vars.inq_active);
 
     /* if selective connection is active, or inquiry is already active, reject it */
@@ -2120,16 +2125,18 @@ tBTM_STATUS btm_ble_start_inquiry (UINT8 mode, UINT8   duration)
         return(BTM_BUSY);
     }
 
+    BTM_TRACE_DEBUG("btm_ble_start_inquiry: scan_activity = 0x%02x scan_window = %d, scan_interval = %d", 
+            p_ble_cb->scan_activity,scan_window, scan_interval);
     if (!BTM_BLE_IS_SCAN_ACTIVE(p_ble_cb->scan_activity))
     {
 #if (defined BLE_EXTENDED_ADV_SUPPORT && (BLE_EXTENDED_ADV_SUPPORT == TRUE))
         if (controller_get_interface()->supports_ble_extended_advertisements())
         {
             btsnd_hcic_ble_set_extended_scan_params(0x01 /*LE 1M */,BTM_BLE_SCAN_MODE_ACTI,
-                                BTM_BLE_LOW_LATENCY_SCAN_INT,
-                                BTM_BLE_LOW_LATENCY_SCAN_WIN,
-                                BTM_BLE_LOW_LATENCY_SCAN_INT,
-                                BTM_BLE_LOW_LATENCY_SCAN_WIN,
+                                scan_interval,
+                                scan_window,
+                                scan_interval,
+                                scan_window,
                                 btm_cb.ble_ctr_cb.addr_mgnt_cb.own_addr_type,
                                 SP_ADV_ALL);
         }
@@ -2137,8 +2144,8 @@ tBTM_STATUS btm_ble_start_inquiry (UINT8 mode, UINT8   duration)
 #endif
         {
             btsnd_hcic_ble_set_scan_params(BTM_BLE_SCAN_MODE_ACTI,
-                                                    BTM_BLE_LOW_LATENCY_SCAN_INT,
-                                                    BTM_BLE_LOW_LATENCY_SCAN_WIN,
+                                                    scan_interval,
+                                                    scan_window,
                                                     btm_cb.ble_ctr_cb.addr_mgnt_cb.own_addr_type,
                                                     SP_ADV_ALL);
         }
@@ -3775,6 +3782,31 @@ void btm_ble_update_mode_operation(UINT8 link_role, BD_ADDR bd_addr, UINT8 statu
     }
 }
 
+static void load_ble_wind_interval_from_config(const config_t *config) {
+    int value = -1;
+    LOG_INFO(LOG_TAG, "%s ", __func__);
+    tBTM_BLE_INQ_CB *p_inq = &btm_cb.ble_ctr_cb.inq_var;
+
+    value = config_get_int(config, CONFIG_DEFAULT_SECTION, "BLE_SCAN_WINDOW", -1);
+    if (value != -1) {
+        LOG_INFO(LOG_TAG, "BLE_SCAN_WINDO = %d ",value);
+		p_inq->scan_window = value;
+	}
+
+	value = config_get_int(config, CONFIG_DEFAULT_SECTION, "BLE_SCAN_INTER", -1);
+    if (value != -1) {
+        LOG_INFO(LOG_TAG, "BLE_SCAN_INTER = %d ",value);
+		p_inq->scan_interval = value;
+	}
+
+	value = config_get_int(config, CONFIG_DEFAULT_SECTION, "BLE_ADV_INTER", -1);
+    if (value != -1) {
+        LOG_INFO(LOG_TAG, "BLE_ADV_INTER = %d ",value);
+		p_inq->adv_interval_min = p_inq->adv_interval_max = value;
+	}
+}
+
+
 /*******************************************************************************
 **
 ** Function         btm_ble_init
@@ -3786,6 +3818,7 @@ void btm_ble_update_mode_operation(UINT8 link_role, BD_ADDR bd_addr, UINT8 statu
 *******************************************************************************/
 void btm_ble_init(void)
 {
+    const stack_config_t *stack_config;
     tBTM_BLE_CB *p_cb = &btm_cb.ble_ctr_cb;
 
     BTM_TRACE_DEBUG("%s", __func__);
@@ -3823,6 +3856,11 @@ void btm_ble_init(void)
 #if BLE_VND_INCLUDED == FALSE
     btm_ble_adv_filter_init();
 #endif
+    stack_config = stack_config_get_interface();
+    if (stack_config) {
+        load_ble_wind_interval_from_config(stack_config->get_all());
+    }
+
 }
 
 void btm_ble_free(void)
diff --git a/stack/btm/btm_devctl.c b/stack/btm/btm_devctl.c
index 9f354f1c6..14f25b9fd 100644
--- a/stack/btm/btm_devctl.c
+++ b/stack/btm/btm_devctl.c
@@ -169,8 +169,12 @@ static void reset_complete(void *result) {
   btm_cb.btm_inq_vars.inq_scan_period   = HCI_DEF_INQUIRYSCAN_INTERVAL;
   btm_cb.btm_inq_vars.inq_scan_type     = HCI_DEF_SCAN_TYPE;
 
-  btm_cb.btm_inq_vars.page_scan_window  = HCI_DEF_PAGESCAN_WINDOW;
-  btm_cb.btm_inq_vars.page_scan_period  = HCI_DEF_PAGESCAN_INTERVAL;
+
+  BTM_TRACE_DEBUG("reset_complete: page_scan_window = %d, page_scan_period = %d",btm_cb.btm_inq_vars.page_scan_window,btm_cb.btm_inq_vars.page_scan_period);
+  if(btm_cb.btm_inq_vars.page_scan_window == 0)
+      btm_cb.btm_inq_vars.page_scan_window  = HCI_DEF_PAGESCAN_WINDOW;
+  if(btm_cb.btm_inq_vars.page_scan_period == 0)
+      btm_cb.btm_inq_vars.page_scan_period  = HCI_DEF_PAGESCAN_INTERVAL;
   btm_cb.btm_inq_vars.page_scan_type    = HCI_DEF_SCAN_TYPE;
 
 #if (BLE_INCLUDED == TRUE)
diff --git a/stack/btm/btm_inq.c b/stack/btm/btm_inq.c
index 26632f66c..4bac2c239 100644
--- a/stack/btm/btm_inq.c
+++ b/stack/btm/btm_inq.c
@@ -238,10 +238,13 @@ tBTM_STATUS BTM_SetDiscoverability (UINT16 inq_mode, UINT16 window, UINT16 inter
 
         scan_mode |= HCI_INQUIRY_SCAN_ENABLED;
     }
-
+#if 0
     /* Send down the inquiry scan window and period if changed */
     if ((window != btm_cb.btm_inq_vars.inq_scan_window) ||
         (interval != btm_cb.btm_inq_vars.inq_scan_period))
+#endif
+    BTM_TRACE_API ("BTM_SetDiscoverability:  window 0x%04x, interval 0x%04x", window, interval);
+
     {
         if (btsnd_hcic_write_inqscan_cfg (interval, window))
         {
@@ -646,9 +649,10 @@ tBTM_STATUS BTM_SetConnectability (UINT16 page_mode, UINT16 window, UINT16 inter
 
         scan_mode |= HCI_PAGE_SCAN_ENABLED;
     }
-
+#if 0
     if ((window != p_inq->page_scan_window) ||
         (interval != p_inq->page_scan_period))
+#endif
     {
         p_inq->page_scan_window = window;
         p_inq->page_scan_period = interval;
diff --git a/stack/btm/btm_main.c b/stack/btm/btm_main.c
index 3b25bdbbe..c36d03fc6 100644
--- a/stack/btm/btm_main.c
+++ b/stack/btm/btm_main.c
@@ -23,11 +23,15 @@
  *
  ******************************************************************************/
 
+#define LOG_TAG "bt_btm"
+
 #include "bt_types.h"
 #include "bt_target.h"
 #include <string.h>
 #include "btm_int.h"
 #include "stack_config.h"
+#include "bt_trace.h"
+#include "osi/include/log.h"
 
 /* Global BTM control block structure
 */
@@ -35,6 +39,23 @@
 tBTM_CB  btm_cb;
 #endif
 
+static void load_bt_wind_interval_from_config(const config_t *config) {
+    int value = -1;
+    LOG_INFO(LOG_TAG, "%s ", __func__);
+	value = config_get_int(config, CONFIG_DEFAULT_SECTION, "PAGE_SCAN_WINDOW", -1);
+    if (value != -1) {
+         LOG_INFO(LOG_TAG, "PAGE_SCAN_WINDOW = %d ",value);
+	     btm_cb.btm_inq_vars.page_scan_window  = value;
+	}
+
+	value = config_get_int(config, CONFIG_DEFAULT_SECTION, "PAGE_SCAN_INTER", -1);
+    if (value != -1) {
+         LOG_INFO(LOG_TAG, "PAGE_SCAN_INTER = %d ",value);
+	     btm_cb.btm_inq_vars.page_scan_period  = value;
+	}
+
+}
+
 /*******************************************************************************
 **
 ** Function         btm_init
@@ -49,6 +70,7 @@ tBTM_CB  btm_cb;
 *******************************************************************************/
 void btm_init (void)
 {
+    const stack_config_t *stack_config;
     /* All fields are cleared; nonzero fields are reinitialized in appropriate function */
     memset(&btm_cb, 0, sizeof(tBTM_CB));
     btm_cb.page_queue = fixed_queue_new(SIZE_MAX);
@@ -76,6 +98,10 @@ void btm_init (void)
     btm_cb.sec_dev_rec = list_new(osi_free);
 
     btm_dev_init();                     /* Device Manager Structures & HCI_Reset */
+    stack_config = stack_config_get_interface();
+    if (stack_config) {
+        load_bt_wind_interval_from_config(stack_config->get_all());
+    }
 }
 
 void btm_free (void)
@@ -147,4 +173,3 @@ void btm_free (void)
         btm_cb.devcb.read_tx_power_timer = NULL;
     }
 }
-
