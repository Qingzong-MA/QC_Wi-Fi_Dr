    {0x0206 "LOG_ID_LLM_AFH_ASSESSMENT"     "LOG_ID_LLM_AFH_ASSESSMENT"     0   gQca_LLM_AFHEvalInfo}
    {0x0207 "LOG_ID_LLM_LMP_TIMEOUT"        "LOG_ID_LLM_LMP_TIMEOUT"        0   gQca_DefaultPrint}
