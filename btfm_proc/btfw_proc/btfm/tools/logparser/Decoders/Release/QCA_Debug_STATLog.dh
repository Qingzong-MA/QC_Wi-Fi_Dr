    FIELD fQca_Sniffindex2BBStat          (Fixed 4 Bytes)    (Hex)           "index2:BBStats:"
    FIELD fQca_Sniffindex3BBStat          (Fixed 4 Bytes)    (Hex)           "index3:BBStats:"
    FIELD fQca_Sniffindex4BBStat          (Fixed 4 Bytes)    (Hex)           "index4:BBStats:"
    FIELD fQca_Sniffindex5BBStat          (Fixed 4 Bytes)    (Hex)           "index5:BBStats:"
    FIELD fQca_Sniffindex6BBStat          (Fixed 4 Bytes)    (Hex)           "index6:BBStats:"
    FIELD fQca_Sniffindex7BBStat          (Fixed 4 Bytes)    (Hex)           "index7:BBStats:"
    FIELD fQca_Sniffindex8BBStat          (Fixed 4 Bytes)    (Hex)           "index8:BBStats:"
}


/* CSB audio stats */
GROUP gQca_STAT_BCAUD "CSB Audio Stats"
{
    FIELD fQca_BCAECSegmentsQueued     (Fixed 2 Bytes)      (Decimal)          "EC Queued"
    FIELD fQca_BCAECSegmentsTx         (Fixed 2 Bytes)      (Decimal)          "EC Tx"
    FIELD fQca_BCAECSegmentsDrop       (Fixed 2 Bytes)      (Decimal)          "EC Dropped"
    FIELD fQca_BCAAudioFrameOverflow   (Fixed 2 Bytes)      (Decimal)          "Frame Dropped"
    FIELD fQca_BCAFMBUnavailable       (Fixed 2 Bytes)      (Decimal)          "FMB unavailable"
    FIELD fQca_BCASmallerBAPakcet      (Fixed 2 Bytes)      (Decimal)          "Small BA Pakcets"
    FIELD fQca_BCAAudioFrameTimeout    (Fixed 2 Bytes)      (Decimal)          "Audio Frame Timout"
    FIELD fQca_BCAFullBAPacket         (Fixed 2 Bytes)      (Decimal)          "Full BA Packet"
    FIELD fQca_BCAAudioFramesReceived  (Fixed 2 Bytes)      (Decimal)          "NumAudioFramesRx"
    FIELD fQca_BCACxMDenials           (Fixed 2 Bytes)      (Decimal)          "CxM Denials"
    FIELD fQca_BCALCLateCommands       (Fixed 2 Bytes)      (Decimal)          "LC Late commands"
    RESERVED                           (Fixed 2 Bytes)
}
GROUP gQca_TruncPageStats "Trunc Page Offload Stats"
{
    FIELD fQca_TPOCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE TPOCntr

    GROUP gQca_TruncPageStatsDevTxSlot REPEAT COUNT (Fixed 5 Times) "# Tx Slots for each device"
    {
        GROUP gQca_TruncPageStatsDevTxSlotCnt
        {
            FIELD fQca_runcPageStatsDevTxSlot              (Fixed 4 Bytes)   (DecimalWithFieldLabel TPOCntr)    "# Tx slots for device"
        }
        /* Increment the Counter */
        FIELD fQca_TruncDeviceTxCnt (Fixed 0) RETRIEVE (StoreField TPOCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE TPOCntr
    }

    FIELD fQca_TruncCxmSlots                 (Fixed 4 Bytes)        (Decimal)          "Cxm denied Slots"

    FIELD fQca_TPOSWCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE TPOSWCntr
    GROUP gQca_TruncPageStatsDevSwitchSlot REPEAT COUNT (Fixed 5 Times) " # times switched to each device "
    {
        GROUP gQca_TruncPageStatsDevSwitchSlotCnt
        {
            FIELD fQca_runcPageStatsDevSwitchSlot            (Fixed 2 Bytes)         (DecimalWithFieldLabel TPOSWCntr)    " # times switched to device"
        }
        /* Increment the Counter */
        FIELD fQca_TruncDeviceSwitchCnt (Fixed 0) RETRIEVE (StoreField TPOSWCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE TPOSWCntr
    }
    FIELD fQca_TruncpagelastCnt              (Fixed 2 Bytes)       (Decimal)          "Paging slots in last interval"
    FIELD fQca_TruncCycleslineNo             (Fixed 2 Bytes)       (Decimal)                "Line No"
    FIELD fQca_TruncOldState                 (Fixed 1 Bytes)       (TABLE tTruncPageState)   "Old state"
    FIELD fQca_TruncNewState                 (Fixed 1 Bytes)       (TABLE tTruncPageState)   "New State"
    FIELD fQca_TruncErrReason                (Fixed 1 Bytes)       (Decimal)                "ErrorReason"
}


TABLE tTruncPageState
    { 0 "Disabled"}
    { 1 "Paused"}
    { 2 "Started (but element not in SLC)"}
    { 3 "Running"}
    { 4 "Terminating"}
    {default "Invalid"}
ENDTABLE

TABLE tQca_IsoType
    { 0 "CIS Master"}
    { 1 "CIS Slave"}
    { 2 "BIS Broadcaster"}
    { 3 "BIS Sync"}
    {default "Invalid"}
ENDTABLE

GROUP gQca_STAT_IsoConnStats "ISO Stats"
{
    FIELD fQca_isoStreamAccesAddr                 (Fixed 4 Bytes)       (Hex)                       "Access Addr"
    FIELD fQca_IsoStatsHandle                     (Fixed 1 Bytes)       (Decimal)                   "Connection Handle"
    FIELD fQca_IsoType                            (Fixed 1 Bytes)       (TABLE tQca_IsoType)        "ISO Type"
    FIELD fQca_EventCounterIso                    (Fixed 2 Byte)      (Decimal)                     "EventCounter"
    FIELD fQca_IsoStatsRxCxmDenials               (Fixed 4 Bytes)       (Decimal)                   "Coex Rx Denials"
    FIELD fQca_IsoStatsTxCxmDenials               (Fixed 4 Bytes)       (Decimal)                   "Coex DataPkt Tx Denials"
    FIELD fQca_IsoStatsNpTxCxmDenials               (Fixed 4 Bytes)       (Decimal)                 "Coex NullPkt Tx Denials"
    GROUP gQca_STAT_CisStats IF (FieldIs LessThanOrEqualTo 1 fQca_IsoType)
    {
        GROUP gQca_STAT_CisTxStats "TX"
        {
            FIELD fQca_IsoStatsAcked                  (Fixed 4 Bytes)       (Decimal)          "Acked"
            FIELD fQca_IsoStatsTxFlush                (Fixed 4 Bytes)       (Decimal)          "Tx Flush"
            FIELD fQca_IsoStatsUnacked                (Fixed 4 Bytes)       (Decimal)          "Flush Due to Unacked"
            FIELD fQca_IsoStatsFlushNacked            (Fixed 4 Bytes)       (Decimal)          "Flush Due to Nacked"
            FIELD fQca_IsoStatsLastSub                (Fixed 4 Bytes)       (Decimal)          "Tx In Last Subevent"
            FIELD fQca_IsoStatsRetrans                (Fixed 4 Bytes)       (Decimal)          "Retransmission"
            FIELD fQca_IsoStatsTotalTx                (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsAcked fQca_IsoStatsUnacked) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_IsoStatsTotalTx1               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalTx fQca_IsoStatsRetrans) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_IsoStatsTotalTx2               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalTx1 fQca_IsoStatsTxCxmDenials) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_IsoStatsTotalTx3               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalTx2 fQca_IsoStatsNpTxCxmDenials) (Decimal) SUPPRESS_DETAIL
        }
        GROUP gQca_STAT_CisRxStats "RX"
        {
            FIELD fQca_IsoStatsGood                   (Fixed 4 Bytes)       (Decimal)          "Good"
            FIELD fQca_IsoStatsRxFlush                (Fixed 4 Bytes)       (Decimal)          "Rx Flush"
            FIELD fQca_IsoStatsMiss                   (Fixed 4 Bytes)       (Decimal)          "Rx Miss (Excluded Rx miss for NULL CIE PKT TX)"
            FIELD fQca_IsoStatsAbort                  (Fixed 4 Bytes)       (Decimal)          "Abort(Due to Unexpected Length)"
            FIELD fQca_IsoStatsCrcBad                 (Fixed 4 Bytes)       (Decimal)          "CRC Bad"
            FIELD fQca_IsoStatsDuplicate              (Fixed 4 Bytes)       (Decimal)          "Retransmission(Duplicated PDU)"
            FIELD fQca_IsoStatsBBNAK                  (Fixed 4 Bytes)       (Decimal)          "BB Naks"
            FIELD fQca_IsoStatsNoRxForCIETx            (Fixed 4 Bytes)       (Decimal)          "Rx Miss for CIE Tx"
        }

        FIELD fQca_IsoStatsTotalRx                (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsGood fQca_IsoStatsMiss) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_IsoStatsTotalRx1               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalRx fQca_IsoStatsAbort) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_IsoStatsTotalRx2               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalRx1 fQca_IsoStatsCrcBad) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_IsoStatsTotalRx3               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalRx2 fQca_IsoStatsDuplicate) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_IsoStatsTotalRx4               (Fixed 0) RETRIEVE (AddFieldToField fQca_IsoStatsTotalRx3 fQca_IsoStatsNoRxForCIETx) (Decimal) SUPPRESS_DETAIL

        FIELD fQca_IsoStatsTotalSubevent              (Fixed 0) IF(CompareFields fQca_IsoStatsTotalTx3 LessThan fQca_IsoStatsTotalRx4)
                                                       RETRIEVE (StoreField fQca_IsoStatsTotalRx4) (Decimal) "Total Subevent (Rough reference count)"
        FIELD fQca_IsoStatsTotalSubevent1             (Fixed 0) IF(CompareFields fQca_IsoStatsTotalRx4 LessThanOrEqualTo fQca_IsoStatsTotalTx3)
                                                       RETRIEVE (StoreField fQca_IsoStatsTotalTx3) (Decimal) "Total Subevent (Rough reference count)"

        GROUP gQca_STAT_CisDispatchStats "Dispatch"
        {
            FIELD fQca_IsoStatDispatch_missEvent       (Fixed 4 Bytes)      (Decimal)          "missEvent"
            FIELD fQca_IsoStatDispatch_EventDispatched (Fixed 4 Bytes)      (Decimal)          "EventDispatched"
        }
    }

    GROUP gQca_STAT_BisBroadcasterStats IF (FieldIs EqualTo 2 fQca_IsoType)
    {
        GROUP gQca_STAT_BisTxStats "TX"
        {
            FIELD fQca_IsoStatsTxReserved             (Fixed 4 Bytes)       (Decimal)          "Reserved"
            FIELD fQca_IsoStatsTxFlush;
            RESERVED                                  (Fixed 8 Bytes)
            FIELD fQca_IsoStatsRetrans;
            RESERVED                                  (Fixed 32 Bytes)
        }
        GROUP gQca_STAT_CisDispatchStats;
    }

    GROUP gQca_STAT_BisSyncStats IF (FieldIs EqualTo 3 fQca_IsoType)
    {
        GROUP gQca_STAT_BisRxStats "RX"
        {
            RESERVED                                  (Fixed 20 Bytes)
            FIELD fQca_IsoStatsGood;
            FIELD fQca_IsoStatsRxFlush;
            FIELD fQca_IsoStatsMiss;
            FIELD fQca_IsoStatsAbort;
            FIELD fQca_IsoStatsCrcBad;
            RESERVED                                  (Fixed 12 Bytes)
        }
        GROUP gQca_STAT_CisDispatchStats;
    }

    FIELD fQca_IsoStatsLatecommandsIso         (Fixed 2 Byte)      (Decimal)              "LateCommands"
    Reserved                                   (Fixed 2 Bytes)
    FIELD fQca_IsoStatsTxPowerLevelIso         (Fixed 1 Byte)      (Decimal)              "Tx Power Level Index"
    FIELD fQca_IsoStatsTxPowerdBmIso           (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)              "Tx Power (dBm)"
    FIELD fQca_IsoStatsRxRSSIdBmIso            (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)              "Avg. Rx RSSI (dBm)"
    FIELD fQca_IsoStatsChanMapIso              (Fixed 5 Byte)      (Hex)                  "ChannelMap"
    GROUP gQca_reTransRateStats "Retrans MA Stats"
    {
        FIELD fQca_reTransRateStats_lastrunClk        (Fixed 4 Bytes)     (Hex)                "Last Calculated Time (Native clk)"
        FIELD fQca_reTransRateStats_MA                (Fixed 4 Bytes)     (Decimal)             "Moving Avg"
        FIELD fQca_reTransRateStats_CurHighRetrans    (Fixed 1 Byte)      (Decimal)             "current High prio retrans"
    }

    FIELD fQca_IsoStatsHighPriNse              (Fixed 1 Byte) PRINT_IF   (FieldIs NotEqualTo 0)     (Decimal)              "High Priority NSE"

    GROUP gQca_STAT_CisConfigParam "Config parameters"
    {
        FIELD fQca_IsoStatPhyTx      (Fixed 1 Bytes)      (Decimal)          "PHY C2P"
        FIELD fQca_IsoStatPhyRx      (Fixed 1 Bytes)      (Decimal)          "PHY P2C"
        FIELD fQca_IsoStatFTTx       (Fixed 1 Bytes)      (Decimal)          "Flush Timeout C2P"
        FIELD fQca_IsoStatFTRx       (Fixed 1 Bytes)      (Decimal)          "Flush Timeout P2C"
        FIELD fQca_IsoStatBNTx       (Fixed 1 Bytes)      (Decimal)          "Burst Number C2P"
        FIELD fQca_IsoStatBNRx       (Fixed 1 Bytes)      (Decimal)          "Burst Number P2C"
        FIELD fQca_IsoStatPLTx       (Fixed 2 Bytes)      (Decimal)          "Payload length C2P"
        FIELD fQca_IsoStatPLRx       (Fixed 2 Bytes)      (Decimal)          "Payload length P2C"
    }

    FIELD gQca_IsoStatsBuffer_AllocatedCnt              (Fixed 1 Bytes) (Decimal)   "SDU Buffer Allocated Cnt"
    FIELD gQca_IsoStatsBuffer_MaxRequiredCnt            (Fixed 1 Bytes) (Decimal)   "SDU Buffer Max Required Cnt"
    reserved (fixed 2 bytes)
    FIELD gQca_IsoStatsBuffer_LastHit                   (Fixed 4 Bytes) (Decimal)   "LastHit"
    Reserved                                      (ToEndOfLayer)

    FIELD fQca_IsoStatsTotalRetransRate0              (Fixed 0)           RETRIEVE (MultiplyFieldByInteger fQca_IsoStatsRetrans 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_IsoStatsTotalRetransRate1              (Fixed 0)           RETRIEVE (DivideFieldByField fQca_IsoStatsTotalRetransRate0 fQca_IsoStatsTotalTx1) (Decimal) "Total Retransmission Rate"
    FIELD fQca_IsoStatsCoexDenialRate0                (Fixed 0)           RETRIEVE (MultiplyFieldByInteger fQca_IsoStatsTxCxmDenials 100) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_IsoStatsCoexDenialRate1                (Fixed 0)           RETRIEVE (DivideFieldByField fQca_IsoStatsCoexDenialRate0 fQca_IsoStatsTotalTx1) (Decimal) "Coex Denial Rate"
}

GROUP gQca_StatRetranPktStatus "RetransPkt Stats"
{
    FIELD fQca_statRxCryptoReg                        (Fixed 2 Bytes)     (Hex)      "RxCryptoReg"
    FIELD fQca_stat0                                  (Fixed 2 Bytes)     (Hex)      "HWIO_PP_BTC_SC_INT_RAW_STAT_0_IN"
    FIELD fQca_statCmdDone                            (Fixed 2 Bytes)     (Hex)      "CmdDone"
    FIELD fQca_statrxFifoLen                          (Fixed 2 Bytes)     (Hex)      "RxLen expect2"
