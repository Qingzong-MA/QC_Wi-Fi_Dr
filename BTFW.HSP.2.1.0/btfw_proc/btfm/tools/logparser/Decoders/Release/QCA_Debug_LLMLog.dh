    {0x0240 "LOG_ID_LLM_ESCO_NEGO"          "LOG_ID_LLM_ESCO_NEGO"          0   gQca_LLM_ESCO_Nego}
    {0x0242 "LOG_ID_LLM_LE_LPA"             "LOG_ID_LLM_LE_LPA"             0   gQca_LLM_LE_LPA}
    {0x02FD "LOG_ID_LLM_LE_RAW_RSSI"       "LOG_ID_LLM_LE_RAW_RSSI"       0   gQca_LLM_LE_Rssi}
