     BRANCH (FromTable tAudioOffloadVSEventSubSubEventCode gAudioOffloadVsEvent_Sub_Sub_Event_Code)
     FIELD gAudioOffloadVsEvent_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

