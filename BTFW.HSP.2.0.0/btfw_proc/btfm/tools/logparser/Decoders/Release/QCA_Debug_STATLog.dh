TABLE t_IsoPduRxStatus
    {0 "Unknow_Err"}
    {1 "AC_err"}
    {2 "CRC_err"}
    {3 "CRC_good"}
    {4 "Rx Buf Not Available"}
    {5 "Rx Retrans"}
    {6 "Rx Nak"}
    {7 "Rx Ack"}
ENDTABLE

TABLE t_CIS_SduTxStatus
    {0  "Unknow_Err"}
    {1  "Flush Instead Of Stuff"}
    {2  "Flush Disable Path"}
    {3  "Flush No Memory"}
    {4  "Flush Exceed Limit"}
    {5  "Flush Handle Late"}
    {6  "All PDU be Ack"}
    {7  "Some PDU Rx Nothing/CRC error"}
    {8  "Some PDU be Nak"}
    {9  "Some PDU didn't Tx"}
ENDTABLE

TABLE t_BIS_SduTxStatus
    {0  "Unknow_Err"}
    {1  "Flush Instead Of Stuff"}
    {2  "Flush Disable Path"}
    {7  "All PDU Tx"}
    {9  "Some PDU didn't Tx"}
ENDTABLE

GROUP gQca_STAT_IsoSduTxDbg "ISO SDU Tx Dbg"
{
    FIELD fQca_STAT_IsoSduTxDbg_handle          (Fixed 1 Bytes) (Decimal)   "handle"
    FIELD fQca_STAT_IsoSduTxDbg_isoType         (Fixed 1 Bytes) (TABLE tQca_IsoType)   "isoType"
    FIELD fQca_STAT_IsoSduTxDbg_isFrame         (Fixed 1 Bytes) (TABLE t_IsoFrameType)        "frame"
    GROUP gQca_STAT_IsoSduTxDbg_CIS_sduStatus IF (Fieldis NotEqualTo 2 fQca_STAT_IsoSduTxDbg_isoType)
    {
        /* CIS */
        FIELD fQca_STAT_IsoSduTxDbg_CIS_sduStatus        (Fixed 1 Bytes) (TABLE t_CIS_SduTxStatus)   "sduStatus"
    }

    GROUP gQca_STAT_IsoSduTxDbg_BIS_sduStatus IF (Fieldis EqualTo 2 fQca_STAT_IsoSduTxDbg_isoType)
    {
        /* BIS */
        FIELD fQca_STAT_IsoSduTxDbg_BIS_sduStatus        (Fixed 1 Bytes) (TABLE t_BIS_SduTxStatus)   "sduStatus"
    }

    FIELD fQca_STAT_IsoSduTxDbg_sduSeqn          (Fixed 2 Bytes) (Decimal)   "sduSeqn"
    FIELD fQca_STAT_IsoSduTxDbg_sduLength        (Fixed 2 Bytes) (Decimal)   "sduLength"
    FIELD fQca_STAT_IsoSduTxDbg_cxmDenials       (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)   "cxmDenials"
    Reserved (Fixed 2 bytes)
    FIELD fQca_STAT_IsoSduTxDbg_arrivalTime      (Fixed 4 Bytes) (Decimal)   "arrivalTime"
    FIELD fQca_STAT_IsoSduTxDbg_scheduleTime     (Fixed 4 Bytes) (Decimal)   "scheduleTime"
    FIELD fQca_STAT_IsoSduTxDbg_flushAckTime     (Fixed 4 Bytes) (Decimal)   "flushAckTime"
    FIELD fQca_STAT_IsoSduTxDbg_LastFlushAckTime (Fixed 4 Bytes) (Decimal)   "LastFlushAckTime"
    FIELD fQca_STAT_IsoSduTxDbg_deltaFlushAckTime (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_STAT_IsoSduTxDbg_flushAckTime fQca_STAT_IsoSduTxDbg_LastFlushAckTime) (Decimal) "delta FlushAckTime (us)"

    GROUP  gQca_STAT_IsoSduTxDbg_Latency_Summary "ISO_Latency_Summary"
    {
        FIELD fQca_STAT_IsoSduTxDbg_Arrival_To_Schedule_us   (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_STAT_IsoSduTxDbg_scheduleTime fQca_STAT_IsoSduTxDbg_arrivalTime) (Decimal) "Arrive To Schedule (us)"
        FIELD fQca_STAT_IsoSduTxDbg_Schedule_To_FlushAcke_us (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_STAT_IsoSduTxDbg_flushAckTime fQca_STAT_IsoSduTxDbg_scheduleTime) (Decimal) "Schedule To  FlushAck (us)"
        FIELD fQca_STAT_IsoSduTxDbg_us (Fixed 0) RETRIEVE (SubtractFieldMinusField fQca_STAT_IsoSduTxDbg_flushAckTime fQca_STAT_IsoSduTxDbg_arrivalTime) (Decimal) "Iso Latency (us)"
    }

    FIELD fQca_STAT_IsoSduTxDbg_missDispatch     (Fixed 1 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)   "missDispatch"
    FIELD fQca_STAT_IsoSduTxDbg_pduCnt           (Fixed 1 Bytes) (Decimal)   "pduCnt"
    FIELD fQca_STAT_IsoSduTxDbg_pduLogCnt        (Fixed 1 Bytes) (Decimal)   "pduLogCnt"
    FIELD fQca_STAT_IsoSduTxDbg_beginPduSeqn     (Fixed 1 Bytes) (Decimal)   "beginPduSeqn"

    GROUP gQca_STAT_IsoSduTxDbg_scheduleInfo_Field IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduTxDbg_missDispatch)
    {
        GROUP gQca_STAT_Iso_scheduleInfo "miss Dispatch Since Task: "
        {
            FIELD fQca_STAT_IsoSduTxDbg_scheduleInfo_opcode          (Fixed 1 Bytes) (TABLE tQca_DispatchOpCode)   "opcode"
            FIELD fQca_STAT_IsoSduTxDbg_scheduleInfo_priority        (Fixed 1 Bytes) (Decimal)   "priority"
        }
    }

    GROUP gQca_STAT_IsoSduTxDbg_pduStat_Field IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduTxDbg_pduLogCnt)
    {
        FIELD fQca_STAT_IsoSduTxDbg_LastPduSeqn_init (Fixed 0) (Hex) SUPPRESS_DETAIL STORE lastPduSeqnValue RETRIEVE (StoreInteger 0xFFFFFFFF)

        GROUP gQca_STAT_IsoSduTxDbg_pduStat REPEAT COUNT (FromField Times fQca_STAT_IsoSduTxDbg_pduLogCnt 0) "PDU status"
        {
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_rxStatus_tmp     (Fixed 3 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_txSubEvt_tmp     (Fixed 4 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_schedule_tmp     (Fixed 1 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_seqn_tmp         (Fixed 1 bytes) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_event_tmp        (Fixed 2 bytes) (Decimal) SUPPRESS_DETAIL

            FIELD fQca_STAT_IsoSduTxDbg_LastPduSeqn (Fixed 0) RETRIEVE (StoreField lastPduSeqnValue) (Decimal) SUPPRESS_DETAIL

            GROUP gQca_STAT_IsoSduTxDbg_pduStat_seqn_show IF (CompareFields fQca_STAT_IsoSduTxDbg_pduStat_seqn_tmp NotEqualTo fQca_STAT_IsoSduTxDbg_LastPduSeqn)
            {
                FIELD fQca_STAT_IsoSduTxDbg_pduStat_seqn         (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_seqn_tmp) (Decimal) "------------ PDU seqn --------"
                FIELD fQca_STAT_IsoSduTxDbg_LastPduSeqn_set (Fixed 0) (Hex) SUPPRESS_DETAIL STORE lastPduSeqnValue RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_seqn)
            }

            GROUP gQca_STAT_IsoSduTxDbg_pduStat_schedule IF (Fieldis EqualTo 0 fQca_STAT_IsoSduTxDbg_pduStat_schedule_tmp)
            {
                FIELD fQca_STAT_IsoSduTxDbg_pduStat_schedule     (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_schedule_tmp)   (Decimal)   "scheduled"
            }

            FIELD fQca_STAT_IsoSduTxDbg_pduStat_event     (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_event_tmp)      (Decimal)   "streamEvent"
            FIELD fQca_STAT_IsoSduTxDbg_pduStat_txSubEvt  (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_txSubEvt_tmp)   (Decimal)   "subEvt"

            /* show rxStatus if it's not BIS_M */
            GROUP gQca_STAT_IsoSduTxDbg_pduStat_rxStatus_show IF (Fieldis NotEqualTo 2 fQca_STAT_IsoSduTxDbg_isoType)
            {
                FIELD fQca_STAT_IsoSduTxDbg_pduStat_rxStatus         (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduTxDbg_pduStat_rxStatus_tmp)   (TABLE t_IsoPduRxStatus)   "rxStatus"
            }
        }
    }
}

TABLE t_IsoFrameType
    {0 "UNFRAMED"}
    {1 "FRAMED"}
ENDTABLE

TABLE t_ISO_SduRxStatus
    {0x00 "Success"     "Success"       0   gQca_STAT_IsoSduRxDbg_Success}
    {0x01 "Miss"        "Miss"          0   gQca_STAT_IsoSduRxDbg_Miss}
    {0x02 "MissSync"    "MissSync"      0   gQca_STAT_IsoSduRxDbg_MissSync}
    {0x03 "FailSeqn"    "FailSeqn"      0   gQca_STAT_IsoSduRxDbg_FailSeqn}
    {0x04 "FailLen"     "FailLen"       0   gQca_STAT_IsoSduRxDbg_FailLen}
ENDTABLE

GROUP gQca_STAT_IsoSduRxDbg "ISO SDU Rx Dbg"
{
    FIELD fQca_STAT_IsoSduRxDbg_handle         (Fixed 1 Bytes) (Decimal)                       "handle"
    FIELD fQca_STAT_IsoSduRxDbg_isoType        (Fixed 1 Bytes) (TABLE tQca_IsoType)            "isoType"
    FIELD fQca_STAT_IsoSduRxDbg_isFrame        (Fixed 1 Bytes) (TABLE t_IsoFrameType)          "frame"
    FIELD fQca_STAT_IsoSduRxDbg_sduStatus      (Fixed 1 Bytes) (TABLE t_ISO_SduRxStatus)       "sduStatus"
    FIELD fQca_STAT_IsoSduRxDbg_cxmDenials     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)      "cxmDenials"
    Reserved (Fixed 2 bytes)
    FIELD fQca_STAT_IsoSduRxDbg_missDispatch   (Fixed 1 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)      "missDispatch"
    FIELD fQca_STAT_IsoSduRxDbg_pduCnt         (Fixed 1 Bytes) (Decimal)                       "pduCnt"
    FIELD fQca_STAT_IsoSduRxDbg_pduLogCnt      (Fixed 1 Bytes) (Decimal)                       "pduLogCnt"
    FIELD fQca_STAT_IsoSduRxDbg_startPduSeqn   (Fixed 1 Bytes) (Decimal)                       "startPduSeqn"

    BRANCH (FromTable   t_ISO_SduRxStatus   fQca_STAT_IsoSduRxDbg_sduStatus)

    GROUP gQca_STAT_IsoSduRxDbg_schedule_Field IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduRxDbg_missDispatch)
    {
        GROUP gQca_STAT_Iso_scheduleInfo;
    }

    GROUP gQca_STAT_IsoSduRxDbg_rxPduLog_Field IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduRxDbg_pduLogCnt)
    {
        FIELD fQca_STAT_IsoSduRxDbg_LastPduSeqn_init (Fixed 0) (Hex) SUPPRESS_DETAIL STORE lastPduSeqnValue RETRIEVE (StoreInteger 0xFFFFFFFF)

        GROUP gQca_STAT_IsoSduRxDbg_pduStat REPEAT COUNT (FromField Times fQca_STAT_IsoSduRxDbg_pduLogCnt 0) "PDU status"
        {
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_rxStatus_tmp     (Fixed 3 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_txSubEvt_tmp     (Fixed 4 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_schedule_tmp     (Fixed 1 bits)  (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_seqn_tmp         (Fixed 1 bytes) (Decimal) SUPPRESS_DETAIL
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_event_tmp        (Fixed 2 bytes) (Decimal) SUPPRESS_DETAIL

            FIELD fQca_STAT_IsoSduRxDbg_LastPduSeqn (Fixed 0) RETRIEVE (StoreField lastPduSeqnValue) (Decimal) SUPPRESS_DETAIL

            GROUP gQca_STAT_IsoSduRxDbg_pduStat_seqn_show IF (CompareFields fQca_STAT_IsoSduRxDbg_pduStat_seqn_tmp NotEqualTo fQca_STAT_IsoSduRxDbg_LastPduSeqn)
            {
                FIELD fQca_STAT_IsoSduRxDbg_pduStat_seqn         (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduRxDbg_pduStat_seqn_tmp) (Decimal) "------------ PDU seqn --------"
                FIELD fQca_STAT_IsoSduRxDbg_LastPduSeqn_set (Fixed 0) (Hex) SUPPRESS_DETAIL STORE lastPduSeqnValue RETRIEVE (StoreField fQca_STAT_IsoSduRxDbg_pduStat_seqn)
            }

            FIELD fQca_STAT_IsoSduRxDbg_pduStat_event       (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduRxDbg_pduStat_event_tmp)      (Decimal)   "streamEvent"
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_txSubEvt    (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduRxDbg_pduStat_txSubEvt_tmp)   (Decimal)   "subEvt"
            FIELD fQca_STAT_IsoSduRxDbg_pduStat_rxStatus    (Fixed 0) RETRIEVE (StoreField fQca_STAT_IsoSduRxDbg_pduStat_rxStatus_tmp)   (TABLE t_IsoPduRxStatus)   "rxStatus"
        }
    }
}

GROUP gQca_STAT_IsoSduRxDbg_Success  "RX Success"
{
    FIELD fQca_STAT_IsoSduRxDbg_Success_SduSeqn         (Fixed 2 Bytes)   (Decimal) "SduSeqn"
    FIELD fQca_STAT_IsoSduRxDbg_Success_SduLen          (Fixed 2 Bytes)   (Decimal) "SduLen"
}

GROUP gQca_STAT_IsoSduRxDbg_Miss  "RX Miss"
{
    FIELD fQca_STAT_IsoSduRxDbg_UnFrameMiss_SduSeqn     (Fixed 2 Bytes)   (Decimal) "SduSeqn"
    FIELD fQca_STAT_IsoSduRxDbg_UnFrameMiss_SduLen      (Fixed 2 Bytes)   (Decimal) "SduLen"
}

GROUP gQca_STAT_IsoSduRxDbg_MissSync  "RX MissSync"
{
    FIELD fQca_STAT_IsoSduRxDbg_Miss_missSduSeqn        (Fixed 2 Bytes)   (Decimal) "missSduSeqn"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_cnt                (Fixed 2 Bytes)   (Decimal) "missCnt"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_lastLocalSduSeqn   (Fixed 2 Bytes)   (Decimal) "lastLocalSduSeqn"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_currSduSeqn        (Fixed 2 Bytes)   (Decimal) "currSduSeqn"

    FIELD fQca_STAT_IsoSduRxDbg_Miss_rxPduTime          (Fixed 4 Bytes)   (Decimal) "currRxPduTime"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_rxPduOffset        (Fixed 4 Bytes)   (Decimal) "currRxOffset"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_lastRxSyncRef      (Fixed 4 Bytes)   (Decimal) "last SDU Sync Ref"
    FIELD fQca_STAT_IsoSduRxDbg_Miss_deltaToRxSyncRef   (Fixed 4 Bytes)   (Decimal) "delta to last SDU Sync Ref"
}

GROUP gQca_STAT_IsoSduRxDbg_FailSeqn "RX Fail Seqn"
{
    Group gQca_STAT_IsoSduRxDbg_FailSeqn_FrameCase IF (Fieldis NotEqualTo 0 fQca_STAT_IsoSduRxDbg_isFrame)
    {
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_frame_expectSduSeqn    (Fixed 2 Bytes)   (Decimal) "expectSduSeqn"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_frame_currSduLen       (Fixed 2 Bytes)   (Decimal) "currSduLen"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_frame_currSduSeqn      (Fixed 2 Bytes)   (Decimal) "currSduSeqn"
        Reserved (Fixed 4 bytes)
    }

    Group gQca_STAT_IsoSduRxDbg_FailSeqn_UnframeCase IF (Fieldis EqualTo 0 fQca_STAT_IsoSduRxDbg_isFrame)
    {
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_unframe_localSduSeqn   (Fixed 2 Bytes)   (Decimal) "SduSeqn"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_unframe_currSduLen     (Fixed 2 Bytes)   (Decimal) "SduLen"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_unframe_rxPayloadCnt_SduWidth (Fixed 2 Bytes)   (Decimal) "rx PayloadCnt/SduWidth"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_unframe_currPduSeqn    (Fixed 2 Bytes)   (Decimal) "currPduSeqn"
        FIELD fQca_STAT_IsoSduRxDbg_FailSeqn_unframe_rxSduWidth     (Fixed 1 Bytes)   (Decimal) "SduWidth"
        Reserved (Fixed 1 byte)
    }
}

GROUP gQca_STAT_IsoSduRxDbg_FailLen "RX Fail Len"
{
    FIELD fQca_STAT_IsoSduRxDbg_FailLen_localSduSeqn    (Fixed 2 Bytes)   (Decimal) "SduSeqn"
    FIELD fQca_STAT_IsoSduRxDbg_FailLen_currSduLen      (Fixed 2 Bytes)   (Decimal) "currSduLen"
    FIELD fQca_STAT_IsoSduRxDbg_FailLen_expectSduLen    (Fixed 2 Bytes)   (Decimal) "expectSduLen"
}

GROUP gQca_STAT_VoiceGroup "Voice Group Stats"
{
    FIELD fQca_STAT_ISO_ToAirIntrCnt                    (Fixed 2 Bytes)   (Decimal)   "ToAir Intr Count"
    FIELD fQca_STAT_ISO_ToAirIntrMissedCnt              (Fixed 2 Bytes)   (Decimal)   "ToAir Intr Missed Count"
    FIELD fQca_STAT_ISO_ToAirIntrLateCnt                (Fixed 2 Bytes)   (Decimal)   "ToAir Intr Late Count"
    FIELD fQca_STAT_ISO_ToAirIntrMaxExecutionTime       (Fixed 2 Bytes)   (Decimal)   "ToAir Intr Longest Execution Time"
    FIELD fQca_STAT_ISO_FromAirIntrCnt                  (Fixed 2 Bytes)   (Decimal)   "FromAir Intr Count"
    FIELD fQca_STAT_ISO_FromAirIntrMissedCnt            (Fixed 2 Bytes)   (Decimal)   "FromAir Intr Missed Count"
    FIELD fQca_STAT_ISO_FromAirIntrMaxExecutionTime     (Fixed 2 Bytes)   (Decimal)   "FromAir Intr Longest Execution Time"
    FIELD fQca_STAT_ISO_FromAirGoodCnt                  (Fixed 2 Bytes)   (Decimal)   "FromAir Window Good Count"
    FIELD fQca_STAT_ISO_FromAirFailCnt                  (Fixed 2 Bytes)   (Decimal)   "FromAir Window Fail Count"
    FIELD fQca_STAT_ISO_FromAirLostCnt                  (Fixed 2 Bytes)   (Decimal)   "FromAir Window Lost Count"
    FIELD fQca_STAT_ISO_FromAirEDP1WayVoteCnt           (Fixed 2 Bytes)   (Decimal)   "FromAir EDP 1-Way Vote Count"
    FIELD fQca_STAT_ISO_FromAirEDP2WayVoteCnt           (Fixed 2 Bytes)   (Decimal)   "FromAir EDP 2-Way Vote Count"
    FIELD fQca_STAT_ISO_FromAirEDP3WayVoteCnt           (Fixed 2 Bytes)   (Decimal)   "FromAir EDP 3-Way Vote Count"
    FIELD fQca_STAT_ISO_FromAirEDPCorrelationFailCnt    (Fixed 2 Bytes)   (Decimal)   "FromAir EDP Correlation Fail Count"
}

GROUP gQca_STAT_VoiceStream "Voice Stream Stats"
{
    FIELD fQca_STAT_ISO_ConnHandle                      (Fixed 2 Bytes)   (Decimal)   "Stream Connection Handle"
    FIELD fQca_STAT_ISO_ToAirRingSampleLevel            (Fixed 2 Bytes)   (Decimal)   "ToAir Ring Sample Level"
    FIELD fQca_STAT_ISO_ToAirAddCnt                     (Fixed 1 Byte)    (Decimal)   "ToAir Add Count"
    FIELD fQca_STAT_ISO_ToAirDropCnt                    (Fixed 1 Byte)    (Decimal)   "ToAir Drop Count"
    FIELD fQca_STAT_ISO_ToAirStuffCnt                   (Fixed 1 Byte)    (Decimal)   "ToAir Stuff Count"
    FIELD fQca_STAT_ISO_ToAirFlushCnt                   (Fixed 1 Byte)    (Decimal)   "ToAir Flush Count"
    FIELD fQca_STAT_ISO_ToAirIOPDropCnt                 (Fixed 1 Byte)    (Decimal)   "ToAir IOP Drop Count"
    FIELD fQca_STAT_ISO_ToAirUnused                     (Fixed 1 Byte)    (Decimal)   "ToAir IOP Unused"
    FIELD fQca_STAT_ISO_FromAirPLCWeakBitDiscardCnt     (Fixed 2 Bytes)   (Decimal)   "FromAir PLC Weak Bit Discard Count"
    FIELD fQca_STAT_ISO_FromAirPLCFillCnt               (Fixed 2 Bytes)   (Decimal)   "FromAir PLC Fill Count"
    FIELD fQca_STAT_ISO_FromAirPLCReplaceCnt            (Fixed 2 Bytes)   (Decimal)   "FromAir PLC Replace Count"
    FIELD fQca_STAT_ISO_FromAirRingSampleLevel          (Fixed 2 Bytes)   (Decimal)   "FromAir Ring Sample Level"
    FIELD fQca_STAT_ISO_FromAirAddCnt                   (Fixed 1 Byte)    (Decimal)   "FromAir Add Count"
    FIELD fQca_STAT_ISO_FromAirDropCnt                  (Fixed 1 Byte)    (Decimal)   "FromAir Drop Count"
    FIELD fQca_STAT_ISO_FromAirStuffCnt                 (Fixed 1 Byte)    (Decimal)   "FromAir Stuff Count"
    FIELD fQca_STAT_ISO_FromAirFlushCnt                 (Fixed 1 Byte)    (Decimal)   "FromAir Flush Count"
    FIELD fQca_STAT_ISO_FromAirIOPStuffCnt              (Fixed 1 Byte)    (Decimal)   "FromAir IOP Stuff Count"
}
