GROUP gQca_STAT_MRCPeriodicStats    "MRC Periodic Stats"
{
    FIELD fQca_mrcActiveCount                (Fixed 2 Bytes)     (Decimal)       "MRC Active Count"
    FIELD fQca_mrcInactiveCountRxChain0      (Fixed 2 Bytes)     (Decimal)       "MRC Inactive Rx Ch0 In Use Count"
    FIELD fQca_mrcInactiveCountRxChain1      (Fixed 2 Bytes)     (Decimal)       "MRC Inactive Rx Ch1 In Use Count"
    FIELD fQca_mrcConnHandle                 (Fixed 1 Byte)      (Decimal)       "Conn Handle"
    FIELD fQca_mrcActivePercent              (Fixed 1 Byte)      (Decimal)       "MRC Active Percent"
}

GROUP gQca_STAT_IbfPeriodicStats    "iBF Periodic Stats"
{
    FIELD fQca_ibfConnHandle                 (Fixed 2 Bytes)     (Decimal)       "Conn Handle"
    GROUP fQca_ibfPLbelow10Stats         "IBF PL9 and below Stats"
    {
    FIELD fQca_BelowPL10ibfUsageCnt         (Fixed 2 Bytes)     (Decimal)       "Below PL10 iBF Usage Count"
    FIELD fQca_BelowPL10Ch0UsageCnt         (Fixed 2 Bytes)     (Decimal)       "Below PL10 Ch0 Usage Count"
    FIELD fQca_BelowPL10Ch1UsageCnt         (Fixed 2 Bytes)     (Decimal)       "Below PL10 Ch1 Usage Count"
    }
    GROUP fQca_ibfPL10Stats         "iBF PL10 Stats"
    {
    FIELD fQca_PL10IbfUsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL10 iBF Usage Count"
    FIELD fQca_PL10Ch0UsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL10 Ch0 Usage Count"
    FIELD fQca_PL10Ch1UsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL10 Ch1 Usage Count"
    }
    GROUP fQca_ibfPL11Stats         "iBF PL11 Stats"
    {
    FIELD fQca_PL11IbfUsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL11 IBF Usage Count"
    FIELD fQca_PL11Ch0UsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL11 Ch0 Usage Count"
    FIELD fQca_PL11Ch1UsageCnt         (Fixed 2 Bytes)     (Decimal)       "PL11 Ch1 Usage Count"
    }
}

GROUP gQca_STAT_isoAudioRetransRate "ISO Audio RETRANS RATE STATS "
{
    FIELD fQca_isoAudioRetransRatehciHandle           (Fixed 1 Byte)          (Decimal)              "Stream Handle "
    FIELD fQca_isoAudioRetransRatereTransCount        (Fixed 1 Byte)          (Decimal)              "Retrans SE"
    FIELD fQca_isoAudioRetransRatemaxRetransPerEval   (Fixed 1 Byte)          (Decimal)              "MaxRetransPerEval"
    FIELD fQca_isoAudioRetransRateretransPerInterval  (Fixed 1 Byte)          (Decimal)              "RetransPerInterval"
    FIELD fQca_isoAudioRetransRatelastTimeCalClk      (Fixed 4 Bytes)         (Decimal)              "LastEventCount"
    FIELD fQca_isoAudioRetransRateretransMovingAvg    (Fixed 4 Bytes)         (Decimal)              "Moving Avg"
    FIELD fQca_isoAudiosetCriPriCnt                   (Fixed 2 Bytes)         (Decimal)              "MciCriPriCnt"
    FIELD fQca_isoAudiolastCriticalEvent              (Fixed 2 Bytes)         (Decimal)              "LastCrtical EventCounter"
    FIELD fQca_isoAudioRetransbackUpCxmDenialCount    (Fixed 4 Bytes)         (Decimal)              "backUpCxmDenialCount"
    FIELD fQca_isoAudioRetranslastRetransRate         (Fixed 4 Bytes)         (Decimal)              "lastRetransRate"
    FIELD fQca_isoAudioRetranslastretransCount        (Fixed 1 Bytes)         (Decimal)              "retransCount"
    FIELD fQca_isoAudioRetranslastretransPercent      (Fixed 1 Bytes)         (Decimal)              "retransPercent"
    FIELD fQca_isoAudioRetranslastaddtinalPercent     (Fixed 1 Bytes)         (Decimal)              "addtinalPercent"
    FIELD fQca_isoAudioRetranslastcxmDenialCnt        (Fixed 1 Bytes)         (Decimal)              "cxmDenialCnt"
}

GROUP gQca_STAT_isoVoiceRetransRate "ISO Voice RETRANS RATE STATS "
{
    FIELD fQca_isoRetransRatehciHandle           (Fixed 1 Byte)          (Decimal)              "Stream Handle "
    FIELD fQca_isoRetransRatereTransCount        (Fixed 1 Byte)          (Decimal)              "Retrans count"
    FIELD fQca_isoRetransRatemaxRetransPerEval   (Fixed 1 Byte)          (Decimal)              "MaxRetransPerEval"
    FIELD fQca_isoRetransRateretransPerInterval  (Fixed 1 Byte)          (Decimal)              "RetransPerInterval"
    FIELD fQca_isoRetransRatelastTimeCalClk      (Fixed 4 Bytes)         (Decimal)              "Cal clk (native clk)"
    FIELD fQca_isoRetransRateretransMovingAvg    (Fixed 4 Bytes)         (Decimal)              "Moving Avg"
    FIELD fQca_isoRetransRateretrasnSubEvents    (Fixed 1 Byte)          (Decimal)              "High Prio SE"
    Reserved                                     (Fixed 1 Byte)
    FIELD fQca_isoVoicesetCriPriCnt              (Fixed 2 Bytes)         (Decimal)              "MciCriPriCnt"
    FIELD fQca_isoVoicelastCriticalEvent         (Fixed 2 Bytes)         (Decimal)              "LastCrtical EventCounter"
    Reserved                                     (ToEndOfLayer)
}

GROUP gQca_3mNACKStats "3M Nack Status"
{
    FIELD fQca_3mAverageNakrate             (Fixed 4 Bytes)          (Decimal)                      "average nack rate"
    FIELD fQca_3mNaks                       (Fixed 2 Bytes)          (Decimal)                      "3M NACKS"
    FIELD fQca_3mtotalTx                    (Fixed 2 Bytes)          (Decimal)                      "total 3M packets"
    FIELD fQca_hcihandleOf3M                (Fixed 2 Bytes)          (Decimal)                      "Conn Handle"
}

TABLE tFRAState
    {0x00 "3M PACKETS CAN USE"}
    {0x01 "NO 3M PACKETS"}
ENDTABLE

GROUP gQca_FRAStats "FRA Stats"
{
    FIELD fQca_frafilteredARQN                   (Fixed 4 Bytes)        (Hex)                         "filteredARQN"
    FIELD fQca_frafilteredARQNt                     (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_frafilteredARQN 100)    (Decimal) SUPPRESS_DETAIL
    FIELD fQca_frafilteredARQNf                  (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger   fQca_frafilteredARQNt 32768) (Decimal) "filteredARQN(%)"
    FIELD fQca_frasCurtate                       (Fixed 1 Byte)         (TABLE tFRAState)             "Current FRA state"
    FIELD fQca_frasNewtate                       (Fixed 1 Byte)         (TABLE tFRAState)             "New FRA state"
    FIELD fQca_frasNumTran                       (Fixed 1 Byte)         (Decimal)                     "NumTrans"
    FIELD fQca_frasTxStatus                      (Fixed 1 Byte)         (Decimal)                     "TxStatus"
}

Group gQca_STAT_PageScanPerfStats "Page Scan Performance info"
{
    FIELD fQca_PageScanSlots                    (Fixed 2 Bytes)         (decimal)               "Primary page scan slots"
    FIELD fQca_BGD_PageScanSlots                (Fixed 2 Bytes)         (decimal)               "Background page scan slots"
    FIELD fQca_PageScanIDDetect                 (Fixed 2 Bytes)         (decimal)               "Primary ID detects"
    FIELD fQca_BGD_PageScanIDDetect             (Fixed 2 Bytes)         (decimal)               "Background ID detects"
    FIELD fQca_PageScanResponseFail                 (Fixed 2 Bytes)         (decimal)           "Total Page Scan response fails"
}

TABLE APCF_ENABLE
    {0 "Disabled"}
    {1 "Enabled"}
ENDTABLE

Group gQca_STAT_ApcfContextStats "APCF Context Stats"
{
    FIELD fQca_ApcfContext_Enable                       (Fixed 1 Byte)          (TABLE APCF_ENABLE)              "Enable"
    FIELD fQca_ApcfContext_Filters                      (Fixed 1 Byte)          (decimal)                        "Filters"
    FIELD fQca_ApcfContext_BcastEntries                 (Fixed 1 Byte)          (decimal)                        "BcastEntries"
    FIELD fQca_ApcfContext_DeviceNameEntries            (Fixed 1 Byte)          (decimal)                        "DeviceNameEntries"
    FIELD fQca_ApcfContext_ServiceUUIDEntrie            (Fixed 1 Byte)          (decimal)                        "ServiceUUIDEntrie"
    FIELD fQca_ApcfContext_SolicitationUUIDEntries      (Fixed 1 Byte)          (decimal)                        "SolicitationUUIDEntries"
    FIELD fQca_ApcfContext_ServiceDataEntrie            (Fixed 1 Byte)          (decimal)                        "ServiceDataEntrie"
    FIELD fQca_ApcfContext_ManfDataEntries              (Fixed 1 Byte)          (decimal)                        "ManfDataEntries"
    FIELD fQca_ApcfContext_TransDiscEntries             (Fixed 1 Byte)          (decimal)                        "TransDiscEntries"
    FIELD fQca_ApcfContext_ADTypeEntries                (Fixed 1 Byte)          (decimal)                        "ADtypeEntries"
    FIELD fQca_ApcfContext_PatternMatchDataEntries      (Fixed 1 Byte)          (decimal)                        "PatternMatchDataEntries"
    FIELD fQca_ApcfContext_TrackingEntries              (Fixed 2 Byte)          (decimal)                        "TrackingEntries"
}

TABLE EDPH_RUN_STATUS
    {0 "STOP"}
    {1 "START"}
    {2 "RUN"}
ENDTABLE

GROUP gQca_EDPHHist "EDPH history"
{
    FIELD fQca_EDPH_HisthciHandle               (Fixed 1 Byte)      (Hex)            "hciHandle"
    FIELD fQca_EDPH_status                      (Fixed 1 Bytes)     (TABLE EDPH_RUN_STATUS) "status"
    FIELD fQca_EDPH_totalEnCnt                  (Fixed 2 Bytes)     (Decimal)        "totalEnCnt"
    FIELD fQca_EDPH_hecGoodnCnt                 (Fixed 2 Bytes)     (Decimal)        "hecGoodCnt"
    FIELD fQca_EDPH_nakCnt                      (Fixed 2 Bytes)     (Decimal)        "nakCnt"
    FIELD fQca_EDPH_noRspCnt                    (Fixed 2 Bytes)     (Decimal)        "noRspCnt"
    FIELD fQca_EDPH_succCnt                     (Fixed 2 Bytes)     (Decimal)        "succCnt"
    FIELD fQca_EDPH_failCnt                     (Fixed 2 Bytes)     (Decimal)        "failCnt"
    GROUP fQca_EDPH_errTypeCnt   "errTypeCnt"
    {
    FIELD fQca_EDPH_errHEC                      (Fixed 2 Bytes)     (Decimal)        "errHecCnt"
    FIELD fQca_EDPH_errSeq                      (Fixed 2 Bytes)     (Decimal)        "errSeqCnt"
    FIELD fQca_EDPH_errArq                      (Fixed 2 Bytes)     (Decimal)        "errArqCnt"
    FIELD fQca_EDPH_errFlow                     (Fixed 2 Bytes)     (Decimal)        "errFlowCnt"
    FIELD fQca_EDPH_errType                     (Fixed 2 Bytes)     (Decimal)        "errPktTypeCnt"
    FIELD fQca_EDPH_errLtaddr                   (Fixed 2 Bytes)     (Decimal)        "errLtaddrCnt"
    }
    FIELD fQca_edphErrIdxCntr0 (Fixed 0) RETRIEVE (StoreInteger 0) (hex) SUPPRESS_DETAIL STORE IdxCntr
    GROUP gQCA_EDPHErrcntRecords REPEAT COUNT (Fixed 19 Times)
    {
    FIELD fQca_EDPH_errCnti                     (Fixed 2 Bytes)     (DecimalWithFieldLabel IdxCntr)       "ERR"
    FIELD fQca_edphErrIdxCntrIncr (Fixed 0) RETRIEVE (StoreField IdxCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE IdxCntr
    }
    FIELD fQca_EDPH_abortCfg                    (Fixed 4 Bytes)     (Hex)           "abortRegCfg. 0-abort;0x0f-notAbort"
    FIELD fQca_EDPH_RSSI                        (Fixed 1 Bytes)     RETRIEVE (SignExtension 8) (Decimal) "RSSI"
    FIELD fQca_EDPH_TxPowerLevel                (Fixed 1 Bytes)     (Decimal)       "txPowerLevel"
}

GROUP gQca_EDPHStart "EDPH start"
{
    FIELD fQca_EDPH_hciHandle                       (Fixed 1 Byte)     (Hex)            "hciHandle"
    FIELD fQca_EDPHCfg_Classic_MV_Threshold         (Fixed 1 Byte)     (Hex)            "Classic_MV_Threshold"
    FIELD fQca_EDPHCfg_Difference_Threshold         (Fixed 1 Byte)     (Hex)            "Cfg_Difference_Threshold"
    RESERVED                                        (Fixed 1 Byte)
    FIELD fQca_EDPHCfg_Packet_Header_Mask           (Fixed 4 Bytes)    (Hex)            "Cfg_Packet_Header_Mask"

    FIELD fQca_EDPH_UAP                             (Fixed 1 Byte)     (Hex)            "UAP"
    FIELD fQca_EDPH_lt_addr                         (Fixed 1 Byte)     (Decimal)        "lt_addr"
    RESERVED                                        (Fixed 2 Bytes)
    FIELD fQca_EDPH_expHdr0                         (Fixed 4 Bytes)    (Hex)            "expSeq0"
    FIELD fQca_EDPH_expHdr1                         (Fixed 4 Bytes)    (Hex)            "expSeq1"
    RESERVED                                        (Fixed 8 Bytes)
}

GROUP gQca_STAT_WarDevice "War Device Info"
{
    FIELD fQca_manufacture         (Fixed 2 Bytes)    (Hex)            "manufacturer"
    FIELD fQca_lmpSubversion       (Fixed 2 Bytes)    (Hex)            "lmp sub version"
    FIELD fQca_lmpVesion           (Fixed 1 Byte)     (Hex)            "lmp version"
    FIELD fQca_attribute0          (Fixed 1 Byte)     (Hex)            "Attribute0"
