GROUP gQca_CtrlData_LePowerCtrlReq
{
        FIELD fQca_OTA_Phy            (Fixed 1 Byte)      (TABLE tQcaLePowerCtrl_PHY)          "Phy Type"
        FIELD fQca_OTA_Delta          (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)  "Delta"
        FIELD fQca_OTA_TxPower        (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)  "Tx Power"
}

GROUP gQca_CtrlData_LePowerCtrlRsp
{
        RESERVED                      (Fixed 6 Bits)
        FIELD fQca_OTA_LEPRspMax   (Fixed 1 Bits)      (Hex) "Max"
		FIELD fQca_OTA_LEPRspMin   (Fixed 1 Bits)      (Hex) "Min"
        FIELD fQca_OTA_LEPRspDelta    (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)     "Delta"
        FIELD fQca_OTA_LEPRspTxPower  (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)     "Tx Power"
        FIELD fQca_OTA_APR            (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)     "APR"
}

GROUP gQca_CtrlData_LePowerChangeInd
{
        FIELD fQca_OTA_LEPChIndPhy    (Fixed 1 Byte)      (TABLE tQcaLePowerCtrl_PHY) "Phy Type"
		RESERVED                      (Fixed 6 Bits)
        FIELD fQca_OTA_LEPRspMax;
		FIELD fQca_OTA_LEPRspMin;
        FIELD fQca_OTA_ChIndDelta     (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)    "Delta"
        FIELD fQca_OTA_ChIndTxPower   (Fixed 1 Byte)      RETRIEVE (SignExtension 8) (Decimal)    "Tx Power"
}

GROUP gQca_CtrlData_LePowerReportsReq
{
        FIELD fQca_OTA_LEPReqEnable   (Fixed 1 Byte)      (TABLE tQcaLePowerCtrl_Enable) "Enable"
}

GROUP gQca_CtrlData_LePowerReportsRsp
{
}

