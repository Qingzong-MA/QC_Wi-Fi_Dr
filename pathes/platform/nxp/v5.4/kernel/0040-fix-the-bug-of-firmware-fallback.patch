From 84b7e4b2369bb6c63eb010755186ff1e8e9db549 Mon Sep 17 00:00:00 2001
From: "nano.wang" <nano.wang@quectel.com>
Date: Fri, 25 Apr 2025 23:36:30 +0800
Subject: [PATCH 1/4] fix the bug of firmware fallback

---
 drivers/base/firmware_loader/main.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/base/firmware_loader/main.c b/drivers/base/firmware_loader/main.c
index 95d21b4af904..1191b2dd12d7 100644
--- a/drivers/base/firmware_loader/main.c
+++ b/drivers/base/firmware_loader/main.c
@@ -785,7 +785,9 @@ _request_firmware(const struct firmware **firmware_p, const char *name,
 			dev_warn(device,
 				 "Direct firmware load for %s failed with error %d\n",
 				 name, ret);
-		ret = firmware_fallback_sysfs(fw, name, device, opt_flags, ret);
+		if (opt_flags & FW_OPT_USERHELPER) {
+			ret = firmware_fallback_sysfs(fw, name, device, opt_flags, ret);
+		}
 	} else
 		ret = assign_fw(fw, device, opt_flags);
 
