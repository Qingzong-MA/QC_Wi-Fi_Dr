TABLE tQca_OTALogID APPENDS_ONLY tQca_EnhLogID
    {0x0300 "OTA LMP RX PDU"        "OTA LMP RX PDU"            0 gQca_OTA_LMPRxPDU}
    {0x0301 "OTA LMP TX PDU"        "OTA LMP TX PDU"            0 gQca_OTA_LMPTxPDU}
    {0x0302 "OTA LE CTRL RX PDU"    "OTA LE CTRL RX PDU"        0 gQca_OTA_LECtrlRxPDU}
    {0x0303 "OTA LE CTRL TX PDU"    "OTA LE CTRL TX PDU"        0 gQca_OTA_LECtrlTxPDU}
    {0x0309 "OTA BIG CTRL RX PDU"           "OTA BIG CTRL RX PDU"               0   gQca_OTA_BIGCtrlRxPDU}
    {0x030A "OTA BIG CTRL TX PDU"           "OTA BIG CTRL TX PDU"               0   gQca_OTA_BIGCtrlTxPDU}
    {0x030B "OTA PROTOTYPE CTRL RX PDU"    "OTA LEP CTRL RX PDU"        0 gQca_OTA_LEPCtrlPDU}
    {0x030C "OTA PROTOTYPE CTRL TX PDU"    "OTA LEP CTRL TX PDU"        0 gQca_OTA_LEPCtrlPDU}
ENDTABLE

TABLE tQca_OTA_LMPRole
    { 0x0 "Central"}
    { 0x1 "Peripheral" }
    { Default "Invalid" }
ENDTABLE

GROUP gQca_OTA_LMPTxPDU "LMP Tx PDU Info"
{

    FIELD fQca_OTA_Handle               (Fixed 1 Byte)      (Decimal)           "Handle"
    RESERVED                            (Fixed 1 Byte)
    FIELD fQca_OTA_LMPPduLen            (Fixed 1 Byte)      (Decimal)           "PDU Length"
    FIELD fQca_OTA_LMPTxAck             (Fixed 1 Bit)       (Decimal)           "TxACK Req"
    FIELD fQca_OTA_LMPTxNotify          (Fixed 1 Bit)       (Decimal)           "Tx Notify"
    FIELD fQca_OTA_LMPTxUpdate          (Fixed 1 Bit)       (Decimal)           "Tx Update"
    FIELD fQca_OTA_LMPRole              (Fixed 1 Bit)       (TABLE tQca_OTA_LMPRole)           "Transmitter Role"
    RESERVED                            (Fixed 4 Bits)
    FIELD fQca_OTA_LMPPDU_Type          (Fixed 0) RETRIEVE(StoreInteger 0) (Decimal) SUPPRESS_DETAIL	STORE sQca_PduType
    FIELD fQca_SetTraversalOverride     (Fixed 0) RETRIEVE(StoreInteger 1) (HEX) SUPPRESS_DETAIL Store sQca_TraversalOverride
}

GROUP gQca_OTA_LMPRxPDU "LMP Rx PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                            (Fixed 1 Byte)
    FIELD fQca_OTA_LMPPduLen;
    FIELD fQca_OTA_LMPTxAck;
    RESERVED                            (Fixed 2 Bits)
    FIELD fQca_OTA_LMPRole;
    RESERVED                            (Fixed 4 Bits)
    FIELD fQca_OTA_LMPPDU_Type;
    FIELD fQca_SetTraversalOverride;
}

GROUP gQca_OTA_LECtrlRxPDU "LE Ctrl Rx PDU Info"
{
    FIELD fQca_OTA_Handle;
    FIELD fQca_OTA_LMPTxAck;
    FIELD fQca_OTA_LMPTxNotify;
    FIELD fQca_OTA_QLLType              (Fixed 1 Bit)       (Decimal)           "QLL Type"
    FIELD fQca_OTA_LMPRole;
    RESERVED                            (Fixed 4 Bits)
    RESERVED                            (Fixed 1 Bytes)
    FIELD fQca_OTA_LETxAck              (Fixed 1 Bit)       (Decimal)           "TxACK Req"
    FIELD fQca_OTA_LEPduLen             (Fixed 7 Bits)      (Decimal)           "PDU Length"

    /* We took 14 bytes offset from starting of the QCA Debug packet to reach PduLen field */
    /* The below Move command will move (PduLen value + Offset(14)) bytes from start of QCA Debug packet to read 2 bytes containing Event Counter info */
    FIELD fQca_OTA_LEEventCounter   START_BIT (MoveAbsoluteFromField  fQca_OTA_LEPduLen 14)   (Fixed 2 Bytes)  (Hex) SUPPRESS_DETAIL NO_MOVE

    FIELD fQca_OTA_LERxType             (Fixed 1 Byte)  (TABLE tQca_OTA_RxPrototypeCtrlOpcode)   "LL Control Opcode"
    BRANCH (FromTable tQca_OTA_RxPrototypeCtrlOpcode fQca_OTA_LERxType)
}

GROUP gQca_OTA_LECtrlRxOpCode "LE Ctrl Rx Opcode"
{
    FIELD fQca_OTA_LEPDU_Type           START_BIT (Move -8 Bits) (Fixed 0) RETRIEVE(StoreInteger 1) (Decimal) SUPPRESS_DETAIL        STORE sQca_PduType
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_LERxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 2) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_OTA_LECtrlTxPDU "LE Ctrl Tx PDU Info"
{
    FIELD fQca_OTA_Handle;
    FIELD fQca_OTA_LMPTxAck;
    FIELD fQca_OTA_LMPTxNotify;
    FIELD fQca_OTA_QLLType;
    FIELD fQca_OTA_LMPRole;
    RESERVED                            (Fixed 4 Bits)
    RESERVED                            (Fixed 1 Bytes)
    FIELD fQca_OTA_LETxAck;
    FIELD fQca_OTA_LEPduLen;
    FIELD fQca_OTA_LEEventCounter;
    FIELD fQca_OTA_LETxType             (Fixed 1 Byte)  (TABLE tQca_OTA_TxPrototypeCtrlOpcode)   "LL Control Opcode"
    BRANCH (FromTable tQca_OTA_TxPrototypeCtrlOpcode fQca_OTA_LETxType)
}

GROUP gQca_OTA_LECtrlTxOpCode "LE Ctrl Tx Opcode"
{
    FIELD fQca_OTA_LETxPDU_Type         START_BIT (Move -8 Bits) (Fixed 0) RETRIEVE(StoreInteger 1) (Decimal) SUPPRESS_DETAIL        STORE sQca_PduType
    FIELD fQca_SetTraversalOverride;
    FIELD fQca_OTA_LETxPDU_Side         (Fixed 0) RETRIEVE(StoreInteger 2) ALSO (StoreIntraframeField side) (Hex)   SUPPRESS_DETAIL
}

TABLE tQca_OTA_RxPrototypeCtrlOpcode
            { 0x28      "LE_LL_CHANNEL_REPORTING_IND"       "LE_LL_CHANNEL_REPORTING_IND"       0 gQca_CtrlData_LeChannelReportInd }
            { 0x29      "LE_LL_CHANNEL_STATUS_IND"          "LE_LL_CHANNEL_STATUS_IND"          0 gQca_CtrlData_LeChannelStatusInd }
            { 0xB4      "QLL_LE_LL_CHANNEL_REPORTING_IND"   "QLL_LE_LL_CHANNEL_REPORTING_IND"   0 gQca_CtrlData_LeChannelReportInd }
            { 0xB5      "QLL_LE_LL_CHANNEL_STATUS_IND"      "QLL_LE_LL_CHANNEL_STATUS_IND"      0 gQca_CtrlData_LeChannelStatusInd }
            {Default    ""                                  ""                                  0 gQca_OTA_LECtrlRxOpCode   }
ENDTABLE

TABLE tQca_OTA_TxPrototypeCtrlOpcode
            { 0x28      "LE_LL_CHANNEL_REPORTING_IND"       "LE_LL_CHANNEL_REPORTING_IND"       0 gQca_CtrlData_LeChannelReportInd }
            { 0x29      "LE_LL_CHANNEL_STATUS_IND"          "LE_LL_CHANNEL_STATUS_IND"          0 gQca_CtrlData_LeChannelStatusInd }
            { 0xB4      "QLL_LE_LL_CHANNEL_REPORTING_IND"   "QLL_LE_LL_CHANNEL_REPORTING_IND"   0 gQca_CtrlData_LeChannelReportInd }
            { 0xB5      "QLL_LE_LL_CHANNEL_STATUS_IND"      "QLL_LE_LL_CHANNEL_STATUS_IND"      0 gQca_CtrlData_LeChannelStatusInd }
            {Default    ""                                  ""                                  0 gQca_OTA_LECtrlTxOpCode   }
ENDTABLE

TABLE tQca_OTA_BIGCtrlOpcode
	{ 0x00  "BIG_CHANNEL_MAP_IND"  "BIG_CHANNEL_MAP_IND"  0  gQca_BIGCtrlData_ChannelMap }
	{ 0x01  "BIG_TERMINATE_IND"  "BIG_TERMINATE_IND"  0  gQca_BIGCtrlData_TermInd }
	{ Default   ""      ""  0  gQca_OTA_LECtrlTxOpCode}
ENDTABLE

GROUP gQca_BIGCtrlData_TermInd
{
	FIELD fQca_BIGCtrlData_Reason  (Fixed 1 Byte)    (Hex)    "Reason"
    FIELD fQca_BIGCtrlData_instant;
    FIELD fQca_BIGCtrlData_Pduinstant;
}

GROUP gQca_BIGCtrlData_ChannelMap
{
	FIELD fQca_BIGCtrlData_ChannelMap   (Fixed 5 Bytes)    (Hex)    "ChM"
    FIELD fQca_BIGCtrlData_instant      (Fixed 2 Bytes)    (Hex)    "Update Instant"
    FIELD fQca_BIGCtrlData_Pduinstant      (Fixed 2 Bytes)    (Hex)  "Tx/Rx Instant"
}

GROUP gQca_OTA_BIGCtrlRxPDU "BIG Ctrl Rx PDU Info"
{
    RESERVED                            (Fixed 3 Bytes)
    FIELD fQca_OTA_BIGPduLen            (Fixed 1 Byte)     (Decimal)                  "PDU Length"

    FIELD fQca_OTA_BIGPDU_Type          (Fixed 1 Byte)  (TABLE tQca_OTA_BIGCtrlOpcode)   "LL Control Opcode"
    BRANCH (FromTable tQca_OTA_BIGCtrlOpcode fQca_OTA_BIGPDU_Type)
}

GROUP gQca_OTA_BIGCtrlTxPDU "BIG Ctrl Tx PDU Info"
{
    RESERVED                            (Fixed 3 Bytes)
    FIELD fQca_OTA_BIGPduLen;

    FIELD fQca_OTA_BIGPDU_Type;
	BRANCH (FromTable tQca_OTA_BIGCtrlOpcode fQca_OTA_BIGPDU_Type)
}

GROUP gQca_OTA_LEPCtrlPDU "LEP Ctrl PDU Info"
{
    FIELD fQca_OTA_Handle;
    RESERVED                          (Fixed 2 Bytes)
    FIELD fQca_OTA_LEPPAck            (Fixed 1 Bit)       (Decimal)                   "TxACK Req"
    FIELD fQca_OTA_LEPPduLen          (Fixed 7 Bits)      (Decimal)                   "PDU Length"

    FIELD fQca_OTA_LEPPDU_Type        (Fixed 1 Byte)  (TABLE tQca_LC_PrototypeCtrlOpcode)   "LL Prototype Control opcode"
    BRANCH (FromTable tQca_LC_PrototypeCtrlOpcode fQca_OTA_LEPPDU_Type)
    FIELD fQca_OTA_LEPEvtCnter        (Fixed 2 Bytes) (Hex) "Event counter"
}

GROUP gQca_ChangeTraversal  if(FieldIs Equalto 1 sQca_TraversalOverride)
{
	GROUP gQca_TraverseToLMP IF (FieldIs EqualTo 0 sQca_PduType)
	{
		FIELD fQca_LMPTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf1)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
	GROUP gQca_TraverseToLLCtrl IF (FieldIs EqualTo 1 sQca_PduType)
	{
		FIELD fQca_LLCtrlTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf2)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
	GROUP gQca_TraverseToBIGCtrl IF (FieldIs EqualTo 2 sQca_PduType)
	{
        /* Not sure the protocol value, need update if it is defined in frontline. */
		//FIELD fQca_LLCtrlTraverse  (Fixed 0) RETRIEVE(StoreInteger 0xf3)   (hex)   SUPPRESS_DETAIL Store sQca_Traversal
	}
    FIELD qca_set_role (Fixed 0) RETRIEVE (StoreField fQca_OTA_LMPRole) ALSO (StoreIntraframeField Role) (Decimal) SUPPRESS_DETAIL
    FIELD qca_set_address (Fixed 0) RETRIEVE (StoreField fQca_OTA_Handle) ALSO (StoreIntraframeField Static_ConnHandle) (Decimal) SUPPRESS_DETAIL

	// We are traversing to LMP and it expects to see the values below.  Put something there to suppress errors.
    FIELD SatisfyClock 			(fixed 0) RETRIEVE(StoreInteger 0) ALSO (StoreIntraframeField clock) (hex)  SUPPRESS_DETAIL

    //LE LL
    // Since access address is not logged, we are representing access address as conn handle in LE LL tab
    FIELD SatisfyAccessAddr     (Fixed 0) RETRIEVE(StoreField fQca_OTA_Handle)         ALSO (StoreIntraframeField AccessAddr)                   (Hex)               SUPPRESS_DETAIL
    FIELD SatisfyEventCtr       (Fixed 0) RETRIEVE(StoreField fQca_OTA_LEEventCounter) ALSO (StoreIntraframeField EventCtr)                     (Hex)	            SUPPRESS_DETAIL
    FIELD SatisfyEncrInfo       (Fixed 0) RETRIEVE(StoreInteger 0)                     ALSO (StoreIntraframeField EncrInfo)                     (Hex)	            SUPPRESS_DETAIL

    // Representing the side information as Transmitter's Role, side=1 says Central and side=2 means Peripheral
    FIELD SatisfySide           (Fixed 0) RETRIEVE(StoreField fQca_OTA_LMPRole)        ALSO (AddInteger 1) ALSO (StoreIntraframeField side)     (Decimal)           SUPPRESS_DETAIL

    FIELD fQca_InitTraversalOverride2    (Fixed 0) RETRIEVE(StoreInteger 0) (HEX) SUPPRESS_DETAIL Store sQca_TraversalOverride
}




TABLE tQcaLePowerCtrl_PHY
    { 0x00 "Current" }
    { 0x01 "1M" }
    { 0x02 "2M" }
    { 0x04 "Coded S=8" }
    { 0x08 "Coded S=2" }
    { Default "Invalid" }
ENDTABLE

TABLE tQcaLePowerCtrl_Limits
    { 0x00 "Intermediate" }
    { 0x01 "Min" }
    { 0x02 "Max" }
    { 0x03 "Single Fixed" }
    { Default "Invalid" }
ENDTABLE

TABLE tQcaLePowerCtrl_Enable
    { 0x0 "Disabled" }
    { 0x1 "Enabled" }
    { Default "Invalid" }
ENDTABLE

TABLE tQca_LC_PrototypeCtrlOpcode
            { 0x23 "LE_LL_PWR_CTRL_REQ" "LE_LL_PWR_CTRL_REQ" 0 gQca_CtrlData_LePowerCtrlReq }
            { 0x24 "LE_LL_PWR_CTRL_RSP" "LE_LL_PWR_CTRL_RSP" 0 gQca_CtrlData_LePowerCtrlRsp }
            { 0x25 "LE_LL_PWR_CHANGE_IND" "LE_LL_PWR_CHANGE_IND" 0 gQca_CtrlData_LePowerChangeInd }
            { 0xF4 "LE_LL_PWR_REPORTS_REQ" "LE_LL_PWR_REPORTS_REQ" 0 gQca_CtrlData_LePowerReportsReq }
            { 0xF5 "LE_LL_PWR_REPORTS_RSP" "LE_LL_PWR_REPORTS_RSP" 0 gQca_CtrlData_LePowerReportsRsp }
            {Default "Unknown"          "Unknown"              0   }
ENDTABLE

GROUP gQca_CtrlData_LeChannelReportInd
{
        FIELD fQca_ChannelReportIndEnable            (Fixed 1 Byte)      (Decimal)      "Enable"
        FIELD fQca_ChannelReportIndintervalMin       (Fixed 1 Byte)      (Decimal)      "Min Interval (200ms unit)"
        FIELD fQca_ChannelReportIndintervalMax       (Fixed 1 Byte)      (Decimal)      "Max Interval (200ms unit)"
        FIELD fQca_leChReportIndConnEvtCnt           (Fixed 2 Byte)      (Hex)          "Le Conn Evt Counter"
}

