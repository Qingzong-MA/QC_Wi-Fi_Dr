TABLE tQca_AudioLogID APPENDS_ONLY tQca_EnhLogID
    {0x0900 "LOG_ID_A2DP_PKT_TIMER_EXPIRED"         "LOG_ID_A2DP_PKT_TIMER_EXPIRED"         0 gQca_A2DP_PktTimerExpired}
    {0x0901 "LOG_ID_A2DP_SAMPLE_BUF_OVERFLOW"       "LOG_ID_A2DP_SAMPLE_BUF_OVERFLOW"       0 gQca_A2DP_SampleBufOverflow}
    {0x0902 "LOG_ID_A2DP_MEDIA_PKT"                 "LOG_ID_A2DP_MEDIA_PKT"                 0 gQca_AUDIO_BUFFER_DATA}
    {0x0903 "LOG_ID_A2DP_L2CAP_RINGBUFFER_FULL"     "LOG_ID_A2DP_L2CAP_RINGBUFFER_FULL"     0 gQca_AUDIO_DATA_RINGBUFFER_FULL}
    {0x0905 "LOG_ID_A2DP_TWS_TIMESTAMP"             "LOG_ID_A2DP_TWS_TIMESTAMP"             0 gQca_A2DP_TWS_Timestamp}
    {0x0906 "LOG_ID_A2DP_HCI_WRITE_CFG_ERR"         "LOG_ID_A2DP_HCI_WRITE_CFG_ERR"         0 gQca_A2DP_HCI_WriteCfgErr}
    {0x0907 "LOG_ID_A2DP_LINK_QUALITY"              "LOG_ID_A2DP_LINK_QUALITY"              0 gQca_A2DP_LINK_QUALITY}
    {0x0908 "LOG_ID_A2DP_LINK_QUALITY_TXDONE"       "LOG_ID_A2DP_LINK_QUALITY_TXDONE"       0 gQca_COPFeedbackInfo}
    {0x0909 "LOG_ID_A2DP_CODEC_MISMATCH"            "LOG_ID_A2DP_CODEC_MISMATCH"            0 gQca_CodecMismatch}
    {0x090A "LOG_ID_A2DP_INVALID_HANDLE"            "LOG_ID_A2DP_INVALID_HANDLE"            0 gQca_A2DP_InvalidConn}
    {0x090B "LOG_ID_A2DP_MEDIA_BUFFER_SIZE"         "LOG_ID_A2DP_MEDIA_BUFFER_SIZE"         0 gQca_BufferSize}
    {0x090C "LOG_ID_COP_MEDIA_PKT_INFO"             "LOG_ID_COP_MEDIA_PKT_INFO"             0 gQca_COPMediaPktInfo}
    {0x090D "LOG_ID_A2DP_FEEDBACK_CHNL_CONGESTION"  "LOG_ID_A2DP_FEEDBACK_CHNL_CONGESTION"  0 gQca_A2DPFeedbackChnlCongestion}
    {0x090F "LOG_ID_A2DP_BB_BW_REPORT"              "LOG_ID_A2DP_BB_BW_REPORT"              0 gQca_A2DP_bbBwReport}
    {0x0910 "LOG_ID_A2DP_LINK_THROUGHPUT"           "LOG_ID_A2DP_LINK_THROUGHPUT"           0 gQca_A2DPThroughput}
    {0x0911 "LOG_ID_A2DP_DBG_UNDERFLOW_STATS"       "LOG_ID_A2DP_DBG_UNDERFLOW_STATS"       0 gQca_A2DP_UnderflowStats}
    {0x0912 "LOG_ID_A2DP_WATERMARK_CODEC"           "LOG_ID_A2DP_WATERMARK_CODEC"           0 gQca_A2DPWatermarkCodec}
    {0x0913 "LOG_ID_A2DP_BUFFER_DEPTH"              "LOG_ID_A2DP_BUFFER_DEPTH"              0 gQca_A2DPBufferDepth}
    {0x0914 "LOG_ID_COP_FEEDBACK_INFO"           	"LOG_ID_COP_FEEDBACK_INFO"              0 gQca_COPFeedbackInfo}

    {0x0920 "LOG_ID_A2DP_SINK_CONFIG"               "LOG_ID_A2DP_SINK_CONFIG"               0 gQca_A2dpSinkConfig}
    {0x0921 "LOG_ID_A2DP_SINK_COP_PACKET"           "LOG_ID_A2DP_SINK_COP_PACKET"           0 gQca_AUDIO_BUFFER_DATA}
    {0x0922 "LOG_ID_A2DP_SINK_PKT_INSTANT_PASSED"   "LOG_ID_A2DP_SINK_PKT_INSTANT_PASSED"   0 gQca_A2dpSinkPacketTTPInfo}

    {0x0930 "LOG_ID_SALF_A2DP_LINK_QUALITY"         "LOG_ID_SALF_A2DP_LINK_QUALITY"         0 gQca_A2DP_SALF_LQ}

    {0x0940 "LOG_ID_VOICE_BUFFER_MIC_DATA"          "LOG_ID_VOICE_BUFFER_MIC_DATA"          0 gQca_VOICE_BUFFER_MIC_DATA}
    {0x0941 "LOG_ID_VOICE_BUFFER_SPKR_DATA"         "LOG_ID_VOICE_BUFFER_SPKR_DATA"         0 gQca_VOICE_BUFFER_SPKR_DATA}
    {0x0942 "LOG_ID_VOICE_TRANSPARENT_DRIFT"        "LOG_ID_VOICE_TRANSPARENT_DRIFT"        0 gQca_VOICE_TRANSPARENT_DRIFT}
    {0x0943 "LOG_ID_VOICE_TRANSPARENT_RX_PKT_LATE"  "LOG_ID_VOICE_TRANSPARENT_RX_PKT_LATE"  0 gQca_VOICE_TRANSPARENT_RX_PKT_LATE}
    {0x0944 "LOG_ID_VOICE_TRANSPARENT_SAMPLE_RATE_INVALID"          "LOG_ID_VOICE_TRANSPARENT_SAMPLE_RATE_INVALID"  0 gQca_VOICE_TRANSPARENT_INVALID_RATE}
    {0x0945 "LOG_ID_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID" "LOG_ID_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID"  0 gQca_VOICE_TRANSPARENT_PRIMER_TIMING_OFFSET_INVALID}
    {0x0946 "LOG_ID_VOICE_TRANSPARENT_SB_NOT_ACTIVE"            "LOG_ID_VOICE_TRANSPARENT_SB_NOT_ACTIVE"  0 gQca_VOICE_TRANSPARENT_SLIMBUS_NOT_ACTIVE}
    {0x0947 "LOG_ID_VOICE_TRANSPARENT_PRIMER_RETRY"             "LOG_ID_VOICE_TRANSPARENT_PRIMER_RETRY"  0 gQca_VOICE_TRANSPARENT_PRIMER_RETRY}
    {0x0948 "LOG_ID_VOICE_TRANSPARENT_PRIMER_HISTORY"           "LOG_ID_VOICE_TRANSPARENT_PRIMER_HISTORY"  0 gQca_VOICE_TRANSPARENT_PRIMER_HISTORY}
    {0x0949 "LOG_ID_VOICE_TRANSPARENT_FROM_AIR_PATH_SWITCH"     "LOG_ID_VOICE_TRANSPARENT_FROM_AIR_PATH_SWITCH"  0 gQca_VOICE_TRANSPARENT_FROM_AIR_PATH_SWITCH}
    {0x094A "LOG_ID_VOICE_TRANSPARENT_PRIMER_SM"                "LOG_ID_VOICE_TRANSPARENT_PRIMER_SM"  0 gQca_VOICE_TRANSPARENT_PRIMER_SM}
    {0x094B "LOG_ID_VOICE_TRANSPARENT_ERR_FRAMELEN"             "LOG_ID_VOICE_TRANSPARENT_ERR_FRAMELEN"    0   gQca_VOICE_TRANSPARENT_ERR_FRAMELEN}
    {0x094C "LOG_ID_SALF_STATS"                                 "LOG_ID_SALF_STATS"                   0 gSalfDebug_stats}
    {0x094D "LOG_ID_VOICE_VS_DECODE_ERROR"                     "LOG_ID_VOICE_VS_DECODE_ERROR"       0 gQca_VOICE_VsDecodeError}
    {0x094E "LOG_ID_VOICE_VS_ERR"                              "LOG_ID_VOICE_VS_ERR"                0 gQca_VOICE_VsErr}
    {0x0952 "LOG_ID_VOICE_ISO_TRANSPORT_STATE"      "LOG_ID_VOICE_ISO_TRANSPORT_STATE"          0   gQca_VOICE_IsoTransportState} 
    {0x0953 "LOG_ID_VOICE_ISO_PRIMER"               "LOG_ID_VOICE_ISO_PRIMER"                   0   gQca_VOICE_IsoPrimer} 
    {0x0957 "LOG_ID_VOICE_ISO_FROM_AIR_NO_DATA" "LOG_ID_VOICE_ISO_FROM_AIR_NO_DATA"         0 gQca_VOICE_ISO_FROM_AIR_NO_DATA}
    {0x0958 "LOG_ID_COP_PACKET_FROM_ADSP"       "LOG_ID_COP_PACKET_FROM_ADSP" 0 gQca_AUDIO_BUFFER_DATA_COP_FROM_ADSP}
    {0x0959 "LOG_ID_COP_PACKET_TO_ADSP"         "LOG_ID_COP_PACKET_TO_ADSP" 0 gQca_AUDIO_BUFFER_DATA_COP_TO_ADSP}
    {0x0960 "LOG_ID_VOICE_ISO_LATENCY"         "LOG_ID_VOICE_ISO_LATENCY" 0 gQca_VOICE_ISO_LATENCY}
    {0x0961 "LOG_ID_COP_VER_UNMATCH"           "LOG_ID_COP_VER_UNMATCH" 0 gQca_COP_VER_UNMATCH}
    {0x0962 "LOG_ID_COP_SEQ_UNMATCH"           "LOG_ID_COP_SEQ_UNMATCH" 0 gQca_COP_SEQ_UNMATCH}

    {0x09FF "Audio End"}
ENDTABLE

TABLE tTransportState 
	{0, "TRANSPORT_STOPPED"} 
	{1, "TRANSPORT_IDLE"} 
	{2, "TRANSPORT_ALIVE"} 
	{3, "TRANSPORT_ACTIVE"} 
ENDTABLE 

GROUP gQca_VOICE_IsoTransportState "Voice Transport State" 
{ 
	FIELD fQca_VOICE_IsoTransportState_state   (Fixed 1 Byte)      (TABLE tTransportState)         "Transport State" 
} 

GROUP gQca_VOICE_IsoPrimer "Voice ISO Primer info" 
{ 
	FIELD gQca_VOICE_IsoPrimer_FrameTiming     (Fixed 4 Byte)      (Hex)                           "Frame Timing: CE Time" 
	FIELD gQca_VOICE_IsoPrimer_FrameInterval   (Fixed 2 Byte)      (Decimal)                       "Frame Interval in usec" 
	FIELD gQca_VOICE_IsoPrimer_FrameSize       (Fixed 2 Byte)      (Decimal)                       "Frame Size" 

} 

GROUP gQca_A2DP_PktTimerExpired "Stereo ACI IOP Data"
{
    FIELD fQca_IOP_btClkCapture                (Fixed 4 Bytes)     (Hex)                           "btClkCapture"
    FIELD fQca_IOP_configClkDivisor            (Fixed 2 Bytes)     (Hex)                           "configClkDivisor"
    FIELD fQca_IOP_status                      (Fixed 2 Bytes)     (Hex)                           "status"
    FIELD fQca_IOP_pDataBlock                  (Fixed 2 Bytes)     (Hex)                           "pDataBlock"
    FIELD fQca_IOP_pStart                      (Fixed 2 Bytes)     (Hex)                           "pStart"
    FIELD fQca_IOP_pEnd                        (Fixed 2 Bytes)     (Hex)                           "pEnd"
    FIELD fQca_IOP_pHead                       (Fixed 2 Bytes)     (Hex)                           "pHead"
    FIELD fQca_IOP_pTail                       (Fixed 2 Bytes)     (Hex)                           "pTail"
    FIELD fQca_IOP_dropCount                   (Fixed 2 Bytes)     (Hex)                           "drop Count"
    FIELD fQca_IOP_sampleHolder                (Fixed 2 Bytes)     (Hex)                           "sampleHolder"
    FIELD fQca_IOP_numSubframeCount            (Fixed 2 Bytes)     (Hex)                           "numSubframeCount"
    FIELD fQca_IOP_currHeader                  (Fixed 2 Bytes)     (Hex)                           "currHeader"
    FIELD fQca_IOP_currSubframeLength          (Fixed 2 Bytes)     (Hex)                           "currSubframeLength"
    FIELD fQca_IOP_ringBufferHeadSave          (Fixed 2 Bytes)     (Hex)                           "ringBufferHeadSave"
    FIELD fQca_IOP_scratchpad_1                (Fixed 2 Bytes)     (Hex)                           "scratchpad_1"
    FIELD fQca_IOP_scratchpad_2                (Fixed 2 Bytes)     (Hex)                           "scratchpad_2"
    FIELD fQca_IOP_scratchpad_3                (Fixed 2 Bytes)     (Hex)                           "scratchpad_3"
    FIELD fQca_IOP_scratchpad_4                (Fixed 2 Bytes)     (Hex)                           "scratchpad_4"
    FIELD fQca_IOP_sampleCount                 (Fixed 2 Bytes)     (Hex)                           "sampleCount"
    FIELD fQca_IOP_totalFrameLength_Bytes      (Fixed 2 Bytes)     (Hex)                           "totalFrameLength_Bytes"
    FIELD fQca_IOP_numSubframes                (Fixed 2 Bytes)     (Hex)                           "numSubframes"
    FIELD fQca_IOP_encodedFrameLength          (Fixed 2 Bytes)     (Hex)                           "encodedFrameLength"
    FIELD fQca_IOP_debugWord_1                 (Fixed 2 Bytes)     (Hex)                           "debugWord_1"
    FIELD fQca_IOP_debugWord_2                 (Fixed 2 Bytes)     (Hex)                           "debugWord_2"
    FIELD fQca_IOP_numRxSyncWords              (Fixed 2 Bytes)     (Hex)                           "numRxSyncWords"
    FIELD fQca_IOP_numRxFrames                 (Fixed 2 Bytes)     (Hex)                           "numRxFrames"
    FIELD fQca_IOP_configControlReg            (Fixed 1 Bytes)     (Hex)                           "configControlReg"
    FIELD fQca_IOP_configFrameDivisor          (Fixed 1 Bytes)     (Hex)                           "configFrameDivisor"
    FIELD fQca_IOP_configSlotWidth             (Fixed 1 Bytes)     (Hex)                           "configSlotWidth"
    FIELD fQca_IOP_configDataWidth             (Fixed 1 Bytes)     (Hex)                           "configDataWidth"
    FIELD fQca_IOP_configFlag                  (Fixed 1 Bytes)     (Hex)                           "configFlag"
    FIELD fQca_IOP_flag                        (Fixed 1 Bytes)     (Hex)                           "flag"
    FIELD fQca_IOP_currState                   (Fixed 1 Bytes)     (Hex)                           "currState"
}

GROUP gQca_A2DP_SampleBufOverflow "Overflow Count"
{
    FIELD fQca_A2DP_OverflowCount              (Fixed 2 Bytes)     (Decimal)                       "Overflow Count"
}

TABLE tWifiActivity
{0x00 "no wifi 2.4G"}
{0x01 "wifi on 2.4G"}
ENDTABLE

TABLE tGenericEncodeSubId
{0x01 "scan status" "scan status" 0 gQca_SB_Generic_SubSB_scanStatus}
{0x02 "QHS support" "QHS support" 0 gQca_SB_Generic_SubSB_QHSSupport}
{0x03 "ULL support" "ULL support" 0 gQca_SB_Generic_SubSB_ULLSupport}
{0x04 "sink battery level" "sink battery level" 0 gQca_SB_Generic_SubSB_BatteryLevel}
{0x05 "CQDDR support" "CQDDR support" 0 gQca_SB_Generic_SubSB_CQDDR}
ENDTABLE

GROUP gQca_SB_Generic_SubSB_scanStatus
{
    FIELD fQca_SB_Generic_SubSB_scanStatus_1   (Fixed 1 Byte)   (Hex)  "pageScan"
    FIELD fQca_SB_Generic_SubSB_scanStatus_2   (Fixed 1 Byte)   (Hex)  "LEScan"
}

GROUP gQca_SB_Generic_SubSB_QHSSupport
{
    FIELD fQca_SB_Generic_SubSB_QHSSupport_1   (Fixed 1 Byte)   (Hex)  "QHS support"
}

GROUP gQca_SB_Generic_SubSB_ULLSupport
{
    FIELD fQca_SB_Generic_SubSB_ULLSupport_1   (Fixed 1 Byte)   (Hex)  "ULL support"
}

GROUP gQca_SB_Generic_SubSB_BatteryLevel
{
    FIELD fQca_SB_Generic_SubSB_BatteryLevel_1   (Fixed 1 Byte)   (Decimal)  "battery level"
}

TABLE tPrefRate
{0 "2M"}
{1 "3M"}
{DEFAULT "BLE"}
ENDTABLE

GROUP gQca_SB_Generic_SubSB_CQDDR
{
    FIELD fQca_SB_Generic_SubSB_CQDDR_1   (Fixed 1 Byte)   (TABLE tPrefRate)  "preferRate"
    FIELD fQca_SB_Generic_SubSB_CQDDR_2   (Fixed 1 Byte)   (Decimal)  "preferSlots"
}

GROUP gQca_Audio_SB_encodeMode
{
    FIELD fQca_COP_encodeMode   (FromField Bytes sbLen)    (Hex)  "data"
}

GROUP gQca_Audio_SB_Rssi
{
    FIELD fQca_COP_Rssi      (Fixed 1 Byte)    RETRIEVE (SignExtension 8) (Decimal)  "RSSI"
}

GROUP gQca_Audio_SB_otherLinksNum
{
    FIELD fQca_COP_SB_otherLinksNum_num   (Fixed 1 Byte)    (Decimal)  "number of other links"
}

GROUP gQca_Audio_SB_wifiActivity
{
    FIELD fQca_COP_SB_wifiActivity   (Fixed 1 Byte)    (TABLE tWifiActivity)  "wifiActivity"
}

GROUP gQca_Audio_SB_genericEncode
{
    FIELD fQca_COP_SB_genericEncode_SubId   (Fixed 1 Byte)    (TABLE tGenericEncodeSubId)  "subSBid"
    FIELD fQca_COP_SB_genericEncode_dataLen (Fixed 0) RETRIEVE (SubtractFieldMinusInteger sbLen 1) (Decimal) SUPPRESS_DETAIL
    BRANCH (FromTable tGenericEncodeSubId fQca_COP_SB_genericEncode_SubId)
}

GROUP gQca_Audio_COPv2_SB_Quality
{
    FIELD fQca_COP_SB_Quality_MaskLen   (Fixed 0) RETRIEVE (SubtractFieldMinusInteger sbLen 3) (Decimal) SUPPRESS_DETAIL
    FIELD fQca_COP_SB_Quality_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_COP_SB_Quality_Weakbits  (Fixed 2 Bytes) RETRIEVE (AndMask 0x3FFF) ALSO (ShiftRight 0) (Decimal) "Num of Weak bits" NO_MOVE
    FIELD fQca_COP_SB_Quality_Status    (Fixed 2 Bytes) RETRIEVE (AndMask 0xC000) ALSO (ShiftRight 14) (Table EDP_STATUS) "Status"
    FIELD fQca_COP_SB_Quality_Mask      (FromField Bytes fQca_COP_SB_Quality_MaskLen) (HEX)  "Quality Mask"
}

GROUP gQca_Audio_SB_QualityFB
{
    FIELD fQca_COP_SB_QualityFB_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_COP_SB_QualityFB_quality   (Fixed 1 Byte)    (Decimal)  "quality"
    FIELD fQca_COP_SB_QualityFB_rssi      (Fixed 1 Byte)    RETRIEVE (SignExtension 8) (Decimal)  "RSSI"
}

GROUP gQca_Audio_SB_Primer
{
    FIELD fQca_Audio_SB_Primer_1     (Fixed 4 Bytes)    RETRIEVE (SignExtension 8)(Decimal)  "timeOffset"
    FIELD fQca_Audio_SB_Primer_2     (Fixed 2 Bytes)    (Decimal)  "interval"
    FIELD fQca_Audio_SB_Primer_3     (Fixed 2 Bytes)    (Decimal)  "size"
}
GROUP gQca_Audio_SB_drift
{
    FIELD fQca_Audio_SB_drift     (Fixed 1 Bytes)    RETRIEVE (SignExtension 8)(Decimal)  "drift"
}
GROUP gQca_Audio_SB_sequence
{
    FIELD fQca_Audio_SB_sequence_1     (Fixed 2 Bytes)    (Decimal)  "Sequence"
}

GROUP gQca_Audio_SB_sampleCnt
{
    FIELD fQca_Audio_SB_sampleCnt_StrId     (Fixed 1 Byte)    (Decimal)  "Stream ID"
    FIELD fQca_Audio_SB_sampleCnt_cnt       (Fixed 2 Bytes)    (Decimal)  "sampleCnt"
}

GROUP gQca_COP_SB "SideBand"
{
    FIELD fQca_COP_SB_Id        (Fixed 1 Byte)     (TABLE tSbIds)   "SideBand ID"
    GROUP gQca_COP_SBLen_len1 IF(FieldIs EqualTo 0x1 copVer)
    {
        FIELD fQca_COP_SB_Len1       (Fixed 1 Byte)     (Decimal)        "SideBand Length" STORE sbLen
    }
    GROUP gQca_COP_SBLen_len2 IF(FieldIs EqualTo 0x2 copVer)
    {
        FIELD fQca_COP_SB_Len2       (Fixed 2 Byte)     (Decimal)        "SideBand Length" STORE sbLen
    }
    BRANCH (FromTable tSbIds fQca_COP_SB_Id)

    /*FIELD fQca_COP_SB_Pld       (ToEndOfLayer) (HEX)  "SideBand Data" */
}

GROUP gQca_COPv2_SDU "SDU"
{
    FIELD fQca_COPv2_SDU_StrId  (Fixed 1 Bytes) (Decimal) "Stream ID"
    FIELD fQca_COPv2_SDU_Len    (Fixed 2 Bytes) (Decimal) "SDU Length"
    FIELD fQca_COPv2_SDU_Pld    (FromField Bytes fQca_COPv2_SDU_Len) (HEX) "SDU Data"
}

GROUP gQca_COPv2_Pkt "COP v2 Pkt"
{
    FIELD fQca_Audio_COPv2_Header_SB  (Fixed 2 Bytes) RETRIEVE (AndMask 0x4) ALSO (ShiftRight 2) (Decimal) "Sideband Present"
    FIELD fQca_Audio_COPv2_Length     (Fixed 2 Bytes) (Decimal) "Length" NO_MOVE
    FIELD fQca_Audio_COPv2_Length_odd      (Fixed 2 Bytes) RETRIEVE (AndMask 0x1) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL
    
    GROUP fQca_Audio_COPv2_SB IF(FieldIs EqualTo 0x1 fQca_Audio_COPv2_Header_SB)
    {
	    FIELD fQca_Audio_COPv2_SB_Num     (Fixed 1 Bytes) (Decimal) "SideBand Num"

        GROUP gQca_COP_SB_Loop REPEAT COUNT (FromField Times fQca_Audio_COPv2_SB_Num 0)
        {
            GROUP gQca_COP_SB;
        }
    }

    GROUP gQca_Audio_COPv2_odd IF(FieldIs EqualTo 0x1 fQca_Audio_COPv2_Length_odd)
    {
        GROUP gQca_Audio_COPv2_SDU_LoopOdd    REPEAT SIZE (ToEndOfLayer 3)
        {
            GROUP gQca_COPv2_SDU;
        }
    }

    GROUP gQca_Audio_COPv2_even IF(FieldIs EqualTo 0x0 fQca_Audio_COPv2_Length_odd)
    {
        GROUP gQca_Audio_COPv2_SDU_LoopEven    REPEAT SIZE (ToEndOfLayer 2)
        {
            GROUP gQca_COPv2_SDU;
        }
    }
}

GROUP gQca_AUDIO_BUFFER_DATA "Audio Data"
{
    FIELD fQca_Audio_Pkt_Sqn_No                 (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Audio_Pkt_Len_                   (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"
    FIELD fQca_Audio_IOP_Data                   (FromField Bytes fQca_Audio_Pkt_Len_)   (HEX)      "Audio Data"
}

GROUP gQca_AUDIO_BUFFER_DATA_COP_TO_ADSP "Audio Data (COP)"
{
    FIELD fQca_Cop_Audio_Pkt_Sqn_No_TA      (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Cop_Audio_Pkt_Len_TA         (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"
    FIELD fQca_Cop_Audio_IOP_Data_TA        (FromField Bytes fQca_Cop_Audio_Pkt_Len_TA)   (HEX)      "Audio Data"	NO_MOVE
    
    /* 4B Sync word */
    RESERVED                                (Fixed 4 Bytes)

    FIELD fQca_Audio_COP_Header_Ver_TA      (Fixed 2 Bytes) RETRIEVE (AndMask 0x3) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL NO_MOVE STORE copVer

    /* COP Ver 2b */
    GROUP fQca_Audio_COPv2_TO_ADSP IF(FieldIs EqualTo 0x2 fQca_Audio_COP_Header_Ver_TA)
    {
        GROUP gQca_COPv2_Pkt;
    }

    FIELD fQca_Cop_Audio_Pkt_Dummy_TA       (toendoflayer) (Hex)  SUPPRESS_DETAIL
}


GROUP gQca_AUDIO_BUFFER_DATA_COP_FROM_ADSP "Audio Data (COP)"
{
    FIELD fQca_Cop_Audio_Pkt_Sqn_No_FA     (Fixed 2 Bytes)                         (Decimal)                           "Sequence No"
    FIELD fQca_Cop_Audio_Pkt_Len_FA        (Fixed 2 Byte)                          (Decimal)                           "Pkt Length"
    FIELD fQca_Cop_Audio_IOP_Data_FA       (FromField Bytes fQca_Cop_Audio_Pkt_Len_FA)   (HEX)      "Audio Data"	NO_MOVE
    
    /* 6B Timestamp */
    FIELD fQca_Audio_TStamp_FA             (Fixed 6 Bytes) RETRIEVE (AndMask 0xFFFFFFFFFFFF) ALSO (ShiftRight 4) (Decimal) "Timestamp (us)"

    FIELD fQca_Audio_COP_Header_Ver_FA     (Fixed 2 Bytes) RETRIEVE (AndMask 0x3) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL NO_MOVE STORE copVer

    /* COP Ver 2b */
    GROUP fQca_Audio_COPv2_FROM_ADSP IF(FieldIs EqualTo 0x2 fQca_Audio_COP_Header_Ver_FA)
    {
        GROUP gQca_COPv2_Pkt;
    }

    FIELD fQca_Cop_Audio_Pkt_Dummy_FA      (toendoflayer) (Hex)  SUPPRESS_DETAIL
}

GROUP gQca_VOICE_ISO_LATENCY "ISO Latency"
{
    FIELD fQca_VOICE_ISO_Latency_LogId         (Fixed 1 Bytes) (TABLE LogIDTable) SUPPRESS_DETAIL

    GROUP fQca_Voice_ISO_Latency_TimeArrival IF(FieldIs EqualTo 0x00 fQca_VOICE_ISO_Latency_LogId) "Time Arrival Debug"
    {
        RESERVED                               (Fixed 1 Bytes)

        FIELD fQca_ISO_T_Arrival_Length        (Fixed 2 Bytes) (Decimal) "Length"
        FIELD fQca_ISO_T_Arrival_Expected      (Fixed 4 Bytes) (Hex) "Expected Time (ToAir ISR Start)"
        FIELD fQca_ISO_T_Arrival_COP_Tstamp    (Fixed 4 Bytes) (Hex) "COP Pkt Timestamp"

        FIELD fQca_ISO_T_Arrival_Tmp1          (Fixed 0) RETRIEVE (AddFieldToInteger fQca_ISO_T_Arrival_Length 8) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_Tmp2          (Fixed 0) RETRIEVE (MultiplyFieldByInteger fQca_ISO_T_Arrival_Tmp1 1000) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_Tmp3          (Fixed 0) RETRIEVE (DivideFieldByInteger fQca_ISO_T_Arrival_Tmp2 192) (Decimal) SUPPRESS_DETAIL
        FIELD fQca_ISO_T_Arrival_COP_Arrival   (Fixed 0) RETRIEVE (AddFieldToField fQca_ISO_T_Arrival_COP_Tstamp fQca_ISO_T_Arrival_Tmp3) ALSO (AndMask 0xFFFFFFF)  (Hex) "COP Arrival Time"

        FIELD fQca_ISO_T_Arrival_Delta         (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_ISO_T_Arrival_Expected fQca_ISO_T_Arrival_COP_Arrival) ALSO (AndMask 0xFFFFFFF)  (Decimal) "Delta (Expected_Time - COP_Arrival_Time)"
    }

    FIELD fQca_ISO_Latency_More                (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

TABLE LogIDTable
    {0, "Time Arrival"}
ENDTABLE

