GROUP gQca_CXM_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags "NewBTFlags"
{
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit7  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "CONT_MSG_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit6  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "SCHED_MSG_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit5  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_DEBUG_MODE_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit4  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "LNA_CTRL_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit3  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "UPDATE_PLD_HDR_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit2  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "UPDATE_HDR_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit1  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "UPDATE_CORR_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit0  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_MODE_EN"

    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit15 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "N/A"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit14 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "N/A"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit13 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_CLK_DIV_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit12 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "JUP_MODE_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit11 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "EGRET_MODE_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit10 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_MODE_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit9  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_CPU_INT_MSG_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit8  (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "COEX_GPM_EN"

    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit21   START_BIT   (Move 2 Bits)            (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)       "COEX_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit20 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_SYS_MSG_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit19 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_ACL_CRITICAL_POLL_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit18 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_CAL_RECOVERY_DIS"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit17 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_CAL_SEQ_ERROR_EN"
    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit16 (Fixed 1 Bit)PRINT_IF (FieldIs EqualTo 1)   (Table tQca_CXM_EnabledBit)     "MCI_INVALID_GPM_EN"

    FIELD fQca_MciGpmAgent_BT_UPDATE_FLAGS_NewBTFlags_Bit24 (Fixed 8 Bits)PRINT_IF (FieldIs EqualTo 1)  (Hex) SUPRESS_DETAIL
}

