GROUP gQca_WiPower_PruPlatSetting "WiPower PRU Platform Setting"
{
    FIELD fQca_WiP_PruDPlatSetting_na1       (Fixed 2 Bytes)     (Decimal) "N/A"
    FIELD fQca_WiP_PruDPlatSetting_vreg_min  (Fixed 2 Bytes)     (Decimal) ALSO (Constant "mV") "Vreg_min"
    FIELD fQca_WiP_PruDPlatSetting_vreg_set  (Fixed 2 Bytes)     (Decimal) ALSO (Constant "mV") "Vreg_set"
    FIELD fQca_WiP_PruDPlatSetting_vreg_high (Fixed 2 Bytes)     (Decimal) ALSO (Constant "mV") "Vreg_high"
    FIELD fQca_WiP_PruDPlatSetting_na2       (Fixed 4 Bytes)     (Decimal) "N/A"
}

GROUP gQca_WiPower_PruEmbedSetting "WiPower PRU Embeded Setting"
{
    FIELD fQca_WiP_PruDEmbedSetting_preg_min (Fixed 2 Bytes)     (Decimal) ALSO (Constant "mW") "Preg_min"
    FIELD fQca_WiP_PruDEmbedSetting_preg_max (Fixed 2 Bytes)     (Decimal) ALSO (Constant "mW") "Preg_max"
    FIELD fQca_WiP_PruDEmbedSetting_vreg_min_preg_max (Fixed 2 Bytes) (Decimal) ALSO (Constant "mV") "Vreg_min(Preg_max)"
    FIELD fQca_WiP_PruDEmbedSetting_vreg_min_preg_min (Fixed 2 Bytes) (Decimal) ALSO (Constant "mV") "Vreg_min(Preg_min)"
    FIELD fQca_WiP_PruDEmbedSetting_na1      (Fixed 2 Bytes)     (Decimal) "N/A"
    FIELD fQca_WiP_PruDEmbedSetting_zLimit   (Fixed 2 Bytes)     (Decimal) ALSO (Constant "ohm") "zLimit"

    FIELD fQca_WiP_PruDEmbedSetting_na2      (Fixed 4 Bytes)     (Decimal) "N/A"
    FIELD fQca_WiP_PruDEmbedSetting_na3      (Fixed 2 Bytes)     (Decimal) "N/A"
}

TABLE tQca_Wip_LinkState
    {0x00 "Closed"}
    {0x01 "New"}
    {0x02 "Connecting"}
    {0x03 "Connected"}
    {0x04 "Failed"}
    {Default "Invalid"}
ENDTABLE

GROUP gQca_WiPower_PruLinkState "WiPower PRU Link State"
{
    FIELD fQca_WiP_PruLinkState       (Fixed 1 Byte)  (Table tQca_Wip_LinkState) "State"
}

GROUP gQca_WiPower_PruDisableBuck "WiPower PRU Disable Buck"
{
    FIELD fQca_WiP_PruDisableBuckReason    (Fixed 1 Byte)  (Hex) "Reason"
}

GROUP gQca_WiPower_PruSetState "WiPower PRU Set State"
{
    FIELD fQca_WiP_PruSetState_old    (Fixed 1 Byte)  (Table tQca_Wip_PruState) "Old State"
    FIELD fQca_WiP_PruSetState_new    (Fixed 1 Byte)  (Table tQca_Wip_PruState) "New State"
}

TABLE tQca_Wip_PruhalDetect
    {0x00 "Kailua Reset"}
    {Default "Invalid"}
ENDTABLE


GROUP gQca_WiPower_PruHalDetect "WiPower PRUHAL Detection"
{
    FIELD fQca_WiP_PruHalDetect    (Fixed 1 Byte)  (Table tQca_Wip_PruhalDetect) "Detect"
}

TABLE tQca_Wip_PruhalApiIdx
    {0x00 "Init"}
    {0x01 "SetCurrentLimit"}
    {0x02 "SetChargeOutput"}
    {0x03 "GetCurrentLimit"}
    {0x04 "GetChargeOutput"}
    {0x05 "GetDynamicParams"}
    {0x06 "CheckChargeComplete"}
    {0x07 "SetPowerLimit"}
    {0x08 "SetPowerAdjust"}
    {0x09 "SetZLimit"}
    {Default "Invalid"}
ENDTABLE

TABLE tQca_Wip_PruhalApiRet
    {0x00 "Failure"}
    {0x01 "Success"}
    {Default "Invalid"}
ENDTABLE

GROUP gQca_WiPower_PruHalApi "WiPower PRUHAL API"
{
    FIELD fQca_WiP_PruHalApiIdx    (Fixed 1 Byte)  (Table tQca_Wip_PruhalApiIdx) "API"
    FIELD fQca_WiP_PruHalApiRet    (Fixed 1 Byte)  (Table tQca_Wip_PruhalApiRet) "Result"
