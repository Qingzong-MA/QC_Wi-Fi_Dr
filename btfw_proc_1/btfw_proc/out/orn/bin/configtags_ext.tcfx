    <TAG Number="265" Name="Soundwire Configuration">
      <DESCRIPTION>Configures sound wire IO level.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="Voice" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Soundwire" Type="STRUCTURE" Size="4">
        <ELEMENTS Name="Voltage Level" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="0 - Voltage trims for the 1.8V default setting as programmed by HW, 1 - Voltage trims for the 1.2V should be programmed by FW." />
        <ELEMENTS Name="SWR Unique ID" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="It will store the alternate non default unique ID of SWR slave enumeration address" />
