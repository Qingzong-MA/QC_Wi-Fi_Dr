    {0x04E9 "LOG_ID_CXM_INFO_PFAL_COEX_MCI_UTIL"    "LOG_ID_CXM_INFO_PFAL_COEX_MCI_UTIL"    0 gQca_CXM_Info}
    {0x04EA "LOG_ID_CXM_INFO_PFAL_LC_STATE"         "LOG_ID_CXM_INFO_PFAL_LC_STATE"         0 gQca_CXM_Info}
    {0x04EB "LOG_ID_CXM_INFO_PFAL_HCI_VENDOR"       "LOG_ID_CXM_INFO_PFAL_HCI_VENDOR"       0 gQca_CXM_Info}
    {0x04F0 "LOG_ID_CXM_INFO_MWS_SERVER"            "LOG_ID_CXM_INFO_MWS_SERVER"            0 gQca_CXM_Info}
    {0x04F1 "LOG_ID_CXM_INFO_PFAL_COEX_MWS"         "LOG_ID_CXM_INFO_PFAL_COEX_MWS"         0 gQca_CXM_Info}
    {0x04F2 "LOG_ID_CXM_INFO_PFAL_COEX_MWS_HW"      "LOG_ID_CXM_INFO_PFAL_COEX_MWS_HW"      0 gQca_CXM_Info}
    {0x04F3 "LOG_ID_CXM_INFO_QMI_IDL_ACCESSOR"      "LOG_ID_CXM_INFO_QMI_IDL_ACCESSOR"      0 gQca_CXM_Info}
    {0x04F4 "LOG_ID_CXM_INFO_QMI_IDL_LIB"           "LOG_ID_CXM_INFO_QMI_IDL_LIB"           0 gQca_CXM_Info}
    {0x04F5 "LOG_ID_CXM_INFO_WCI2_HDLC"             "LOG_ID_CXM_INFO_WCI2_HDLC"             0 gQca_CXM_Info}
