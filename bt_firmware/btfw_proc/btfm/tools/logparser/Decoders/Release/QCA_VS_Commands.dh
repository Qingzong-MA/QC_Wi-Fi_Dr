{0x2D "ERR_QOS_REJECTED"}
{0x2E "ERR_CHANNEL_CLASSIFICATION_NOT_SUPPORTED"}
{0x2F "ERR_INSUFFICIENT_SECURITY "}
{0x30 "ERR_PARAMETER_OUT_OF_MANDATORY_RANGE"}
{0x31 "ERR_RESERVED"}
