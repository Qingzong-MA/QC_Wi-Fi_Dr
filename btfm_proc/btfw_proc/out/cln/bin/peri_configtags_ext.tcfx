            <ELEMENTS Name="DBG_UART_TXD" Default="0x1A" Description="DBG_UART_TXD" />
            <ELEMENTS Name="DBG_UART_RXD" Default="0x1B" Description="DBG_UART_RXD" />
            <ELEMENTS Name="AOA_0" Default="0x1C" Description="AOA_0" />
