{0x33 "ERR_RESERVED"}
{0x34 "ERR_RESERVED_SLOT_VIOLATION"}
{0x35 "ERR_ROLE_SWITCH_FAILED"}
{0x36 "ERR_INQUIRY_RESPONSE_DATA_TOO_LARGE"}
{0x37 "ERR_SIMPLE_PAIRING_NOT_SUPPORTED_BY_HOST"}
{0x38 "ERR_HOST_BUSY_PAIRING"}
{0x3A "ERR_CONTROLLER_BUSY"}
{0x3B "ERR_LE_UNACCEPTABLE_CONNECTION_PARAMS"}
{0x3C "ERR_LE_ADVERTISING_TIMEOUT"}
