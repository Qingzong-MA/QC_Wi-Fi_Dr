GROUP gQca_dhkey_sm "Dhkey_SM"
{
    FIELD fQca_dhkeyCurrState     (Fixed 1 Byte)      (TABLE tQca_DHKEY_STATE)             "CurrState"
    FIELD fQca_dhkeyEvent         (Fixed 1 Byte)      (TABLE tQca_LLM_SeqEvents)           "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_dhkeyNewState      (Fixed 1 Byte)      (TABLE tQca_DHKEY_STATE)             "NewState"
}

GROUP gQca_mpc_state "MPC State"
{
    FIELD fQca_mpcState_mpcGroupId (Fixed 1 Bytes)      (Decimal)      "Group ID"
    FIELD fQca_mpcState_mpcCount   (Fixed 1 Bytes)      (Decimal)      "MPC Count"
    FIELD fQca_mpcState_mpcIdx     (Fixed 1 Bytes)      (Decimal)      "MPC Index"
    FIELD fQca_mpcState_mpcSlotCount    (Fixed 1 Bytes) (Decimal)      "MPC Slot Count"
    FIELD fQca_mpcState_mpcActiveMask   (Fixed 1 Bytes) (Decimal)      "MPC Active Mask"

    FIELD fQca_mpcState_mpcEventCounter (Fixed 2 Bytes) (Decimal)      "Event Counter"
    FIELD fQca_mpcState_mpcTxPLCounter  (Fixed 2 Bytes) (Decimal)      "Tx Payload Counter"

    GROUP gQca_mpcState_Slots REPEAT COUNT (FromField Times fQca_mpcState_mpcSlotCount) "Slots"
    {
	FIELD fQca_mpcState_mpcSlotNr    (Fixed 1 Bytes)    (Decimal)  "Slot Nr"
	FIELD fQca_mpcState_mpcHciHandle (Fixed 1 Bytes)    (Decimal)  "HCI Handle"
	FIELD fQca_mpcState_mpcRxPLCounter  (Fixed 2 Bytes) (Decimal)  "Rx Payload Counter"
	FIELD fQca_mpcState_mpcTIFS         (Fixed 2 Bytes) (Decimal)  "T_IFS"
    }

    RESERVED            (ToEndOfLayer)
}

GROUP gQca_cis_creation_timestamp "CIS Creation Timestamp"
{
    FIELD fQca_CIS_DBG_cisHandle (Fixed 1 Byte)    (Hex) "CIS Handle"
    FIELD fQca_CIS_DBG_aclHandle (Fixed 1 Byte)    (Hex) "ACL Handle"
    FIELD fQca_CIS_DBG_cisFlags  (Fixed 1 Byte)    (Hex) SUPPRESS_DETAIL
    FIELD fQca_CIS_DBG_Type      (Fixed 1 Byte)    (Hex) "ISO Type"

    /* BIT0 - first CIS */
    FIELD fQca_CIS_DBG_firstCIS  (Fixed 0) RETRIEVE (StoreField fQca_CIS_DBG_cisFlags) ALSO (AndMask 0x1) (Table tQca_YesOrNo) "First CIS"

    GROUP fQca_CIS_DBG_overall "Overall" 
    {
	FIELD fQca_CIS_DBG_start     (Fixed 4 Byte)    (Hex) "Request: create CIS"
	FIELD fQca_CIS_DBG_stop      (Fixed 4 Byte)    (Hex) "Request: completed"
	FIELD fQca_CIS_DBG_creation_time    (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_CIS_DBG_stop  fQca_CIS_DBG_start) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Total CIS Creation time"
    }

    /* Stage 0 (C only) */
    GROUP fQca_CIS_DBG_Stage0 IF (FieldIs EqualTo 0 fQca_CIS_DBG_Type) "Prepare CIS Creation" 
    {
	FIELD fQca_CIS_stage0_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount  (Fixed 2 Byte)   (Decimal) "LE EventCounter"
	FIELD fQca_CIS_stage0_local_llcp   (Fixed 1 Byte)    (TABLE tQca_LE_LLCPStates) "In Progress LLCP (LOCAL)"
	FIELD fQca_CIS_stage0_remote_llcp  (Fixed 1 Byte)    (TABLE tQca_LE_LLCPStates) "In Progress LLCP (REMOTE)"

        FIELD fQca_CIS_DBG_delta0        (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage0_time  fQca_CIS_DBG_start) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
    }

    FIELD fQca_CIS_DBG_Stage0_dummy (Fixed 8 Bytes) IF NOT (FieldIs EqualTo 0 fQca_CIS_DBG_Type) (Hex) SUPPRESS_DETAIL

    /* Stage 1 */
    GROUP fQca_CIS_DBG_Stage1 "LL_CIS_REQ"
    {
	FIELD fQca_CIS_stage1_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount;

	FIELD fQca_CIS_stage1_evtCountRef  (Fixed 2 Byte)    (Decimal) "Ref LE EventCounter (In PDU)"

	FIELD fQca_CIS_stage1_minOffset  (Fixed 4 Byte)    (Decimal) "Min Offset (In PDU)"
	FIELD fQca_CIS_stage1_maxOffset  (Fixed 4 Byte)    (Decimal) "Max Offset (In PDU)"

        FIELD fQca_CIS_DBG_delta1_C      (Fixed 0) IF (FieldIs EqualTo 0 fQca_CIS_DBG_Type) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage1_time fQca_CIS_stage0_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
        FIELD fQca_CIS_DBG_delta1_P      (Fixed 0) IF NOT (FieldIs EqualTo 0 fQca_CIS_DBG_Type) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage1_time fQca_CIS_DBG_start) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
    }

    /* Stage 2 */
    GROUP fQca_CIS_DBG_Stage2 "LL_CIS_RSP"
    {
	FIELD fQca_CIS_stage2_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount;

	FIELD fQca_CIS_stage1_evtCountRef;

	FIELD fQca_CIS_stage1_minOffset;
	FIELD fQca_CIS_stage1_maxOffset;

        FIELD fQca_CIS_DBG_delta2        (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage2_time fQca_CIS_stage1_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
    }

    /* Stage 3 */
    GROUP fQca_CIS_DBG_Stage3 "LL_CIS_IND"
    {
	FIELD fQca_CIS_stage3_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount;

	FIELD fQca_CIS_stage1_evtCountRef;

	FIELD fQca_CIS_stage3_offset  (Fixed 4 Byte)    (Decimal) "Final Offset (In PDU)"

        FIELD fQca_CIS_DBG_delta3        (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage3_time fQca_CIS_stage2_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
    }

    /* Stage 4 (C only) */
    GROUP fQca_CIS_DBG_Stage4 IF (FieldIs EqualTo 0 fQca_CIS_DBG_Type) "ACK of LL_CIS_IND" 
    {
	FIELD fQca_CIS_stage4_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount;
	RESERVED    (Fixed 2 Bytes)

        FIELD fQca_CIS_DBG_delta4        (Fixed 0) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage4_time fQca_CIS_stage3_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"

    }
    FIELD fQca_CIS_DBG_Stage4_dummy (Fixed 8 Bytes) IF NOT (FieldIs EqualTo 0 fQca_CIS_DBG_Type) (Hex) SUPPRESS_DETAIL

    /* Stage 5 */
    GROUP fQca_CIS_DBG_Stage5 "LLCP completed"
    {
	FIELD fQca_CIS_stage5_time      (Fixed 4 Byte)   (Hex) "Timestamp"
	FIELD fQca_CIS_stage0_evtCount;
	FIELD fQca_CIS_stage5_reason  (Fixed 1 Byte)    (Hex) "Reason"
	RESERVED    (Fixed 1 Bytes)

        FIELD fQca_CIS_DBG_delta5_C (Fixed 0) IF (FieldIs EqualTo 0 fQca_CIS_DBG_Type) RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage5_time fQca_CIS_stage4_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
        FIELD fQca_CIS_DBG_delta5_P (Fixed 0) IF NOT (FieldIs EqualTo 0
						      fQca_CIS_DBG_Type)
	RETRIEVE (SubtractFieldMinusField  fQca_CIS_stage5_time fQca_CIS_stage3_time) ALSO (AndMask 0xFFFFFFF)  (Decimal) ALSO (Constant "us") "Time since last stage"
    }

    RESERVED            (ToEndOfLayer)
} 

