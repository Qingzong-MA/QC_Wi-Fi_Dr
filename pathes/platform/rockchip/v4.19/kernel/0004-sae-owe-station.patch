 kernel/arch/ia64/configs/generic_defconfig | 1 +
 kernel/arch/x86/configs/i386_defconfig     | 1 +
 kernel/arch/x86/configs/x86_64_defconfig   | 1 +
 kernel/include/net/cfg80211.h              | 4 +++-
 4 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/kernel/arch/ia64/configs/generic_defconfig b/kernel/arch/ia64/configs/generic_defconfig
index 81f686dee5..eef4b9b045 100644
--- a/kernel/arch/ia64/configs/generic_defconfig
+++ b/kernel/arch/ia64/configs/generic_defconfig
@@ -216,5 +216,6 @@ CONFIG_DEBUG_KERNEL=y
 CONFIG_DEBUG_MUTEXES=y
 CONFIG_CRYPTO_PCBC=m
 CONFIG_CRYPTO_MD5=y
+CONFIG_CRYPTO_GCM=y
 # CONFIG_CRYPTO_ANSI_CPRNG is not set
 CONFIG_CRC_T10DIF=y
diff --git a/kernel/arch/x86/configs/i386_defconfig b/kernel/arch/x86/configs/i386_defconfig
index 9218cb1286..9c62120310 100644
--- a/kernel/arch/x86/configs/i386_defconfig
+++ b/kernel/arch/x86/configs/i386_defconfig
@@ -306,4 +306,5 @@ CONFIG_SECURITY_SELINUX=y
 CONFIG_SECURITY_SELINUX_BOOTPARAM=y
 CONFIG_SECURITY_SELINUX_DISABLE=y
 CONFIG_CRYPTO_AES_586=y
+CONFIG_CRYPTO_GCM=y
 # CONFIG_CRYPTO_ANSI_CPRNG is not set
diff --git a/kernel/arch/x86/configs/x86_64_defconfig b/kernel/arch/x86/configs/x86_64_defconfig
index 146a122933..6068d3652a 100644
--- a/kernel/arch/x86/configs/x86_64_defconfig
+++ b/kernel/arch/x86/configs/x86_64_defconfig
@@ -304,4 +304,5 @@ CONFIG_SECURITY_NETWORK=y
 CONFIG_SECURITY_SELINUX=y
 CONFIG_SECURITY_SELINUX_BOOTPARAM=y
 CONFIG_SECURITY_SELINUX_DISABLE=y
+CONFIG_CRYPTO_GCM=y
 # CONFIG_CRYPTO_ANSI_CPRNG is not set
diff --git a/kernel/include/net/cfg80211.h b/kernel/include/net/cfg80211.h
index 8d68886b9b..4e4d3913a5 100644
--- a/kernel/include/net/cfg80211.h
+++ b/kernel/include/net/cfg80211.h
@@ -77,6 +77,9 @@ struct wiphy;
  * wireless hardware capability structures
  */
 
+/* Indicate backport support for external authentication*/
+#define CFG80211_EXTERNAL_AUTH_SUPPORT 1
+
 /**
  * enum ieee80211_channel_flags - channel flags
  *
@@ -6846,7 +6849,6 @@ int cfg80211_external_auth_request(struct net_device *netdev,
 bool cfg80211_iftype_allowed(struct wiphy *wiphy, enum nl80211_iftype iftype,
 			     bool is_4addr, u8 check_swif);
 
-
 /* Logging, debugging and troubleshooting/diagnostic helpers. */
 
 /* wiphy_printk helpers, similar to dev_printk */
