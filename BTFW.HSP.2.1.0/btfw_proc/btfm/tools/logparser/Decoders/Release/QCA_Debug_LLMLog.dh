ENDTABLE

/* LLM Link Manager Debug Info */
GROUP gQca_LLM_PscanInfo "Page Scan Info"
{
    FIELD fQca_PScan_Struct_Opcode          (Fixed 4 Bytes)         (Hex)         "Page Scan Struct Opcode"
    FIELD fQca_PScan_State                  (Fixed 1 Byte)          (Hex)         "State"
}

GROUP gQca_LLM_LMStateInfo "Link Manager SM"
{
    FIELD fQca_LMCurrState      (Fixed 1 Byte)      (TABLE tQca_LLM_LinkMngrStates)         "CurrState"
    FIELD fQca_LMEvent          (Fixed 1 Byte)      (TABLE tQca_LLM_LinkMngrEvents)         "Event"
    FIELD fQca_LLMHandle        (Fixed 1 Byte)      (Decimal)                               "Handle"
    FIELD fQca_LMNewState       (Fixed 1 Byte)      (TABLE tQca_LLM_LinkMngrStates)         "NewState"
    FIELD fQca_LMExtState       (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (Hex)   SUPPRESS_DETAIL
}

/* LLM Connection Manager Debug Info */
GROUP gQca_LLM_CMStateInfo "Conn Manager SM"
{
    FIELD fQca_CMCurrState      (Fixed 1 Byte)      (TABLE tQca_LLM_ConnMngrStates)         "CurrState"
    FIELD fQca_CMEvent          (Fixed 1 Byte)      (TABLE tQca_LLM_ConnMngrEvents)         "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_CMNewState       (Fixed 1 Byte)      (TABLE tQca_LLM_ConnMngrStates)         "NewState"
    FIELD fQca_CMExtState       (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_LLM_SeqStateInfo "Seq SM"
{
    FIELD fQca_SeqCurrState     (Fixed 1 Byte)      (TABLE tQca_LLM_SeqStates)             "CurrState"
    FIELD fQca_SeqEvent         (Fixed 1 Byte)      (TABLE tQca_LLM_SeqEvents)             "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_SeqNewState      (Fixed 1 Byte)      (TABLE tQca_LLM_SeqStates)             "NewState"
    FIELD fQca_SeqExtState      (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_LLM_LELLStateInfo "LE LinkLayer SM"
{
    FIELD fQca_LLCurrState      (Fixed 1 Byte)      (TABLE tQca_LE_LLCPStates)             "CurrState"
    FIELD fQca_LLEvent          (Fixed 1 Byte)      (TABLE tQca_LLM_LE_ConnMngrEvents)     "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_LLNewState       (Fixed 1 Byte)      (TABLE tQca_LE_LLCPStates)             "NewState"
    FIELD fQca_LLExtState       (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (TABLE tQca_LE_LLCPStates)   "RemoteCurrState"
}

GROUP gQca_LLM_LECMStateInfo "LE ConnMngr SM"
{
    FIELD fQca_LECMCurrState    (Fixed 1 Byte)      (TABLE tQca_LE_ConnMngrStates)         "CurrState"
    FIELD fQca_LECMEvent        (Fixed 1 Byte)      (TABLE tQca_LLM_LE_ConnMngrEvents)     "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_LECMNewState     (Fixed 1 Byte)      (TABLE tQca_LE_ConnMngrStates)         "NewState"
    FIELD fQca_LECMExtState     (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (Hex)   SUPPRESS_DETAIL
}

GROUP gQca_LLM_LEEncrStateInfo "LE Encr SM"
{
    FIELD fQca_LEEncCurrState   (Fixed 1 Byte)      (TABLE tQca_LE_EncrSeqStates)          "CurrState"
    FIELD fQca_LEEncEvent       (Fixed 1 Byte)      (TABLE tQca_LLM_LE_ConnMngrEvents)     "Event"
    FIELD fQca_LLMHandle;
    FIELD fQca_LEEncNewState    (Fixed 1 Byte)      (TABLE tQca_LE_EncrSeqStates)          "NewState"
    FIELD fQca_LEEncExtState    (Fixed 1 Byte)  IF NOT (FieldIs EqualTo 5 fQca_sMainVer) (TABLE tQca_LE_EncrEnableStates)       "EncrEnable"
}

GROUP gQca_LLM_LEAdvFilterMatchInfo "LE Adv Filter Match"
{
    FIELD fQca_filterMatchMask  (Fixed 2 Byte)      (Hex)                       "Match Mask"
    FIELD fQca_filterEnableMask (Fixed 2 Byte)      (Hex)                       "Enable Mask"
    FIELD fQca_filterId         (Fixed 1 Byte)      (Hex)                       "Filter Id"
    FIELD fQca_flags            (Fixed 1 Byte)      (Hex)                       "Flags"
}

GROUP gQca_LLM_AFHEvalInfo "AFH Eval Info"
{
    FIELD fQca_HCIChanneltMap           (Fixed 10 Bytes)      (Hex)          "HCI Channel Map"
    FIELD fQca_WLANChannelMap           (Fixed 10 Bytes)      (Hex)          "WLAN Channel Map"
    FIELD fQca_LTEChannelMap            (Fixed 10 Bytes)      (Hex)          "LTE Channel Map"
    FIELD fQca_LocalChannelMap          (Fixed 10 Bytes)      (Hex)          "Local Channel Map"
    FIELD fQca_FinalAFHMap              (Fixed 10 Bytes)      (Hex)          "Final AFH Map"
    FIELD fQca_HCIConnHandle            (Fixed 2 Bytes)       (Hex)          "HCI Connection Handle"
    FIELD fQca_RemoteChannClass         (Fixed 10 Bytes)      (Hex)          "Remote Channel Classisficaion"
}

GROUP gQca_LLM_AllocEventNoBuff "Alloc Event Buffer Info"
{
    FIELD fQca_EventID                  (Fixed 1 Byte)        PRINT_IF (FieldIs NotEqualTo 0)        (Hex)          "HCI Event ID"
    GROUP gQca_HciEventFailure          IF(FieldIs NotEqualTo 0 fQca_EventID)
    {
        FIELD fQca_EventLen                 (Fixed 1 Byte)        (Hex)          "Event Payload length"
        RESERVED                            (Fixed 2 Bytes)
    }
    GROUP gQca_LmpFailure               IF(FieldIs EqualTo 0 fQca_EventID)
    {
        FIELD fQca_lmpOpcode               (Fixed 1 Byte)        (Hex)          "LMP opcode"
        FIELD fQca_lmpLength               (Fixed 1 Byte)        (Hex)          "LMP PDU length"
        RESERVED                            (Fixed 1 Bytes)
    }
}

GROUP gQca_LLM_AuthenRetry "Authenticate Retry Attempts"
{
    FIELD fQca_AuthRetryAttempts        (Fixed 1 Byte)        (Hex)          "Retry Attempts Count"
    FIELD fQca_AuthRetryAttemptsActive  (Fixed 1 Byte)        (Hex)          "Retry Attempts Active"
    FIELD fQca_AuthRetryAttemptsBdAddr  (Fixed 6 Byte)        (Hex)          "Retry Attempts BdAddr"
}

GROUP gQca_LLM_SetRepAttemptsNoBuff "Alloc Set Repeat Attempts Device Info"
{
    FIELD fQca_AuthRetryNoBuffBdAddr    (Fixed 6 Byte)        (Hex)          "Retry Attempts BdAddr"
}

GROUP gQca_LLM_AFHHangOverData "AFH Hang Over Data"
{
    /* Init the Counter to 1 */
    FIELD fQca_AFHCntr1 (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE AFHCntr
    GROUP gQca_Interferes1 REPEAT COUNT (Fixed 3 Times)
    {
        GROUP gQCA_InterfereType1 LABEL(LabelCount "AFH Interference Band #" AFHCntr )
        {
        FIELD fQca_AFHBadChanCnt1               (Fixed 1 Bytes)       (Decimal)      "BadChanCnt"
        FIELD fQca_AFHPeakLoChan1               (Fixed 1 Bytes)       (Decimal)      "PeakLoChan"
        FIELD fQca_AFHPeakHiChan1               (Fixed 1 Bytes)       (Decimal)      "PeakHiChan"
        FIELD fQca_AFHInBandAvgRssi1            (Fixed 1 Bytes)       RETRIEVE (SignExtension 8) (Decimal) ALSO (Constant "dbm")    "InBandAvgRssi"
        }
        /* Increment the Counter */
        FIELD fQca_AFHCntrIncr1 (Fixed 0) RETRIEVE (StoreField AFHCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE AFHCntr
    }

    /* Init the Counter to 1 */
    FIELD fQca_AFHCntr2 (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE AFHCntr
    GROUP gQca_Interferes2 REPEAT COUNT (Fixed 3 Times)
    {
        GROUP gQCA_InterfereType2 LABEL(LabelCount "AFH HangOver Band #" AFHCntr )
        {
        FIELD fQca_AFHPeakLoChan2               (Fixed 1 Bytes)       (Decimal)      "PeakLoChan"
        FIELD fQca_AFHPeakHiChan2               (Fixed 1 Bytes)       (Decimal)      "PeakHiChan"
        FIELD fQca_AFHInBandAvgRssi2            (Fixed 1 Bytes)       RETRIEVE (SignExtension 8) (Decimal)      "InBandAvgRssi"
        FIELD fQca_AFHHangOver2                 (Fixed 1 Bytes)       (Decimal)      "hangOver cycles"
        }
        /* Increment the Counter */
        FIELD fQca_AFHCntrIncr2 (Fixed 0) RETRIEVE (StoreField AFHCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE AFHCntr
    }
}

GROUP gQca_LLM_LMPowerLevelInfo "Power Level Info"
{
    FIELD fQca_ConnectionHandle         (Fixed 2 Bytes)        (Decimal)             "Connection Handle"
    FIELD fQca_AdvertisingIndex         (Fixed 1 Bytes)        (Decimal)             "LE Advt Index"
    RESERVED                            (Fixed 1 Bytes)
    FIELD fQca_TxPowerLevel             (Fixed 4 Bytes)        (Decimal)             "Tx Power Level"
    FIELD fQca_AvgRSSI                  (Fixed 4 Bytes) IF (MoreBytes)        RETRIEVE (SignExtension 8) (Decimal)            "Avg rssi"
    FIELD fQca_TxMaxPowerLevel          (ToEndOfLayer) IF (MoreBytes)        (Decimal)             "Tx Max Power Level"
}

GROUP gQca_LLM_Force_2PageInfo "InForce2PageList"
{
    FIELD fQca_MatchIndex               (Fixed 1 Byte)        (Decimal)             "MatchListIndex"
}

GROUP gQca_LLM_AFHRssiData "AFH Rssi Data"
{
    FIELD fQca_ChannelCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE ChannelCntr

    GROUP gQca_AFHRssi REPEAT COUNT (Fixed 79 Times) "Raw RSSI Data"
    {
        GROUP gQca_AFHRssiType
        {
        FIELD fQca_AFHRssiByte          (Fixed 1 Bytes)   RETRIEVE (SignExtension 8)   (DecimalWithFieldLabel ChannelCntr)      "Channel"
        }
        FIELD fQca_ChannelIncr (Fixed 0) RETRIEVE (StoreField ChannelCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE ChannelCntr
    }
    
    /* Init the Counter to 1 */
    FIELD fQca_AFHCntr (Fixed 0) RETRIEVE (StoreInteger 1) (hex) SUPPRESS_DETAIL STORE AFHCntr
    GROUP gQca_Interferes REPEAT COUNT (Fixed 3 Times)
    {
        GROUP gQCA_InterfereType LABEL(LabelCount "AFH Interference Band #" AFHCntr )
        {
        FIELD fQca_AFHBadChanCnt               (Fixed 1 Bytes)       (Decimal)      "BadChanCnt"
        FIELD fQca_AFHPeakLoChan               (Fixed 1 Bytes)       (Decimal)      "PeakLoChan"
        FIELD fQca_AFHPeakHiChan               (Fixed 1 Bytes)       (Decimal)      "PeakHiChan"
        FIELD fQca_AFHInBandAvgRssi            (Fixed 1 Bytes)      RETRIEVE (SignExtension 8) (Decimal) ALSO (Constant "dbm")      "InBandAvgRssi"
        }
        /* Increment the Counter */
        FIELD fQca_AFHCntrIncr (Fixed 0) RETRIEVE (StoreField AFHCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE AFHCntr
    }
}

GROUP gQca_LE_TX_RX_PHY "LE_TX_RX_PHY"
{
    FIELD fQca_TX_PHY               (Fixed 1 Byte)        (TABLE tQca_PHY)             "TX_PHY"
    FIELD fQca_RX_PHY               (Fixed 1 Byte)        (TABLE tQca_PHY)             "RX_PHY"
}

GROUP gQca_LLM_SCANAfhEvalInfo "SCAN Afh Eval Info"
{
    FIELD fQca_InqScanAfhMap           (Fixed 4 Bytes)      (Hex)          "Inq Scan Afh Map"
    FIELD fQca_PageScanAfhMap          (Fixed 4 Bytes)      (Hex)          "Page Scan Afh Map"
    FIELD fQca_InqScanChTbl            (Fixed 32 Bytes)     (Hex)          "Inq Scan Ch Tbl"
    FIELD fQca_PageScanChTbl           (Fixed 32 Bytes)     (Hex)          "Page Scan Ch Tbl"
    FIELD fQca_BdAddr                  (Fixed 6 Bytes)      (Hex)          "BD Addr"
}



GROUP gQca_LLM_PhySelInfo "PHY Select Info"
{
    FIELD fQca_PhySelDir                (Fixed 1 Byte)        (TABLE tQca_LE_PhySel_Direction)          "Direction"
    GROUP gQCA_LE_PhySelState_1                                                                         "Current State"
    {
        FIELD fQca_PhySelState_PHY_1             (Fixed 1 Byte)      (TABLE tQca_LE_PhySelStates)       "PHY State"
        FIELD fQca_PhySelState_LEN_1             (Fixed 1 Byte)      (TABLE tQca_LE_PhySel_LenStates)   "Packet Len State"
    }
    GROUP gQCA_LE_PhySelState_2                                                                         "New State"
    {
        FIELD fQca_PhySelState_PHY_2              (Fixed 1 Byte)      (TABLE tQca_LE_PhySelStates)      "PHY State"
        FIELD fQca_PhySelState_LEN_2              (Fixed 1 Byte)      (TABLE tQca_LE_PhySel_LenStates)  "Packet Len State"
    }
    FIELD fQca_EntryPER                 (Fixed 1 Byte)        (Decimal)                                 "Entry PER"
    FIELD fQca_EntryRSSI                (Fixed 1 Byte)         RETRIEVE (SignExtension 8)(Decimal)      "Entry RSSI"
    RESERVED                            (Fixed 1 Byte)

    FIELD fQca_DeltaPER                 (Fixed 4 Byte)        RETRIEVE (SignExtension 32) (Decimal)     "Delta PER"
    FIELD fQca_DeltaRSSI                (Fixed 1 Byte)        RETRIEVE (SignExtension 8) (Decimal)      "Delta RSSI"
    FIELD fQca_PhySelStatus             (Fixed 1 Byte)        (TABLE tQca_LE_PhySelStatus)              "Status"
    FIELD fQca_PhySelStateMachineEvt    (Fixed 1 Byte)        (TABLE tQca_LE_PhySelStateMachineEvt)     "SM Event"
    RESERVED                            (Fixed 1 Bytes)
}

GROUP gQca_LLM_PhySelStats "PHY Select Stats"
{
    FIELD fQca_PhySelBadPkts            (Fixed 4 Bytes)        (Decimal)          "Bad Packets"
    FIELD fQca_PhySelGoodPkts           (Fixed 4 Bytes)        (Decimal)          "Good Packets"
    FIELD fQca_PhySelPer                (Fixed 4 Bytes)        (Decimal)          "PER"
    FIELD fQca_PhySelRssi               (Fixed 1 Byte)        RETRIEVE (SignExtension 8) (Decimal)     "RSSI"
    FIELD fQca_PhySelPhyRate            (Fixed 1 Byte)         (TABLE tQca_LE_PhyRate)  "PHY"
}

GROUP gQca_LLM_AFH_SlotRem "Slots: "
{
    FIELD fgQca_LLM_AFH_SlotRem                 (Fixed 2 Bytes)        (Decimal)  "Slots"
}

GROUP gQca_LLM_AFHBand "AFH Rssi Data"
{
    FIELD fQca_AFHBadChanCntband               (Fixed 1 Bytes)       (Decimal)      "BadChanCnt"
    FIELD fQca_AFHPeakLoChanband               (Fixed 1 Bytes)       (Decimal)      "PeakLoChan"
    FIELD fQca_AFHPeakHiChanband               (Fixed 1 Bytes)       (Decimal)      "PeakHiChan"
    FIELD fQca_AFHInBandAvgRssiband            (Fixed 1 Bytes)      RETRIEVE (SignExtension 8) (Decimal) ALSO (Constant "dbm")      "InBandAvgRssi"
}

GROUP gQca_LLM_CigParams "CIG Parameters"
{
    FIELD fQca_CigParamsId                   (Fixed 1 Bytes)      (Decimal)                                 "CIG ID"
    FIELD fQca_CigParamsCisCount             (Fixed 1 Bytes)      (Decimal)                                 "CIS Count"
    FIELD fQca_CigParamsSca                  (Fixed 1 Bytes)      (Decimal)                                 "Sleep Clock Accuracy"
    FIELD fQca_IsoParamsPacking              (Fixed 1 Bytes)      (TABLE tQca_LE_ISO_Packing)               "Packing"
    FIELD fQca_IsoParamsFraming              (Fixed 1 Bytes)      (TABLE tQca_LE_ISO_Framing)               "Framing"
    FIELD fQca_CigParamsFtMS                 (Fixed 1 Bytes)      (Decimal)                                 "FT M2S"
    FIELD fQca_CigParamsFtSM                 (Fixed 1 Bytes)      (Decimal)                                 "FT S2M"
    RESERVED                                 (Fixed 1 Bytes)
    FIELD fQca_IsoParamsIsoInterval          (Fixed 2 Bytes)      (Scale 1.25 2) ALSO (Constant "ms")       "ISO Interval"
    RESERVED                                 (Fixed 2 Bytes)
    FIELD fQca_CigParamsSduIntervalMS        (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "SDU Interval M2S"
    FIELD fQca_CigParamsSduIntervalSM        (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "SDU Interval S2M"
    GROUP gQca_CisParams REPEAT COUNT (FromField Times fQca_CigParamsCisCount) "CIS Parameters"
    {
        FIELD fQca_IsoParamsId                   (Fixed 1 Bytes)      (Decimal)             "CIS ID"
        FIELD fQca_IsoParamsNse                  (Fixed 1 Bytes)      (Decimal)             "NSE"
        GROUP gQca_CisTxParams "TX"
        {
            FIELD fQca_IsoParamsBn                       (Fixed 1 Bytes)      (Decimal)                           "BN"
            FIELD fQca_IsoParamsPhy                      (Fixed 1 Bytes)      (TABLE tQca_LE_PhyRate)             "PHY"
            FIELD fQca_IsoParamsMaxPdu                   (Fixed 2 Bytes)      (Decimal)                           "Max PDU Size"
            FIELD fQca_IsoParamsMaxSdu                   (Fixed 2 Bytes)      (Decimal)                           "Max SDU size"
        }
        GROUP gQca_CisRxParams "RX"
        {
            FIELD fQca_IsoParamsBn;   
            FIELD fQca_IsoParamsPhy;
            FIELD fQca_IsoParamsMaxPdu;
            FIELD fQca_IsoParamsMaxSdu;
        }
    }
}

GROUP gQca_LLM_BigParams "BIG Parameters"
{
    FIELD fQca_BigRole                       (Fixed 1 Bytes)      (TABLE tQca_LE_BIG_Role)                  "Role"
    FIELD fQca_BigHandle                     (Fixed 1 Bytes)      (Hex)                                     "BIG Handle"
    FIELD fQca_BigParamsNumBis               (Fixed 1 Bytes)      (Decimal)                                 "Number of BIS"
    FIELD fQca_IsoParamsNse;

    GROUP fQca_BigM                          IF (FieldIs EqualTo 2 fQca_BigRole)
    {
    	FIELD fQca_BigAdvHandle_Str          (Fixed 1 Bytes)       (Hex)  "ADV Handle" 
        RESERVED                             (Fixed 7 Bytes)
    }

    GROUP fQca_BigS                          IF (FieldIs EqualTo 3 fQca_BigRole)
    {
    	FIELD fQca_BigAdvAddr                (Fixed 6 Bytes) IF (FieldIs EqualTo 3 fQca_BigRole) (Hex)      "ADV Address" 
    	FIELD fQca_BigAdvSid                 (Fixed 5 Bits)  IF (FieldIs EqualTo 3 fQca_BigRole) (Decimal)  "ADV SID" 
    	FIELD fQca_BigAdvAddrType            (Fixed 3 Bits)  IF (FieldIs EqualTo 3 fQca_BigRole) (Decimal)  "ADV Address Type" 
        RESERVED                             (Fixed 1 Bytes)
    }

    FIELD fQca_IsoParamsPhy;
    FIELD fQca_IsoParamsPacking;
    FIELD fQca_IsoParamsFraming;
    FIELD fQca_IsoParamsBn;  

    FIELD fQca_BigParamsIrc                  (Fixed 1 Bytes)      (Decimal)                                 "IRC"
    FIELD fQca_BigParamsPto                  (Fixed 1 Bytes)      (Decimal)                                 "PTO"
    FIELD fQca_BigParamsEnc                  (Fixed 1 Bytes)      (Decimal)                                 "Encryption"
    FIELD fQca_BigParamsPwrLvl               (Fixed 1 Bytes)      (Decimal)                                 "Tx Power Level"

    FIELD fQca_BigParamsBrctCode             (Fixed 16 Bytes)     (Hex)                                     "Broadcast Code"

    FIELD fQca_IsoParamsMaxPdu;
    FIELD fQca_IsoParamsMaxSdu;

    FIELD fQca_IsoParamsIsoInterval;
    RESERVED                                 (Fixed 2 Bytes)

    FIELD fQca_BigParamsSduInterval          (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "SDU Interval"
}

GROUP gQca_LLM_BigInfo "BIG Info"
{
    FIELD fQca_BigParamsNumBis;
    FIELD fQca_IsoParamsNse;
    FIELD fQca_IsoParamsBn;  
    FIELD fQca_BigParamsIrc;
    FIELD fQca_BigParamsPto;
    FIELD fQca_IsoParamsPhy;
    FIELD fQca_IsoParamsFraming;
    FIELD fQca_BigParamsEnc;
    FIELD fQca_BigInfoGiv                    (Fixed 8 Bytes)      (Hex)                                     "GIV"
    FIELD fQca_BigInfoGskd                   (Fixed 16 Bytes)     (Hex)                                     "GSKD"
    FIELD fQca_ChannelMap                    (Fixed 5 bytes)      (Hex)                                     "Channel Map"
    FIELD fQca_BigHandle;
    FIELD fQca_SyncHanlde                    (Fixed 2 Bytes)      (Hex)                                     "Sync Handle"
    FIELD fQca_IsoParamsMaxPdu;
    FIELD fQca_IsoParamsIsoInterval;
    FIELD fQca_IsoParamsMaxSdu;
    FIELD fQca_BigInfoBaseCrcInit            (Fixed 2 Bytes)      (Hex)                                     "Base CRC Init"
    FIELD fQca_BigInfoSaa                    (Fixed 4 Bytes)      (Hex)                                     "SAA"
    FIELD fQca_BigInfoSubInterval            (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "Sub Interval"
    FIELD fQca_BigInfoBisSpacing             (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "BIS Spacing"
    FIELD fQca_BigParamsSduInterval;
    FIELD fQca_BigInfoBigOffset              (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "BIG Offset"
    GROUP gQca_BigInfoRxClock "Rx Clock"
    {
        FIELD fQca_BigInfoRxClockN           (Fixed 4 Bytes)      (Hex)                                     "CLKN"
        FIELD fQca_BigInfoRxClockFrac        (Fixed 2 Bytes)      (Hex)                                     "FRAC"
        RESERVED                             (Fixed 2 Bytes)
    }
    RESERVED                                 (Fixed 4 Bytes)
    FIELD fQca_BigInfoPktCounter             (Fixed 8 Bytes)      (Decimal)                                 "Packet Count"
}

GROUP gQca_LLM_IsoDataStats "ISO Data Stats"
{
    FIELD fQca_IsoGroupId                   (Fixed 1 Bytes)      (Decimal)                                 "Group ID"
    FIELD fQca_IsoStreamId                  (Fixed 1 Bytes)      (Decimal)                                 "Stream ID"
    GROUP gQca_LLM_IsoDataIntfc "ISO Data Interface"
    {
        GROUP gQca_LLM_IsoDataIntfcTx "TX"
        {
            FIELD fQca_IsoDataSetup             (Fixed 2 Bytes)      (Decimal)                                 "Setup"
            FIELD fQca_IsoDataCompl             (Fixed 2 Bytes)      (Decimal)                                 "Setup Complete"
            FIELD fQca_IsoDataSetupBuf          (Fixed 2 Bytes)      (Decimal)                                 "Buffer Setup"
            FIELD fQca_IsoDataComplBuf          (Fixed 2 Bytes)      (Decimal)                                 "Buffer Setup Complete"
            FIELD fQca_IsoDataFlushBuf          (Fixed 2 Bytes)      (Decimal)                                 "Buffer Flush"
            FIELD fQca_IsoDataNoBuf             (Fixed 2 Bytes)      (Decimal)                                 "No Buffer"
        }
        GROUP gQca_LLM_IsoDataIntfcRx "RX"
        {
            FIELD fQca_IsoDataSetup;
            FIELD fQca_IsoDataCompl; 
            FIELD fQca_IsoDataSetupBuf;
            FIELD fQca_IsoDataComplBuf;
            FIELD fQca_IsoDataFlushBuf;
            FIELD fQca_IsoDataNoBuf;
            FIELD fQca_IsoDataProc                 (Fixed 2 Bytes)      (Decimal)                                 "Proc"
            FIELD fQca_IsoDataProcGood             (Fixed 2 Bytes)      (Decimal)                                 "Good"
            FIELD fQca_IsoDataProcNoReap           (Fixed 2 Bytes)      (Decimal)                                 "No Data"
            FIELD fQca_IsoDataPutPdu               (Fixed 2 Bytes)      (Decimal)                                 "Put PDU"
            FIELD fQca_IsoDataGetSdu               (Fixed 2 Bytes)      (Decimal)                                 "Get SDU"
            FIELD fQca_IsoDataGetNoSdu             (Fixed 2 Bytes)      (Decimal)                                 "Get No SDU"
            FIELD fQca_IsoDataForceFreeSdu         (Fixed 2 Bytes)      (Decimal)                                 "Force Free SDU"
            FIELD fQca_IsoDataPrepTxBuf            (Fixed 2 Bytes)      (Decimal)                                 "Pre Tx Buffer"
        }
    }

    GROUP gQca_LLM_IsoDataAdapt "ISO Data Adapt"
    {
        GROUP gQca_LLM_IsoalTx "TX"
        {
            FIELD fQca_isoalFreeSduAtStop                   (Fixed 2 Bytes)         (Decimal)                                 "Free SDU At Stop"
            FIELD fQca_isoalFreeUsed                        (Fixed 2 Bytes)         (Decimal)                                 "Free Used"
            FIELD fQca_isoalFreeNotUsed                     (Fixed 2 Bytes)         (Decimal)                                 "Free Not Used"
            FIELD fQca_isoalFreeAsLate                      (Fixed 2 Bytes)         (Decimal)                                 "Free Not Used"
            FIELD fQca_isoalEmp                             (Fixed 2 Bytes)         (Decimal)                                 "Empty"
            FIELD fQca_isoalEmpAsLate                       (Fixed 2 Bytes)         (Decimal)                                 "Empty As Late"
            FIELD fQca_isoalEmpAsNotStarted                 (Fixed 2 Bytes)         (Decimal)                                 "Empty As Not Started"
            FIELD fQca_isoalEmpAsNotAlignedBN               (Fixed 2 Bytes)         (Decimal)                                 "Empty As Not Aligned BN"
            FIELD fQca_isoalFlushed                         (Fixed 2 Bytes)         (Decimal)                                 "Flushed"
            FIELD fQca_isoalGetSdu                          (Fixed 2 Bytes)         (Decimal)                                 "Get SDU"
            FIELD fQca_isoalPutSdu                          (Fixed 2 Bytes)         (Decimal)                                 "Put SDU"
            FIELD fQca_isoalSduNoBuf                        (Fixed 2 Bytes)         (Decimal)                                 "SDU No Buffer"

            FIELD fQca_isoalIcbAlloc                        (Fixed 2 Bytes)         (Decimal)                                 "ICB Alloc"
            FIELD fQca_isoalIcbUsed                         (Fixed 2 Bytes)         (Decimal)                                 "ICB Used"
            FIELD fQca_isoalIcbNotUsed                      (Fixed 2 Bytes)         (Decimal)                                 "ICB Not Used"
            FIELD fQca_isoalFreeIcbAtStop                   (Fixed 2 Bytes)         (Decimal)                                 "ICB Freed at Stop"

            FIELD fQca_isoalTxSkipPrepare                   (Fixed 2 Bytes)         (Decimal)                                 "Skip Prepare"
            FIELD fQca_isoalTxSduNoBufAsDepth               (Fixed 2 Bytes)         (Decimal)                                 "SDU No Buf AsDepth"

            FIELD fQca_isoalToHostNoBuf                     (Fixed 2 Bytes)         (Decimal)                                 "Loop No Buffer"
            FIELD fQca_isoalToHostSkipRetx                  (Fixed 2 Bytes)         (Decimal)                                 "Loop Skip Retransmission"
            FIELD fQca_isoalToHostCnt                       (Fixed 2 Bytes)         (Decimal)                                 "Loop Count"
        }                                                   
        GROUP gQca_LLM_IsoalRx "RX"                   
        {
            FIELD fQca_isoalSduNoBuf;
            FIELD fQca_isoalGenSdu                          (Fixed 2 Bytes)         (Decimal)                                 "Generate SDU"
            FIELD fQca_isoalPdu                             (Fixed 2 Bytes)         (Decimal)                                 "PDU"
            FIELD fQca_isoalFreeSduAtStop;
            FIELD fQca_isoalSduFreeAsToUp                   (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As To Up"
            FIELD fQca_isoalErrPdu                          (Fixed 2 Bytes)         (Decimal)                                 "Error PDU"
            FIELD fQca_isoalSduFreeAsErrLLID                (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As Error LLID"
            FIELD fQca_isoalSduFreeAsTooLarge               (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As Too Large"
            FIELD fQca_isoalSduMissFirstSeg                 (Fixed 2 Bytes)         (Decimal)                                 "First Segmentation Miss"
            FIELD fQca_isoalSduMissNonFirstSeg              (Fixed 2 Bytes)         (Decimal)                                 "Non-first Segmentation Miss"
            FIELD fQca_isoalSduMissSync                     (Fixed 2 Bytes)         (Decimal)                                 "SDU Miss Sync"
            FIELD fQca_isoalSduToHost                       (Fixed 2 Bytes)         (Decimal)                                 "Route Count"
            FIELD fQca_isoalSduToHostNoBuf                  (Fixed 2 Bytes)         (Decimal)                                 "Route No Buffer"
            FIELD fQca_isoalSduCheckFail                    (Fixed 2 Bytes)         (Decimal)                                 "SDU Check Fail"
        }
        FIELD fQca_isoalErrCnt1                             (Fixed 2 Bytes)         (Decimal)                                 "Error Count 1"
        FIELD fQca_isoalErrCnt2                             (Fixed 2 Bytes)         (Decimal)                                 "Error Count 2"
    }
}

