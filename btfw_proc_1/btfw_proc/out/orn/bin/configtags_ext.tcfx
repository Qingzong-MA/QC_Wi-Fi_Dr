    <TAG Number="42" Name="Radio Gain Setting Override">
      <DESCRIPTION>This tag provides Radio Gain information including raw data values for certain dBm values.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="RM_GAIN_FACTOR_TABLE" Type="STRUCTURE" Size="60">
