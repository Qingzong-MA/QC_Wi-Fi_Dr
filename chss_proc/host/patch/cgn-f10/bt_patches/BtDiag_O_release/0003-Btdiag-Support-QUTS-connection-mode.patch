+#include <errno.h>
 
-#ifdef __cplusplus
-}
-#endif
 
 #ifdef USE_VENDOR_LIB
 #include <dlfcn.h>
@@ -225,7 +224,7 @@ int userial_vendor_ioctl(int fd, userial_vendor_ioctl_op_t op, int *p_data)
             fprintf(stderr, "## userial_vendor_ioctl: UART Flow On\n ");
             ti.c_cflag |= CRTSCTS;
 
-            if (err = tcsetattr(fd, TCSANOW, &ti) < 0) {
