    <TAG Number="90" Name="LE Supported Features">
      <DESCRIPTION>The format of the LE Supported Features is defined in the BT specification.  The LE_SUPPORTED_FEATURES_MASK is applied to the BT Supported Features such that a "0" bit forces the software to never support the given feature, while a "1" bit allows the software to support a given feature if the software is built with the required support.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="LE Supported Features Mask" Type="STRUCTURE" Size="8">
        <ELEMENTS Name="Byte 0" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Encryption" Default="0x1" Start="0" End="0" Description="Encryption Supported" />
          <ELEMENTS Name="Conn_Param_Req" Default="0x1" Start="1" End="1" Description="Connection Parameters Request Procedure" />
          <ELEMENTS Name="Ext_Rej_Ind" Default="0x1" Start="2" End="2" Description="Extended Reject Indication" />
          <ELEMENTS Name="Slave_Init_Exch" Default="0x1" Start="3" End="3" Description="Slave-initiated Features Exchange" />
          <ELEMENTS Name="Ping" Default="0x1" Start="4" End="4" Description="LE Ping" />
          <ELEMENTS Name="Data Length Extension" Default="0x1" Start="5" End="5" Description="LE Data Packet Length Extension" />
          <ELEMENTS Name="LL Privacy" Default="0x1" Start="6" End="6" Description="LE Privacy for Scanner and Advertiser." />
          <ELEMENTS Name="Extended Scanner Filter Policies" Default="0x1" Start="7" End="7" Description="Extended Scanner Filter Policies" />
        </ELEMENTS>
        <ELEMENTS Name="Byte 1" Type="BITFIELD" Size="1">
          <ELEMENTS Name="2 Mbps PHY" Default="0x1" Start="0" End="0" Description="LE 2Ms/s Physical Data Rate" />
          <ELEMENTS Name="Stable TX Modulation Index" Default="0x0" Start="1" End="1" Description="Controller has a Stable TX Modulation Index" />
          <ELEMENTS Name="Stable RX Modulation Index" Default="0x0" Start="2" End="2" Description="Controller has a Stable RX Modulation Index" />
          <ELEMENTS Name="Coded PHY" Default="0x1" Start="3" End="3" Description="LE Coded PHY (125Kbps/500Kbps) Support" />
          <ELEMENTS Name="Extended Advertising" Default="0x1" Start="4" End="4" Description="LE Advertising Extension Support" />
          <ELEMENTS Name="Periodic Advertising" Default="0x1" Start="5" End="5" Description="LE Advertising Extension Support for Periodic advertising" />
          <ELEMENTS Name="Channel Selection Algo 2" Default="0x1" Start="6" End="6" Description="Support for LE channel selection algorithm 2" />
          <ELEMENTS Name="Power Class 1" Default="0x1" Start="7" End="7" Description="Support for LE Power Class 1 feature." />
        </ELEMENTS>
        <ELEMENTS Name="Byte 2" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Minimum Channels Procedure" Default="0x1" Start="0" End="0" Description="Support for minimum number of used channels procedure." />
          <ELEMENTS Name="Conn CTE Request" Default="0x1" Start="1" End="1" Description="Connection CTE Request supported" />
          <ELEMENTS Name="Conn CTE Response" Default="0x1" Start="2" End="2" Description="Connection CTE Response supported" />
          <ELEMENTS Name="Connless CTE Tx" Default="0x1" Start="3" End="3" Description="Connectionless CTE Tx supported" />
          <ELEMENTS Name="Connless CTE Rx" Default="0x1" Start="4" End="4" Description="Connectionless CTE Rx supported" />
          <ELEMENTS Name="AntSw CTE Tx" Default="0x1" Start="5" End="5" Description="Antenna Switching During CTE Tx supported" />
          <ELEMENTS Name="AntSw CTE Rx" Default="0x1" Start="6" End="6" Description="Antenna Switching During CTE Rx supported" />
          <ELEMENTS Name="Recv CTE" Default="0x1" Start="7" End="7" Description="Receiving Constant Tone Extensions" />
        </ELEMENTS>
        <ELEMENTS Name="Byte 3" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LE PAST Sender" Default="0x1" Start="0" End="0" Description="LE PAST packet Tx support." />
          <ELEMENTS Name="LE PAST Recipient" Default="0x1" Start="1" End="1" Description="LE PAST packet Rx support." />
          <ELEMENTS Name="LE SCA Update" Default="0x1" Start="2" End="2" Description="Sleep Clock Accuracy Communication Support." />
          <ELEMENTS Name="LE Remote Public Key Validation" Default="0x1" Start="3" End="3" Description="LE Remote Public Key Validation Support." />
          <ELEMENTS Name="LE CIS Master" Default="0x1" Start="4" End="4" Description="Support LE ISO CIS Master role or not." />
          <ELEMENTS Name="LE CIS Slave" Default="0x1" Start="5" End="5" Description="Support LE ISO CIS Slave role or not." />
          <ELEMENTS Name="LE BIS Master" Default="0x1" Start="6" End="6" Description="Support LE ISO BIS Master role or not. aka. ISO Broadcast Tx." />
          <ELEMENTS Name="LE BIS Slave" Default="0x1" Start="7" End="7" Description="Support LE ISO BIS Slave role or not.  aka. ISO Broadcast Rx." />
        </ELEMENTS>
        <ELEMENTS Name="Byte 4" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LE_Supported_Features_Reserved_0" Default="0x0" Start="0" End="0" Description="This bit is reserved for LE_ISO_HOST_SUPPORT controlled by host. It can not overwrite the bit setting in controller." />
          <ELEMENTS Name="LE Power Control Request" Default="0x1" Start="1" End="1" Description="LE Power Control Request" />
          <ELEMENTS Name="LE Power Change Indication" Default="0x1" Start="2" End="2" Description="LE Power Change Indication" />
          <ELEMENTS Name="LE Path Loss Monitoring" Default="0x1" Start="3" End="3" Description="LE Path Loss Monitoring" />
          <ELEMENTS Name="LE Periodic ADI" Default="0x1" Start="4" End="4" Description="LE Periodic ADI enable" />
          <ELEMENTS Name="LE Connection Subrating" Default="0x1" Start="5" End="5" Description="LE Enhanced Connection Update feature" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_6" Default="0x0" Start="6" End="6" Description="" />
          <ELEMENTS Name="LE_Channel_Classification" Default="0x1" Start="7" End="7" Description="LE Channel Classification Feature" />
        </ELEMENTS>
        <ELEMENTS Name="Byte 5" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LE_Advertising_Coding_Selection" Default="0x1" Start="0" End="0" Description="LE Advertising Coding Selection." />
          <ELEMENTS Name="LE_Advertising_Coding_Selection_Host_Support" Default="0x0" Start="1" End="1" Description="Reserved for LE Advertising Coding Selection Host Support. Cannot overwrite bit setting in controller." />
          <ELEMENTS Name="Decision Based Advertising" Default="0x1" Start="2" End="2" Description="Decision-Based Advertising Filtering feature." />
          <ELEMENTS Name="PAwR Advertiser" Default="0x0" Start="3" End="3" Description="Advertiser role for Periodic Advertising with Responses" />
          <ELEMENTS Name="PAwR Scanner" Default="0x0" Start="4" End="4" Description="Scanner role for Periodic Advertising with Responses" />
          <ELEMENTS Name="ISOAL Unsegmented Framed Mode" Default="0x1" Start="5" End="5" Description="ISOAL Unsegmented Framed Mode" />
          <ELEMENTS Name="Channel Sounding" Default="0x1" Start="6" End="6" Description="Channel Sounding" />
          <ELEMENTS Name="Channel Sounding Host Support" Default="0x0" Start="7" End="7" Description="Channel Sounding Host Support" />
        </ELEMENTS>
        <ELEMENTS Name="Byte 6" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Channel Sounding PCT Quality Indication" Default="0x0" Start="0" End="0" Description="Channel Sounding PCT Quality Indication" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_1" Default="0x0" Start="1" End="1" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_2" Default="0x0" Start="2" End="2" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_3" Default="0x0" Start="3" End="3" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_4" Default="0x0" Start="4" End="4" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_5" Default="0x0" Start="5" End="5" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_6" Default="0x0" Start="6" End="6" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_7" Default="0x0" Start="7" End="7" Description="Reserved" />
        </ELEMENTS>
        <ELEMENTS Name="Byte 7" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LE_Supported_Features_Reserved_0" Default="0x0" Start="0" End="0" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_1" Default="0x0" Start="1" End="1" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_2" Default="0x0" Start="2" End="2" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_3" Default="0x1" Start="3" End="3" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_4" Default="0x0" Start="4" End="4" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_5" Default="0x0" Start="5" End="5" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_6" Default="0x0" Start="6" End="6" Description="Reserved" />
          <ELEMENTS Name="LE_Supported_Features_Reserved_7" Default="0x0" Start="7" End="7" Description="Reserved" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="146" Name="ANT Parameters">
      <DESCRIPTION>This tag contains the ANT parameters, including default correlator threshold value.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="ANT Parameters Values" Type="STRUCTURE" Size="20">
        <ELEMENTS Name="TxPowerConfiguration" Type="STRUCTURE" Size="6">
          <ELEMENTS Name="4_DBM_POWER_LEVEL_INDEX" Type="INTEGER" Size="1" Min="0x0" Max="0x9" Default="0x7" Signed="false" Description="Power level index for 4 dbm Tx power." />
          <ELEMENTS Name="0_DBM_POWER_LEVEL_INDEX" Type="INTEGER" Size="1" Min="0x0" Max="0x9" Default="0x6" Signed="false" Description="Power level index for 0 dbm Tx power." />
          <ELEMENTS Name="MINUS5_DBM_POWER_LEVEL_INDEX" Type="INTEGER" Size="1" Min="0x0" Max="0x9" Default="0x5" Signed="false" Description="Power level index for -5 dbm Tx power." />
          <ELEMENTS Name="MINUS10_DBM_POWER_LEVEL_INDEX" Type="INTEGER" Size="1" Min="0x0" Max="0x9" Default="0x4" Signed="false" Description="Power level index for -10 dbm Tx power." />
          <ELEMENTS Name="MINUS20_DBM_POWER_LEVEL_INDEX" Type="INTEGER" Size="1" Min="0x0" Max="0x9" Default="0x2" Signed="false" Description="Power level index for -20 dbm Tx power." />
          <ELEMENTS Name="Padding" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="GFSK_Mod_Modulus" Type="INTEGER" Size="2" Min="0xD0" Max="0x1FF" Default="0x15A" Signed="false" Description="GFSK MOD MODULUS register value for ANT.  Register field is 9 bits." />
        <ELEMENTS Name="LE_Phase_Rotation_Value" Type="INTEGER" Size="4" Min="0x0" Max="0xFFFFFFFF" Default="0x20302030" Signed="false" Description="LE phase rotation value for ANT. Writes to register RX_ACQ_PHASE_ROT_ANT." />
        <ELEMENTS Name="GFSK_Demod_Fg_Factor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x10" Signed="false" Description="" />
        <ELEMENTS Name="RSSI bias" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0x38" Signed="true" Description="RSSI bias for proximity feature." />
        <ELEMENTS Name="Coex Priority" Type="INTEGER" Size="1" Min="0x0" Max="0x7" Default="0x1" Signed="false" Description="Coex priority for ANT-WLAN coex." />
        <ELEMENTS Name="ANT Control" Type="BITFIELD" Size="1">
          <ELEMENTS Name="ANT Enable" Default="0x1" Start="0" End="0" Description="0 - ANT feature disabled.  1- ANT feature enabled." />
          <ELEMENTS Name="Use ANT Threshold Defaults" Default="0x0" Start="1" End="1" Description="0 - Use dynamic calculation based on sync word  1 - Use default values" />
          <ELEMENTS Name="ANT Debug Enable" Default="0x0" Start="2" End="2" Description="0-Disable ANT debug log print, 1-Enable ANT debug log print" />
        </ELEMENTS>
        <ELEMENTS Name="GFSK_Mod_Phase_Scale" Type="INTEGER" Size="1" Min="0x1" Max="0xFF" Default="0x9A" Signed="false" Description="GFSK MOD PHASE SCALE register value for ANT." />
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved3" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
      </ELEMENTS>
    </TAG>
    <TAG Number="157" Name="Audio Options">
      <DESCRIPTION>Controls audio options that apply to all system audio features, including BT SCO, BT A2DP, and FM.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Audio Config" Type="STRUCTURE" Size="16">
        <ELEMENTS Name="AudioFlags" Type="BITFIELD" Size="4">
          <ELEMENTS Name="Soundwire" Default="0x1" Start="0" End="0" Description="If set, all audio bus data uses a single Soundwire interface.  If clear, audio bus data uses PCM/I2S pins specific to each audio feature.  Applies to all voice and audio data that interfaces to an external audio bus, including BT Mono, BT Stereo/A2DP, and FM.  Default=1." />
          <ELEMENTS Name="Soundwire Always On" Default="0x0" Start="1" End="1" Description="1-enable. Enable Soundwire when BT on and wakeup; 0- disable. Enable Soundwire only when need use it." />
        </ELEMENTS>
        <ELEMENTS Name="Num Audio Buses" Type="INTEGER" Size="1" Min="0x0" Max="0x2" Default="0x1" Signed="false" Description="Number of Audio Buses Supported. Default=1." />
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved3" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="ISO Audio IOP Configuration" Type="STRUCTURE" Size="8">
          <ELEMENTS Name="Clock Divisor" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x3C00" Signed="false" Description="Clock divisor register.  Default = 0x3C00" />
          <ELEMENTS Name="Control Reg" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x58" Signed="false" Description="ACI control register value.  Default=0x58.  Bit0:enable.  Bit3:1:Frame sync type (100=I2S).  Bit4: slave.  Bit5: loopback.  Bit6: invert BClk.  The tag shouldn't set the enable bit; IOP will enable it during initialization." />
          <ELEMENTS Name="Frame Divisor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x1F" Signed="false" Description="Number of bit clocks per frame.  Default = 0x1F, 31d." />
          <ELEMENTS Name="Slot Width" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0xF" Signed="false" Description="Number of bits per time slot.  Default = 0xF, 15d." />
          <ELEMENTS Name="Data Width" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0xF" Signed="false" Description="Number of bits of data per sample.  Default = 0xF, 15d." />
          <ELEMENTS Name="Slot Count" Type="INTEGER" Size="1" Min="0x1" Max="0x3" Default="0x1" Signed="false" Description="Slot count enabled." />
          <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="158" Name="WakeOn Smart">
      <DESCRIPTION>Configuration for the WakeOn smart feature.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="WakeOn Smart Param" Type="STRUCTURE" Size="5">
        <ELEMENTS Name="Number of Rssi filters" Type="INTEGER" Size="1" Min="0x1" Max="0xA" Default="0xA" Signed="false" Description="Max number of items in Rssi threshold filtering list" />
        <ELEMENTS Name="Number of Rssi Average items" Type="INTEGER" Size="1" Min="0x1" Max="0xA" Default="0xA" Signed="false" Description="Max number of items in Rssi averaging list" />
        <ELEMENTS Name="Average Number of samples" Type="INTEGER" Size="1" Min="0x1" Max="0x10" Default="0x10" Signed="false" Description="Number of samples to account while calculating the RSSI average" />
        <ELEMENTS Name="Supervision Average timeout" Type="INTEGER" Size="1" Min="0x1" Max="0x5" Default="0x3" Signed="false" Description="Supervision timeout in minutes to calculate the RSSI averaging" />
        <ELEMENTS Name="Average weigh timeout" Type="INTEGER" Size="1" Min="0x1" Max="0xA" Default="0x5" Signed="false" Description="Average weigh timeout in minutes. This value will be used during calculation of the RSSI averaging." />
      </ELEMENTS>
    </TAG>
    <TAG Number="160" Name="LE Rx Golden Range">
      <DESCRIPTION>This tag describes the LE Rx golden range limits.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="" Features="" />
      <ELEMENTS Name="LE_Golden_Range" Type="STRUCTURE" Size="8">
        <ELEMENTS Name="dBm_Golden_Lower_1M" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xCE" Signed="true" Description="Golden Range lower threshold in dBm for LE1M." />
        <ELEMENTS Name="dBm_Golden_Upper_1M" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xDD" Signed="true" Description="Golden Range upper threshold in dBm for LE1M." />
        <ELEMENTS Name="dBm_Golden_Lower_2M" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xCE" Signed="true" Description="Golden Range lower threshold in dBm for LE2M." />
        <ELEMENTS Name="dBm_Golden_Upper_2M" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xDD" Signed="true" Description="Golden Range upper threshold in dBm for LE2M." />
        <ELEMENTS Name="dBm_Golden_Lower_CODED" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xCE" Signed="true" Description="Golden Range lower threshold in dBm for LE CODED PHY." />
        <ELEMENTS Name="dBm_Golden_Upper_CODED" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xDD" Signed="true" Description="Golden Range upper threshold in dBm for LE CODED PHY." />
        <ELEMENTS Name="dBm_Golden_Lower_LEHS" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xCE" Signed="true" Description="Golden Range lower threshold in dBm for LEHigh Speed." />
        <ELEMENTS Name="dBm_Golden_Upper_LEHS" Type="INTEGER" Size="1" Min="0x81" Max="0x7F" Default="0xDD" Signed="true" Description="Golden Range upper threshold in dBm for LEHigh Speed." />
      </ELEMENTS>
    </TAG>
    <TAG Number="181" Name="Coex MPTA Configuration">
      <DESCRIPTION>Configuration for the master PTA coexistence interface.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Coex MPTA Configuration" Type="STRUCTURE" Size="76">
        <ELEMENTS Name="Coex MPTA Configuration Flags" Type="BITFIELD" Size="2">
          <ELEMENTS Name="Tx_Rx" Default="0x0" Start="0" End="0" Description="If PTA_No_TxRx mode is specified, sets whether to use Tx (1) or Rx (0) for PTA requests." />
          <ELEMENTS Name="Tx_On_En" Default="0x0" Start="1" End="1" Description="Sets whether to rearbitrate for Tx/Rx change on BT_PRIORITY signal. 1 to enable, 0 to disable." />
          <ELEMENTS Name="Polarity" Default="0x0" Start="2" End="2" Description="Sets the polarity of the MPTA interface. This is also used for MPTA Grant Mode." />
          <ELEMENTS Name="PTA_No_TxRx" Default="0x0" Start="3" End="3" Description="Set when slave PTA does not indicates Tx/Rx status on BT_PRIORITY. See Tx_Rx bit when using this mode." />
          <ELEMENTS Name="Tx_Gap_En" Default="0x0" Start="4" End="4" Description="Enable the feature to insert gap in continuous Tx case." />
        </ELEMENTS>
        <ELEMENTS Name="Mode" Type="INTEGER" Size="1" Min="0x0" Max="0x3" Default="0x3" Signed="false" Description="0: 2-wire mode (Reserved). 1: MPTA Grant Mode. 2: PTA mode. 3: interface off mode (no activity on mpta_confx)." />
        <ELEMENTS Name="Low Priority Rx Weight" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x19" Signed="false" Description="Coexistence weight of low priority Rx." />
        <ELEMENTS Name="Low Priority Tx Weight" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x19" Signed="false" Description="Coexistence weight of low priority Tx." />
        <ELEMENTS Name="High Priority Rx Weight" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x6C" Signed="false" Description="Coexistence weight of high priority Rx." />
        <ELEMENTS Name="High Priority Tx Weight" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x6C" Signed="false" Description="Coexistence weight of high priority Tx." />
        <ELEMENTS Name="PRI_Extend_Threshold" Type="INTEGER" Size="1" Min="0x0" Max="0xF" Default="0x0" Signed="false" Description="Time in us to ignore the BT_PRIORITY signal after BT_ACTIVE asserts." />
        <ELEMENTS Name="BT_PRIORITY_Extend" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="Time in us to extend the BT_PRIORITY signal." />
        <ELEMENTS Name="BT_ACTIVE_Extend" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="Time in us to extend the BT_ACTIVE signal." />
        <ELEMENTS Name="PRI_Time" Type="INTEGER" Size="1" Min="0x0" Max="0x3F" Default="0x12" Signed="false" Description="Time in us that the BT_PRIORITY signal is sample to determine priority." />
        <ELEMENTS Name="First_Slot_Time" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x18" Signed="false" Description="Time in us that the first Rx/Tx slot will occur on the BT_PRIORITY signal." />
        <ELEMENTS Name="Cont Nack Time" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x4" Signed="false" Description="Wait time in us after CONT_INFO is triggered." />
        <ELEMENTS Name="Cont Rst To Info" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x20" Signed="false" Description="Time in us delay inserted between CONT_RST and CONT_INFO during the re-arbitration." />
        <ELEMENTS Name="Cont Info Delay" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x10" Signed="false" Description="Timer to trigger CONT_INFO after Tx/Rx is sampled." />
        <ELEMENTS Name="Cont Info Default Tx Channel" Type="INTEGER" Size="1" Min="0x0" Max="0x7F" Default="0x25" Signed="false" Description="Default channel to use in Tx CONT_INFO messages." />
        <ELEMENTS Name="Cont Info Default Tx Power" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x8" Signed="false" Description="Default Tx power to use in Tx CONT_INFO messages." />
        <ELEMENTS Name="Cont Info Default Rx Channel" Type="INTEGER" Size="1" Min="0x0" Max="0x7F" Default="0x25" Signed="false" Description="Default channel to use in Rx CONT_INFO messages." />
        <ELEMENTS Name="Cont Info Default Rx RSSI" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xBA" Signed="false" Description="Default RSSI to use in Rx CONT_INFO messages." />
        <ELEMENTS Name="Cont Info Tx Link ID" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFD" Signed="false" Description="Link ID to use for Tx MCI messages" />
        <ELEMENTS Name="Cont Info Rx Link ID" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFD" Signed="false" Description="Link ID to use for Rx MCI messages" />
        <ELEMENTS Name="BT_Active" Type="INTEGER" Size="1" Min="0x0" Max="0x3" Default="0x0" Signed="false" Description="0: No WB timer capturing.SCALENLSCALENL 1: Capture WB timer when active goes from 0 to 1.SCALENLSCALENL 2: Capture WB timer when active goes from 1 to 0.SCALENLSCALENL 3: Capture WB timer when active changes.  This is also used for MPTA Grant Mode." />
        <ELEMENTS Name="BT_Prio" Type="INTEGER" Size="1" Min="0x0" Max="0x3" Default="0x0" Signed="false" Description="0: No WB timer capturing.SCALENLSCALENL 1: Capture WB timer when priority goes from 0 to 1.SCALENLSCALENL 2: Capture WB timer when priority goes from 1 to 0.SCALENLSCALENL 3: Capture WB timer when priority changes." />
        <ELEMENTS Name="PP Concurrency" Type="BITFIELD" Size="1">
          <ELEMENTS Name="PP02_RXRX" Default="0x0" Start="0" End="0" Description="set if concurrency between PP0 RX and PP2 RX is allowed" />
          <ELEMENTS Name="PP02_RXTX" Default="0x0" Start="1" End="1" Description="set if concurrency between PP0 RX and PP2 TX is allowed" />
          <ELEMENTS Name="PP02_TXRX" Default="0x0" Start="2" End="2" Description="set if concurrency between PP0 TX and PP2 RX is allowed" />
          <ELEMENTS Name="PP02_TXTX" Default="0x0" Start="3" End="3" Description="set if concurrency between PP0 TX and PP2 TX is allowed" />
          <ELEMENTS Name="PP12_RXRX" Default="0x0" Start="4" End="4" Description="set if concurrency between PP1 RX and PP2 RX is allowed" />
          <ELEMENTS Name="PP12_RXTX" Default="0x0" Start="5" End="5" Description="set if concurrency between PP1 RX and PP2 TX is allowed" />
          <ELEMENTS Name="PP12_TXRX" Default="0x0" Start="6" End="6" Description="set if concurrency between PP1 TX and PP2 RX is allowed" />
          <ELEMENTS Name="PP12_TXTX" Default="0x0" Start="7" End="7" Description="set if concurrency between PP1 TX and PP2 TX is allowed" />
        </ELEMENTS>
        <ELEMENTS Name="Reserved0" Type="BITFIELD" Size="1" />
        <ELEMENTS Name="PP2 Concurrency" Type="BITFIELD" Size="1">
          <ELEMENTS Name="PP20_RXRX" Default="0x0" Start="0" End="0" Description="set if concurrency between PP2 RX and PP0 RX is allowed" />
          <ELEMENTS Name="PP20_RXTX" Default="0x0" Start="1" End="1" Description="set if concurrency between PP2 RX and PP0 TX is allowed" />
          <ELEMENTS Name="PP20_TXRX" Default="0x0" Start="2" End="2" Description="set if concurrency between PP2 TX and PP0 RX is allowed" />
          <ELEMENTS Name="PP20_TXTX" Default="0x0" Start="3" End="3" Description="set if concurrency between PP2 TX and PP0 TX is allowed" />
          <ELEMENTS Name="PP21_RXRX" Default="0x0" Start="4" End="4" Description="set if concurrency between PP2 RX and PP1 RX is allowed" />
          <ELEMENTS Name="PP21_RXTX" Default="0x0" Start="5" End="5" Description="set if concurrency between PP2 RX and PP1 TX is allowed" />
          <ELEMENTS Name="PP21_TXRX" Default="0x0" Start="6" End="6" Description="set if concurrency between PP2 TX and PP1 RX is allowed" />
          <ELEMENTS Name="PP21_TXTX" Default="0x0" Start="7" End="7" Description="set if concurrency between PP2 TX and PP1 TX is allowed" />
        </ELEMENTS>
        <ELEMENTS Name="Continuous_Tx_Interval" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="the interval for continuous ACL Tx, Unit:Millisecond" />
        <ELEMENTS Name="Continuous_Tx_Gap" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x0" Signed="false" Description="Gap for each continuous Tx interval, Unit: Millisecond. It should be less than the poll interval" />
        <ELEMENTS Name="Weight of MPTA priority level0" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x25" Signed="false" Description="User configurable weight of MPTA priority level.Higher than BT Scan lower than A2dp" />
        <ELEMENTS Name="Weight of MPTA priority level1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x5B" Signed="false" Description="User configurable weight of MPTA priority level. Higher than A2dp but lower than SCO." />
        <ELEMENTS Name="Weight of MPTA priority level2" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x67" Signed="false" Description="User configurable weight of MPTA priority level. Higher than Hid but lower than SCO." />
        <ELEMENTS Name="Weight of MPTA priority level3" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xDE" Signed="false" Description="User configurable weight of MPTA priority level. Higher than SCO but lower than Broadcast Audio" />
        <ELEMENTS Name="MPTA Grant Config" Type="STRUCTURE" Size="40">
          <ELEMENTS Name="PPx Edge Delays" Type="STRUCTURE" Size="16">
            <ELEMENTS Name="PP0 Rx Edge Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP0 Rx Falling Edge Delay value in microseconds" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Moe PP0 Rx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
            <ELEMENTS Name="PP0 Tx Edge Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP0 Tx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
            <ELEMENTS Name="PP1 Rx Edge Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP1 Rx Faliing Edge Delay value in microseconds" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP1 Rx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
            <ELEMENTS Name="PP1 Tx Edge Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP1 Tx Falling Edge Delay value in microseconds" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode PP1 Tx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
          </ELEMENTS>
          <ELEMENTS Name="WLAN Edge Delays" Type="STRUCTURE" Size="8">
            <ELEMENTS Name="WLAN Rx Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode WLAN Rx Falling Edge Delay value in microseconds" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode WLAN Rx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
            <ELEMENTS Name="WLAN Tx Delay" Type="STRUCTURE" Size="4">
              <ELEMENTS Name="Falling Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode WLAN Tx Falling Edge Delay value in microseconds" />
              <ELEMENTS Name="Rising Edge Delay" Type="INTEGER" Size="2" Min="0x0" Max="0x1FF" Default="0x0" Signed="false" Description="mPTA Grant Mode WLAN Tx Rising Edge Delay value in microseconds" />
            </ELEMENTS>
          </ELEMENTS>
          <ELEMENTS Name="BT WLAN Filter" Type="BITFIELD" Size="1">
            <ELEMENTS Name="Ignore PP0 Rx" Default="0x0" Start="0" End="0" Description="Ignore PP0 Rx activity" />
            <ELEMENTS Name="Ignore PP0 Tx" Default="0x0" Start="1" End="1" Description="Ignore PP0 Tx activity" />
            <ELEMENTS Name="Ignore PP1 Rx" Default="0x0" Start="2" End="2" Description="Ignore PP1 Rx activity" />
            <ELEMENTS Name="Ignore PP1 Tx" Default="0x0" Start="3" End="3" Description="Ignore PP1 Tx activity" />
            <ELEMENTS Name="WLAN Tx source" Default="0x0" Start="4" End="4" Description="Source of the WLAN Tx activity. 1'b0: WLAN DTOP; 1'b1: Cont_Info from MCI interface" />
          </ELEMENTS>
          <ELEMENTS Name="Priority Value" Type="STRUCTURE" Size="4">
            <ELEMENTS Name="Priority Offset High" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x80" Signed="false" Description="Priority offset for mpta_status = 1 (high priority)" />
            <ELEMENTS Name="Priority Offset Low" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x80" Signed="false" Description="Priority offset for mpta_status = 1 (low priority)" />
            <ELEMENTS Name="Base Priority High" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x37" Signed="false" Description="Base priority value for mpta_status = 1 (high priority)" />
            <ELEMENTS Name="Base Priority Low" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x19" Signed="false" Description="Base priority value for mpta_status = 0 (low priority)" />
          </ELEMENTS>
          <ELEMENTS Name="CONT_INFO TxRx value" Type="BITFIELD" Size="1">
            <ELEMENTS Name="Base Low TxRx" Default="0x0" Start="0" End="0" Description="Tx/Rx value for CONT_INFO with base priority when mpta_status is 0. 1:Tx, 0:Rx." />
            <ELEMENTS Name="Base Offset Low TxRx" Default="0x0" Start="1" End="1" Description="Tx/Rx value for CONT_INFO with base + offset priority when mpta_status is 0. 1:Tx, 0:Rx." />
            <ELEMENTS Name="Base High TxRx" Default="0x0" Start="2" End="2" Description="Tx/Rx value for CONT_INFO with base priority when mpta_status is 1. 1:Tx, 0:Rx." />
            <ELEMENTS Name="Base Offset High TxRx" Default="0x0" Start="3" End="3" Description="Tx/Rx value for CONT_INFO with base + offset priority when mpta_status is 1. 1:Tx, 0:Rx." />
          </ELEMENTS>
          <ELEMENTS Name="CONT_INFO contents" Type="STRUCTURE" Size="4">
            <ELEMENTS Name="Link" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFC" Signed="false" Description="Link ID" />
            <ELEMENTS Name="RSSI" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xBA" Signed="false" Description="Rx RSSI Value" />
            <ELEMENTS Name="TxPower" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x8" Signed="false" Description="Tx Power Value" />
            <ELEMENTS Name="Channel" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x25" Signed="false" Description="Frequency Offset" />
          </ELEMENTS>
          <ELEMENTS Name="Timeout" Type="STRUCTURE" Size="4">
            <ELEMENTS Name="Max Req Time" Type="INTEGER" Size="2" Min="0x1" Max="0x280" Default="0x271" Signed="false" Description="Timeout value to ignore PTA request after it's been granted. 32us resolution. Valid values are between 1 and 640" />
            <ELEMENTS Name="No Nack Detection Time" Type="INTEGER" Size="2" Min="0x1" Max="0x1FF" Default="0x160" Signed="false" Description="CONT_NACK wait time after CONT_INFO is triggered. 16MHz clock period resolution. Valid values are between 1 and 511" />
          </ELEMENTS>
          <ELEMENTS Name="WLAN CONT RST TIMEOUT" Type="INTEGER" Size="2" Min="0x1" Max="0x280" Default="0x271" Signed="false" Description="Timeout value for not receiving a Cont_Rst message after a Cont_Info message from WLAN. 32us resolution. Valid values are between 1 and 640" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="182" Name="Coex SPTA Configuration">
      <DESCRIPTION>Configuration for the slave PTA coexistence interface.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Coex SPTA Configuration" Type="STRUCTURE" Size="4">
        <ELEMENTS Name="Coex SPTA Configuration Flags" Type="BITFIELD" Size="2">
          <ELEMENTS Name="Enable" Default="0x0" Start="0" End="0" Description="SPTA enable, 1 for enabled, 0 for disabled." />
          <ELEMENTS Name="Abort Enable for PP0 TX" Default="0x1" Start="1" End="1" Description="Abort Enable for PP0 TX." />
          <ELEMENTS Name="Abort Enable for PP1 TX" Default="0x1" Start="2" End="2" Description="Abort Enable for PP1 TX." />
          <ELEMENTS Name="Abort Enable for PP2 TX" Default="0x1" Start="3" End="3" Description="Abort Enable for PP2 TX." />
          <ELEMENTS Name="Abort Enable for PP0 RX" Default="0x1" Start="4" End="4" Description="Abort Enable for PP0 RX." />
          <ELEMENTS Name="Abort Enable for PP1 RX" Default="0x1" Start="5" End="5" Description="Abort Enable for PP1 RX." />
          <ELEMENTS Name="Abort Enable for PP2 RX" Default="0x1" Start="6" End="6" Description="Abort Enable for PP2 RX." />
        </ELEMENTS>
        <ELEMENTS Name="Priority Window Timer" Type="INTEGER" Size="1" Min="0x0" Max="0x3F" Default="0x9" Signed="false" Description="Timer to indicate priority on slave PTA interface before switching to Tx/Rx indication." />
        <ELEMENTS Name="Priority Threshold" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x7F" Signed="false" Description="8-bit priority threshold to determine high/low priority on slave PTA interface. PP request is considered high priority if its priority value is above this threshold; otherwise, it would be low priority." />
      </ELEMENTS>
    </TAG>
    <TAG Number="211" Name="TX Top Gain LUT">
      <DESCRIPTION>TX master gain LUT</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="RM" PlatformSpecific="false" Platforms="" Features="" />
      <ELEMENTS Name="TX TOP GAIN LUT" Type="STRUCTURE" Size="144">
        <ELEMENTS Name="TX GAIN LUT CH0" Type="FIXED_ARRAY" ElementSize="4" Size="64" Min="0x0" Max="0xFFFFFFFF" Signed="false" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0" VariableName="PL">
          <ELEMENTS Name="PL0" Default="0x1400B" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_0" />
          <ELEMENTS Name="PL1" Default="0x1E00B" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_1" />
          <ELEMENTS Name="PL2" Default="0x7000F" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_2" />
          <ELEMENTS Name="PL3" Default="0xB0013" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_3" />
          <ELEMENTS Name="PL4" Default="0xF4017" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_4" />
          <ELEMENTS Name="PL5" Default="0x13401B" Description="Writes to BT_HTOP_TOP_TX_GAIN_LUT_CH0_5" />
