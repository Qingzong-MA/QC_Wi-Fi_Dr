{
    FIELD fBCS_STEP_INDEX_POS_PATCH        (Fixed 1 Bytes) (Decimal)    "BCS_STEP_INDEX_POS_PATCH  "
    FIELD fBCS_EVENT_INDEX_POS_PATCH       (Fixed 1 Bytes) (Decimal)    "BCS_EVENT_INDEX_POS_PATCH "
    FIELD fBCS_PROC_INDEX_POS_PATCH        (Fixed 2 Bytes) (Decimal)    "BCS_PROC_INDEX_POS_PATCH  "
    FIELD fBCS_STEP_MODE_POS_PATCH         (Fixed 1 Bytes) (Decimal)    "BCS_STEP_MODE_POS_PATCH   "
    FIELD fBCS_CS_SYNC_PHY_POS_PATCH       (Fixed 1 Bytes) (Decimal)    "BCS_CS_SYNC_PHY_POS_PATCH "
    FIELD fBCS_RTT_TYPE_POS_PATCH          (Fixed 1 Bytes) (Decimal)    "BCS_RTT_TYPE_POS_PATCH  "
    RESERVED (Fixed 5 Bytes)
    FIELD fBcs_freqOffsetMHz (Fixed 1 Bytes) (Decimal) "freqOffsetMHz"
    FIELD fBcs_freqOffsetKHz (Fixed 2 Bytes) (Decimal) "freqOffsetKHz"
    FIELD fBcs_agcIndex (Fixed 1 Bytes) (Decimal) "agcIndex"
    FIELD fBcs_dvgaIndex (Fixed 1 Bytes) (Decimal) "dvgaIndex"
    FIELD fBcs_rssidBm (Fixed 1 Bytes) (Decimal) "rssidBm"
    FIELD fBcs_aci (Fixed 1 Bytes) (Decimal) "aci"
    FIELD fBCS_DATA_START_RX_SOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "RX_SOF_TIME_USEC "
    FIELD fBCS_DATA_START_RX_SOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "RX_SOF_TIME_FRAC "
    FIELD fBCS_DATA_START_RX_TOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "RX_TOF_TIME_USEC "
    FIELD fBCS_DATA_START_RX_TOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "RX_TOF_TIME_FRAC "
    FIELD fBCS_DATA_START_RX_AOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "RX_AOF_TIME_USEC "
    FIELD fBCS_DATA_START_RX_AOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "RX_AOF_TIME_FRAC "
    FIELD fBCS_DATA_START_RX_EOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "RX_EOF_TIME_USEC "
    FIELD fBCS_DATA_START_RX_EOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "RX_EOF_TIME_FRAC "
    FIELD fBCS_DATA_START_TX_SOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "TX_SOF_TIME_USEC "
    FIELD fBCS_DATA_START_TX_SOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "TX_SOF_TIME_FRAC "
    FIELD fBCS_DATA_START_TX_TOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "TX_TOF_TIME_USEC "
    FIELD fBCS_DATA_START_TX_TOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "TX_TOF_TIME_FRAC "
    FIELD fBCS_DATA_START_TX_EOF_TIME_USEC  (Fixed 4 Bytes)   (Decimal) "TX_EOF_TIME_USEC "
    FIELD fBCS_DATA_START_TX_EOF_TIME_FRAC  (Fixed 1 Bytes)   (Decimal) "TX_EOF_TIME_FRAC "
    FIELD fBCS_DATA_START_RX_ACQ_MF_EARLY   (Fixed 4 Bytes)   (Decimal) "RX_ACQ_MF_EARLY  "
    FIELD fBCS_DATA_START_RX_ACQ_MF_ONTIME  (Fixed 4 Bytes)   (Decimal) "RX_ACQ_MF_ONTIME "
    FIELD fBCS_DATA_START_RX_ACQ_MF_LATE    (Fixed 4 Bytes)   (Decimal) "RX_ACQ_MF_LATE   "
    FIELD fBCS_DATA_START_STEP_CH           (Fixed 2 Bytes)   (Decimal) "Step Channel   "
    FIELD fBCS_DATA_START_STEP_SINR         (Fixed 4 Bytes)   (Decimal) "Step SINR   "
    RESERVED (Fixed 1 Bytes)

    FIELD fBCS_DATA_START_STEP_DCIQ_LEN     (Fixed 1 Bytes)   (Decimal) "Step DCIQ LEN   "
    GROUP gBCS_Data_Step_DCIQ_Samples       IF (FieldIs NotEqualTo 0 fBCS_DATA_START_STEP_DCIQ_LEN) "DCIQ Samples"
    {
        FIELD fBCS_DATA_START_STEP_DCIQ_DATA  (FromField Bytes fBCS_DATA_START_STEP_DCIQ_LEN) (StringOfHex)       "HexDump"
    }

    FIELD fBCS_DATA_START_STEP_TONEIQ_LEN     (Fixed 2 Bytes)   (Decimal) "Step TONEIQ LEN   "
    GROUP gBCS_Data_Step_ToneIQ_Samples       IF (FieldIs NotEqualTo 0 fBCS_DATA_START_STEP_TONEIQ_LEN) "TONE IQ Samples"
    {
        FIELD fBCS_DATA_START_STEP_TONEIQ_DATA  (FromField Bytes fBCS_DATA_START_STEP_TONEIQ_LEN) (StringOfHex)       "HexDump"
    }

    FIELD fBCS_DATA_START_STEP_SPIQ_LEN     (Fixed 2 Bytes)   (Decimal) "Step SPIQ LEN   "
    GROUP gBCS_Data_Step_SpIQ_Samples       IF (FieldIs NotEqualTo 0 fBCS_DATA_START_STEP_SPIQ_LEN) "SP IQ Samples"
    {
        FIELD fBCS_DATA_START_STEP_SPIQ_DATA  (FromField Bytes fBCS_DATA_START_STEP_SPIQ_LEN) (StringOfHex)       "HexDump"
    }

    FIELD fBCS_DATA_START_STEP_REGDATA_LEN     (Fixed 2 Bytes)   (Decimal) "Step REGDATA LEN   "
    FIELD fQca_RegCntr  (Fixed 0)   RETRIEVE (StoreInteger 0)   (Hex)   SUPPRESS_DETAIL STORE RegCntr
    GROUP gBCS_Data_Step_REGDATA_values       IF (FieldIs NotEqualTo 0 fBCS_DATA_START_STEP_REGDATA_LEN) REPEAT SIZE (FromField Bytes fBCS_DATA_START_STEP_REGDATA_LEN) "RegValues"
    {
        GROUP gQca_RegInfo LABEL(LabelCount "Reg #" RegCntr)
        {
            // FIELD fBCS_DATA_START_STEP_REGDATA_DATA  (FromField Bytes fBCS_DATA_START_STEP_REGDATA_LEN) (StringOfHex)       "HexDump"
            FIELD fBCS_DATA_START_STEP_REGDATA_DATA (Fixed 4 Bytes)   (Hex) "Reg Value   "
        }

        FIELD fQca_RegCntrIncr (Fixed 0) RETRIEVE (StoreField RegCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE RegCntr
    }

    FIELD fBCS_DATA_START_STEP_MODE1_DATA_LEN     (Fixed 2 Bytes)   (Decimal) "Step MODE1 DATA LEN   "
    GROUP gBCS_Data_Step_MODE1_DATA_values       IF (FieldIs NotEqualTo 0 fBCS_DATA_START_STEP_MODE1_DATA_LEN) "MODE1 DATA"
    {
        //FIELD fBCS_DATA_START_STEP_MODE1DATA_DATA  (FromField Bytes fBCS_DATA_START_STEP_MODE1_DATA_LEN) (StringOfHex)       "HexDump"
        FIELD fBCS_DATA_START_STEP_MODE1DATA_fractionalTime (Fixed 4 Bytes)   (Hex)     "RTT : fractionalTime   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_binHalf (Fixed 6 Bytes)   (Hex)     "RTT : binHalf[3]   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_binfull     (Fixed 6 Bytes)   (Hex)     "RTT : binFull[3]   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_binCount    (Fixed 6 Bytes)   (Hex)     "RTT : binCount[3]   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_initialDecimationPhase  (Fixed 1 Bytes)   (Hex)     "RTT : initialDecimationPhase   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_globalStepIndex  (Fixed 1 Bytes)   (Hex)     "RTT : globalStepIndex   "
        //RESERVED (FIXED 2 BYTES)

        FIELD fBCS_DATA_START_STEP_MODE1DATA_normalization (Fixed 4 Bytes)   (Hex)     "RTT NADM: normalization   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_phaseDiff (Fixed 4 Bytes)   (Hex)     "RTT NADM: phaseDiff   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_regBinCount0Value (Fixed 4 Bytes)   (Hex)     "RTT NADM: regBinCount0Value   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_regBinCount1Value (Fixed 4 Bytes)   (Hex)     "RTT NADM: regBinCount1Value   "

        FIELD fBCS_DATA_START_STEP_MODE1DATA_regBin_mBq (Fixed 128 Bytes)   (Hex)     "RTT NADM: mBQ"
        FIELD fBCS_DATA_START_STEP_MODE1DATA_regBin_rBq (Fixed 128 Bytes)   (Hex)     "RTT NADM: rBQ"

        FIELD fBCS_DATA_START_STEP_MODE1DATA_phaseStraight (Fixed 4 Bytes)   RETRIEVE (SignExtension 32)      (Decimal)     "RTT NADM: phaseStraight   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_phaseCurve (Fixed 4 Bytes)    RETRIEVE (SignExtension 32)     (Decimal)     "RTT NADM: phaseCurve   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_phaseStraight_1 (Fixed 4 Bytes)   RETRIEVE (SignExtension 32)      (Decimal)     "RTT NADM: phaseStraight 1  "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_phaseStraight_2 (Fixed 4 Bytes)   RETRIEVE (SignExtension 32)      (Decimal)     "RTT NADM: phaseStraight 2  "

        FIELD fBCS_DATA_START_STEP_MODE1DATA_cntStraight (Fixed 2 Bytes)   (Hex)     "RTT NADM: cntStraight   "

        FIELD fBCS_DATA_START_STEP_MODE1DATA_cntCurve (Fixed 2 Bytes)   (Hex)     "RTT NADM: cntCurve   "

        FIELD fBCS_DATA_START_STEP_MODE1DATA_b4DemodCorrNADM (Fixed 1 Bytes)   (Hex)     "RTT NADM: b4DemodCorrNADM   "
        FIELD fBCS_DATA_START_STEP_MODE1DATA_finalNADM (Fixed 1 Bytes)   (Hex)     "RTT NADM: finalNADM   "
    }
	
    FIELD fBCS_DATA_START_STEP_REGDATA_LEN;
    FIELD fQca_RegCntr;
    GROUP gBCS_Data_Step_REGDATA_values;
		
}

