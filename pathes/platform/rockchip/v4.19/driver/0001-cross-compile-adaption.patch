-		(LINUX_VERSION_CODE < KERNEL_VERSION(4, 20, 0)))
+#if 0 //Add by Qingzong, 20221108
 static inline int pld_pcie_get_reg_dump(struct device *dev, uint8_t *buf,
 					uint32_t len)
 {
