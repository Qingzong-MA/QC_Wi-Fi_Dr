    <TAG Number="83" Name="LE Tx Power Configuration">
      <DESCRIPTION>These parameters control LE TX output power configuration.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="LE Power Configuration" Type="STRUCTURE" Size="15">
        <ELEMENTS Name="Advertising Power Level Index" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="Advertising power level index (Default=0x8, 8d). Host can control range by limiting Tx Output Power. This Tx Power is used for Advertising and Scan Response. Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="Scan Request Power Level Index" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="Scan Request Tx Power Level Index (Default=0x8, 8d). Host can control range by limiting Tx Output Power. This Power also used for CONNECT_IND, AUX_CONNECT_REQ and AUX_CONNECT_RSP. Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="Connection Power Level Index" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="Connection power level index (Default=0x8, 8d). Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="Broadcaster Power Level Index" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="LE ISO BIG Tx power level. (Default=0x8, 8d). Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="MultiAdvTxPower_min" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x0" Signed="false" Description="Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="MultiAdvTxPower_low" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x1" Signed="false" Description="Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="MultiAdvTxPower_mid" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x3" Signed="false" Description="Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="MultiAdvTxPower_high" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x5" Signed="false" Description="Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="MultiAdvTxPower_max" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="Negative PL can be specified as 0x20(-1) ~ 0x23(-4)." />
        <ELEMENTS Name="Max PL on individual PHY" Type="STRUCTURE" Size="6">
          <ELEMENTS Name="feature control flag" Type="BITFIELD" Size="1">
            <ELEMENTS Name="feature_enable" Default="0x0" Start="0" End="0" Description="enable feature" />
          </ELEMENTS>
