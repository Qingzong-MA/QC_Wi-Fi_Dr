GROUP gQca_STAT_ScoConnStats "Synchronous Connection Stats"
{
    FIELD fQca_ScoPiconetClockS            (Fixed 4 Bytes) (Hex)                           "PiconetStartClock"
    FIELD fQca_ScoPiconetClockE            (Fixed 4 Bytes) (Hex)                           "PiconetEndClock"
    FIELD fQca_ScoConnHandle               (Fixed 2 Bytes) (Decimal)                        "ConnHandle"
    FIELD fQca_ScoInstanceCnt           (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "InstantCnt"
    FIELD fQca_ScoFrameCnt               (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "FrameCnt"
    FIELD fQca_ScoMissedInstanceCnt       (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "MissedInstantCnt"
    FIELD fQca_ScoTxRetransmitSlotCnt     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "TxRetransmitCnt"
    FIELD fQca_ScoRxRetransmitSlotCnt     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "RxRetransmitCnt"
    FIELD fQca_ScoTxCoexCritical     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexCriticalTxDenialCnt"
    FIELD fQca_ScoTxCoexNormal         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexNormalTxDenialCnt"
    FIELD fQca_ScoRxCoexCritical     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexCriticalRxDenialCnt"
    FIELD fQca_ScoRxCoexNormal         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexNormalRxDenialCnt"
    FIELD fQca_ScoCoexTxAbortCnt     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexTxAbortCnt"
    FIELD fQca_ScoCoexRxAbortCnt     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "CoexRxAbortCnt"
    FIELD fQca_ScoLateTxCmdCnt         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "LateTxCmdCnt"
    FIELD fQca_ScoLateRxCmdCnt         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "LateRxCmdCnt"
    FIELD fQca_ScoLateDispCnt         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "LateDispatchCnt"

    FIELD fQca_ScoGoodRxFrameCnt          (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "RxGoodRxFrameCnt"
    FIELD fQca_ScoGoodRxReservedCnt     (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "GoodRxReservedCnt"
    FIELD fQca_ScoGoodRxRetxCnt          (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "GoodRxRetxCnt"
    FIELD fQca_ScoGoodRxRelayCnt          (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "GoodRxRelayCnt"
    FIELD fQca_ScoGoodTxFrameCnt          (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "GoodTxFrameCnt"
    FIELD fQca_ScoGoodPeerAckCnt          (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "GoodPeerAckCnt"
    FIELD fQca_ScoReclaimedRetransCnt   (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "ReclaimedRetransCnt"

    FIELD fQca_ScoPktLen                  (Fixed 2 Bytes) (Decimal)               "Pakcet Length"

    FIELD fQca_ScoTesco                   (Fixed 1 Byte)  (Decimal)               "Tesco"
    FIELD fQca_ScoWesco                   (Fixed 1 Byte)  (Decimal)               "Wesco"
    FIELD fQca_ScoPktType                 (Fixed 1 Byte)  (TABLE tQca_ScoPktType) "PktType"

    /* LSB of the PacketTypes from BIT7 to BIT0*/
    RESERVED                               (Fixed 3 Bit)
    FIELD fQca_qhsPhy                     (Fixed 3 Bit)  (TABLE tQhsPhy)         "QHS Rate"
    FIELD fQca_ScoparentACLLinkStatus   (Fixed 1 Bit)  (TABLE tSniffSta)       "Sniff Status"
    FIELD fQca_ScoRole                    (Fixed 1 Bit)  (TABLE t_linkRole)      "ACL Role"

    FIELD fQca_scoStats_airCodeFormat  (Fixed 1 Bytes) (TABLE tQca_Airformat)  "Air Code Format"
    FIELD fQca_ScoTxPowerLevel         (Fixed 1 Bytes) (Decimal)               "TxPowerLevel"
    FIELD fQca_ScoTxPower              (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal) "TxPower(dBM)"
    FIELD fQca_scoStats_avgRSSI        (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal) "Avg RSSI in DBM"

    FIELD fQca_scoStats_airCodeCompany (Fixed 2 Bytes) (Hex)                  "Air Code Vendor CompanyID"
    FIELD fQca_scoStats_airCodeCodec   (Fixed 2 Bytes) (Hex)                  "Air Code Vendor CodecID"
}

