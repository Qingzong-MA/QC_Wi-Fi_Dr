GROUP gQca_DBFW_evt "DBFW Event"
{
    FIELD fQca_DBFWSubEventCode      (Fixed 1 Byte)         (Table tQca_DBFWSubEventCode)         "Sub Opcode"
    BRANCH (FromTable tQca_DBFWSubEventCode fQca_DBFWSubEventCode)
}

GROUP gQca_DBFW_linkLossEvent  "Link Loss Event"
{
    FIELD fQca_DBFW_connHandle;
    FIELD fQca_DBFW_reserved1           (Fixed 4 Bits)          (Hex)                 SUPPRESS_DETAIL
    FIELD fQca_DBFW_noOfConnections     (Fixed 3 Bits)          (Hex)                 "Number Of Connections"
    FIELD fQca_DBFW_linkRole            (Fixed 1 Bit)           (TABLE tQca_DBFW_Link_Role)      "Link Role"
    FIELD fQca_DBFW_txPowerLastSync     (Fixed 1 Byte)          RETRIEVE (SignExtension 8) (Decimal)                 "Last Successful Packet's Tx Power"
    FIELD fQca_DBFW_lastRxRSSI          (Fixed 1 Byte)          RETRIEVE (SignExtension 8) (Decimal)                 "Last Successful Packet's Rx RSSI"
    FIELD fQca_DBFW_lastRxClock         (Fixed 4 Bytes)         (Hex)                 "Last Successful Rx Clock"
    GROUP gQca_DBFW_afhState "AFH State"
    {
        FIELD fQca_DBFW_reserved2           (Fixed 3 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_afhMode             (Fixed 1 Bit)           (Hex)                 "AFH Mode"
        FIELD fQca_DBFW_preRecoverymode     (Fixed 1 Bit)           (Hex)                 "PreRecovery Mode"
        FIELD fQca_DBFW_recoveryMode        (Fixed 1 Bit)           (Hex)                 "Recovery Mode"
        FIELD fQca_DBFW_afhAcked            (Fixed 1 Bit)           (Hex)                 "AFH Acked"
        FIELD fQca_DBFW_afhSent             (Fixed 1 Bit)           (Hex)                 "AFH Sent"
    }
    FIELD fQca_DBFW_channelMap          (Fixed 10 Bytes)        (Binary)              "AFH Channel Map"
    FIELD fQca_DBFW_reserved3           (Fixed 2 Bytes)         (Hex)                 SUPPRESS_DETAIL
    FIELD fQca_DBFW_lsto                (Fixed 4 Bytes)         (Decimal)             "Link Supervision Timeout"
    GROUP gQca_DBFW_sniffDetails "Sniff Details"
    {
        FIELD fQca_DBFW_reserved4           (Fixed 6 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_subratingMode       (Fixed 1 Bit)           (Hex)                 "Subrating Mode"
        FIELD fQca_DBFW_sniffMode           (Fixed 1 Bit)           (Hex)                 "Sniff Mode"
        FIELD fQca_DBFW_sniffOffset         (Fixed 2 Bytes)         (Hex)                 "Sniff Offset"
        FIELD fQca_DBFW_sniffInterval       (Fixed 2 Bytes)         (Hex)                 "Sniff Interval"
        FIELD fQca_DBFW_sniffAttempts       (Fixed 2 Bytes)         (Hex)                 "Sniff Attempts"
        FIELD fQca_DBFW_sniffTimeout        (Fixed 2 Bytes)         (Hex)                 "Sniff Timeout"
        FIELD fQca_DBFW_subratingLatency    (Fixed 2 Bytes)         (Hex)                 "Subrating Latency"
        FIELD fQca_DBFW_subratingMinRemoteTimeout         (Fixed 2 Bytes)         (Hex)                 "Subrating Minimum Remote Timeout"
        FIELD fQca_DBFW_subratingMinLocalTimeout          (Fixed 2 Bytes)         (Hex)                 "Subrating Minimum Local Timeout"
    }
    GROUP gQca_DBFW_txPktDetails "Link Supervision Timeout Tx Packet Details"
    {
        FIELD fQca_DBFW_reserved5           (Fixed 3 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_txEdr               (Fixed 1 Bit)           (TABLE tQca_DBFW_BR_EDR)                  "Tx Type"
        FIELD fQca_DBFW_txPacketType_BR        (Fixed 4 Bit)        IF (FieldIs EqualTo 1 fQca_DBFW_txEdr)   (TABLE tQca_BB_BR_PacketType)                 "Packet Type"
        FIELD fQca_DBFW_txPacketType_EDR        (Fixed 4 Bit)        IF (FieldIs EqualTo 0 fQca_DBFW_txEdr)   (TABLE tQca_BB_EDR_PacketType)                 "Packet Type"
        FIELD fQca_DBFW_txPowerLastTransmitted          (Fixed 1 Byte)          RETRIEVE (SignExtension 8) (Decimal)                 "Last Transmitted Packet's Tx Power"
        FIELD fQca_DBFW_reserved6           (Fixed 6 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_txL2capFlowStop     (Fixed 1 Bit)           (TABLE tQca_DBFW_GO_STOP)                 "Tx L2CAP Flow Stop"
        FIELD fQca_DBFW_txBBFlowStop        (Fixed 1 Bit)           (TABLE tQca_DBFW_GO_STOP)                 "Tx BB Flow Stop"
        FIELD fQca_DBFW_txMsgOpcode         (Fixed 2 Bytes)         (Hex)                 "Tx LM Message opcode"
        FIELD fQca_DBFW_txRxAttempt         (Fixed 2 Bytes)         (Hex)                 "Tx/Rx Attempts in LSTO"
    }
    GROUP gQca_DBFW_rxPktDetails "Link Supervision Timeout Rx Packet Details"
    {
        FIELD fQca_DBFW_reserved7           (Fixed 3 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_rxEdr               (Fixed 1 Bit)           (TABLE tQca_DBFW_BR_EDR)                  "Rx Type"
        FIELD fQca_DBFW_rxPacketType_BR      (Fixed 4 Bit)           IF (FieldIs EqualTo 1 fQca_DBFW_rxEdr)   (TABLE tQca_BB_BR_PacketType)                 "Packet Type"
        FIELD fQca_DBFW_rxPacketType_EDR      (Fixed 4 Bit)          IF (FieldIs EqualTo 0 fQca_DBFW_rxEdr)   (TABLE tQca_BB_EDR_PacketType)                 "Packet Type"
        FIELD fQca_DBFW_reserved8           (Fixed 5 Bits)          (Hex)                 SUPPRESS_DETAIL
        FIELD fQca_DBFW_rxL2capFlowStop     (Fixed 1 Bit)           (TABLE tQca_DBFW_GO_STOP)                 "Rx L2CAP Flow Stop"
        FIELD fQca_DBFW_rxBBFlowStop        (Fixed 1 Bit)           (TABLE tQca_DBFW_GO_STOP)                 "Rx BB Flow Stop"
        FIELD fQca_DBFW_rxARQN              (Fixed 1 Bit)           (TABLE tQca_DBFW_ACK_NAK)                 "Rx ARQN"
        FIELD fQca_DBFW_rxMsgOpcode         (Fixed 2 Bytes)         (Hex)                 "Rx LM Message opcode"
    }
    GROUP gQca_DBFW_NetworkTopology REPEAT COUNT (FromField Times fQca_DBFW_noOfConnections) "Network Topology"
    {
        FIELD fQca_DBFW_NetworkTopologyConnHandle        (Fixed 2 Bytes)         (Hex)                                "Handle"
        FIELD fQca_DBFW_NetworkTopologyRole              (Fixed 1 Byte)          (TABLE tQca_DBFW_Link_Role)          "Role"
    }
    FIELD fQca_DBFW_NetworkTopologyUnparsed (toendoflayer) IF(MoreBytes) (stringofhex) SUPPRESS_DETAIL
}

GROUP gQca_DBFW_clockInfoEvent  "Clock Info Event"
{
    FIELD fQca_DBFW_numberOfClocks        (Fixed 4 Bytes)         (Hex)                                "Number of Clocks"
    GROUP gQca_DBFW_PiconetRxClock REPEAT COUNT (FromField Times fQca_DBFW_numberOfClocks) "Piconet Rx Clock"
    {
        FIELD fQca_DBFW_PiconetRxClock        (Fixed 4 Bytes)         (Hex)                                "Piconet Rx Clock"
    }
}

GROUP gQca_DBFW_activePageSlotsEvent  "Active Page Slots Event"
{
    FIELD fQca_DBFW_activePageSlots        (Fixed 2 Bytes)         (Hex)           "Slots"
}

GROUP gQca_DBFW_lmpDebugInfoEvent  "DBFW+ LMP Debug Info Event"
{
    GROUP gQca_DBFW_lmpDebugInfo  REPEAT COUNT (Fixed 4 Times)  "LMP Debug Info"
    {
        FIELD fQca_DBFW_payload             (Fixed 4 Bytes)         (Hex)           "LMP Message"
        FIELD fQca_DBFW_firstClk            (Fixed 4 Bytes)         (Hex)           "First Clock"
        FIELD fQca_DBFW_lastClk             (Fixed 4 Bytes)         (Hex)           "Last Clock"
        FIELD fQca_DBFW_retransCnt          (Fixed 1 Byte)          (Decimal)       "Retransmission Count"
        GROUP gQca_DBFW_variousInfo "Various Info"
        {
            /* MSB to LSB */
            RESERVED                            (Fixed 6 Bits)
            FIELD fQca_DBFW_variousInfoUsed     (Fixed 1 Bit)          (TABLE tQca_DBFW_Internally_Used) "Internally Used"
            FIELD fQca_DBFW_variousInfoRole     (Fixed 1 Bit)          (TABLE tQca_DBFW_Link_Role)       "Initiated Role"
        }
        GROUP gQca_DBFW_ackInfo "ACK Info"
        {
            /* MSB to LSB */
            RESERVED                            (Fixed 1 Bit)
            FIELD fQca_DBFW_ackInfoValid        (Fixed 1 Bit)          (TABLE tQca_DBFW_ACK_Info_Valid)  "Valid"
            FIELD fQca_DBFW_ackInfoFlow         (Fixed 1 Bit)          (TABLE tQca_DBFW_GO_STOP)         "Flow"
            FIELD fQca_DBFW_ackInfoArqn         (Fixed 1 Bit)          (TABLE tQca_DBFW_ACK_NAK)         "ARQN"
            FIELD fQca_DBFW_ackInfoPktType      (Fixed 4 Bits)         (TABLE tQca_DBFW_Packet_Type)     "Packet Type"
        }
    }
}

GROUP gQca_DBFW_A2DPDebugInfoEvent "DBFW+ A2DP Debug Info Event"
{
    FIELD fQca_DBFW_connHandle;
    FIELD fQca_DBFW_RoleDevice            (Fixed 1 Byte)           (TABLE tQca_DBFW_Link_Role)          "Device Role"
    FIELD fQca_DBFW_A2DPRole              (Fixed 1 Byte)           (TABLE tQca_DBFW_A2DP_Role)          "A2DP Role"
    GROUP gQca_DBFW_flaginfo    "Flags BIt set"
    {
        /* MSB to LSB */
        FIELD fQca_DBFW_L2CAPFragmentCount    (Fixed 3 Bits)        (Decimal)                           "L2CAP Fragment Count"
        FIELD fQca_DBFW_LMPRx                 (Fixed 1 Bit)         (TABLE tQca_DBFW_LMP)             "LMP Rx"
        FIELD fQca_DBFW_LMPTx                 (Fixed 1 Bit)         (TABLE tQca_DBFW_LMP)             "LMP Tx"
        FIELD fQca_DBFW_peerL2capFlowStop     (Fixed 1 Bit)         (TABLE tQca_DBFW_A2DP_Flow)         "Peer L2CP Flow Stop"
        FIELD fQca_DBFW_peerBBFlowStop        (Fixed 1 Bit)         (TABLE tQca_DBFW_A2DP_Flow)         "Peer BB Flow Stop"
        FIELD fQca_DBFW_L2CAPFragmentExceeded (Fixed 1 Bit)         (Decimal)                        "L2CAP Fragment Exceeded"
    }
    FIELD fQca_DBFW_NonDataTx                  (Fixed 1 Byte)       (Decimal)                            "Non Data Tx"
    FIELD fQca_DBFW_NonDataRx                  (Fixed 1 Byte)       (Decimal)                            "Non Data Rx"
    FIELD fQca_DBFW_L2CAPDelay                 (Fixed 2 Bytes)      (Decimal)                            "L2CAP Delay"
    FIELD fQca_DBFW_L2CAPStartTime             (Fixed 4 Bytes)      (Hex)                                "A2DP Tx Clk"
    RESERVED                                   (FIXED 3 BYTES)
    GROUP gQCA_DBFW_HCI_FRAG REPEAT COUNT (FromField Times fQca_DBFW_L2CAPFragmentCount) "HCI Fragment Info"
    {
        GROUP gQCA_DBFW_HCI_FRAGMENT "HCI Fragment"
        {
            GROUP gQca_DBFW_flags       "Flags Bit set"
            {
                /* MSB to LSB */
                RESERVED                              (FIXED 3 Bits)
                FIELD fQca_DBFW_txEdr;
                FIELD fQca_DBFW_ackInfoPktType;
            }
            FIELD fQca_DBFW_AckMissCount              (FIXED 1 Byte)        (Decimal)                             "Ack Miss Count"
            FIELD fQca_DBFW_NakCount                  (FIXED 1 Byte)        (Decimal)                             "Nak Count"
            FIELD fQca_DBFW_NoPollCount               (FIXED 1 Byte)        (Decimal)                             "Poll Miss Count"
            FIELD fQca_DBFW_retransCount              (Fixed 1 Byte)        (Decimal)                             "Retransmission Count"
            RESERVED                                  (FIXED 1 Byte)
            FIELD fQca_DBFW_A2DPAntennaTime           (Fixed 2 Bytes)       (Decimal)                             "A2DP Grant time in slots"
            FIELD fQca_DBFW_A2dp_TxPower              (Fixed 1 byte) RETRIEVE (SignExtension 8) (Decimal)         "LastTxPower_dBm"
            FIELD fQca_DBFW_A2dp_RxPower              (Fixed 1 byte) RETRIEVE (SignExtension 8) (Decimal)         "LastRxPower_dBm"
            RESERVED                                  (FIXED 1 BYTE)
            FIELD fQca_DBFW_A2dp_channelMap           (Fixed 10 Bytes)        (Binary)                            "Channel Map"
            FIELD fQca_DBFW_PiconetClock              (FIXED 4 Bytes)         (Hex)                               "Piconet Clock"
        }
    }
}

GROUP gQca_DBFW_scoDebugInfoEvent  "DBFW+ SCO Debug Info Event"
{
    FIELD fQca_DBFW_connHandle;
    GROUP gQca_DBFW_flagsInfo "Flags Bit Set"
    {
        /* MSB to LSB */
        RESERVED                            (Fixed 6 Bits)
        FIELD fQca_DBFW_deviceRole          (Fixed 1 Bit)          (TABLE tQca_DBFW_Link_Role)             "Device Role"
        FIELD fQca_DBFW_countNullPacket     (Fixed 1 Bit)          (TABLE tQca_DBFW_enableMode)            "Count NULL Packet As Missed Packet"
    }
    FIELD fQca_DBFW_scoMode                 (Fixed 1 Byte)         (TABLE tQca_DBFW_SCO_Mode)              "SCO/eSCO Mode"
    /* Init the Counter */
    FIELD fQca_DBFW_idxInit                 (Fixed 0)              RETRIEVE (StoreInteger 0) (Decimal) SUPPRESS_DETAIL STORE dbfwIdx
    GROUP gQca_DBFW_txDroppedPkt REPEAT COUNT (Fixed 5 Times) "Tx Consecutive Dropped Packet"
    {
        FIELD fQca_DBFW_packetGroup         (Fixed 4 Bytes)        (DecimalWithFieldLabel dbfwIdx)    "Group"
        /* Increase the Counter */
        FIELD fQca_DBFW_idxInr              (Fixed 0) RETRIEVE (StoreField dbfwIdx) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE dbfwIdx
    }
    FIELD fQca_DBFW_idxInit;
    GROUP gQca_DBFW_txMissedPkt REPEAT COUNT (Fixed 5 Times) "Tx Consecutive Missed Packet Count"
    {
        FIELD fQca_DBFW_packetGroup;
        FIELD fQca_DBFW_idxInr;
    }
    FIELD fQca_DBFW_idxInit;
    GROUP gQca_DBFW_rxDroppedPkt REPEAT COUNT (Fixed 5 Times) "Rx Consecutive Dropped Packet Count"
    {
        FIELD fQca_DBFW_packetGroup;
        FIELD fQca_DBFW_idxInr;
    }
    FIELD fQca_DBFW_idxInit;
    GROUP gQca_DBFW_rxMissedPkt REPEAT COUNT (Fixed 5 Times) "Rx Consecutive Missed Packet Count"
    {
        FIELD fQca_DBFW_packetGroup;
        FIELD fQca_DBFW_idxInr;
    }
    FIELD fQca_DBFW_idxInit;
    GROUP gQca_DBFW_txRetransPkt REPEAT COUNT (Fixed 5 Times) "Tx Retransmitted Packet Count"
    {
        FIELD fQca_DBFW_packetGroup;
        FIELD fQca_DBFW_idxInr;
    }
    FIELD fQca_DBFW_idxInit;
    GROUP gQca_DBFW_rxRetransPkt REPEAT COUNT (Fixed 5 Times) "Rx Retransmitted Packet Count"
    {
        FIELD fQca_DBFW_packetGroup;
        FIELD fQca_DBFW_idxInr;
    }
}

GROUP gQca_DBFW_scoPacketInfoEvent  "DBFW+ SCO Packet Info Event"
{
    FIELD fQca_DBFW_scoPakcetM2S                 (Fixed 1 Byte)         (TABLE tQca_DBFW_SCO_Packet_Type)              "SCO Packet Type M->S"
    FIELD fQca_DBFW_scoPakcetS2M                 (Fixed 1 Byte)         (TABLE tQca_DBFW_SCO_Packet_Type)              "SCO Packet Type S->M"
}

