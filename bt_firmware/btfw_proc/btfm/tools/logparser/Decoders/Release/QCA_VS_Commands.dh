    FIELD fBQRCmd_Mask_SCOMiss              (Fixed 1 Bit)       (Binary)  "SCO Glitch"
    FIELD fBQRCmd_Mask_AudioGlitch          (Fixed 1 Bit)       (Binary)  "A2DP Glitch"
