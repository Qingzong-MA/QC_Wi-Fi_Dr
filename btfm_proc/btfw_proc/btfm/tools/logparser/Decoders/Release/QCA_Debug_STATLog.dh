    FIELD Qca_STAT_agc_cm_exception_4           (Fixed 4 Byte)   (Hex)   "HZ_MDM_BT_RX_AGC_CM_EXCEPTION_4"
    FIELD Qca_STAT_agc_cm_exception_5           (Fixed 4 Byte)   (Hex)   "HZ_MDM_BT_RX_AGC_CM_EXCEPTION_5"
