  <TAG_GROUPS>
    <TAG_GROUP Name="BT" Description="Configuration Tags in this group control some parameters of the Bluetooth protocol" />
    <TAG_GROUP Name="SYS" Description="Configuration Tags in this group modify general system settings" />
    <TAG_GROUP Name="RM" Description="Configuration Tags in this group modify the settings of the Radio" />
    <TAG_GROUP Name="Voice" Description="Configuration Tags in this group are used to configure the platform setttings" />
    <TAG_GROUP Name="USB" Description="Configuration Tags in this group modify the settings of USB transport" />
    <TAG_GROUP Name="CBL" Description="Configuration Tags in this group control the Serial Cable Replacement Application" />
    <TAG_GROUP Name="APP" Description="Configuration Tags in this group control the Higher layer Application settings" />
    <TAG_GROUP Name="MMI" Description="Configuration Tags in this group control the MMI configuration" />
  </TAG_GROUPS>

  <PLATFORMS>
    <PLATFORM Name="QCC2072" ID="33" Description="QCC2072 (Cologne)" />
  </PLATFORMS>

  <FEATURES/>
