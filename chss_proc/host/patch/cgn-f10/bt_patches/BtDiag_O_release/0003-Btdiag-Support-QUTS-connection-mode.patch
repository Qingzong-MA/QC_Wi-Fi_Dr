diff --git a/hciattach_rome.c b/hciattach_rome.c
index f1f3f86c48f8..960bffb9ff17 100755
--- a/hciattach_rome.c
+++ b/hciattach_rome.c
@@ -58,10 +58,9 @@
 #endif
 #include "hciattach_rome.h"
