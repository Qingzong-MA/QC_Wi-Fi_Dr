GROUP gQca_LLM_CigParams "CIG Parameters"
{
    FIELD fQca_CigParamsId                   (Fixed 1 Bytes)      (Decimal)                                 "CIG ID"
    FIELD fQca_CigParamsCisCount             (Fixed 1 Bytes)      (Decimal)                                 "CIS Count"
    FIELD fQca_CigParamsSca                  (Fixed 1 Bytes)      (Decimal)                                 "Sleep Clock Accuracy"
    FIELD fQca_IsoParamsPacking              (Fixed 1 Bytes)      (TABLE tQca_LE_ISO_Packing)               "Packing"
    FIELD fQca_IsoParamsFraming              (Fixed 1 Bytes)      (TABLE tQca_LE_ISO_Framing)               "Framing"
    FIELD fQca_CigParamsFtMS                 (Fixed 1 Bytes)      (Decimal)                                 "FT M2S"
    FIELD fQca_CigParamsFtSM                 (Fixed 1 Bytes)      (Decimal)                                 "FT S2M"
    FIELD fQca_CigParamsState                (Fixed 1 Bytes)      (TABLE tQca_LE_ISO_CigState)              "CIG State"
    FIELD fQca_IsoParamsIsoInterval          (Fixed 2 Bytes)      (Scale 1.25 2) ALSO (Constant "ms")       "ISO Interval"
    FIELD fQca_CigSyncDelay                  (Fixed 2 Bytes)      (Decimal) ALSO (Constant "us")            "CIG Sync Delay"
    FIELD fQca_CigParamsSduIntervalMS        (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "SDU Interval M2S"
    FIELD fQca_CigParamsSduIntervalSM        (Fixed 4 Bytes)      (Decimal) ALSO (Constant "us")            "SDU Interval S2M"
    GROUP gQca_CisParams REPEAT COUNT (FromField Times fQca_CigParamsCisCount) "CIS Parameters"
    {
        FIELD fQca_IsoParamsId                   (Fixed 1 Bytes)      (Decimal)             "CIS ID"
        FIELD fQca_IsoParamsNse                  (Fixed 1 Bytes)      (Decimal)             "NSE"
	FIELD fQca_IsoParamsCisSyncDelay         (Fixed 2 Bytes)      (Decimal) ALSO (Constant "us")        "CIS Sync Delay"
	FIELD fQca_IsoParamsSubeventDuration     (Fixed 2 Bytes)      (Decimal) ALSO (Constant "us")        "Subevent Duration"

        GROUP gQca_CisTxParams "TX"
        {
            FIELD fQca_IsoParamsBn                       (Fixed 1 Bytes)      (Decimal)                           "BN"
            FIELD fQca_IsoParamsPhy                      (Fixed 1 Bytes)      (TABLE tQca_LE_PhyRate)             "PHY"
            FIELD fQca_IsoParamsMaxPdu                   (Fixed 2 Bytes)      (Decimal)                           "Max PDU Size"
            FIELD fQca_IsoParamsMaxSdu                   (Fixed 2 Bytes)      (Decimal)                           "Max SDU size"
        }
        GROUP gQca_CisRxParams "RX"
        {
            FIELD fQca_IsoParamsBn;   
            FIELD fQca_IsoParamsPhy;
            FIELD fQca_IsoParamsMaxPdu;
            FIELD fQca_IsoParamsMaxSdu;
        }
    }
    RESERVED            (ToEndOfLayer)
}

