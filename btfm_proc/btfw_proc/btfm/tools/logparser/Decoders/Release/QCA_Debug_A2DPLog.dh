TABLE tSbIds
{ 0x05 "SB_EncodeMode" "SB_EncodeMode" 0 gQca_Audio_SB_encodeMode}
{ 0x06 "SB_Rssi" "SB_Rssi" 0 gQca_Audio_SB_Rssi}
{ 0x07 "SB_numBTLinks" "SB_numBTLinks" 0 gQca_Audio_SB_otherLinksNum}
{ 0x08 "SB_wifiActivity" "SB_wifiActivity" 0 gQca_Audio_SB_wifiActivity}
{ 0x09 "SB_primer_v1" "SB_primer" 0 gQca_Audio_SB_primer}
{ 0x0a "SB_drift" "SB_drift" 0 gQca_Audio_SB_drift}
{ 0x0b "SB_quality_v1" "SB_quality_v1" 0 gQca_Audio_COPv1_SB_Quality}
{ 0x0d "SB_primer_ack_v2" "SB_primerAck"}
{ 0x0e "SB_genericEncode" "SB_genericEncode" 0 gQca_Audio_SB_genericEncode}
{ 0x0f "SB_RX_QUALITY MASK" "SB_RX_QUALITY MASK" 0 gQca_Audio_COPv2_SB_Quality}
{ 0x10 "SB_primer_v2" "SB_primer" 0 gQca_Audio_SB_primer_v2}
{ 0x11 "SB_quality" "SB_quality" 0 gQca_Audio_SB_QualityFB}
{ 0x14 "SB_EncoderReady" "SB_encoderReady" 0 gQca_LE_Audio_EncoderReady}
{ 0x18 "SB_sequence" "SB_sequence" 0 gQca_Audio_SB_sequence}
{ 0x19 "SB_sampleCnt" "SB_sampleCnt" 0 gQca_Audio_SB_sampleCnt}
ENDTABLE

GROUP gQca_COPFeedbackInfo "COP feedback"
{
	FIELD fQca_COP_SYNC01      (Fixed 2 Bytes)   (Hex)    SUPPRESS_DETAIL
	FIELD fQca_COP_SYNC02      (Fixed 2 Bytes)   (Hex)    SUPPRESS_DETAIL
    
    FIELD fQca_COP_Header_Ver_TA      (Fixed 2 Bytes) RETRIEVE (AndMask 0x3) ALSO (ShiftRight 0) (Decimal) SUPPRESS_DETAIL NO_MOVE STORE copVer
	
    GROUP fQca_COP_V0 IF(FieldIs EqualTo 0x00 fQca_COP_Header_Ver_TA) "COPV0"
    {
        FIELD fQca_COP_Header01_1  (Fixed 5 Bits)    (Hex)    SUPPRESS_DETAIL //"fmt_id_l4"
        FIELD fQca_COP_Header01_2  (Fixed 1 Bit)     (Hex)    "sidebandPresense"
        FIELD fQca_COP_Header01_3  (Fixed 2 Bits)    (Hex)    "version"
        FIELD fQca_COP_Header02_1  (Fixed 5 Bits)    (Hex)    "Quality"
        FIELD fQca_COP_Header02_2  (Fixed 3 Bits)    (Hex)    SUPPRESS_DETAIL
        RESERVED (Fixed 2 Bytes)
    }
    GROUP fQca_COP_V1 IF(FieldIs EqualTo 0x01 fQca_COP_Header_Ver_TA) "COPV1"
    {
        FIELD fQca_COP_Header11_1  (Fixed 5 Bits)    (Hex)    SUPPRESS_DETAIL //"fmt_id_l4"
        FIELD fQca_COP_Header11_2  (Fixed 1 Bit)     (Hex)    "sidebandPresense"
        FIELD fQca_COP_Header11_3  (Fixed 2 Bits)    (Hex)    "version"
        FIELD fQca_COP_Header12_1  (Fixed 7 Bits)    (Hex)    "Quality"
        FIELD fQca_COP_Header12_2  (Fixed 1 Bits)    (Hex)    SUPPRESS_DETAIL  //"fmt_id_h5"
        FIELD fQca_COP_numSB       (Fixed 1 Byte)    (Hex)    "SBNum" STORE sbNum
        GROUP gQca_sbloop REPEAT COUNT (FromField Times fQca_COP_numSB 0)  "SideBand"
        {
            GROUP gQca_COP_SB;
        }
        FIELD fQca_COP_FrameNo (Fixed 1 Bytes) RETRIEVE (AndMask 0xF) (Decimal)  "FrameNo" NO_MOVE
        FIELD fQca_COP_PyldLen (Fixed 2 Bytes) RETRIEVE (ShiftRight  4)   (Decimal) "Payldlen"
        GROUP gQca_COP_Data IF(FieldIs NotEqualTo 0x00 fQca_COP_PyldLen) "Frame"
        {
            FIELD fQca_COP_Data    (FromField Bytes fQca_COP_PyldLen)     (Hex)       "Data"
        }
        RESERVED (Fixed 2 Bytes) //end marker: c000
    }
    GROUP fQca_COP_V2 IF(FieldIs EqualTo 0x2 fQca_COP_Header_Ver_TA)
    {
        GROUP gQca_COP_Pkt;
    }
}
