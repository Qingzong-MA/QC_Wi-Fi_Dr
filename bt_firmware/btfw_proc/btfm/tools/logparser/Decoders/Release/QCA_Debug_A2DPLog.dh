{ 0x05 "SB_EncodeMode" "SB_EncodeMode" 0 gQca_Audio_SB_encodeMode}
{ 0x06 "SB_Rssi" "SB_Rssi" 0 gQca_Audio_SB_Rssi}
{ 0x07 "SB_numBTLinks" "SB_numBTLinks" 0 gQca_Audio_SB_otherLinksNum}
{ 0x08 "SB_wifiActivity" "SB_wifiActivity" 0 gQca_Audio_SB_wifiActivity}
{ 0x0a "SB_drift" "SB_drift" 0 gQca_Audio_SB_drift}
{ 0x0e "SB_genericEncode" "SB_genericEncode" 0 gQca_Audio_SB_genericEncode}
{ 0x0f "SB_RX_QUALITY MASK" "SB_RX_QUALITY MASK" 0 gQca_Audio_COPv2_SB_Quality}
{ 0x10 "SB_primer" "SB_primer" 0 gQca_Audio_SB_primer}
{ 0x11 "SB_quality" "SB_quality" 0 gQca_Audio_SB_QualityFB}
