        FIELD fQca_LLM_PclConnStatsPendReq125k               (Fixed 1 Bit) (TABLE tQca_Power_Status)     "PHY 125k"
        FIELD fQca_LLM_PclConnStatsPendReq2M                 (Fixed 1 Bit) (TABLE tQca_Power_Status)     "PHY 2M"
        FIELD fQca_LLM_PclConnStatsPendReq1M                 (Fixed 1 Bit) (TABLE tQca_Power_Status)     "PHY 1M"
