     FIELD gADVM_Evt_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)        "This is unparsed data"
}

TABLE tADVM_Cmd_SubOpcodes
    {0x00 "HCI_VS_ADVM_Read_Supported_Features"             "HCI_VS_ADVM_Read_Supported_Features"}
    {0x01 "HCI_VS_ADVM_Monitor_Rssi"                        "HCI_VS_ADVM_Monitor_Rssi"}
    {0x02 "HCI_VS_ADVM_Cancel_Monitor_Rssi"                 "HCI_VS_ADVM_Cancel_Monitor_Rssi"}
    {0x03 "HCI_VS_ADVM_LE_Monitor_Advertisement"            "HCI_VS_ADVM_LE_Monitor_Advertisement"}
    {0x04 "HCI_VS_ADVM_LE_Cancel_Monitor_Advertisement"     "HCI_VS_ADVM_LE_Cancel_Monitor_Advertisement"}
    {0x05 "HCI_VS_ADVM_LE_Set_Advertisement_Filter_Enable"  "HCI_VS_ADVM_LE_Set_Advertisement_Filter_Enable"}
    {0x06 "HCI_VS_ADVM_Read_Absolute_RSSI"                  "HCI_VS_ADVM_Read_Absolute_RSSI"}

    {0x07 "HCI_VS_ADVM_Avdtp_Capabilities_Configuration"    "HCI_VS_ADVM_Avdtp_Capabilities_Configuration"   0 gADVM_Avdtp_Capabilities_Configuration}
    {0x08 "HCI_VS_ADVM_Avdtp_Open"                          "HCI_VS_ADVM_Avdtp_Open"    0 gADVM_Avdtp_Open}
    {0x09 "HCI_VS_ADVM_Avdtp_Start"                         "HCI_VS_ADVM_Avdtp_Start"   0 gADVM_Avdtp_Start}
    {0x0A "HCI_VS_ADVM_Avdtp_Suspend"                       "HCI_VS_ADVM_Avdtp_Suspend" 0 gADVM_Avdtp_Suspend}
    {0x0B "HCI_VS_ADVM_Avdtp_Close"                         "HCI_VS_ADVM_Avdtp_Close"   0 gADVM_Avdtp_Close}
ENDTABLE

TABLE tADVM_Evt_SubOpcodes
    {0x00 "HCI_VS_ADVM_Read_Supported_Features"             "HCI_VS_ADVM_Read_Supported_Features"          0 gADVM_Read_Supported_Features_Evt}
    {0x01 "HCI_VS_ADVM_Monitor_Rssi"                        "HCI_VS_ADVM_Monitor_Rssi"}
    {0x02 "HCI_VS_ADVM_Cancel_Monitor_Rssi"                 "HCI_VS_ADVM_Cancel_Monitor_Rssi"}
    {0x03 "HCI_VS_ADVM_LE_Monitor_Advertisement"            "HCI_VS_ADVM_LE_Monitor_Advertisement"}
    {0x04 "HCI_VS_ADVM_LE_Cancel_Monitor_Advertisement"     "HCI_VS_ADVM_LE_Cancel_Monitor_Advertisement"}
    {0x05 "HCI_VS_ADVM_LE_Set_Advertisement_Filter_Enable"  "HCI_VS_ADVM_LE_Set_Advertisement_Filter_Enable"}
    {0x06 "HCI_VS_ADVM_Read_Absolute_RSSI"                  "HCI_VS_ADVM_Read_Absolute_RSSI"}

    {0x07 "HCI_VS_ADVM_Avdtp_Capabilities_Configuration"    "HCI_VS_ADVM_Avdtp_Capabilities_Configuration"   0 gADVM_Avdtp_Capabilities_Configuration_Evt}
    {0x08 "HCI_VS_ADVM_Avdtp_Open"                          "HCI_VS_ADVM_Avdtp_Open"    0 gADVM_Avdtp_Open_Evt}
    {0x09 "HCI_VS_ADVM_Avdtp_Start"                         "HCI_VS_ADVM_Avdtp_Start"}
    {0x0A "HCI_VS_ADVM_Avdtp_Suspend"                       "HCI_VS_ADVM_Avdtp_Suspend"}
    {0x0B "HCI_VS_ADVM_Avdtp_Close"                         "HCI_VS_ADVM_Avdtp_Close"}
ENDTABLE

GROUP gADVM_Read_Supported_Features_Evt
{
    Group gADVM_SupportFeatureBits "Feature Bits"
    {
        FIELD gADVM_SupportFeatureBits_A2dpOffload              (Fixed 1 bit)  (Decimal)                          "A2dp Offload"
        reserved (fixed 1 bit)
        FIELD gADVM_SupportFeatureBits_Continuous_ADVM          (Fixed 1 bit)  (Decimal)                          "Continuous Adv Monitoring"
        FIELD gADVM_SupportFeatureBits_validity_DHKey           (Fixed 1 bit)  (Decimal)                          "Validity DHKey"

        FIELD gADVM_SupportFeatureBits_ADVM                     (Fixed 1 bit)  (Decimal)                          "Adv Monitoring of Legacy ADV"
        FIELD gADVM_SupportFeatureBits_RSSI_Moni_for_ADV        (Fixed 1 bit)  (Decimal)                          "RSSI Monitoring of Legacy Adv"
        FIELD gADVM_SupportFeatureBits_RSSI_Moni_for_LE_Conn    (Fixed 1 bit)  (Decimal)                          "RSSI Monitoring of LE Connection"
        FIELD gADVM_SupportFeatureBits_RSSI_Moni_for_BREDR_Conn (Fixed 1 bit)  (Decimal)                          "RSSI Monitoring of BREDR Connection"
        reserved (fixed 7 bytes)
    }

    FIELD gADVM_event_prefix_length                             (Fixed 1 bytes) (Decimal)                          "prefix_length"
    FIELD gADVM_event_prefix                                    (FromField Bytes gADVM_event_prefix_length) (StringOfAscii)                     "prefix"
}

TABLE tAvdmA2dpCodecType
    {0,     "SBC"}
    {2,     "AAC"}
    {0xFF,  "Vendor"}
ENDTABLE

Group gServiceCategory_MediaCodecCapability  "Codec Capability"
{
    FIELD gCodecCapability_ServiceCategory                  (Fixed 1 Byte) (Hex) "Service Category"
    FIELD gCodecCapability_CodecInfo_Length                 (Fixed 1 Byte) (Decimal) "Length"
    FIELD gCodecCapability_CodecInfo_MediaType              (Fixed 1 Byte) (Hex) "Media type"
    FIELD gCodecCapability_CodecInfo_Codec                  (Fixed 1 Byte) (TABLE tAvdmA2dpCodecType) "Codec"

    /* calc left size */
    FIELD init_left_size (Fixed 0) RETRIEVE (StoreField gCodecCapability_CodecInfo_Length) ALSO (SubtractInteger 2) (Hex) SUPPRESS_DETAIL STORE left_size

    Group gCodecInfoSBC IF (Fieldis Equalto 0 gCodecCapability_CodecInfo_Codec)
    {
        /* for SBC: 4 bytes */
        FIELD gCodecCapability_CodecInfo_SampleRate         (Fixed 4 Bits) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tSBCSampleRate) "SampleRate"
        FIELD gCodecCapability_CodecInfo_ChanMode           (Fixed 4 Bits) RETRIEVE (AndMask 0x0F) (TABLE tSBCChannelMode) "ChannelMode"

        FIELD gCodecCapability_CodecInfo_BlkLen             (Fixed 4 Bits) RETRIEVE (AndMask 0x0F) (TABLE tSBCBlockLength) "BlockLength"
        FIELD gCodecCapability_CodecInfo_Subband            (Fixed 4 Bits) RETRIEVE (AndMask 0x0C) (TABLE tSBCSubband) "Subband"

        FIELD gCodecCapability_CodecInfo_MinBitpool         (Fixed 1 Byte) (Decimal) "Minimum Bitpool"
        FIELD gCodecCapability_CodecInfo_MaxBitpool         (Fixed 1 Byte) (Decimal) "Maximum Bitpool"

        FIELD update_left_size_for_SBC      (Fixed 0) RETRIEVE (SubtractFieldMinusInteger left_size 4) (Decimal) SUPPRESS_DETAIL STORE left_size
    }

    Group gCodecInfoAAC IF (Fieldis Equalto 2 gCodecCapability_CodecInfo_Codec)
    {
        /* for AAC: 6 bytes */
        FIELD gCodecCapability_CodecInfo_AACObjectType      (Fixed 4 Bits)  RETRIEVE (AndMask 0x0F) (TABLE tAACObjectType) "ObjectType"
        Reserved (fixed 4 bits)

        Group gCodecCapability_CodecInfo_AACSampleRate "Sample Rate"
        {
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b7     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "8kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b6     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "11.025kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b5     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "12kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b4     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "16kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b3     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "22.05kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b2     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "24kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b1     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "32kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet1_b0     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "44.1kHz"

            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet2_b7     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "48kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet2_b6     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "64kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet2_b5     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "88.2kHz"
            FIELD gCodecCapability_CodecInfo_AACSampleRate_Octet2_b4     (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "96kHz"
        }

        Group gCodecCapability_CodecInfo_AAC_ChannelMode "Channel Mode"
        {
            FIELD gCodecCapability_CodecInfo_AAC_ChannelMode_channel1   (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "Channel 1"
            FIELD gCodecCapability_CodecInfo_AAC_ChannelMode_channel2   (Fixed 1 bit) PRINT_IF (FieldIs NotEqualTo 0)  (Decimal) "Channel 2"
        }
        Reserved (fixed 2 bits)

        FIELD gCodecCapability_CodecInfo_AAC_VBR              (Fixed 1 bit) (Decimal) "Variable Bit Rate"
        FIELD gCodecCapability_CodecInfo_AAC_BitRate          (Fixed 23 bit) (Hex) "Bit Rate"

        FIELD update_left_size_for_AAC      (Fixed 0) RETRIEVE (SubtractFieldMinusInteger left_size 6) (Decimal) SUPPRESS_DETAIL STORE left_size
    }

    /* for vendor: 6 bytes */
    FIELD gCodecCapability_CodecInfo_VendorId             (Fixed 4 Byte) IF (Fieldis Equalto 0xFF gCodecCapability_CodecInfo_Codec) (Hex) "NonA2DP_CodecType Vendor Id"
    FIELD gCodecCapability_CodecInfo_CodecId              (Fixed 2 Byte) IF (Fieldis Equalto 0xFF gCodecCapability_CodecInfo_Codec) (Hex) "NonA2DP_CodecType Codec Id"
    FIELD update_left_size_for_Vendor   (Fixed 0) IF (Fieldis Equalto 0xFF gCodecCapability_CodecInfo_Codec) RETRIEVE (SubtractFieldMinusInteger left_size 6) (Decimal) SUPPRESS_DETAIL STORE left_size

    Group gCodecInfoVendor IF (Fieldis Equalto 0xFF gCodecCapability_CodecInfo_Codec)
    {
        Group gCodecInfoAptx IF (Fieldis Equalto 0x4F gCodecCapability_CodecInfo_VendorId)
        {
            Group gCodecInfoAptx2 IF (Fieldis Equalto 0x01 gCodecCapability_CodecInfo_CodecId)
            {
                FIELD gCodecCapability_CodecInfo_AptxClassicSampleRate   (Fixed 4 Bits) RETRIEVE (AndMask 0x0F) ALSO (ShiftLeft 4) (TABLE tAptxClassicSampleRate) "SampleRate"
                FIELD gCodecCapability_CodecInfo_AptxClassicChanMode     (Fixed 4 Bits) RETRIEVE (AndMask 0x0F) (TABLE tAptxClassicChannelMode) "ChannelMode"
                FIELD update_left_size_for_APTX      (Fixed 0) RETRIEVE (SubtractFieldMinusInteger left_size 1) (Decimal) SUPPRESS_DETAIL STORE left_size
            }
        }

        /* Group gCodecInfoAptxHD IF (Fieldis Equalto 0x4F gCodecCapability_CodecInfo_VendorId) */
    }

    FIELD updateLeftSize_unparse        (FromField Bytes left_size)  IF(Fieldis GreaterThan 0 left_size)  (stringofhex)       "This is unparsed data"
}

GROUP gADVM_Avdtp_Codec_Capabilities "Codec Capabilities"
{
    FIELD gCodecCapability_ServiceCategoryCnt                (Fixed 1 Byte) (Decimal) "Codec Capability Couont"
    GROUP gServiceCategory_MediaCodecCapabilities REPEAT COUNT (FromField Times gCodecCapability_ServiceCategoryCnt 0)
    {
        Group gServiceCategory_MediaCodecCapability;
    }
}
TABLE tAudioInterfaceParam_ParamId
    {0x00 "Bus Type"}
    {0x01 "Stream Config"}
    {0x02 "MTU"}
ENDTABLE

TABLE tAudioInterfaceParam_BusType
    {0,     "Slimbus"}
    {1,     "I2S"}
ENDTABLE

GROUP gADVM_Avdtp_AudioInterfaceParams "Audio Interface Params"
{
    FIELD gAudioInterfaceParams_Cnt                (Fixed 1 Byte) (Decimal) "Audio Interface Params Cnt"
    GROUP gAudioInterfaceParams_Datas REPEAT COUNT (FromField Times gAudioInterfaceParams_Cnt 0)
    {
        Group gAudioInterfaceParam "Audio Interface Param"
        {
            FIELD gAudioInterfaceParam_VendorId         (Fixed 4 Byte) (Hex) "Vendor Id"
            FIELD gAudioInterfaceParam_ParamId          (Fixed 2 Byte) (TABLE tAudioInterfaceParam_ParamId) "VS Param ID"
            FIELD gAudioInterfaceParam_ValueLen         (Fixed 1 Byte) (Decimal) "VS Data Len"

            FIELD audioparam_init_left_size (Fixed 0) RETRIEVE (StoreField gAudioInterfaceParam_ValueLen) (Hex) SUPPRESS_DETAIL STORE left_size

            Group gAudioInterfaceParam_Value_BusType IF (Fieldis Equalto 0 gAudioInterfaceParam_ParamId)
            {
                FIELD fAudioInterfaceParam_Value_BusType (Fixed 1 Byte) (TABLE tAudioInterfaceParam_BusType) "Bus Type"
                FIELD update_left_size_for_busType      (Fixed 0) RETRIEVE (SubtractFieldMinusInteger left_size 1) (Decimal) SUPPRESS_DETAIL STORE left_size
            }

            Group gAudioInterfaceParam_Value_MTU IF (Fieldis Equalto 2 gAudioInterfaceParam_ParamId)
            {
                FIELD fAudioInterfaceParam_Value_MTU    (Fixed 2 Bytes) (Decimal) "MTU"
                FIELD update_left_size_for_MTU          (Fixed 0) RETRIEVE (SubtractFieldMinusInteger left_size 2) (Decimal) SUPPRESS_DETAIL STORE left_size
            }
            FIELD gAudioInterfaceParam_Value            (FromField Bytes left_size) IF(Fieldis GreaterThan 0 left_size) (stringofhex) "VS Value"
        }
    }
}

GROUP gADVM_Avdtp_Capabilities_Configuration
{
    GROUP gADVM_Avdtp_Codec_Capabilities;
    GROUP gADVM_Avdtp_AudioInterfaceParams;
}

GROUP gADVM_Avdtp_Capabilities_Configuration_Evt
{
    /* same format with gADVM_Avdtp_Capabilities_Configuration */
    Group gADVM_Avdtp_Capabilities_Configuration;
}

GROUP gADVM_Avdtp_Open
{
    FIELD gADVM_Avdtp_Open_ConnHandle                (Fixed 2 Byte) (Decimal) "Connection Handle"
    FIELD gADVM_Avdtp_Open_L2capDstCID               (Fixed 2 Byte) (Hex) "L2CAP Dst CID"
    FIELD gADVM_Avdtp_Open_L2capMTU                  (Fixed 2 Byte) (Decimal) "L2CAP MTU"
    Group gServiceCategory_MediaCodecCapability;
    GROUP gADVM_Avdtp_AudioInterfaceParams;
}

GROUP gADVM_Avdtp_Open_Evt
{
    FIELD gADVM_Avdtp_Open_Evt_A2dpOffloadHandle     (Fixed 2 Byte) (Decimal) "A2dp Offload Handle"
    GROUP gADVM_Avdtp_AudioInterfaceParams;
}

GROUP gADVM_Avdtp_Start
{
    FIELD gADVM_Avdtp_Open_Evt_A2dpOffloadHandle;
}

GROUP gADVM_Avdtp_Suspend
{
    FIELD gADVM_Avdtp_Open_Evt_A2dpOffloadHandle;
}

GROUP gADVM_Avdtp_Close
{
    FIELD gADVM_Avdtp_Open_Evt_A2dpOffloadHandle;
}

/******************************************************************************
 *                          Decoder for OCF 0x171 Audio Offload               *
 ******************************************************************************/

GROUP gAudioOffloadCmd
{
     FIELD gAudioOffloadCmd_opcode (Fixed 1 byte) (Table tAudioOffloadSubOpcodes) "SubOpcode"
     BRANCH (FromTable tAudioOffloadSubOpcodes gAudioOffloadCmd_opcode)
     FIELD gAudioOffload_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

GROUP gAudioOffloadEvt
{
     FIELD gAudioOffloadEvt_status (Fixed 1 byte)  (Decimal)                          "Status"
     FIELD gAudioOffloadEvt_opcode (Fixed 1 Bytes) (Table tAudioOffloadEvtSubOpcodes) "SubOpcode"
     BRANCH (FromTable tAudioOffloadEvtSubOpcodes gAudioOffloadEvt_opcode)
     FIELD gAudioOffloadEvt_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)       "This is unparsed data"
}

TABLE tAudioOffloadSubOpcodes
    {0x01 "HCI_VS_AOF_CONFIGURE"         "HCI_VS_AOF_CONFIGURE"          0 gAudioOffloadCmd_AOF_CONFIGURE}
    {0x02 "HCI_VS_AOF_DECONFIGURE"       "HCI_VS_AOF_DECONFIGURE"        0 gAudioOffloadCmd_AOF_DECONFIGURE}
    {0x03 "HCI_VS_AOF_STREAM_START"      "HCI_VS_AOF_STREAM_START"       0 gAudioOffloadCmd_AOF_STREAM_START}
    {0x04 "HCI_VS_AOF_STREAM_STOP"       "HCI_VS_AOF_STREAM_STOP"        0 gAudioOffloadCmd_AOF_STREAM_STOP}
    {0x05 "HCI_VS_AOF_INTERNAL_TEST_REQ" "HCI_VS_AOF_INTERNAL_TEST_REQ"  0 gAudioOffloadCmd_AOF_INTERNAL_TEST_REQ}
    {0x06 "HCI_VS_AOF_INTERNAL_REQ"      "HCI_VS_AOF_INTERNAL_REQ"       0 gAudioOffloadCmd_AOF_INTERNAL_REQ}
    {0x07 "HCI_VS_AOF_STREAM_SET_PARAM"  "HCI_VS_AOF_STREAM_SET_PARAM"   0 gAudioOffloadCmd_AOF_STREAM_SET_PARAM}
    {Default "Invalid subOpcode"}
ENDTABLE

TABLE tAudioOffloadEvtSubOpcodes
    {0x01 "HCI_VS_AOF_CONFIGURE"}
    {0x02 "HCI_VS_AOF_DECONFIGURE"}
    {0x03 "HCI_VS_AOF_STREAM_START"}
    {0x04 "HCI_VS_AOF_STREAM_STOP"}
    {0x05 "HCI_VS_AOF_INTERNAL_TEST_REQ" "HCI_VS_AOF_INTERNAL_TEST_REQ"  0 gAudioOffloadCmd_AOF_INTERNAL_TEST_REQ_RESP}
    {0x06 "HCI_VS_AOF_INTERNAL_REQ"      "HCI_VS_AOF_INTERNAL_REQ"       0 gAudioOffloadCmd_AOF_INTERNAL_REQ_RESP}
    {0x07 "HCI_VS_AOF_STREAM_SET_PARAM"}
    {Default "Invalid subOpcode"}
ENDTABLE

TABLE tAudioOffloadRole
    {0 "Encoder"}
    {1 "Decoder"}
    {Default "Invalid Audio Offload Role"}
ENDTABLE

TABLE tAudioOffloadCodec
    {0 "Aptx Adaptive"}
    {1 "Aptx Classic"}
    {2 "Aptx HD"}
    {Default "Invalid Audio Offload Codec"}
ENDTABLE

TABLE tAudioOffloadContentProtection
    {0 "Content Protection Disabled"}
    {1 "Content Protection Enabled"}
    {Default "Invalid Audio Offload Content Protection"}
ENDTABLE

TABLE tAudioOffloadSampleRate
    {0 "44.1 KHz"}
    {1 "48 KHz"}
    {Default "Invalid Audio Offload Sample Rate"}
ENDTABLE

TABLE tAudioOffloadChannelMode
    {-1 "unchanged"}
    {0  "Joint stereo"}
    {1  "Mono (not supported)"}
    {2  "Dual Mono"}
    {4  "Stereo TWS"}
    {8  "Earbud"}
    {Default "Invalid Audio Offload Channel Mode"}
ENDTABLE

TABLE tAudioOffloadPrimaryProfile
    {0  "Unchanged"}
    {1  "High Quality 0"}
    {2  "Low Quality 0"}
    {3  "Speech"}
    {4  "Low Latency 1"}
    {5  "High Quality 1"}
    {Default "Invalid Audio Offload Primary Profile"}
ENDTABLE

TABLE tAudioOffloadSecondaryProfile
    {0  "Unchanged"}
    {1  "None"}
    {2  "Low Power"}
    {Default "Invalid Audio Offload Secondary Profile"}
ENDTABLE

TABLE tAudioOffloadSyncMode
    {0   "Stereo sync mode"}
    {1   "Dual mono with autosync"}
    {2   "Dual mono without autosync"}
    {Default "Invalid Audio Offload Sync Mode"}
ENDTABLE

GROUP gAudioOffloadCmd_AOF_CONFIGURE "AOF Configure"
{
     FIELD gAudioCmd_AOF_CONFIGURE_Role                       (Fixed 1 byte) (TABLE tAudioOffloadRole)              "Role"
     FIELD gAudioCmd_AOF_CONFIGURE_Codec                      (Fixed 1 byte) (TABLE tAudioOffloadCodec)             "Codec"
     FIELD gAudioCmd_AOF_CONFIGURE_StreamID                   (Fixed 1 byte) (Hex)                                  "Stream Identifier"
     FIELD gAudioCmd_AOF_CONFIGURE_ContentProtection          (Fixed 1 byte) (TABLE tAudioOffloadContentProtection) "Content Protection"
     FIELD gAudioCmd_AOF_CONFIGURE_Bus_Sample_Rate            (Fixed 1 byte) (TABLE tAudioOffloadSampleRate)        "Bus (I2S/Slimbus) Sample Rate"
     FIELD gAudioCmd_AOF_CONFIGURE_Protocol_Sample_Rate       (Fixed 1 byte) (TABLE tAudioOffloadSampleRate)        "Protocol (A2DP) Sample Rate"
     BRANCH (FromTable tAudioOffloadCodecSpecificData gAudioCmd_AOF_CONFIGURE_Codec)
}

TABLE tAudioOffloadCodecSpecificData
    {0x00 "Aptx Adaptive" "Aptx Adaptive" 0 AudioOffloadCmd_AptxAdaptive_Role_Table}
    {0x01 "Aptx Classic"  "Aptx Classic" 0 AudioOffloadCmd_AptxClassic_Role_Table}
    {Default "Invalid Codec"}
ENDTABLE

GROUP AudioOffloadCmd_AptxAdaptive_Role_Table
{
    BRANCH (FromTable tAudioOffloadCodecSpecificData_AptxAdaptiveRole gAudioCmd_AOF_CONFIGURE_Role)
}

TABLE tAudioOffloadCodecSpecificData_AptxAdaptiveRole
    {0 "Aptx Adaptive Encoder" "Aptx Adaptive Encoder" 0 AudioOffloadCmd_AptxAdaptive_Encoder_Table}
    {1 "Aptx Adaptive Decoder" "Aptx Adaptive Decoder" 0 AudioOffloadCmd_AptxAdaptive_Decoder_Table}
    {Default "Invalid Audio Offload Role"}
ENDTABLE

GROUP AudioOffloadCmd_AptxAdaptive_Encoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Channel_Mode       (Fixed 1 byte) (TABLE tAudioOffloadChannelMode)        "Channel Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Primary_Profile    (Fixed 1 byte) (TABLE tAudioOffloadPrimaryProfile)     "Primary Profile"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Secondary_Profile  (Fixed 1 byte) (TABLE tAudioOffloadSecondaryProfile)   "Secondary Profile"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_TTP_Offset_LL0     (Fixed 4 byte) (Decimal)                               "TTP delay for LL0 in us"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_TTP_Offset_LL1     (Fixed 4 byte) (Decimal)                               "TTP delay for LL1 in us"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_TTP_Offset_HQ0     (Fixed 4 byte) (Decimal)                               "TTP delay for HQ0 in us"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_TTP_Offset_HQ1     (Fixed 4 byte) (Decimal)                               "TTP delay for HQ1 in us"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Min_Snk_Buf_LL     (Fixed 4 byte) (Decimal)                               "Minimum Sink Buffering Low Latency Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Max_Snk_Buf_LL     (Fixed 4 byte) (Decimal)                               "Maximum Sink Buffering Low Latency Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Min_Snk_Buf_HQ     (Fixed 4 byte) (Decimal)                               "Minimum Sink Buffering High Quality Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Max_Snk_Buf_HQ     (Fixed 4 byte) (Decimal)                               "Maximum Sink Buffering High Quality Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Min_Snk_Buf_TWS    (Fixed 4 byte) (Decimal)                               "Minimum Sink Buffering TWS Mode"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptEnc_Max_Snk_Buf_TWS    (Fixed 4 byte) (Decimal)                               "Maximum Sink Buffering TWS Mode"
}

GROUP AudioOffloadCmd_AptxAdaptive_Decoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptDec_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptDec_TTP_A1             (Fixed 4 byte) (Decimal)                               "TTP offset for SSRC=0xA1"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptDec_TTP_A2             (Fixed 4 byte) (Decimal)                               "TTP offset for SSRC=0xA2"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptDec_TTP_A3             (Fixed 4 byte) (Decimal)                               "TTP offset for SSRC=0xA3"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxAdaptDec_TTP_A4             (Fixed 4 byte) (Decimal)                               "TTP offset for SSRC=0xA4"
}

GROUP AudioOffloadCmd_AptxClassic_Role_Table
{
    BRANCH (FromTable tAudioOffloadCodecSpecificData_AptxClassicRole gAudioCmd_AOF_CONFIGURE_Role)
}

TABLE tAudioOffloadCodecSpecificData_AptxClassicRole
    {0 "Aptx Classic Encoder" "Aptx Classic Encoder" 0 AudioOffloadCmd_AptxClassic_Encoder_Table}
    {1 "Aptx Classic Decoder" "Aptx Classic Decoder" 0 AudioOffloadCmd_AptxClassic_Decoder_Table}
    {Default "Invalid Audio Offload Role"}
ENDTABLE

GROUP AudioOffloadCmd_AptxClassic_Encoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxClassicEnc_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxClassicEnc_Sync_Mode          (Fixed 1 byte) (TABLE tAudioOffloadSyncMode)          "Sync Mode"
}

GROUP AudioOffloadCmd_AptxClassic_Decoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxClassicDec_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxClassicDec_TTP                (Fixed 4 byte) (Decimal)                              "TTP offset in us"
}

GROUP AudioOffloadCmd_AptxHD_Role_Table
{
    BRANCH (FromTable tAudioOffloadCodecSpecificData_AptxHDRole gAudioCmd_AOF_CONFIGURE_Role)
}

TABLE tAudioOffloadCodecSpecificData_AptxHDRole
    {0 "Aptx HD Encoder" "Aptx HD Encoder" 0 AudioOffloadCmd_AptxHD_Encoder_Table}
    {1 "Aptx HD Decoder" "Aptx HD Decoder" 0 AudioOffloadCmd_AptxHD_Decoder_Table}
    {Default "Invalid Audio Offload Role"}
ENDTABLE

GROUP AudioOffloadCmd_AptxHD_Encoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxHDEnc_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
}

GROUP AudioOffloadCmd_AptxHD_Decoder_Table
{
     FIELD gAudioCmd_AOF_CONFIGURE_AptxHDDec_L2capMTU           (Fixed 2 byte) (Decimal)                              "Negotiated Media Channel MTU"
     FIELD gAudioCmd_AOF_CONFIGURE_AptxHDDec_TTP                (Fixed 4 byte) (Decimal)                              "TTP offset in us"
}

GROUP gAudioOffloadCmd_AOF_DECONFIGURE "AOF DECONFIGURE"
{
     FIELD gAudioCmd_AOF_DECONFIGURE_StreamID                   (Fixed 1 byte) (Hex)                                  "Stream Identifier"
}

GROUP gAudioOffloadCmd_AOF_STREAM_START "AOF STREAM_START"
{
     FIELD gAudioCmd_AOF_STREAM_START_StreamID                  (Fixed 1 byte) (Hex)                                  "Stream Identifier"
     FIELD gAudioCmd_AOF_STREAM_START_ACLHandle                 (Fixed 2 byte) (Hex)                                  "ACL Connection Handle"
     FIELD gAudioCmd_AOF_STREAM_START_L2CAP_CID                 (Fixed 2 byte) (Hex)                                  "L2CAP CID"

     GROUP gAudioOffloadAofStreamStart_Encoder IF(FieldIs EqualTo 8 cmd_tot_len) "Encoder Data"
     {
        FIELD gAudioCmd_AOF_STREAM_START_MaximumLatency         (Fixed 1 byte) (Decimal)                              "Maximum latency in milliseconds"
        FIELD gAudioCmd_AOF_STREAM_START_ContentProtectionHdr   (Fixed 1 byte) (Hex)                                  "Content protection header"
     }

     GROUP gAudioOffloadAofStreamStart_Decoder IF(FieldIs EqualTo 11 cmd_tot_len) "Decoder Data"
     {
        FIELD gAudioCmd_AOF_STREAM_START_PeakBitrate            (Fixed 4 byte) (Decimal)                              "Peak stream bitrate"
        FIELD gAudioCmd_AOF_STREAM_START_PacketHdrSize          (Fixed 1 byte) (Decimal)                              "Packet Header Size (bytes prior to audio data)"
     }

     FIELD gAudioOffloadAofStreamStart_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                            "This is unparsed data"
}

GROUP gAudioOffloadCmd_AOF_STREAM_STOP "AOF STREAM STOP"
{
     FIELD gAudioCmd_AOF_STREAM_STOP_StreamID                  (Fixed 1 byte) (Hex)                                  "Stream Identifier"
     FIELD gAudioOffloadAofStreamStop_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                            "This is unparsed data"
}

GROUP gAudioOffloadCmd_AOF_INTERNAL_TEST_REQ "AOF Internal Test Request"
{
     FIELD gAudioOffloadAofInternalTestReq_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                        "Test Payload"
}

GROUP gAudioOffloadCmd_AOF_INTERNAL_TEST_REQ_RESP "AOF Internal Test Request Response"
{
     FIELD gAudioOffloadAofInternalTestReqResp_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                    "Echoed test payload"
}


GROUP gAudioOffloadCmd_AOF_INTERNAL_REQ "AOF Internal Request"
{
     FIELD gAudioCmd_AOF_INTERNAL_REQ_StreamID                  (Fixed 1 byte) (Hex)                                  "Stream Identifier"
     FIELD gAudioOffloadAofInternalReq_unparsed (toendoflayer)  IF(MoreBytes) (stringofhex)                           "Internal Payload"
}

GROUP gAudioOffloadCmd_AOF_INTERNAL_REQ_RESP "AOF Internal Request Response"
{
     FIELD gAudioOffloadAofInternalReqResp_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                        "Internal response payload"
}

TABLE tAudioOffloadParameterID
    {0 "2.4 GHz WiFi Enable" "2.4 GHz WiFi Enable" 0 AudioOffloadCmd_Parameter_ID_WiFi_Enable}
    {1 "Max Bitrate"         "Max Bitrate"         0 AudioOffloadCmd_Parameter_ID_MaxBitrate}
ENDTABLE

GROUP gAudioOffloadCmd_AOF_STREAM_SET_PARAM "AOF Stream Set Parameter"
{
     FIELD gAudioCmd_AOF_STREAM_SET_PARAM_StreamID               (Fixed 1 byte) (Hex)                                  "Stream Identifier"
     FIELD gAudioCmd_AOF_STREAM_SET_PARAM_ParameterID            (Fixed 1 byte) (TABLE tAudioOffloadParameterID)       "ParameterID"
     BRANCH (FromTable tAudioOffloadParameterID gAudioCmd_AOF_STREAM_SET_PARAM_ParameterID)
     FIELD gAudioOffloadAofStreamSetParam_unparsed (toendoflayer) IF(MoreBytes) (stringofhex)                          "This is unparsed data"
}

TABLE tAudioOffloadWiFiEnable
    {0 "2.4 GHz WiFi Disabled"}
    {1 "2.4 GHz WiFi Enabled"}
    {Default "Invalid Audio Offload WiFi Enable Status"}
ENDTABLE

GROUP AudioOffloadCmd_Parameter_ID_WiFi_Enable "2.4 GHz WiFi Enable"
{
     FIELD gAudioCmd_AOF_STREAM_SET_PARAM_WiFI_ENABLE            (Fixed 1 byte) (TABLE tAudioOffloadWiFiEnable)        "WiFi Enable"
}

GROUP AudioOffloadCmd_Parameter_ID_MaxBitrate "Max Bitrate"
{
     FIELD gAudioCmd_AOF_STREAM_SET_PARAM_Max_BitRate            (Fixed 4 byte) (Decimal)                              "Max Bitrate (kbps)"
}

/******************************************************************************
 *                          Decoder for OCF 0x1E9                            *
 ******************************************************************************/

GROUP gTruncPageOffloadEvt
{
     FIELD gTruncPageOffloadEvt_status (Fixed 1 byte) (Table tTruncPageOffloadStatus) "Status"
     FIELD gTruncPageOffloadEvt_opcode (Fixed 1 byte) (Table tTruncPageOffloadOpcodes) "SubOpcode"
     FIELD gTruncPageOffloadEvt_unparsed (toendoflayer) IF(MoreBytes) (stringofhex) "This is unparsed data"
}

GROUP gTruncPageOffloadCmpEvt
{
    FIELD gTruncPageOffloadCmpEvt_SubEvent (Fixed 1 byte) (Table tTruncPageOffloadSubevent) ""
    FIELD gTruncPageOffloadCmpEvt_Status   (Fixed 1 Byte) (Table tTruncPageOffloadStatus) "status"
    FIELD gTruncPageOffloadCmpEvt_BDADDR   (toendoflayer) IF(MoreBytes) (hex) "Found device address"
}

TABLE tTruncPageOffloadSubevent
{ 0x01 "Page Offload complete event"}
{ default "unknown"}
ENDTABLE

TABLE tTruncPageOffloadStatus
{ 0x00 "Success"}
{ 0x01 "Error: Unknown HCI Command"}
{ 0x04 "Error: Page time out"}
{ 0x07 "Error: Memory Full"}
{ 0x09 "Error: Maximum number of connections reached"}
{ 0x0B "Error: Connection already exists"}
{ 0x0C "Error: Command Disallowed"}
{ 0x12 "Error: Invalid HCI Parameters" }
{ default "unknown"}
ENDTABLE

/******************************************************************************
 *                          Decoder for VS Event 0xB4                            *
 ******************************************************************************/

GROUP gLinkPowerCtrlCmpEvt
{
    FIELD gLinkPowerCtrlCmpEvt_subOpCode            (Fixed 1 byte)    (TABLE tLinkPowerCtrlOp)     "Sub Opcode"
    FIELD fLinkPowerCtrlCmpEvt_PairCnt              (Fixed 1 Bytes)   (Decimal)       " Number of technologies with restricted power"

    GROUP  gQCA_LinkPowerCtrlCmpEvt_Pairs_Cnt REPEAT COUNT (FromField Times fLinkPowerCtrlCmpEvt_PairCnt)
    {
        GROUP gQCA_LinkPowerCtrlCmpEvt_Pairs " Pair"
        {
            FIELD fLinkPowerCtrlCmpEvt_Tech     (Fixed 1 Bytes)   (Table tLinkPowerCtrlTech)       "Technology: "
            FIELD fLinkPowerCtrlCmpEvt_PIdx     (Fixed 1 Bytes) (Decimal)       "Max allowed Power Level Index"
            FIELD fLinkPowerCtrlCmpEvt_fineBO   (Fixed 1 Bytes) (Decimal)       "Fine backoff applied at max. PL Idx(0.25 dBm unit)"
            FIELD fLinkPowerCtrlCmpEvt_platformMaxPower     (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)       "Max power supported on platform(0.25 dBm unit) for Tech"
        }
    }
}

/******************************************************************************
 *                          Decoder for VS Event 0xD1                            *
 ******************************************************************************/
 
TABLE tTimeSyncEvtEvtType
{ 0x00 "LE Connection Established"}
{ 0x01 "LE PHY Update"}
ENDTABLE
 
GROUP gTimeSyncEvt "LE TimeSync VS Event"
{
	FIELD fTimeSyncEvt_ConnHandle			(Fixed 2 Bytes)	(Hex)						"Connection Handle"
	FIELD fTimeSyncEvt_EvtType				(Fixed 1 Byte)	(TABLE tTimeSyncEvtEvtType)	"Event Type"
	FIELD fTimeSyncEvt_EvtCounter			(Fixed 2 Bytes)	(Hex)						"Connection Event Counter"	
}
