GROUP gQca_LLM_LE_PAST_invalidHandle "Invalid PAST handle"
{
    FIELD fQca_PAST_handleSource 		(Fixed 1 Byte)	(TABLE tQca_PAST_handleSource) "PAST source"
    FIELD fQca_PAST_invalidSyncHandle	(Fixed 1 Byte)	IF (FieldIs EqualTo 1 fQca_PAST_handleSource)	(Hex)	"Sync Handle"
	FIELD fQca_PAST_invalidAdvHandle	(Fixed 1 Byte)	IF (FieldIs EqualTo 2 fQca_PAST_handleSource)	(Hex)	"Adv Handle"
}

GROUP gQca_LLM_PowerControlInfo "Power Control Info"
{
    FIELD fQca_LLM_PowerControlInfoConnHandle       (Fixed 2 Bytes)     (Decimal) "Connection Handle"
    FIELD fQca_LLM_PowerControlInfoSource           (Fixed 1 Byte)      (TABLE tQca_PLChangeSource) "Source of the Power change"
    GROUP gQca_LLM_PowerControlInfoFlags "Power Control Flags"
    {
        RESERVED    (Fixed 4 Bits)
        FIELD fQca_LLM_PowerControlSupport          (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Power Control Support "
        FIELD fQca_LLM_EnhPowerControlSupport       (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Enhanced Power Control Support "
        FIELD fQca_LLM_ConstPowerLevelCheck         (Fixed 1 Bit) (TABLE tQca_Power_Status)     "Constant Power Support"
        FIELD fQca_LLM_LPAPCSupport                 (Fixed 1 Bit) (TABLE tQca_Power_Status)     "LPAPC Support "
    }
    FIELD fQca_LLM_PowerControlInfoMinPL            (Fixed 1 Byte)      (Decimal) "Minimum PL Index"
    FIELD fQca_LLM_PowerControlInfoMaxPL            (Fixed 1 Byte)      (Decimal) "Maximum PL Index"
    FIELD fQca_LLM_PowerControlInfoiPAMaxPL         (Fixed 1 Byte)      (Decimal) "iPA Max PL Index"
    FIELD fQca_LLM_PowerControlInfoCurrTxPL         (Fixed 1 Byte)      (Decimal) "Current Transmit PL"
    FIELD fQca_LLM_PowerControlInfoCurrTxdBm_BR     (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Current BR Transmit Power in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoCurrTxdBm_EDR    (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Current EDR Transmit Power in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoSAR_BR_LimitdBm  (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "BR SAR Limit in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoSAR_EDR_LimitdBm (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "EDR SAR Limit in 0.25 dBm"
    FIELD fQca_LLM_PowerControlInfoAvgRSSIdBm       (Fixed 1 Byte) RETRIEVE (SignExtension 8) (Decimal) "Average RSSI dBm"
}

