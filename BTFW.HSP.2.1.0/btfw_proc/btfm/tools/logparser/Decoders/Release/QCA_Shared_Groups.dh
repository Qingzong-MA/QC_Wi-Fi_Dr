}

TABLE tQca_ScoPktType
    {0x05 "HV1" }
    {0x06 "HV2" }
    {0x07 "HV3" }
    {0x08 "DV" }
    {0x27 "EV3" }
    {0x2C "EV4" }
    {0x2D "EV5" }
    {0x36 "2_EV3" }
    {0x37 "3_EV3" }
    {0x3C "2_EV5" }
    {0x3D "3_EV5" }
    {0xFF "3Q_EV3" }
ENDTABLE

TABLE tQhsPhy
    { 0 "Non-QHS"}
    { 2 "QHS_2M"}
    { 3 "QHS_3M"}
    { 4 "QHS_4M"}
    { 5 "QHS_5M"}
    { 6 "QHS_6M"}
    {default "Invalid"}
ENDTABLE

TABLE tQca_Airformat
    {0x00 "SDB_VOICE_CODING_FORMAT_MULAW"}
    {0x01 "SDB_VOICE_CODING_FORMAT_ALAW"}
    {0x02 "SDB_VOICE_CODING_FORMAT_CVSD"}
    {0x03 "SDB_VOICE_CODING_FORMAT_TRANSPARENT"}
    {0x04 "SDB_VOICE_CODING_FORMAT_LINEAR"}
    {0x05 "SDB_VOICE_CODING_FORMAT_MSBC"}
    {default "Vendor Codec"}
ENDTABLE

GROUP gQca_STAT_ScoConnStats "Synchronous Connection Stats"
{
    FIELD fQca_ScoPiconetClock        (Fixed 4 Bytes) (Hex)                   "PiconetClock"
    FIELD fQca_ScoConnHandle          (Fixed 2 Bytes) (Decimal)               "ConnHandle"
    FIELD fQca_ScoInstanceCnt         (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)               "InstanceCnt"
    FIELD fQca_ScoMissedInstanceCnt   (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)               "MissedInstanceCnt"
    FIELD fQca_ScoTxRetransmitSlotCnt (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)               "TxRetransmitSlotCnt"
    FIELD fQca_ScoRxRetransmitSlotCnt (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal)               "RxRetransmitSlotCnt"
	FIELD fQca_ScoGoodRxFrameCnt      (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) 			  "RxGoodRxFrameCnt"
	Reserved  						  (Fixed 10 Bytes)
	GROUP gQca_qbmIsoStats "QBM Periodic Stats"
	{
	    FIELD fQca_nPktsGood       (Fixed 2 Bytes)       (Decimal)          "Good Pkts"
        FIELD fQca_nPktsCorrected  (Fixed 2 Bytes)       (Decimal)          "Corrected Pkts"
        FIELD fQca_nPktCGood       (Fixed 2 Bytes)       (Decimal)          "Good Pkt C Count"
        FIELD fQca_nPktBad	       (Fixed 2 Bytes)       (Decimal)          "Bad Pkts"
	}
    FIELD fQca_ScoRole                (Fixed 1 Byte)  (Decimal)               "Role"
    FIELD fQca_ScoTesco               (Fixed 1 Byte)  (Decimal)               "Tesco"
    FIELD fQca_ScoWesco               (Fixed 1 Byte)  (Decimal)               "Wesco"
    FIELD fQca_ScoPktType             (Fixed 1 Byte)  (TABLE tQca_ScoPktType) "PktType"
    FIELD fQca_ScoPktLen              (Fixed 2 Bytes) (Decimal)               "Pakcet Length"
    FIELD fQca_qhsPhy                 (Fixed 1 Bytes) (TABLE tQhsPhy)         "QHS Rate"
    FIELD fQca_ScoTxPowerLevel        (Fixed 1 Bytes) (Decimal)               "TxPowerLevel" 
    FIELD fQca_scoStats_avgRSSI       (Fixed 1 Bytes) RETRIEVE (SignExtension 8) (Decimal)               "Avg RSSI in DBM"
    FIELD fQca_scoStats_airCodeFormat (Fixed 1 Bytes) (TABLE tQca_Airformat)               "Air Code Format"
    RESERVED                          (Fixed 2 Bytes)
}