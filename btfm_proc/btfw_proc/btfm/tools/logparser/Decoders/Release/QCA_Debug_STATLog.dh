    FIELD fQca_STAT_AsdStats_tgtLossAckf    (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_tgtLossAckt 16384) (Decimal)   "TgtLossAck(%)"
    FIELD fQca_STAT_AsdStats_tgtLossRssi    (Fixed 2 Bytes) (Decimal)           "Target LossRssi"
    FIELD fQca_STAT_AsdStats_tgtLossRssit   (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_STAT_AsdStats_tgtLossRssi 100)(Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_AsdStats_tgtLossRssif   (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_tgtLossRssit 16384) (Decimal)   "TgtLossRssi(%)"
    FIELD fQca_STAT_AsdStats_weight_ack     (Fixed 2 Bytes) (Decimal)           "weightAck"
    FIELD fQca_STAT_AsdStats_weight_ackt    (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_STAT_AsdStats_weight_ack 100)(Decimal) SUPPRESS_DETAIL
    FIELD fQca_STAT_AsdStats_weight_ackf    (Fixed 0 Byte) RETRIEVE (DivideFieldByInteger fQca_STAT_AsdStats_weight_ackt 16384) (Decimal)   IN_SUMMARY "weightAck(%)" "weightAck(%)"
