GROUP gQca_A2DP_bbBwReport "A2DP baseband bandwidth report"
{
	FIELD fQca_bbBwReport_handle (Fixed 6 Bits) (Decimal) "Handle"
	FIELD fQca_bbBwReport_type (Fixed 1 Bits) (Decimal) SUPPRESS_DETAIL
	FIELD fQca_bbBwReport_dir	(Fixed 1 Bits) (TABLE tA2DPRole) "Report Direction"
	RESERVED (Fixed 1 Bytes)
	FIELD fQca_bbBwReport_empty (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0)    (Decimal) "Empty Slots"
	FIELD fQca_bbBwReport_overall (Fixed 4 Bytes) (Decimal)   "Overall Slots used"
	FIELD fQca_bbBwReport_overallretrans (Fixed 4 Bytes) (Decimal)   "Overall Retrans Slots used"
	FIELD fQca_bbBwReport_slotsUsed  (Fixed 2 Bytes)  (Decimal) "Slots Used this second"
	GROUP gQca_A2DP_bbBwReport_edrStat IF (FieldIs EqualTo 0x00 fQca_bbBwReport_type) "EDR packet statistics"
	{
		FIELD fQca_bbBwReport_edr1Slot	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "2DH1/3DH1 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr2slot	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "2DH3 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr3slot	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "3DH3 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr4slot	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "2DH5 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr5slot	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "3DH5 Counts"
		RESERVED (Fixed 2 Bytes)
	}
	GROUP gQca_A2DP_bbBwReport_QHSStat IF (FieldIs EqualTo 0x01 fQca_bbBwReport_type) "QHS packet statistics"
	{
		FIELD fQca_bbBwReport_qhs2M_s1	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 2M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs2M_s3	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 2M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs3M_s1	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 3M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs3M_s3	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 3M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs4M_s1	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 4M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs4M_s3	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 4M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs5M_s1	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 5M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs5M_s3	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 5M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs6M_s1	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 6M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs6M_s3	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "QHS 6M 3 Slots Counts"
	}
	FIELD fQca_bbBwReport_retrans (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0)    (Decimal) "Retrans Slots"
	GROUP gQca_A2DP_bbBwReport_edrStatRetrans IF (FieldIs EqualTo 0x00 fQca_bbBwReport_type) "EDR Retrans packet statistics"
	{
		FIELD fQca_bbBwReport_edr1SlotRetrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans 2DH1/3DH1 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr2slotRetrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans 2DH3 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr3slotRetrans	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans 3DH3 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr4slotRetrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans 2DH5 Counts"
		RESERVED (Fixed 2 Bytes)
		FIELD fQca_bbBwReport_edr5slotRetrans	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans 3DH5 Counts"
		RESERVED (Fixed 2 Bytes)
	}
	GROUP gQca_A2DP_bbBwReport_QHSStatRetrans IF (FieldIs EqualTo 0x01 fQca_bbBwReport_type) "QHS packet Retrans statistics"
	{
		FIELD fQca_bbBwReport_qhs2M_s1Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 2M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs2M_s3Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 2M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs3M_s1Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 3M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs3M_s3Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 3M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs4M_s1Retrans	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 4M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs4M_s3Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 4M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs5M_s1Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 5M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs5M_s3Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 5M 3 Slots Counts"
		FIELD fQca_bbBwReport_qhs6M_s1Retrans	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 6M 1 Slots Counts"
		FIELD fQca_bbBwReport_qhs6M_s3Retrans	 (Fixed 2 Bytes) PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Retrans QHS 6M 3 Slots Counts"
	}
	GROUP gQca_A2DP_bbBwReport_TxerrorStatus IF (FieldIs EqualTo 0x00 fQca_bbBwReport_dir)
	{
		FIELD fQca_bbBwReport_RfLoss	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "No Ack packets detected"
		FIELD fQca_bbBwReport_Nak	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Nak packets counts"
		FIELD fQca_bbBwReport_txAbort	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Coex Tx abort counts"
		FIELD fQca_bbBwReport_txDenial	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Coex Tx Denial counts"
	}
	GROUP gQca_A2DP_bbBwReport_RxerrorStatus IF (FieldIs EqualTo 0x01 fQca_bbBwReport_dir)
	{
		FIELD fQca_bbBwReport_errNoAec	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Rx No address code decteted Slots"
		FIELD fQca_bbBwReport_errHecBad	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Rx Hec Bad Slots"
		FIELD fQca_bbBwReport_errCrcBad	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Rx Crc bad Slots"
		FIELD fQca_bbBwReport_errPhyError	 (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "Rx Phy error Slots"
	}
	FIELD fQca_bbBwReport_txPwr    (Fixed 1 Bytes) (Decimal)           "Tx Power Level"
