    FIELD fQca_STAT_FromAirDropCnt                  (Fixed 1 Byte)    (Decimal)   "FromAir Drop Count"
    FIELD fQca_STAT_FromAirStuffCnt                 (Fixed 1 Byte)    (Decimal)   "FromAir Stuff Count"
    FIELD fQca_STAT_FromAirFlushCnt                 (Fixed 1 Byte)    (Decimal)   "FromAir Flush Count"
