GROUP gQca_STAT_QC_ISO_UpdateInfo "CIS parameter update"
{
    // Base
    FIELD fQca_IsoType;
    FIELD fQca_STAT_Up_cigId            (Fixed 1 Byte) (Hex)                         "CIG ID"
    FIELD fQca_STAT_Up_cisCount         (Fixed 1 Byte) (Decimal) "CIS Count"
    FIELD fQca_STAT_Up_type             (Fixed 1 Byte) (Table tQC_ISO_UpdateInfoType) "Message Type"

    FIELD fQca_STAT_Up_mask             (Fixed 2 Byte) (Hex) "Mask"

    Reserved                            (Fixed 2 byte)

    GROUP gQca_STAT_Up_Trigger IF (FieldIs EqualTo 1 fQca_STAT_Up_type)
    {
            FIELD gQca_STAT_Up_Trigger_TriggerId    (Fixed 1 Bytes) (Table tQC_ISO_TriggerIdTbl) "Trigger ID"
            FIELD gQca_STAT_Up_Trigger_CurConfigId  (Fixed 1 Bytes) (Hex)          "Current Config ID"
            FIELD gQca_STAT_Up_Trigger_TgtConfigId  (Fixed 1 Bytes) (Hex)          "Target Config ID"
        }

    GROUP gQca_STAT_Up_CalcParam IF (FieldIs EqualTo 2 fQca_STAT_Up_type)
    {
            FIELD gQca_STAT_Up_CalcParam_CigOffset  (Fixed 4 Bytes) RETRIEVE (SignExtension 32) (Decimal) "CIG Offset (us)"

            FIELD gQca_STAT_Up_CalcParam_MinDistance (Fixed 4 Bytes) (Decimal) "min distance (usec)"
            FIELD gQca_STAT_Up_CalcParam_SelDistance (Fixed 4 Bytes) (Decimal) "selected distance (usec)"

            FIELD gQca_STAT_Up_CalcParam_FlushRule  (Fixed 1 Bytes) (Hex) "Flush Rule"
            FIELD gQca_STAT_Up_CalcParam_UpdateCount  (Fixed 1 Bytes) (Hex) "UpdateCount"
        Reserved                                (Fixed 2 byte)

        GROUP gQca_STAT_Up_CalcParam_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID  (Fixed 1 Bytes) (Hex) "CIS ID"
            Reserved                              (Fixed 3 byte)
            FIELD gQca_STAT_Up_CalcParam_CIS_cisInstant     (Fixed 2 Bytes) (Decimal) "CIS Instant"

            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter  (Fixed 2 Bytes) (Decimal) "CIS eventCounter"
            FIELD gQca_STAT_Up_CalcParam_CIS_aclEvtCounter  (Fixed 2 Bytes) (Decimal) "ACL eventCounter"
            FIELD gQca_STAT_Up_CalcParam_CIS_aclInterval    (Fixed 2 Bytes) (Decimal) "ACL Interval (frame)"

            FIELD gQca_STAT_Up_CalcParam_CIS_TxPktCnt     (Fixed 4 Bytes) (Decimal) "CIS Current Tx PayloadCounter"
            FIELD gQca_STAT_Up_CalcParam_CIS_TxPktCntInst     (Fixed 4 Bytes) (Decimal) "CIS Instant Tx PayloadCounter"
            FIELD gQca_STAT_Up_CalcParam_CIS_RxPktCnt     (Fixed 4 Bytes) (Decimal) "CIS Current Rx PayloadCounter"
            FIELD gQca_STAT_Up_CalcParam_CIS_RxPktCntInst     (Fixed 4 Bytes) (Decimal) "CIS Instant Rx PayloadCounter"

            FIELD gQca_STAT_Up_CalcParam_CIS_TxPktEvtCnt     (Fixed 2 Bytes) (Decimal) "CIS TX PayloadCounter Evt Count"
            FIELD gQca_STAT_Up_CalcParam_CIS_RxPktEvtCnt     (Fixed 2 Bytes) (Decimal) "CIS RX PayloadCounter Evt Count"

            FIELD gQca_STAT_Up_CalcParam_CIS_isoalTxSeqn     (Fixed 2 Bytes) (Decimal) "ISOAL TX PDU Seqn"
            FIELD gQca_STAT_Up_CalcParam_CIS_isoalRxSeqn     (Fixed 2 Bytes) (Decimal) "ISOAL RX PDU Seqn"
        }

    }
    GROUP gQca_STAT_Up_TxRxInd IF (FieldIs EqualTo 3 fQca_STAT_Up_type)
    {
        FIELD gQca_STAT_Up_TxRxInd_aclHandle (Fixed 1 Bytes) (Hex) "ACL HCI Handle"
        Reserved                             (Fixed 1 byte)
        FIELD gQca_STAT_Up_TxRxInd_aclEvtCount (Fixed 2 Bytes) (Decimal) "ACL Event Counter"

        GROUP gQca_STAT_Up_TxRxInd_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID;
            Reserved                              (Fixed 1 byte)
            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter;
        }
    }
    GROUP gQca_STAT_Up_RCVD_ACK IF (FieldIs EqualTo 4 fQca_STAT_Up_type)
    {
        FIELD gQca_STAT_Up_TxRxInd_aclHandle;
        Reserved                             (Fixed 1 byte)
        FIELD gQca_STAT_Up_TxRxInd_aclEvtCount;

        GROUP gQca_STAT_Up_RcvdAck_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID;
            Reserved                              (Fixed 1 byte)
            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter;
        }
    }
    GROUP gQca_STAT_Up_SLC_Apply IF (FieldIs EqualTo 5 fQca_STAT_Up_type)
    {
        FIELD gQca_STAT_Up_SLC_Apply_Interval  (Fixed 2 Bytes) (Hex) "ISO Interval"
        Reserved                               (Fixed 2 byte)
        FIELD gQca_STAT_Up_SLC_Apply_Delta     (Fixed 4 Bytes) (Decimal) "Delta of first CIS from CIG anchor (us)"

        GROUP gQca_STAT_Up_SLC_Apply_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID;
            FIELD gQca_STAT_Up_SLC_Apply_CIS_NSE (Fixed 1 Bytes) (Hex) "NSE"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_streamOffset (Fixed 2 Bytes) (Decimal) "Stream Offset"

            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter;
            FIELD gQca_STAT_Up_CalcParam_CIS_cisInstant;

            FIELD gQca_STAT_Up_SLC_Apply_CIS_preTxPktCount (Fixed 4 Bytes) (Decimal) "Pre Tx payload counter"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_newTxPktCount (Fixed 4 Bytes) (Decimal) "New Tx payload counter"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_preRxPktCount (Fixed 4 Bytes) (Decimal) "Pre Rx payload counter"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_newRxPktCount (Fixed 4 Bytes) (Decimal) "New Rx payload counter"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_txBN (Fixed 1 Bytes) (Hex) "Tx BN"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_rxBN (Fixed 1 Bytes) (Hex) "Rx BN"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_txFT (Fixed 1 Bytes) (Hex) "Tx FT"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_rxFT (Fixed 1 Bytes) (Hex) "Rx FT"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_txPL (Fixed 2 Bytes) (Decimal) "Tx PDU Length"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_rxPL (Fixed 2 Bytes) (Decimal) "Rx PDU Length"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_txPHY (Fixed 2 Bytes) (Hex) "Tx PHY"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_rxPHY (Fixed 2 Bytes) (Hex) "Rx PHY"

            FIELD gQca_STAT_Up_SLC_Apply_CIS_streamDelay (Fixed 4 Bytes) (Decimal) "Stream Delay"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_subInteral (Fixed 4 Bytes) (Decimal) "Subevent Interval (us)"
            FIELD gQca_STAT_Up_SLC_Apply_CIS_subDuration (Fixed 4 Bytes) (Decimal) "Subevent Duration(us)"
        }
    }
    GROUP gQca_STAT_Up_Isoal IF (FieldIs EqualTo 6 fQca_STAT_Up_type)
    {
        GROUP gQca_STAT_Up_Isoal_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID;
            Reserved                               (Fixed 1 byte)
            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter;

            FIELD gQca_STAT_Up_CalcParam_CIS_isoalTxSeqn;
            FIELD gQca_STAT_Up_CalcParam_CIS_isoalRxSeqn;

            FIELD gQca_STAT_Up_Isoal_CIS_txPduLen    (Fixed 2 Bytes) (Decimal)    "Tx PDU Len"
            FIELD gQca_STAT_Up_Isoal_CIS_rxPduLen    (Fixed 2 Bytes) (Decimal)    "Rx PDU Len"

            FIELD gQca_STAT_Up_Isoal_CIS_txSduLen    (Fixed 2 Bytes) (Decimal)    "Tx SDU Len"
            FIELD gQca_STAT_Up_Isoal_CIS_rxSduLen    (Fixed 2 Bytes) (Decimal)    "Rx SDU Len"
        }
    }

    GROUP gQca_STAT_Up_Done IF (FieldIs EqualTo 7 fQca_STAT_Up_type)
    {
        GROUP gQca_STAT_Up_Done_CIS  REPEAT COUNT (FromField Times fQca_STAT_Up_cisCount) "CIS info[]"
        {
            FIELD gQca_STAT_Up_CalcParam_CIS_CID;
            Reserved                               (Fixed 1 byte)
            FIELD gQca_STAT_Up_CalcParam_CIS_cisEvtCounter;

            FIELD gQca_STAT_Up_SLC_Apply_CIS_preTxPktCount;
            FIELD gQca_STAT_Up_SLC_Apply_CIS_preRxPktCount;
        }
    }

    Reserved                                     (ToEndOfLayer)
}

