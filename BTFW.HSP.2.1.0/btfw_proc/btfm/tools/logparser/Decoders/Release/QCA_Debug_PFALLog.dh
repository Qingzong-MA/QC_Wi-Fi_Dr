TABLE tQca_LLMLogID APPENDS_ONLY tQca_EnhLogID
    {0x0700 "LOG_ID_PFAL_BUILD_INFO"        "LOG_ID_PFAL_BUILD_INFO"        0   gQca_PFAL_BuildInfo}
    {0x0701 "LOG_ID_PFAL_ASSERT_INFO"       "LOG_ID_PFAL_ASSERT_INFO"       0   }
    {0x0702 "LOG_ID_PFAL_COREDUMP_INFO"     "LOG_ID_PFAL_COREDUMP_INFO"     0   gQca_PFAL_CoreDumpInfo}
    {0x0703 "LOG_ID_PFAL_TRC_TRIG"          "LOG_ID_PFAL_TRC_TRIG"          0   gQca_PFAL_Trc_Trig}
    {0x0704 "LOG_ID_PFAL_TRC_DATA"          "LOG_ID_PFAL_TRC_DATA"          0   gQca_PFAL_Trc_Data}
    {0x0705 "LOG_ID_PFAL_TRC_STOP"          "LOG_ID_PFAL_TRC_STOP"          0   gQca_PFAL_Trc_Stop}

    {0x0708 "LOG_ID_PFAL_SLEEP_DEBUG"       "LOG_ID_PFAL_SLEEP_DEBUG"       0   gQca_PFAL_SleepDebug}
    {0x0709 "LOG_ID_PFAL_UART_DEBUG"        "LOG_ID_PFAL_UART_DEBUG"        0   }
    {0x070A "LOG_ID_PFAL_CPU_BANDWIDTH"     "LOG_ID_PFAL_CPU_BANDWIDTH"     0   gQca_PFAL_CPUBandwidth}
    {0x070B "LOG_ID_PFAL_LOWER_HEAP_STATS"  "LOG_ID_PFAL_LOWER_HEAP_STATS"  0   gQca_PFAL_LowerHeapStats}
    {0x070C "LOG_ID_PFAL_UPPER_HEAP_STATS"  "LOG_ID_PFAL_UPPER_HEAP_STATS"  0   gQca_PFAL_UpperHeapStats}
    {0x070D "LOG_ID_PFAL_STACK_WARN"        "LOG_ID_PFAL_STACK_WARN"        0   gQca_PFAL_StackWarn}

    {0x070F "LOG_ID_PFAL_UART_CTS_ON"       "LOG_ID_PFAL_UART_CTS_ON"       0   }
    {0x0710 "LOG_ID_PFAL_RM_HW_TXDC_CAL_DEBUG"     "LOG_ID_PFAL_RM_HW_TXDC_CAL_DEBUG" 0   gQca_PFAL_RM_HW_TXDC_CAL_DEBUG}

    {0x0713 "LOG_ID_PFAL_TEMP_CHANGE"       "LOG_ID_PFAL_TEMP_CHANGE"       0   gQca_PFAL_TempChange}
    {0x0714 "LOG_ID_PFAL_INIT_CAL_RESULT"   "LOG_ID_PFAL_INIT_CAL_RESULT"   0   gQca_PFAL_InitCalResult}
    {0x0715 "LOG_ID_PFAL_ACI_REG_DUMP"      "LOG_ID_PFAL_ACI_REG_DUMP"      0   gQca_PFAL_AciRegDump}
    {0x0716 "LOG_ID_PFAL_RM_HW_CAL_STATUS"  "LOG_ID_PFAL_RM_HW_CAL_STATUS"  0   gQca_PFAL_CalStatus}
    {0x0717 "LOG_ID_PFAL_RM_TXDC_CAL_RES"   "LOG_ID_PFAL_RM_TXDC_CAL_RES"   0   gQca_PFAL_DCCal_Result}
    {0x0718 "LOG_ID_PFAL_ACI_SINK_CONTEXT_DUMP"     "LOG_ID_PFAL_ACI_SINK_CONTEXT_DUMP" 0   gQca_PFAL_AciSinkContextDump}

    {0x0720 "LOG_ID_PFAL_STATS_A2DP_SRC_MCL" "LOG_ID_PFAL_STATS_A2DP_SRC_MCL" 0 gQca_STAT_A2dpSrcMclPeriodicStats}
	
    {0x0721 "LOG_ID_PFAL_SENSUART_TX_SIG_RETRY_ERR" "LOG_ID_PFAL_SENSUART_TX_SIG_RETRY_ERR"     0   gQca_PFAL_SensUartTxSigRetryErr}
    {0x0722 "LOG_ID_PFAL_SENSUART_RX_SIG_REV_ERR"   "LOG_ID_PFAL_SENSUART_RX_SIG_REV_ERR"       0   gQca_PFAL_SensUartRxSigRevErr}
    {0x0723 "LOG_ID_PFAL_SENSUART_TX_BUF_EXHAUST_ERR" "LOG_ID_PFAL_SENSUART_TX_BUF_EXHAUST_ERR" 0   gQca_PFAL_SensUartTxBufExhanustErr}
    {0x0724 "LOG_ID_PFAL_SENSUART_REPORT_ADVEVT"    "LOG_ID_PFAL_SENSUART_REPORT_ADVEVT"        0   gQca_PFAL_SensUartReportAdvevt}
    {0x0725 "LOG_ID_PFAL_ASD_INFO"                  "LOG_ID_PFAL_ASD_INFO"        0   gQca_PFAL_AsdInfo}
	{0x0726 "LOG_ID_PFAL_RTSC_ACL_CORR_PKT"  "LOG_ID_PFAL_RTSC_ACL_CORR_PKT"            0 gQca_PFAL_Rtsc_AclCorrPktInfo}
    {0x0727 "LOG_ID_PFAL_QBM_PKT_ERR_INFO"   "LOG_ID_PFAL_QBM_PKT_ERR_INFO"             0 gQca_PFAL_Rtsc_EscoPktErrInfo}
    {0x0728 "LOG_ID_PFAL_LE_FATAL_ABORT"     "LOG_ID_PFAL_LE_FATAL_ABORT"               0 gQca_PFAL_LE_FatalAbort}
    {0x0729 "LOG_ID_PFAL_BTC_FATAL_ABORT"    "LOG_ID_PFAL_BTC_FATAL_ABORT"              0 gQca_PFAL_BTC_FatalAbort}
    {0x0730 "LOG_ID_PFAL_RM_RRI_ERR_INFO"    "LOG_ID_PFAL_RM_RRI_ERR_INFO"              0 gQca_PFAL_RM_RRI_ERR}
    {0x0732 "LOG_ID_PFAL_MRC_STATS"          "LOG_ID_PFAL_MRC_STATS"            	0 gQca_PFAL_Rtsc_MrcStats}
    {0x0733 "LOG_ID_PFAL_MEM_POOL_ALLOC_FAIL"    "LOG_ID_PFAL_MEM_POOL_ALLOC_FAIL"        0 gQca_PFAL_MemPoolAllocFail}
    {0x0734 "LOG_ID_PFAL_RM_G3G4_BLOCK_STATISTIC"   "LOG_ID_PFAL_RM_G3G4_BLOCK_STATISTIC" 0   gQca_PFAL_RM_g3g4BlockStatistic}
    {0x07FE "LOG_ID_PFAL_XFEM_REGDUMP"  	"LOG_ID_PFAL_XFEM_REGDUMP"  	0 	gQca_PFAL_xFEM_Regdump}
	
    {0x07FF "PFAL End"}
ENDTABLE

GROUP gQca_PFAL_BuildInfo   "Build Info"
{
    FIELD fQca_BuildInfoLen      (Fixed 1 Byte)   (Hex)            SUPPRESS_DETAIL
    FIELD fQca_BuildInfo         (FromField Bytes fQca_BuildInfoLen)     (StringOfAscii)      "Build Label"
    FIELD fQca_BuildInfoNvm      (ToEndOfLayer)                          (StringOfAscii)      "Build Label in NVM"
}

GROUP gQca_PFAL_xFEM_Regdump "xFEM REGUDMP"
{
    FIELD femReg1            (Fixed 4 Bytes)      (Hex)          "CFG_XFEM_BT"
    FIELD femReg2            (Fixed 4 Bytes)      (Hex)          "CFG_XFEM_CTRL_2G_CH0_0T7"
    FIELD femReg3            (Fixed 4 Bytes)      (Hex)          "CFG_XFEM_CTRL_2G_CH0_8T12"
    FIELD femReg4            (Fixed 4 Bytes)      (Hex)          "CFG_XFEM_CTRL_BT"
}

GROUP gQca_PFAL_CoreDumpInfo    "Core Dump Info"
{
    FIELD fQca_CoreDumpFileName     (Fixed 4 Bytes)             (Hex)  SUPPRESS_DETAIL
    FIELD fQca_CoreDumpLineNo       (Fixed 4 Bytes)             (Decimal)                "Line #"
    FIELD fQca_CoreDumpPCAddr       (Fixed 4 Bytes)             (Hex)                    "PC Addr"
    FIELD fQca_CoreDumpReason       (Fixed 4 Bytes)             (Hex)                    "Reset Reason"
    FIELD fQca_CoreDumpBuildVer     (Fixed 4 Bytes)             (Hex)                    "Build Version"
    FIELD fQca_CoreDumpBuildLbl     (Fixed 4 Bytes)             (Hex)  SUPPRESS_DETAIL
    RESERVED                        (Fixed 4 Bytes)
    FIELD fQca_CoreDumpAssertCnt    (Fixed 2 Bytes)             (Decimal)                "Assert Count"
    RESERVED                        (Fixed 2 Bytes)
}

GROUP gQca_ReservedData
{
	FIELD qQca_ReservedData		(ToEndOfLayer)				(StringOfHex)		"Data"
}

TABLE tQCA_SleepModes

    {0x00 "PFAL_SLEEP_EXIT_SLEEP"       "PFAL_SLEEP_EXIT_SLEEP"         0   }
    {0x01 "PFAL_SLEEP_ENTER_NAP"        "PFAL_SLEEP_ENTER_NAP"          0   }
    {0x02 "PFAL_SLEEP_ENTER_DEEPSLEEP"  "PFAL_SLEEP_ENTER_DEEPSLEEP"    0   }
ENDTABLE

GROUP gQca_PFAL_SleepWakeIrq  IF (FieldIs EqualTo 0x02 fQca_SleepMode) "Sleep Wake IRQ Info"
{
    FIELD fQca_SleepIRQPend     (Fixed 4 Bytes)             (Hex)   "NVIC_IRQ_PEND"
    FIELD fQca_SleepIRQBcstCnt  (Fixed 4 Bytes)             (Hex)   "BCST Count"
    FIELD fQca_SleepIRQWake     (Fixed 2 Bytes)             (Hex)   "WAKE IRQ"
    FIELD fQca_SleepIRQCoex     (Fixed 2 Bytes)             (Hex)   "COEX IRQ"
	FIELD fQca_SleepWakeLvl     (Fixed 2 Bytes)             (Hex)   "WAKE LVL"
    FIELD fQca_SleepIRQBcst     (Fixed 1 Byte)              (Hex)   "BCST IRQ"
    FIELD fQca_SleepIRQCmpr     (Fixed 1 Byte)              (Hex)   "CMPR IRQ"
}

GROUP gQca_PFAL_SleepLcMask   IF (FieldIs EqualTo 0x80000000 fQca_SleepStateFlags) "Sleep LC Int Mask"
{
	FIELD fQca_SleepLcIntMask   (Fixed 4 Bytes)             (Hex)   "LC Interrupt Mask"
}

GROUP gQca_PFAL_WakeVoterMask IF (FieldIs EqualTo 0x04000000 fQca_SleepStateFlags) "Power Manager Wake Voters"
{
    FIELD fQca_WakeVoteMask     (Fixed 4 Bytes)             (Hex)   "Wake Vote Mask"
}

GROUP gQca_PFAL_SleepDebug "Sleep Debug Info"
{
    FIELD fQca_SleepStateFlags  (Fixed 4 Bytes)             (Hex)   "Sleep State Flags"
    FIELD fQca_SleepEnterTs     (Fixed 4 Bytes)             (Hex)   "Sleep Enter Timestamp"
    FIELD fQca_SleepSuccess     (Fixed 4 Bytes)             (Hex)   "Sleep Success Count"
    FIELD fQca_SleepFailure     (Fixed 4 Bytes)             (Hex)   "Sleep Failure Count"
	FIELD fQca_RepeatedFailure  (Fixed 2 Bytes)             (Hex)   "Repeated Failure Count"
    FIELD fQca_SleepMode        (Fixed 1 Bytes)             (Table tQCA_SleepModes)   "Sleep Mode"
    RESERVED                    (Fixed 1 Bytes)
	GROUP gQca_PFAL_SleepWakeIrq;
	GROUP gQca_PFAL_SleepLcMask;
	GROUP gQca_PFAL_WakeVoterMask;
	GROUP gQca_ReservedData;
}

GROUP gQca_PFAL_CPUBandwidth "CPU profiling Info"
{
    FIELD fQca_LCInt0MaxDuty                  (Fixed 4 Bytes)             (Decimal)   "LC Int0 Max Duty Cycle(units of 62.5 ns)"
    FIELD fQca_CPUBandwidth                   (Fixed 1 Byte)              (Decimal)   "CPU Bandwidth Available(Percentage)"
    FIELD fQca_LCInt0Usage                    (Fixed 1 Byte)              (Decimal)   "LC INT0 usage(Percentage)"
    FIELD fQca_DispatchElementOpcodeAtEntryMaxDutyLCInt0    (Fixed 1 Byte)  (TABLE tQca_DispatchOpCode)   "Dispatch Element at Entry of Max Duty LC Int0"
    FIELD fQca_DispatchElementOpcodeAtExitMaxDutyLCInt0     (Fixed 1 Byte)  (TABLE tQca_DispatchOpCode)   "Dispatch Element at Exit of Max Duty LC Int0"
}

GROUP gQca_PFAL_LowerHeapStats "Lower Heap Stats"
{
    FIELD fQca_LowerHeapTop                 (Fixed 4 Bytes)                 (Hex)   "Lower Heap Top"
    FIELD fQca_LowerHeapBottom              (Fixed 4 Bytes)                 (Hex)   "Lower Heap Bottom"
    FIELD fQca_LowerHeapSize                (Fixed 4 Bytes)                 (Hex)   "Lower Heap Size Left"
}

GROUP gQca_PFAL_UpperHeapStats "Upper Heap Stats"
{
    FIELD fQca_UpperHeapSize                (Fixed 4 Bytes)                 (Hex)   "Upper Heap Size Left"
    FIELD fQca_UpperHeapMaxSize             (Fixed 4 Bytes)                 (Hex)   "Upper Heap Max Alloc Size"
    FIELD fQca_UpperHeapPeak                (Fixed 4 Bytes)                 (Hex)   "Upper Heap Peak Usage"
    FIELD fQca_UpperHeapBlocks              (Fixed 4 Bytes)                 (Hex)   "Upper Heap Block Count "

}

GROUP gQca_PFAL_StackWarn "Stack Warn Mask"
{
    FIELD fQca_StackWarnMask                (Fixed 4 Bytes)                 (Hex)   "Stack Warn Mask"
}

TABLE tQca_PFAL_Trc_DataType
    {0 "Tracer"}
    {1 "Event"}
ENDTABLE

TABLE tQca_PFAL_Trc_Timeunit
    {0 "1 cycle"}
    {1 "128 cycles"}
    {2 "128^2 cycles"}
    {3 "128^3 cycles"}
ENDTABLE

TABLE tQca_PFAL_Trc_BlockID
    {0 "SW defined" "SW defined" 0 gQca_Evt_SWdefined}
    {1 "BT island" "BT island" 0 gQca_Evt_Common}
    {2 "BT Core" "BT Core" 0 gQca_Evt_BTCore}
    {3 "Coex" "Coex" 0 gQca_Evt_Common}
ENDTABLE

TABLE tQca_Evt_SWmodID
    {0 "ACL"}
    {1 "HCI"}
    {2 "SW Event"}
    {3 "AON 1P1"}
ENDTABLE

TABLE tQca_Evt_BTCoremodID
    {0 "LC"}
    {1 "MCI"}
    {2 "Modem"}
    {3 "TOP"}
ENDTABLE

TABLE tQca_Evt_LC
    {0 "LC ERROR Event"}
    {1 "LC State Change"}
    {2 "LC TestMux Change"}
    {Default "Undefined Event"}
ENDTABLE

TABLE tQca_Evt_MCI
    {0 "MCI ERROR Event"}
    {1 "MCI_MSG"}
    {2 "MCI_HTM_TX"}
    {3 "MCI_STATUS_CHANGE"}
    {4 "MCI_CL_CPU_INT"}
    {5 "MCI_TMX_CHANGE"}
    {Default "Undefined Event"}
ENDTABLE

TABLE tQca_Evt_Modem
    {0 "Modem ERROR Event"}
    {Default "Undefined Event"}
ENDTABLE

TABLE tQca_Evt_TOP
    {0 "TOP ERROR Event"}
    {Default "Undefined Event"}
ENDTABLE


GROUP  gQca_Evt_Common
{
    FIELD  fQca_Evt_ModuleID   (Fixed 2 Bits)     (Hex)     "Module ID"    NETWORK_DATA_ORDER
    FIELD  fQca_Evt_EvtID        (Fixed 5 Bits)     (Hex)     "Event ID"    NETWORK_DATA_ORDER
    FIELD  fQca_Evt_Data         (Fixed 16 Bits)    (Hex)    "Event Data"    NETWORK_DATA_ORDER
}

GROUP  gQca_Evt_SWdefined
{
    FIELD  fQca_Evt_SWModID   (Fixed 2 Bits)     (TABLE tQca_Evt_SWmodID)    "Module ID"    NETWORK_DATA_ORDER
    FIELD  fQca_Evt_SWEvtID    (Fixed 5 Bits)     (Hex)      "Event ID"       NETWORK_DATA_ORDER
    FIELD  fQca_Evt_SWData     (Fixed 16 Bits)    (Hex)     "Event Data"    NETWORK_DATA_ORDER
}

GROUP  gQca_Evt_BTCore
{
    FIELD  fQca_Evt_BTCoreModID     (Fixed 2 Bits)   (TABLE tQca_Evt_BTCoremodID)    "Module ID"    NETWORK_DATA_ORDER
    FIELD  gQca_Evt_BtCore_LC        (Fixed 5 Bits)    IF(FieldIs EqualTo 0 fQca_Evt_BTCoreModID)     (TABLE tQca_Evt_LC)        "Event ID"    NETWORK_DATA_ORDER
    FIELD  gQca_Evt_BtCore_MCI      (Fixed 5 Bits)    IF(FieldIs EqualTo 1 fQca_Evt_BTCoreModID)     (TABLE tQca_Evt_MCI)      "Event ID"    NETWORK_DATA_ORDER
    FIELD  gQca_Evt_BtCore_Modem  (Fixed 5 Bits)   IF(FieldIs EqualTo 2 fQca_Evt_BTCoreModID)     (TABLE tQca_Evt_Modem)  "Event ID"    NETWORK_DATA_ORDER
    FIELD  gQca_Evt_BtCore_TOP      (Fixed 5 Bits)    IF(FieldIs EqualTo 3 fQca_Evt_BTCoreModID)     (TABLE tQca_Evt_TOP)      "Event ID"    NETWORK_DATA_ORDER
    FIELD  fQca_Evt_BTCoreData       (Fixed 16 Bits)      (Hex)    "Event Data"    NETWORK_DATA_ORDER
}

GROUP gQca_Trc_TrcSampleDetails
{
    FIELD    fQca_Trc_TrcFlag0          (Fixed 1 Bits)      (Hex)      SUPPRESS_DETAIL
    FIELD    fQca_Trc_TrcRawData     (Fixed 16 Bits)    IF(FieldIs EqualTo 0 fQca_Trc_TrcFlag0)    (Hex)   "Tracer Raw Data"    NETWORK_DATA_ORDER
    GROUP  gQca_Trc_TrcTimeStamp  IF(FieldIs EqualTo 1 fQca_Trc_TrcFlag0)
    {
        FIELD    fQca_Trc_TrcFlag1            (Fixed 1 Bits)     (Hex)    SUPPRESS_DETAIL
        FIELD    fQca_Trc_TrcTimeStamp   (Fixed 15 Bits)    IF(FieldIs EqualTo 0 fQca_Trc_TrcFlag1)     (Hex)   "Tracer Time Stamp"   NETWORK_DATA_ORDER
        GROUP  gQca_Trc_TrcDeltaStamp  IF(FieldIs EqualTo 1 fQca_Trc_TrcFlag1)
        {
            FIELD  fQca_Trc_TrcDeltaStamp    (Fixed 11 Bits) (Hex)        "Delta Time Stamp"  NETWORK_DATA_ORDER
            FIELD  fQca_Trc_TrcIndexChange  (Fixed 4 Bits)  (Decimal)  "Bit Change Index"
        }
    }
}

GROUP gQca_PFAL_Trc_Sample
{
    FIELD fQca_Trc_SampleType         (Fixed 1 Bits)          (TABLE tQca_PFAL_Trc_DataType)         "Sample Type"
    RESERVED                          (Fixed 5 Bits)
    GROUP gQca_Trc_SampleDataTrc      IF(FieldIs EqualTo 0 fQca_Trc_SampleType)           "Trace Data"
    {
        GROUP gQca_Trc_TrcSamples    REPEAT SIZE(Fixed 34 Bits)
        {
            GROUP gQca_Trc_TrcSampleDetails;
        }
    }
    GROUP gQca_Trc_SampleDataEvt     IF(FieldIs EqualTo 1 fQca_Trc_SampleType)    "Event Data"
    {
        FIELD  fQca_Evt_Timeunit        (Fixed 2 Bits)       (TABLE tQca_PFAL_Trc_Timeunit)       "Time Unit"        NETWORK_DATA_ORDER
        FIELD  fQca_Evt_Timedelta      (Fixed 7 Bits)       (Hex)         "Time Delta"      NETWORK_DATA_ORDER
        FIELD  fQca_Evt_CoreID          (Fixed 2 Bits)      (TABLE tQca_PFAL_Trc_BlockID)         "Block ID"        NETWORK_DATA_ORDER
        BRANCH (FromTable tQca_PFAL_Trc_BlockID fQca_Evt_CoreID)
    }
}

TABLE tQca_PFAL_Trc_TrigEvent
    {0 "State Idle"}
    {1 "State WFT"}
    {2 "State TS1"}
    {3 "State TS2"}
    {4 "State TS3"}
    {5 "State TS4"}
    {6 "State TS5"}
    {7 "State Wrap Up"}
    {Default "Invalid"}
ENDTABLE

GROUP gQca_PFAL_Trc_Trig   "Tracer Trigger Event"
{
    FIELD fQca_Trc_TrigAddr0         (Fixed 4 Bytes)     (Hex)     "Trigger Sample[0] Address"
    FIELD fQca_Trc_TrigAddr1         (Fixed 4 Bytes)     (Hex)     "Trigger Sample[1] Address"
    FIELD fQca_Trc_TrigAddr2         (Fixed 4 Bytes)     (Hex)     "Trigger Sample[2] Address"
    FIELD fQca_Trc_TrigAddr3         (Fixed 4 Bytes)     (Hex)     "Trigger Sample[3] Address"
    GROUP gQca_PFAL_TrigSamples    REPEAT SIZE(Fixed 20 Bytes)   "Tracer Trigger Samples 0~3"
    {
        GROUP gQca_PFAL_Trc_Sample;
    }
    FIELD fQca_Trc_TrigState         (Fixed 4 Bits)     (TABLE tQca_PFAL_Trc_TrigEvent)     "Trigger State"
    RESERVED                         (Fixed 4 Bits)
}

GROUP gQca_PFAL_Trc_Data   "Tracer Data Event"
{
    FIELD fQca_Trc_PktCntr  (Fixed 0)   RETRIEVE (StoreInteger 0)   (Hex)   SUPPRESS_DETAIL STORE PktCntr
    /* Loop through the end of the frame to capture all the Log Packets in the Frame */
    GROUP gQca_TrcLogPktLoop  REPEAT SIZE (ToEndOfLayer)  "Tracer Samples"
    {
        /* Parse the Packet Header and Data */
        GROUP gQca_PFAL_SampleIndex LABEL(LabelCount "Sample #" PktCntr)
        {
            GROUP gQca_PFAL_Trc_Sample;
        }
        /* Increment the Counter */
        FIELD fQca_TrcPktCntrIncr (Fixed 0) RETRIEVE (StoreField PktCntr) ALSO (AddInteger 1) (Decimal) SUPPRESS_DETAIL STORE PktCntr
    }
}

TABLE tQca_PFAL_Trc_StopReason
    {0 "Wrap Up"}
    {1 "Buffer Full"}
    {2 "Hci Stop Command"}
    {Default "Invalid"}
ENDTABLE

GROUP gQca_PFAL_Trc_Stop   "Tracer Stop Event"
{
    FIELD fQca_Trc_StopReason         (Fixed 1 Bytes)     (TABLE tQca_PFAL_Trc_StopReason)     "Trigger Stop Reason"
}

GROUP gQca_PFAL_RM_RRI_ERR   "RM RRI Error"
{
    FIELD fQCA_FailCount              (Fixed 2 Bytes)     (HEX)     "RRI fail count"
    FIELD fQCA_TriggerId              (Fixed 1 Bytes)     (HEX)     "RRI Trigger Id"
    FIELD fQca_Status                 (Fixed 1 Bytes)     (HEX)     "RRI Error Status"
}

GROUP gQca_PFAL_TempChange "Temperature Change"
{
    FIELD fQca_NewTempIndex     (Fixed 1 Byte)      (Hex)   "New_Temp_Index"
    FIELD fQca_OldTempIndex     (Fixed 1 Byte)      (Hex)   "Old_Temp_Index"
    FIELD fQca_RawTempCode      (Fixed 2 Byte)      (Hex)   "Raw_Temp_Code"
}

GROUP gQca_PFAL_InitCalResult "Init Cal Result"
{
    FIELD fQca_TXDCCalStatus    (Fixed 24 Byte)     (Hex)   "TXDC_Cal_Status"
    FIELD fQca_TXRSB_Cal        (Fixed 6 Byte)      (Hex)   "TX_RSB_Cal"
    FIELD fQca_RXRSB_Cal        (Fixed 4 Byte)      (Hex)   "RX_RSB_Cal"
    FIELD fQca_AGC_Cal          (Fixed 4 Byte)      (Hex)   "AGC_Cal"
}

GROUP gQca_STAT_A2dpSrcMclPeriodicStats "A2DP SRC MCL Periodic Stats"
{
    FIELD fQca_A2dpSrcMclPeriodicAudioFramesRx            (Fixed 4 Bytes)     (Decimal)       "Audio Frames Rx Count"
    FIELD fQca_A2dpSrcMclPeriodicL2capPktsTx              (Fixed 4 Bytes)     (Decimal)       "L2CAP Frames Tx Count"
    FIELD fQca_A2dpSrcMclPeriodicAudioFrameSize           (Fixed 2 Bytes)     (Decimal)       "Audio Frame Size"
    RESERVED                                        (Fixed 2 Bytes)
}

GROUP gQca_PFAL_Rtsc_AclCorrPktInfo "RTSC ACL Corrected Pkt Info"
{
    FIELD gQca_RTSC_pktCorrReport_clkn          (Fixed 4 Bytes)                                    (Decimal)    "CLKN"
    FIELD fQca_RTSC_nConseqErrs                 (Fixed 4 Bytes)                                    (Decimal)    "Consequitive Errs"
    FIELD fQca_RTSC_nCumBitErr0                 (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)    "Cumulative Bit Err0"
    FIELD fQca_RTSC_nCumBitErr1                 (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)    "Cumulative Bit Err1"
    FIELD fQca_RTSC_nCumBitErr2                 (Fixed 4 Bytes) PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)    "Cumulative Bit Err2"
	FIELD gQca_RTSC_pktCorrReport_AveRssi       (Fixed 2 Bytes) RETRIEVE (SignExtension 16)        (Decimal)    "Ave Rssi"
    FIELD gQca_RTSC_pktCorrReport_PayloadLen    (Fixed 2 Bytes)                                    (Decimal)    "Payload Length"
    FIELD gQca_RTSC_pktCorrReport_PacketType    (Fixed 1 Byte)                                     (Decimal)    "Packet Type"
	FIELD gQca_RTSC_pktCorrReport_HciHandle     (Fixed 1 Byte)                                     (Decimal)    "Hci Handle"
}

GROUP gQca_PFAL_Rtsc_EscoPktErrInfo "RTSC eSCO Pkt Err Info"
{
    FIELD fQca_RTSC_bitErrsAxrB                 (Fixed 1 Byte)     (Decimal)                           "Bit Errs among A and B"
    FIELD fQca_RTSC_bitErrsBxrC                 (Fixed 1 Byte)     (Decimal)                           "Bit Errs among B and C"
    FIELD fQca_RTSC_bitErrsAxrC                 (Fixed 1 Byte)     (Decimal)                           "Bit Errs among A and C"
	FIELD fQca_RTSC_bitErrsAxrBxrC              (Fixed 1 Byte)     (Decimal)                           "Bit Errs among A and B and C"
	FIELD fQca_RTSC_clk                         (Fixed 4 Bytes)    (Hex)                               "CLK"
}

GROUP  gQca_PFAL_SensUartTxSigRetryErr "SensUARTTxState"
{
    FIELD gQca_PFAL_SensUartTxState                            (Fixed 1 Byte)   (Hex)   "SensUARTTxState"
}

GROUP  gQca_PFAL_SensUartRxSigRevErr "SensUARTRxErr"
{
    FIELD gQca_PFAL_SensUartRxErrData                          (Fixed 1 Byte)   (Hex)   "SensUARTRxErrData"
}

