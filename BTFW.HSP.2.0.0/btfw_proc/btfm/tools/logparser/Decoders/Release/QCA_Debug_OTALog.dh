	{ 0x15 "LMP_ENCAP_MINOR_TYPE_QLMP_SHADOW_PTT_CHANGED" "LMP_ENCAP_MINOR_TYPE_QLMP_SHADOW_PTT_CHANGED" 0 gQca_QLMP_ShadowPttChanged}	
	{ 0x16 "LMP_ENCAP_MINOR_TYPE_QLMP_SHADOW_SNIFF_CHANGED" "LMP_ENCAP_MINOR_TYPE_QLMP_SHADOW_SNIFF_CHANGED" 0 gQca_QLMP_ShadowSniffChanged}
    { 0x17 "LMP_ENCAP_MINOR_TYPE_QLMP_FREEZE_PICONET" "LMP_ENCAP_MINOR_TYPE_QLMP_FREEZE_PICONET" 0 gQca_QLMP_FreezePiconet}	
