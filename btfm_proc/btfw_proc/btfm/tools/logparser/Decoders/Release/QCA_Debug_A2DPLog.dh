GROUP gQca_VOICE_TRANSPARENT_PRIMER_SM "Voice Transparent Primer SM"
{
    FIELD fQca_VoiceTransparentPrimerSM_PrimerState      (Fixed 2 Bytes)     (TABLE tPrimerState)    "PrimerState"
    FIELD fQca_VoiceTransparentPrimerSM_CheckCount       (Fixed 2 Bytes)     (Decimal)    "Active Check Count"
    FIELD fQca_VoiceTransparentPrimerSM_AciSampleCount   (Fixed 2 Bytes)     (Decimal)    "ACI Sample Count"
    FIELD fQca_VoiceTransparentPrimerSM_AciFrameCount    (Fixed 2 Bytes)     (Decimal)    "ACI Frame Count"
    FIELD fQca_VoiceTransparentPrimerSM_deltaSampleCount (Fixed 2 Bytes)     (Decimal)    "delta Sample Count"
    FIELD fQca_VoiceTransparentPrimerSM_deltaFrameCount  (Fixed 2 Bytes)     (Decimal)    "delta Frame Count"
    FIELD fQca_VoiceTransparentPrimerSM_txOtaCount       (Fixed 2 Bytes)     (Decimal)    "TxFromAirCount"
    FIELD fQca_VoiceTransparentPrimerSM_TxSBCount        (Fixed 2 Bytes)     (Decimal)    "TxSBCount"
    FIELD fQca_VoiceTransparentPrimerSM_txOtaWrong       (Fixed 2 Bytes)     (Decimal)    "TxFromAirWrongCount"
    FIELD fQca_VoiceTransparentPrimerSM_TxSBWrong        (Fixed 2 Bytes)     (Decimal)    "TxSBWrongCount"
    FIELD fQca_VoiceTransparentPrimerSM_otaDrop          (Fixed 2 Bytes)     (Decimal)    "DropFromAirCount"
    FIELD fQca_VoiceTransparentPrimerSM_sbOF        	 (Fixed 2 Bytes)     (Decimal)    "sbOverflow"
    FIELD fQca_VoiceTransparentPrimerSM_expClk           (Fixed 4 Bytes)     (Decimal) "expectedClk"
    FIELD fQca_VoiceTransparentPrimerSM_arrClk           (Fixed 4 Bytes)     (Decimal) "arrivalClk"
    FIELD fQca_VoiceTransparentPrimerSM_DeltaClk         (Fixed 0) IF(FieldIs NotEqualTo 0 fQca_VoiceTransparentPrimerSM_arrClk) RETRIEVE (SubtractFieldMinusField  fQca_VoiceTransparentPrimerSM_expClk fQca_VoiceTransparentPrimerSM_arrClk) ALSO (AndMask 0xFFFFFFF)  (Decimal) "deltaClk"
    FIELD fQca_VoiceTransparentPrimerSM_hdlFrameCount    (Fixed 2 Bytes)     (Decimal)    "handled rxFrame Count"
    FIELD fQca_VoiceTransparentPrimerSM_COPverRx         (Fixed 1 Bytes)     (Decimal)    "sourceCopVer"
    FIELD fQca_VoiceTransparentPrimerSM_COPverTx         (Fixed 1 Bytes)     (Decimal)    "feedbackCopVer"

}


GROUP gQca_VOICE_TRANSPARENT_PRIMER_RETRY "Voice Transparent Primer Retry Info"
{
    FIELD fQca_VoiceTransparentPrimerRetry_Count                (Fixed 2 Bytes)     (Decimal)    "Retry Count"
    FIELD fQca_VoiceTransparentPrimerRetry_AciSampleCount       (Fixed 2 Bytes)     (Decimal)    "ACI Sample Count"
    FIELD fQca_VoiceTransparentPrimerRetry_AciFrameCount        (Fixed 2 Bytes)     (Decimal)    "ACI Frame Count"
    FIELD fQca_VoiceTransparentPrimerRetry_txOtaCount       	(Fixed 2 Bytes)     (Decimal)    "TxFromAirCount"
    FIELD fQca_VoiceTransparentPrimerRetry_TxSBCount        	(Fixed 2 Bytes)     (Decimal)    "TxSBCount"
    FIELD fQca_VoiceTransparentPrimerRetry_txOtaWrong        	(Fixed 2 Bytes)     (Decimal)    "TxFromAirWrongCount"
    FIELD fQca_VoiceTransparentPrimerRetry_TxSBWrong       		(Fixed 2 Bytes)     (Decimal)    "TxSBWrongCount"
    FIELD fQca_VoiceTransparentPrimerRetry_otaDrop        		(Fixed 2 Bytes)     (Decimal)    "DropFromAirCount"
    FIELD fQca_VoiceTransparentPrimerRetry_sbOF      		  	(Fixed 2 Bytes)     (Decimal)    "sbOverflowCount"
    FIELD fQca_VoiceTransparentPrimerRetry_RxCopSyncWordCnt     (Fixed 2 Bytes)     (Decimal)    "ACI RxCopSyncWord Count"
    GROUP fQca_VoiceTransparentPrimerRetry_RxErrStatus "IOPErrStatus"
    {
        RESERVED (Fixed 3 bits)
        FIELD fQca_VoiceTransparentPrimerRetry_RxErrStatus_BIT4_EndMarkerInvalid    (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "EndMarkerInvalid"
        FIELD fQca_VoiceTransparentPrimerRetry_RxErrStatus_BIT3_ZeroLenFrame        (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "ZeroLenFrame"
        FIELD fQca_VoiceTransparentPrimerRetry_RxErrStatus_BIT2_UnsupportedNframes  (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedNframes"
        FIELD fQca_VoiceTransparentPrimerRetry_RxErrStatus_BIT1_UnsupportedVer      (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "UnsupportedVer"
        FIELD fQca_VoiceTransparentPrimerRetry_RxErrStatus_BIT0_Busy                (Fixed 1 bit)  PRINT_IF   (FieldIs NotEqualTo 0) (TABLE t_truefalse)     "Busy"
        RESERVED (Fixed 1 Bytes)
    }
    FIELD fQca_VoiceTransparentPrimerRetry_TxSampleCnt          (Fixed 2 Bytes)      (Decimal)   "ACI TxSample Count"
}

