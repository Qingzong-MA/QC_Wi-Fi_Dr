            FIELD fQca_isoalFreeSduAtStop;
            FIELD fQca_isoalSduFreeAsToUp                   (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As To Up"
            FIELD fQca_isoalErrPdu                          (Fixed 2 Bytes)         (Decimal)                                 "Error PDU"
            FIELD fQca_isoalSduFreeAsErrLLID                (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As Error LLID"
            FIELD fQca_isoalSduFreeAsTooLarge               (Fixed 2 Bytes)         (Decimal)                                 "Free SDU As Too Large"
            FIELD fQca_isoalSduMissFirstSeg                 (Fixed 2 Bytes)         (Decimal)                                 "First Segmentation Miss"
            FIELD fQca_isoalSduMissNonFirstSeg              (Fixed 2 Bytes)         (Decimal)                                 "Non-first Segmentation Miss"
            FIELD fQca_isoalSduMissSync                     (Fixed 2 Bytes)         (Decimal)                                 "SDU Miss Sync"
            FIELD fQca_isoalSduToHost                       (Fixed 2 Bytes)         (Decimal)                                 "Route Count"
            FIELD fQca_isoalSduToHostNoBuf                  (Fixed 2 Bytes)         (Decimal)                                 "Route No Buffer"
            FIELD fQca_isoalSduCheckFail                    (Fixed 2 Bytes)         (Decimal)                                 "SDU Check Fail"
        }
        FIELD fQca_isoalErrCnt1                             (Fixed 2 Bytes)         (Decimal)                                 "Error Count 1"
        FIELD fQca_isoalErrCnt2                             (Fixed 2 Bytes)         (Decimal)                                 "Error Count 2"
