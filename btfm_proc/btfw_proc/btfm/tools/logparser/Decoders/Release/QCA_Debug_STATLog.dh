    FIELD fQca_STAT_ToAirFlushCnt                   (Fixed 1 Byte)    (Decimal)   "ToAir Flush Count"
    FIELD fQca_STAT_ToAirIOPDropCnt                 (Fixed 1 Byte)    (Decimal)   "ToAir IOP Drop Count"
