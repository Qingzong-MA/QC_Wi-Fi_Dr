    <TAG Number="2" Name="Bluetooth Address">
      <DESCRIPTION>6 Byte Bluetooth Device address, as specified in part B, section 13.1 of the Bluetooth Core Specification.   MSB in byte 5.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="BD Address" Type="FIXED_ARRAY" ElementSize="1" Size="6" Min="0x0" Max="0xFF" Signed="false" Description="BD Address Byte (Default: 0x0 0d)" VariableName="Byte">
        <ELEMENTS Name="Byte_0" Default="0xAD" Description="BD Address Byte 0  (Default: 0xAD 173d)" />
        <ELEMENTS Name="Byte_1" Default="0x5A" Description="BD Address Byte1 (Default: 0x5A 90d)" />
        <ELEMENTS Name="Byte_2" Default="0x0" Description="BD Address Byte2 (Default: 0x0 0d)" />
        <ELEMENTS Name="Byte_3" Default="0x0" Description="BD Address Byte3 (Default: 0x0 0d)" />
        <ELEMENTS Name="Byte_4" Default="0x0" Description="BD Address Byte4 (Default: 0x0 0d)" />
        <ELEMENTS Name="Byte_5" Default="0x0" Description="BD Address Byte5 (Default: 0x0 0d)" />
      </ELEMENTS>
    </TAG>
    <TAG Number="6" Name="Bluetooth Supported Features Mask">
      <DESCRIPTION>The format of the BT Supported Features is defined in the BT4.0 specification.  The BTT_SUPPORTED_FEATURES_MASK is applied to the BT Supported Features such that a "0" bit forces the software to never support the given feature, while a "1" bit allows the software to support a given feature if the software is built with the required support.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Supported Features Mask" Type="STRUCTURE" Size="8">
        <ELEMENTS Name="Byte0" Type="BITFIELD" Size="1">
          <ELEMENTS Name="3-slot packets" Default="0x1" Start="0" End="0" Description="Bit0: 3-slot packets" />
          <ELEMENTS Name="5-Slot packets" Default="0x1" Start="1" End="1" Description="Bit1: 5-Slot packets" />
          <ELEMENTS Name="Encryption" Default="0x1" Start="2" End="2" Description="Bit2: Encryption" />
          <ELEMENTS Name="Slot Offset" Default="0x1" Start="3" End="3" Description="Bit3: Slot Offset" />
          <ELEMENTS Name="Timing Accuracy" Default="0x1" Start="4" End="4" Description="Bit4: Timing Accuracy" />
          <ELEMENTS Name="Switch" Default="0x1" Start="5" End="5" Description="Bit5: Switch" />
          <ELEMENTS Name="Hold Mode" Default="0x1" Start="6" End="6" Description="Bit6: Hold Mode" />
          <ELEMENTS Name="Sniff Mode" Default="0x1" Start="7" End="7" Description="Bit7: Sniff Mode" />
        </ELEMENTS>
        <ELEMENTS Name="Byte1" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Park Mode" Default="0x0" Start="0" End="0" Description="Bit0: Park Mode" />
          <ELEMENTS Name="RSSI" Default="0x1" Start="1" End="1" Description="Bit1: RSSI" />
          <ELEMENTS Name="CQDDR" Default="0x1" Start="2" End="2" Description="Bit2: Channel Quality Driven Data Rate" />
          <ELEMENTS Name="SCO Link" Default="0x1" Start="3" End="3" Description="Bit3: SCO Link" />
          <ELEMENTS Name="HV2 Packets" Default="0x1" Start="4" End="4" Description="Bit4: HV2 Packets" />
          <ELEMENTS Name="HV3 Packets" Default="0x1" Start="5" End="5" Description="Bit5: HV3 Packets" />
          <ELEMENTS Name="u-Law log" Default="0x1" Start="6" End="6" Description="Bit6: u-Law log" />
          <ELEMENTS Name="A-Law log" Default="0x1" Start="7" End="7" Description="Bit7: A-Law log" />
        </ELEMENTS>
        <ELEMENTS Name="Byte2" Type="BITFIELD" Size="1">
          <ELEMENTS Name="CVSD synchronous data" Default="0x1" Start="0" End="0" Description="Bit0: CVSD synchronous data" />
          <ELEMENTS Name="Paging parameter negotiation" Default="0x1" Start="1" End="1" Description="Bit1: Paging parameter negotiation" />
          <ELEMENTS Name="Power Control" Default="0x1" Start="2" End="2" Description="Bit2: Power Control" />
          <ELEMENTS Name="Transperant SCO Data" Default="0x1" Start="3" End="3" Description="Bit3: Transperant SCO Data" />
          <ELEMENTS Name="Flow Control Lag" Default="0x0" Start="4" End="6" Description="Bit4_6: 3 Bits representing the Flow Control Lag" />
          <ELEMENTS Name="Broadcast Encryption" Default="0x1" Start="7" End="7" Description="Bit7: Broadcast Encryption" />
        </ELEMENTS>
        <ELEMENTS Name="Byte3" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Reserved" Default="0x0" Start="0" End="0" Description="Bit 0 : Reserved" />
          <ELEMENTS Name="EDR ACL DQPSK mode" Default="0x1" Start="1" End="1" Description="Bit1: EDR ACL DQPSK mode" />
          <ELEMENTS Name="EDR ACL 8 DPSK mode" Default="0x1" Start="2" End="2" Description="Bit2: EDR ACL 8 DPSK mode" />
          <ELEMENTS Name="Enhanced inquiry scan" Default="0x1" Start="3" End="3" Description="Bit3: Enhanced inquiry scan" />
          <ELEMENTS Name="Interlaced inquiry scan" Default="0x1" Start="4" End="4" Description="Bit4: Interlaced inquiry scan" />
          <ELEMENTS Name="Interlaced page scan" Default="0x1" Start="5" End="5" Description="Bit5: Interlaced page scan" />
          <ELEMENTS Name="RSSI with inquiry results" Default="0x1" Start="6" End="6" Description="Bit6: RSSI with inquiry results" />
          <ELEMENTS Name="ESCO EV3 packets" Default="0x1" Start="7" End="7" Description="Bit7: Extended SCO link (EV3 packets)" />
        </ELEMENTS>
        <ELEMENTS Name="Byte4" Type="BITFIELD" Size="1">
          <ELEMENTS Name="EV4 packets" Default="0x0" Start="0" End="0" Description="Bit0: EV4 packets" />
          <ELEMENTS Name="EV5 packets" Default="0x0" Start="1" End="1" Description="Bit1: EV5 packets" />
          <ELEMENTS Name="Reserved" Default="0x0" Start="2" End="2" Description="Bit2: Reserved" />
          <ELEMENTS Name="AFH capable slave" Default="0x1" Start="3" End="3" Description="Bit3: AFH capable slave" />
          <ELEMENTS Name="AFH classification slave" Default="0x1" Start="4" End="4" Description="Bit4: AFH classification slave" />
          <ELEMENTS Name="BREDR Not Supported" Default="0x0" Start="5" End="5" Description="Bit5: BR/EDR Not Supported" />
          <ELEMENTS Name="LE Supported" Default="0x1" Start="6" End="6" Description="Bit6: LE Supported" />
          <ELEMENTS Name="EDR ACL 3 slot" Default="0x1" Start="7" End="7" Description="Bit7: EDR ACL 3 slot" />
        </ELEMENTS>
        <ELEMENTS Name="Byte5" Type="BITFIELD" Size="1">
          <ELEMENTS Name="EDR ACL 5 slot" Default="0x1" Start="0" End="0" Description="Bit0: EDR ACL 5 slot" />
          <ELEMENTS Name="Sniff Subrating" Default="0x1" Start="1" End="1" Description="Bit1: Sniff Subrating capable" />
          <ELEMENTS Name="Pause Encryption" Default="0x1" Start="2" End="2" Description="Bit 2: Encryption Pause Resume Feature Supported" />
          <ELEMENTS Name="AFH capable master" Default="0x1" Start="3" End="3" Description="Bit3: AFH capable master" />
          <ELEMENTS Name="AFH classification master" Default="0x1" Start="4" End="4" Description="Bit4: AFH classification master" />
          <ELEMENTS Name="EDR eSCO DQPSM mode" Default="0x1" Start="5" End="5" Description="Bit5: EDR eSCO DQPSM mode" />
          <ELEMENTS Name="EDR eSCO 8 DPSK mode" Default="0x0" Start="6" End="6" Description="Bit6: EDR eSCO 8 DPSK mode" />
          <ELEMENTS Name="EDR eSCO 3 slot" Default="0x0" Start="7" End="7" Description="Bit7: EDR eSCO 3 slot" />
        </ELEMENTS>
        <ELEMENTS Name="Byte6" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Extended Inquiry Response" Default="0x1" Start="0" End="0" Description="Bit0: Extended Inquiry Response" />
          <ELEMENTS Name="Simultaneous LE and BREDR" Default="0x1" Start="1" End="1" Description="Bit1: Simultaneous LE and BR/EDR Capable (Controller)" />
          <ELEMENTS Name="Reserved0" Default="0x0" Start="2" End="2" Description="Bit2 : Reserved" />
          <ELEMENTS Name="Simple Pairing" Default="0x1" Start="3" End="3" Description="Bit3:Simple Pairing" />
          <ELEMENTS Name="Encapsulated PDU" Default="0x1" Start="4" End="4" Description="Bit4: Encapsulated PDU" />
          <ELEMENTS Name="Erroneous Data" Default="0x0" Start="5" End="5" Description="Bit5: Erroneous Data" />
          <ELEMENTS Name="QOS PBF" Default="0x1" Start="6" End="6" Description="Bit6:QOS Packet Boundary Flag" />
          <ELEMENTS Name="Reserved1" Default="0x0" Start="7" End="7" Description="Bit7: Reserved" />
        </ELEMENTS>
        <ELEMENTS Name="Byte7" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Link Supervision Timeout Changed Event" Default="0x1" Start="0" End="0" Description="Bit0: Link Supervision Timeout Changed Event" />
          <ELEMENTS Name="Inquiry Tx Power Level" Default="0x1" Start="1" End="1" Description="" />
          <ELEMENTS Name="Enhanced Power Control" Default="0x1" Start="2" End="2" Description="Bit2: Enhanced Power Control feature" />
          <ELEMENTS Name="Bluetooth_Supported_Features_Mask_Reserved_3" Default="0x0" Start="3" End="3" Description="Reserved" />
          <ELEMENTS Name="Bluetooth_Supported_Features_Mask_Reserved_4" Default="0x0" Start="4" End="4" Description="Reserved" />
          <ELEMENTS Name="Bluetooth_Supported_Features_Mask_Reserved_5" Default="0x0" Start="5" End="5" Description="Reserved" />
          <ELEMENTS Name="Bluetooth_Supported_Features_Mask_Reserved_6" Default="0x0" Start="6" End="6" Description="Reserved" />
          <ELEMENTS Name="Extended features" Default="0x1" Start="7" End="7" Description="Bit7: Extended features" />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="8" Name="Extended feature mask Page 2">
      <DESCRIPTION>Mask for Bluetooth spec defined extended feature list-Page 2.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="BT" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Extended Feature Mask Page 2" Type="STRUCTURE" Size="8">
