GROUP gQca_LLM_AfhActionInfo "AFH Action Info"
{
    FIELD gQca_LLM_AfhActionInfoConnHandle          (Fixed 2 Bytes)   (Hex)                     "Connection Handle"
    FIELD gQca_LLM_AfhActionInfoState               (Fixed 1 Bytes)   (TABLE tQca_AFH_State)    "State"
    FIELD gQca_LLM_AfhActionInfoCurrMode            (Fixed 1 Bytes)   (TABLE tQca_AFH_Mode)     "currMode"
    FIELD gQca_LLM_AfhActionInfoNewMode             (Fixed 1 Bytes)   (TABLE tQca_AFH_Mode)     "newMode"
    FIELD gQca_LLM_AfhActionInfoAction              (Fixed 1 Bytes)   (TABLE tQca_AFH_Action)   "Action"
    FIELD gQca_LLM_AfhActionInfoPendingAction       (Fixed 1 Bytes)   (TABLE tQca_AFH_Action)   "Pending Action"
}

GROUP gQca_LLM_LepCtrlInfo "LE PWR CTRL Info"
{
    FIELD gQca_LLM_LepCtrlInfoConnHandle          (Fixed 2 Bytes)   (Hex)                                                "Connection Handle"
    FIELD gQca_LLM_LepCtrlInfolepCtrlPdu          (Fixed 1 Bytes)   (TABLE tQca_LEP_Pdu)                                 "lepCtrlPdu"
    FIELD gQca_LLM_LepCtrlInfophyrate             (Fixed 1 Bytes)   (TABLE tQca_LE_PhyRate)                              "PDU phyrate"
    FIELD gQca_LLM_LepCtrlInfoPduLimits           (Fixed 1 Bytes)   (TABLE tQca_Limits)                                  "PDU limits"
    FIELD gQca_LLM_LepCtrlInfoPduDelta            (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "PDU delta"
    GROUP gQca_LLM_LepCtrlInfopwrCtrlStatus "pwrCtrlStatus"    
    {
        reserved (fixed 1 bits)
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_POWER_ISO_TX_MANANGED            (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "POWER_ISO_TX_MANANGED"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_REMOTE_UNMANANGED                (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "REMOTE_UNMANANGED"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_NO_DELTA_RESPONSE                (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "NO_DELTA_RESPONSE"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_POWER_IND_NEEDED                 (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "POWER_IND_NEEDED"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_REMOTE_POWER_REPORTING_STATUS    (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "REMOTE_POWER_REPORTING_STATUS"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_REMOTE_MIN_POWER                 (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "REMOTE_MIN_POWER"
        FIELD gQca_LLM_LepCtrlInfopwrCtrlStatus_REMOTE_MAX_POWER                 (Fixed 1 bits)    PRINT_IF (FieldIs NotEqualTo 0) (Decimal) "REMOTE_MAX_POWER"
    }
    FIELD gQca_LLM_LepCtrlInfoavgLeRssiDbm        (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "avgLeRssiDbm"
    FIELD gQca_LLM_LepCtrlInfoavgLeRssiDdmAcc     (Fixed 2 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "avgLeRssiDdmAcc"
    FIELD gQca_LLM_LepCtrlInfotransmitPowerLevel  (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "transmitPowerLevel"
    FIELD gQca_LLM_LepCtrlInfotransmitPowerdBm    (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "transmitPowerdBm"
    FIELD gQca_LLM_LepCtrlInforemoteTxPwrDbm      (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "remoteTxPwrDbm"
    FIELD gQca_LLM_LepCtrlInfolocalPwrReq         (Fixed 1 Bytes)   (TABLE tQca_localPwrReq)                             "localPwrReq"
    FIELD gQca_LLM_LepCtrlInfodelta               (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "delta"
    FIELD gQca_LLM_LepCtrlInfodeltaPwrReq         (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "deltaPwrReq"
    FIELD gQca_LLM_LepCtrlInfoapr                 (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "apr"
    FIELD gQca_LLM_LepCtrlInfotxPowerUpCnt        (Fixed 1 Bytes)   (Hex)                                                "txPowerUpCnt"
    FIELD gQca_LLM_LepCtrlInfotxPowerDownCnt      (Fixed 1 Bytes)   (Hex)                                                "txPowerDownCnt"
    FIELD gQca_LLM_orgPwrIdx                      (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "orgPwrIdx"
    FIELD gQca_LLM_reqPwrIdx                      (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "reqPwrIdx"
    FIELD gQca_LLM_LepCtrlInfogrUlLimit           (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "grUlLimit"
    FIELD gQca_LLM_LepCtrlInfogrLlLimit           (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "grLlLimit"
    FIELD gQca_LLM_LepCtrlInfogrLLMargin          (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "grLLMargin"
    FIELD gQca_LLM_LepCtrlInfogrULMargin          (Fixed 1 Bytes)   RETRIEVE (SignExtension 8) (Decimal)                 "grULMargin"
}

