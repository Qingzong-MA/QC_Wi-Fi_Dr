	{ 0x1d "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_LL_STATE" "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_LL_STATE" 0 gQca_QLMP_HandoverLLState}
	{ 0x1e "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_CHANGE_BD_ADDR_REQ" "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_CHANGE_BD_ADDR_REQ" 0 gQca_QLMP_HandoverChangeBDAddrReq}
	{ 0x1f "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_PEER_BD_ADDR_CHANGED" "LMP_ENCAP_MINOR_TYPE_QLMP_HANDOVER_PEER_BD_ADDR_CHANGED" 0 gQca_QLMP_HandoverPeerBdAddrChanged}
