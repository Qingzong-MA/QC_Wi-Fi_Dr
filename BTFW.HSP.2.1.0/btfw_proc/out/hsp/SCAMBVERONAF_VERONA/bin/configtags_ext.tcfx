    <TAG Number="36" Name="External Power Configuration">
      <DESCRIPTION>These parameters control the TX output power control.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="External Power Configuration" Type="STRUCTURE" Size="52">
        <ELEMENTS Name="Power Level Enable Mask" Type="BITFIELD" Size="2">
          <ELEMENTS Name="Level0" Default="0x1" Start="0" End="0" Description="" />
          <ELEMENTS Name="Level1" Default="0x1" Start="1" End="1" Description="" />
          <ELEMENTS Name="Level2" Default="0x1" Start="2" End="2" Description="" />
          <ELEMENTS Name="Level3" Default="0x1" Start="3" End="3" Description="" />
          <ELEMENTS Name="Level4" Default="0x1" Start="4" End="4" Description="" />
          <ELEMENTS Name="Level5" Default="0x1" Start="5" End="5" Description="" />
          <ELEMENTS Name="Level6" Default="0x1" Start="6" End="6" Description="" />
          <ELEMENTS Name="Level7" Default="0x1" Start="7" End="7" Description="" />
          <ELEMENTS Name="Level8" Default="0x1" Start="8" End="8" Description="" />
          <ELEMENTS Name="Level9" Default="0x1" Start="9" End="9" Description="" />
          <ELEMENTS Name="Level_10" Default="0x1" Start="10" End="10" Description="" />
          <ELEMENTS Name="Level_11" Default="0x1" Start="11" End="11" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="Negative PL Enable Mask" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Neg_1" Default="0x1" Start="0" End="0" Description="" />
          <ELEMENTS Name="Neg_2" Default="0x1" Start="1" End="1" Description="" />
          <ELEMENTS Name="Neg_3" Default="0x1" Start="2" End="2" Description="" />
          <ELEMENTS Name="Neg_4" Default="0x1" Start="3" End="3" Description="" />
        </ELEMENTS>
        <ELEMENTS Name="Starting Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x7" Signed="false" Description="" />
        <ELEMENTS Name="GFSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="" />
        <ELEMENTS Name="DQPSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="This value is used to report the DQPSK Max Power Status." />
        <ELEMENTS Name="8DPSK Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0xB" Signed="false" Description="This value is used to report the 8DPSK Max Power Status." />
        <ELEMENTS Name="DQPSK Min Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x0" Signed="false" Description="This value is used to report the DQPSK Min Power Status." />
        <ELEMENTS Name="8DPSK Min Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x0" Signed="false" Description="This value is used to report the 8DPSK Min Power Status." />
        <ELEMENTS Name="Broadcast Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x9" Signed="false" Description="" />
        <ELEMENTS Name="Class 2 Fallback Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x9" Signed="false" Description="" />
        <ELEMENTS Name="Power Class" Type="ENUM" Size="1" Default="0x4" Signed="false">
          <ELEMENTS Name="Class_1" Default="0x1" Description="Power Class 1" />
          <ELEMENTS Name="Class_2" Default="0x2" Description="Power Class 2" />
          <ELEMENTS Name="Class_3" Default="0x3" Description="Power Class 3" />
          <ELEMENTS Name="Class_1_5" Default="0x4" Description="Power Class 1.5" />
        </ELEMENTS>
        <ELEMENTS Name="Platform Power Fine Adjust" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="This value is used for fine adjusting POUT for BR[3:0] and EDR[7:4]. Step size is selected between 1db and 0.25db in the Flags BIT5." />
        <ELEMENTS Name="Platform Power Fine Adjust BLE" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="his value is used for fine adjusting POUT for BLE[3:0] and HS[7:4]. Step size is selected between 1db and 0.25db in the Flags BIT5." />
        <ELEMENTS Name="Flags" Type="BITFIELD" Size="1">
          <ELEMENTS Name="LimitMaxPowerNonAFHTestMode" Default="0x0" Start="0" End="0" Description="value '1' of the bit will ensure that maximum power level for remote nonAFH device is SDB_PWR_INDEX_MAX_NO_AFH in DUT" />
          <ELEMENTS Name="BIT1_RESERVED" Default="0x0" Start="1" End="1" Description="not used in this project" />
          <ELEMENTS Name="CLASS_2_FALLBACK_DYNAMIC_POWER_CONTROL" Default="0x1" Start="2" End="2" Description="If Remote doesn't support power control feature, then DUT's power level can be controlled based on remote avgRSSI value" />
          <ELEMENTS Name="FEM override enable" Default="0x0" Start="3" End="3" Description="Enable FEM overrides 0 1 2 and 3" />
          <ELEMENTS Name="PLATFORM FINE POWER ADJUST STEP SELECT" Default="0x0" Start="5" End="5" Description="Select between 1db and 0.25db steps for platform power fine adjust. 1 = 0.25db, 0 = 1db." />
          <ELEMENTS Name="XPA WLPA Select" Default="0x0" Start="6" End="6" Description="selects either xPA or wl pa. 0 : XPA. 1 : WLPA." />
          <ELEMENTS Name="PowerLimitedCH1" Default="0x0" Start="7" End="7" Description="In HP01, CH1 Tx power max is PL9. This flag will indicate the platform is power limited CH1." />
        </ELEMENTS>
        <ELEMENTS Name="Non AFH Max Power Level" Type="INTEGER" Size="1" Min="0x0" Max="0xB" Default="0x8" Signed="false" Description="For non-AFH device, maximum allowed power level. This should not be more than Max. AFH Power Level. 0 means no specific restriction for  non-AFH. For ETSI compliant, this value should be 8." />
        <ELEMENTS Name="CH0 FEM overrides" Type="FIXED_ARRAY" ElementSize="4" Size="16" Min="0x0" Max="0xFFFFFFFF" Signed="false" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH0" VariableName="FEM">
          <ELEMENTS Name="FEM_0" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH0" />
          <ELEMENTS Name="FEM_1" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH0" />
          <ELEMENTS Name="FEM_2" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH0" />
          <ELEMENTS Name="FEM_3" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH0" />
        </ELEMENTS>
        <ELEMENTS Name="CH1 FEM overrides" Type="FIXED_ARRAY" ElementSize="4" Size="16" Min="0x0" Max="0xFFFFFFFF" Signed="false" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH1" VariableName="FEM">
          <ELEMENTS Name="FEM_0" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH1" />
          <ELEMENTS Name="FEM_1" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH1" />
          <ELEMENTS Name="FEM_2" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH1" />
          <ELEMENTS Name="FEM_3" Default="0x0" Description="Writes to RFA_CMN_REG_AON_XFEM_CFG_XFEM_CTRL_2G_CH1" />
        </ELEMENTS>
        <ELEMENTS Name="RF Power Adjust" Type="INTEGER" Size="1" Min="0x0" Max="0x8" Default="0x0" Signed="false" Description="This value is used for fine adjusting POUT in RF, for all modulations and power levels. The step size is nominally 0.25dB, and the maximum adjust is 2dB. For example, setting the value 4 attempts to adjust POUT down by 1dB. This adjustment accuracy is approximate." />
        <ELEMENTS Name="Reserved1" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved2" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
        <ELEMENTS Name="Reserved3" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x0" Signed="false" Description="Padding bytes for alignment" />
      </ELEMENTS>
    </TAG>
    <TAG Number="39" Name="Tx Power Level Mapping">
      <DESCRIPTION>This Tag contains the Tx Power level to dBM values in Step Size 0.25dBm which are used for calculations like Average Step size and other SAR related validations. These values are depend on the platform</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Tx Power Level Mapping" Type="STRUCTURE" Size="60">
        <ELEMENTS Name="Coarse Power Table" Type="FIXED_ARRAY" ElementSize="1" Size="12" Min="0x80" Max="0x7F" Signed="true" Description="Coarse power for each power level. Unit is dbm" VariableName="Coarse Power PL">
          <ELEMENTS Name="Coarse Power PL0" Default="0xE2" Description="Coarse power at power level 0. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL1" Default="0xE6" Description="Coarse power at power level 1. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL2" Default="0xEB" Description="Coarse power at power level 2. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL3" Default="0xF0" Description="Coarse power at power level 3. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL4" Default="0xF5" Description="Coarse power at power level 4. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL5" Default="0xFA" Description="Coarse power at power level 5. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL6" Default="0xFF" Description="Coarse power at power level 6. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL7" Default="0x4" Description="Coarse power at power level 7. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL8" Default="0x9" Description="Coarse power at power level 8. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL9" Default="0xE" Description="Coarse power at power level 9. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL10" Default="0x14" Description="Coarse power at power level 10. Unit is dbm" />
          <ELEMENTS Name="Coarse Power PL11" Default="0x19" Description="Coarse power at each power level 11. Unit is dbm" />
        </ELEMENTS>
        <ELEMENTS Name="Fine Power Adjust Per Packet Type" Type="STRUCT_ARRAY" Size="48" VariableName="Fine Power Adjust">
          <ELEMENTS Name="BR Packet" Type="STRUCTURE" Size="12">
            <ELEMENTS Name="Fine Power Adjust PL0" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0x0" Signed="true" Description="Fine Power Adjust for PL0.Unit is 0.25dbm. It is the difference between the observed max transmit power and coarse power at power level 0.  Fine Power Adjust PL0 = Actual Power PL0 - 4 * Coarse Power PL0." />
            <ELEMENTS Name="Fine Power Adjust PL1" Type="INTEGER" Size="1" Min="0x80" Max="0x7F" Default="0x0" Signed="true" Description="Fine Power Adjust for PL1.Unit is 0.25dbm. It is the difference between the observed max transmit power and coarse power at power level 1.  Fine Power Adjust PL1 = Actual Power PL1 - 4 * Coarse Power PL1." />
