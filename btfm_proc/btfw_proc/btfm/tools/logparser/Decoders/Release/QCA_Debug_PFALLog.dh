			FIELD fQca_PFAL_UpperHeapSCOConnPoolMem					(Fixed 4 Bytes)	(Decimal)	"SCO Connection Pool Memory Consumed"
			FIELD fQca_PFAL_UpperHeapPiconetPoolMem					(Fixed 4 Bytes)	(Decimal)	"Piconet Pool Memory Consumed"
			FIELD fQca_PFAL_UpperHeapDbgLogPoolsMem					(Fixed 4 Bytes)	(Decimal)	"Debug Log Pools Memory Consumed"
		}
		
		GROUP gQca_PFAL_UpperHeapGenericPoolMem "Generic Pools Stats"
		{
			FIELD fQca_PFAL_UpperHeapGenericPoolTotalMem			(Fixed 4 Bytes)	(Decimal)	"Total Generic Pool Memory Consumed"
			FIELD fQca_PFAL_UpperHeapAdvMem							(Fixed 4 Bytes)	(Decimal)	"Adv Data Memory Consumed"
			FIELD fQca_PFAL_UpperHeapAPCFMem						(Fixed 4 Bytes)	(Decimal)	"APCF Memory Consumed"
			FIELD fQca_PFAL_UpperHeapLEDevListMem					(Fixed 4 Bytes)	(Decimal)	"LE Device Lists Memory Consumed"
			FIELD fQca_PFAL_UpperHeapLEISOStreamMem					(Fixed 4 Bytes)	(Decimal)	"LE ISO Stream Memory Consumed"	
		}
		
		GROUP gQca_PFAL_UpperHeapDirectAllocMem "Direct Memory Allocation Stats"
		{
			FIELD fQca_PFAL_UpperHeapBatchScanMem					(Fixed 2 Bytes)	(Decimal)	"LE Batch Scan Memory Consumed"
			FIELD fQca_PFAL_UpperHeapAdvInstancesMem				(Fixed 2 Bytes)	(Decimal)	"Adv Instances Memory Consumed"
			FIELD fQca_PFAL_UpperHeapADVMMem						(Fixed 2 Bytes)	(Decimal)	"ADVM Memory Consumed"
			FIELD fQca_PFAL_UpperHeapLEPrivacyMem					(Fixed 2 Bytes)	(Decimal)	"LE Privacy Memory Consumed"
			FIELD fQca_PFAL_UpperHeapLEISOGroupMem					(Fixed 2 Bytes)	(Decimal)	"LE ISO Groups Memory Consumed"
			RESERVED												(Fixed 2 Bytes)
		}
		
		FIELD fQca_PFAL_UpperHeapAudioPoolsMem						(Fixed 4 Bytes)	(Decimal)	"Audio Pools Memory Consumed"
		FIELD fQca_PFAL_UpperHeapFreeMem							(Fixed 4 Bytes)	(Decimal)	"Free Memory Remaining"
	}
	
	GROUP gQca_PFAL_LowerHeapMemStats "Lower Heap Memory Stats"
	{
		GROUP gQca_PFAL_LowerHeapStaticPoolMem "Static Pools Stats"
		{
			FIELD fQca_PFAL_LowerHeapStaticPoolTotalMem				(Fixed 4 Bytes)	(Decimal)	"Total Static Pool Memory Consumed"
			FIELD fQca_PFAL_LowerHeapDbgLogPoolsMem					(Fixed 4 Bytes)	(Decimal)	"Debug Log Pools Memory Consumed"
			FIELD fQca_PFAL_LowerHeapHCIPoolsMem					(Fixed 4 Bytes)	(Decimal)	"HCI Data Pools Memory Consumed"
			FIELD fQca_PFAL_LowerHeapLMPPoolsMem					(Fixed 4 Bytes)	(Decimal)	"LMP Pools Memory Consumed"
			FIELD fQca_PFAL_LowerHeapA2dpSinkPoolMem				(Fixed 4 Bytes)	(Decimal)	"A2DP Sink Media Pool Memory Consumed"
		}
		
		GROUP gQca_PFAL_LowerHeapGenericPoolMem "Generic Pools Stats"
		{
			FIELD fQca_PFAL_LowerHeapGenericPoolTotalMem			(Fixed 4 Bytes)	(Decimal)	"Total Generic Pool Memory Consumed"
		}
		
		GROUP gQca_PFAL_LowerHeapDirectAllocMem "Direct Memory Allocation Stats"
		{
			FIELD fQca_PFAL_LowerHeapDbgUartRingBufMem				(Fixed 2 Bytes)	(Decimal)	"UART Debug Ringbuffer Memory Consumed"
			RESERVED												(Fixed 2 Bytes)
		}
		
		FIELD fQca_PFAL_LowerHeapAudioPoolsMem						(Fixed 4 Bytes)	(Decimal)	"Audio Pools Memory Consumed"
		FIELD fQca_PFAL_LowerHeapFreeMem							(Fixed 4 Bytes)	(Decimal)	"Free Memory Remaining"
	}
	
	FIELD fQca_PFAL_MemRequested									(Fixed 4 Bytes)	(Decimal)	"Number of Bytes of Memory Requested"
	FIELD fQca_PFAL_RetAddr											(Fixed 4 Bytes)	(Hex)		"Return Address"
}

GROUP gQCA_PFAL_Dynamic_Logging_Config "Dynamic Logging Config"
{
    FIELD fQca_SLC_Dynamic_Log_Enable  (Fixed 1 bits) (Binary)  "SLC Dynamic Log Enabled"
    FIELD fQca_Audio_Dump_Log_Enable  (Fixed 1 bits) (Binary)   "Audio Dump Log Enabled"
    FIELD fQca_Calc_Rom_CRC         (Fixed 1 bits) (Binary)     SUPPRESS_DETAIL
    FIELD fQca_TXP_Assert_Fatal     (Fixed 1 bits) (Binary)     SUPPRESS_DETAIL
    FIELD fQca_Is_Expect_Fatal      (Fixed 1 bits) (Binary)     SUPPRESS_DETAIL
    FIELD fQca_Dynamic_Log_Enable   (Fixed 1 bits) (Binary)     "Dynamic Log Enabled"
    FIELD fQca_Overwrite_Prev_Logs  (Fixed 1 bits) (Binary)     SUPPRESS_DETAIL
    FIELD fQca_Enhanced_Log_Enable  (Fixed 1 bits) (Binary)     "Enhanced Log Enabled"
    FIELD fQca_Enhanced_Log_Flags  (Fixed 1 Bytes) (Binary)     SUPPRESS_DETAIL
}