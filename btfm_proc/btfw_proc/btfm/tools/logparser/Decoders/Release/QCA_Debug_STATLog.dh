{
    FIELD fQca_Sniffhandle                  (Fixed 1 Byte)      (Hex)           "Handle"
    RESERVED                                (Fixed 1 Byte)
    RESERVED                                (Fixed 1 Byte)
    RESERVED                                (Fixed 1 Byte)
