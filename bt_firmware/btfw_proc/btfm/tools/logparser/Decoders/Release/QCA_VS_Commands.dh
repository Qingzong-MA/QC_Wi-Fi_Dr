}

GROUP gBQRCmd_Action_Clear "CLEAR"
{
    GROUP gBQRCmd_Mask;
}

GROUP gBQRCmd_Mask "ReportMask"
{
/*   FIELD fReportMask       (Fixed 4 byte) (Hex)                       "ReportMask"*/

    /*report mask from MSB to LSB */
