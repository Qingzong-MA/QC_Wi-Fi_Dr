    <TAG Number="44" Name="Voice Options">
      <DESCRIPTION>Contains options and tuning parameters that affect the voice path (both NBS and WBS).</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="Voice" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Options" Type="STRUCTURE" Size="66">
        <ELEMENTS Name="NBS Settings" Type="STRUCTURE" Size="28">
          <ELEMENTS Name="ToAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x1F4" Signed="false" Description="The max ToAir ISR execution time at 64MHz, in usec, including all possible preemption." />
          <ELEMENTS Name="FromAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x834" Signed="false" Description="The max FromAir ISR execution time at 64MHz, in usec, including all possible preemption (including ToAir ISR)." />
          <ELEMENTS Name="PCM Clock Divisor" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x5000" Signed="false" Description="Defines the clock rate divisor to use as a PCM Master in NBS mode.  Divisor = 320000 * f(BCLK)/32 MHz, where f(BCLK) is the desired BCLK frequency.  Default = 0x5000, or 2.048MHz BCLK." />
          <ELEMENTS Name="PCM Frame Divisor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFF" Signed="false" Description="Defines the frame rate divisor to use as a PCM Master in NBS mode.  Divisor = (f(BCLK)/8kHz) - 1, where f(BCLK) is the BCLK frequency.  Default = 0xFF, for use with f(BCLK)=2.048MHz." />
          <ELEMENTS Name="PCM Control" Type="BITFIELD" Size="1">
            <ELEMENTS Name="Reserved0" Default="0x0" Start="0" End="0" Description="Reserved, set to 0." />
            <ELEMENTS Name="Frame Sync Type" Default="0x0" Start="1" End="3" Description="Defines the PCM Frame Sync format.  000=Short LF, 001=Short FR, 010=Short FF, 011=Long, 100=I2S.  Default=000." />
            <ELEMENTS Name="PCM Role" Default="0x1" Start="4" End="4" Description="Define the role on the PCM bus.  0=Master, 1=Slave.  Default=1." />
            <ELEMENTS Name="Reserved1" Default="0x0" Start="5" End="5" Description="Reserved, set to 0." />
            <ELEMENTS Name="Invert BCLK" Default="0x0" Start="6" End="6" Description="Set this to invert the logic of BCLK.  1=Invert, 0=Normal.  Default=0." />
          </ELEMENTS>
          <ELEMENTS Name="CVSD Dither" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x2" Signed="false" Description="Defines the level of HW dithering to apply to the CVSD encoder for NBS.  Used to mask a sawtooth artifact that can otherwise occur when encoding silence.  Default=2." />
          <ELEMENTS Name="Flags" Type="BITFIELD" Size="1">
            <ELEMENTS Name="ARM_CVSD_HPF" Default="0x0" Start="0" End="0" Description="Enables a high-pass filter on encoder input data when using the ARM CVSD codec.  Has a small negative impact on performance." />
            <ELEMENTS Name="ARM_CVSD_PREQUANT" Default="0x0" Start="1" End="1" Description="Enables prequantization of samples after interpolation and before encoding when using the ARM CVSD codec.  Has a large negative impact on performance." />
          </ELEMENTS>
          <ELEMENTS Name="Dummy1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy2" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy3" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy4" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy5" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="PLC Pattern Length" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x28" Signed="false" Description="For NBS PLC, defines a pattern length to match with historical data in order to find a suitable replacement for the lost packet.  Should be scaled with History Length value (history length default=160) in order to avoid degrading PLC.  Default=40." />
          <ELEMENTS Name="PLC History Length" Type="INTEGER" Size="1" Min="0x0" Max="0xA0" Default="0xA0" Signed="false" Description="For NBS PLC, defines length of history buffer.  Reducing history length degrades PLC while offering MIPs gains.  Default=160. Max=160." />
          <ELEMENTS Name="PLC Linear Scale Decay" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x62" Signed="false" Description="For NBS PLC, the integer scalar used to force linear decay if we incur continuous packet loss. Default=98." />
          <ELEMENTS Name="PLC Linear Scale Decay Start Count" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x3" Signed="false" Description="For NBS PLC, linear scale decay begins at start count + 1 consecutive lost packets.  Default=3." />
          <ELEMENTS Name="PLC Linear Scale Decay Give Up Count" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x64" Signed="false" Description="For NBS PLC, the number of consecutive lost packets before we disable PLC and wait for a good packet.  Default=100." />
          <ELEMENTS Name="PLC History Decimation" Type="INTEGER" Size="1" Min="0x1" Max="0x4" Default="0x1" Signed="false" Description="For NBS PLC, determines decimation of history samples.  For example, a value of 2 attempts to pattern match every other sample in history.  A higher number degrades PLC, but saves MIPs.  Default=1." />
          <ELEMENTS Name="PLC Pattern Decimation" Type="INTEGER" Size="1" Min="0x1" Max="0x4" Default="0x1" Signed="false" Description="For NBS PLC, determines pattern decimation constant.  For example, a value of 2 causes pattern matching to only match every other sample in the pattern.  A higher value degrades PLC, but saves MIPs. Default=1." />
          <ELEMENTS Name="PLC Weak Bits Max" Type="INTEGER" Size="1" Min="0x0" Max="0x64" Default="0xA" Signed="false" Description="For NBS PLC, in the case of multiple eSCO packets that are combined in a weighted vote, this parameter defines the maximum number of &quot;weak&quot; bits that allow the packet data to be consumed, rather than replaced with PLC data.  Expressed as a percentage of the xSCO packet bit size.  Default=10." />
          <ELEMENTS Name="Dummy6" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Interpolation_Size" Type="INTEGER" Size="2" Min="0x1" Max="0x8000" Default="0x1000" Signed="false" Description="Interpolation size for sample add or drop. The number needs to be power of 2. By setting it to 1, interpolation can be practically turned off." />
          <ELEMENTS Name="Dummy7" Type="INTEGER" Size="2" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
        </ELEMENTS>
        <ELEMENTS Name="WBS Settings" Type="STRUCTURE" Size="20">
          <ELEMENTS Name="ToAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x5DC" Signed="false" Description="The max ToAir ISR execution time at 64MHz, in usec, including all possible preemption." />
          <ELEMENTS Name="FromAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0xA28" Signed="false" Description="The max FromAir ISR execution time at 64MHz, in usec, including all possible preemption (including ToAir ISR)." />
          <ELEMENTS Name="PCM Clock Divisor" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0xA000" Signed="false" Description="Defines the clock rate divisor to use as a PCM Master in WBS mode.  Divisor = 320000 * f(BCLK)/32 MHz, where f(BCLK) is the desired BCLK frequency.  Default = 0xA000, or 4.096MHz BCLK." />
          <ELEMENTS Name="PCM Frame Divisor" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0xFF" Signed="false" Description="Defines the frame rate divisor to use as a PCM Master in WBS mode.  Divisor = (f(BCLK)/8kHz) - 1, where f(BCLK) is the BCLK frequency.  Default = 0xFF, for use with f(BCLK)=2.048MHz." />
          <ELEMENTS Name="PCM Control" Type="BITFIELD" Size="1">
            <ELEMENTS Name="Reserved0" Default="0x0" Start="0" End="0" Description="Reserved, set to 0." />
            <ELEMENTS Name="Frame Sync Type" Default="0x0" Start="1" End="3" Description="Defines the PCM Frame Sync format.  000=Short LF, 001=Short FR, 010=Short FF, 011=Long, 100=I2S.  Default=000." />
            <ELEMENTS Name="PCM Role" Default="0x1" Start="4" End="4" Description="Define the role on the PCM bus.  0=Master, 1=Slave.  Default=1." />
            <ELEMENTS Name="Reserved1" Default="0x0" Start="5" End="5" Description="Reserved, set to 0." />
            <ELEMENTS Name="Invert BCLK" Default="0x0" Start="6" End="6" Description="Set this to invert the logic of BCLK.  1=Invert, 0=Normal.  Default=0." />
          </ELEMENTS>
          <ELEMENTS Name="Dummy0" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy1" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy2" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy3" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy4" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Dummy5" Type="INTEGER" Size="1" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
          <ELEMENTS Name="Max Checksum Trial" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x3" Signed="false" Description="If the decoding process fails due to checksum error, we flip weak bits, which are derived from erroneous data processing, trying to pass the checksum.  This variable defines the maximum number of trials to flip weak bits." />
          <ELEMENTS Name="PCM Codec" Type="ENUM" Size="1" Default="0x0" Signed="false">
            <ELEMENTS Name="No Codec" Default="0x0" Description="" />
            <ELEMENTS Name="AD74111" Default="0x1" Description="" />
          </ELEMENTS>
          <ELEMENTS Name="Interpolation_Size" Type="INTEGER" Size="2" Min="0x1" Max="0x8000" Default="0x1000" Signed="false" Description="Interpolation size for sample add or drop. The number needs to be power of 2. By setting it to 1, interpolation can be practically turned off." />
          <ELEMENTS Name="Dummy7" Type="INTEGER" Size="2" Min="0x0" Max="0x0" Default="0x0" Signed="false" Description="Dummy byte added for padding/alignment." />
        </ELEMENTS>
        <ELEMENTS Name="Transparent Settings" Type="STRUCTURE" Size="4">
          <ELEMENTS Name="ToAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x190" Signed="false" Description="The max ToAir ISR execution time at 64MHz, in usec, including all possible preemption." />
          <ELEMENTS Name="FromAir Max ISR Time" Type="INTEGER" Size="2" Min="0x0" Max="0xFFFF" Default="0x258" Signed="false" Description="The max FromAir ISR execution time at 64MHz, in usec, including all possible preemption (including ToAir ISR)." />
        </ELEMENTS>
        <ELEMENTS Name="Flags" Type="BITFIELD" Size="1">
          <ELEMENTS Name="EDP Vote Enable" Default="0x1" Start="0" End="0" Description="Enables bitwise majority voting as part of Rx Erroneous Data Processing.  Disabling will eliminate some CPU-intensive processing, at the cost of quality.  Default=1." />
          <ELEMENTS Name="NBS PLC Enable" Default="0x1" Start="1" End="1" Description="Enables NBS Packet Loss Concealment. Default=1." />
          <ELEMENTS Name="NBS PLC Replace Single eSCO CRC Failure" Default="0x1" Start="2" End="2" Description="If NBS PLC is enabled, this flag controls the handling of an eSCO window in which a single eSCO packet is received with a CRC failure (and all other sSCO packets were lost).  If set to 1, then such a packet is discarded in favor of PLC.  If set to 0, then such a packet is consumed as voice data.  Default=1." />
          <ELEMENTS Name="WBS PLC Enable" Default="0x1" Start="3" End="3" Description="Enables WBS Packet Loss Concealment. Default=1." />
          <ELEMENTS Name="Use MSBC For Transp Voice_Setting" Default="0x1" Start="4" End="4" Description="If set, translates a legacy HCI Voice_Setting parameter of &quot;Transparent Data&quot; to &quot;mSBC&quot; instead, to force controller-based encoding/decoding of mSBC (WBS) voice data.  If clear, a legacy Voice_Setting parameter of &quot;Transparent Data&quot; will be treated as transparent which will disable controller-based encoding/decoding." />
          <ELEMENTS Name="Use MSBC For Transp Coding_Format" Default="0x0" Start="5" End="5" Description="If set, translates an HCI Enhanced Setup (Accept) Synchronous Connection Command Transmit_Coding_Format/Receive_Coding_Format parameter of &quot;Transparent&quot; to &quot;mSBC&quot; instead.  If clear, the Transmit_Coding_Format/Receive_Coding_Format parameter will be treated as transparent which will disable controller-based encoding/decoding." />
          <ELEMENTS Name="NBS Sample Doubling Enable" Default="0x0" Start="6" End="6" Description="If set, then the 16 kHz WBS sample rate is applied to NBS streams over the ACI transport. NBS samples are doubled with the expectation that the receiving side will only process every other sample." />
          <ELEMENTS Name="eSCO RTSC Enable" Default="0x0" Start="7" End="7" Description="Enables RTSC (HW Based EDP) for eSCO packets.  Default=0." />
        </ELEMENTS>
        <ELEMENTS Name="Max ACI Slots" Type="INTEGER" Size="1" Min="0x1" Max="0x3" Default="0x1" Signed="false" Description="Maximum number of ACI slots in use on a given ACI-driven audio bus.  Multislot PCM requires a value greater than 1.  Default=1." />
        <ELEMENTS Name="Max EDP Noncorrelating Bits Percent" Type="INTEGER" Size="1" Min="0x0" Max="0x64" Default="0xA" Signed="false" Description="Defines the max percentage of non-correlating bits that will still allow an Rx packet to be used in the 3-way vote during Erroneous Data Processing.  If a given packet differs by more than this percentage of bits when XORed with each of the other two packets, then it is discarded and a 2-way voting algorithm is used instead.  Set to 0 to ignore packet correlation which will allow all 3 Rx packets to be used in the vote.  Default=10." />
        <ELEMENTS Name="Max Voice" Type="INTEGER" Size="1" Min="0x1" Max="0x3" Default="0x1" Signed="false" Description="Maximum number of concurrent voice transports.  Note that two TWS+ voice baseband connections use a single voice transport." />
        <ELEMENTS Name="Path" Type="STRUCTURE" Size="6">
          <ELEMENTS Name="ToAir" Type="FIXED_ARRAY" ElementSize="1" Size="3" Min="0x0" Max="0xFF" Signed="false" Description="ToAir Path" VariableName="ToAir">
            <ELEMENTS Name="ToAir0" Default="0x1" Description="Default ToAir Path ID 0.  This is the highest priority path ID and will always be used first unless already in-use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=1." />
            <ELEMENTS Name="ToAir1" Default="0x2" Description="Default ToAir Path ID 1.  This is the second-highest priority path ID and will be used if ToAir0 is already in use, and ToAir1 is not in use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=2." />
            <ELEMENTS Name="ToAir2" Default="0x3" Description="Default ToAir Path ID 2.  This is the third-highest priority path ID and will be used if ToAir0 and ToAir1 are already in use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=3." />
          </ELEMENTS>
          <ELEMENTS Name="FromAir" Type="FIXED_ARRAY" ElementSize="1" Size="3" Min="0x0" Max="0xFF" Signed="false" Description="FromAir Path" VariableName="FromAir">
            <ELEMENTS Name="FromAir0" Default="0x1" Description="Default FromAir Path ID 0.  This is the highest priority path ID and will always be used first unless already in-use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=1." />
            <ELEMENTS Name="FromAir1" Default="0x2" Description="Default FromAir Path ID 1.  This is the second-highest priority path ID and will be used if FromAir0 is already in use, and FromAir1 is not in use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=2." />
            <ELEMENTS Name="FromAir2" Default="0x3" Description="Default FromAir Path ID 2.  This is the third-highest priority path ID and will be used if FromAir0 and FromAir1 are already in use.  The use of this NVM value may be overridden by using the Enhanced Setup Sync Connection or Enhanced Accept Sync Connection HCI commands.  0=HCI, 1=ACI0_SLOT0, 2=ACI0_SLOT1, 3=ACI0_SLOT2, 4=ACI1_SLOT0, 5=ACI1_SLOT1, 6=ACI1_SLOT2, 7=ACI2_SLOT0, 8=ACI2_SLOT1, 9=ACI2_SLOT2, 0xA=AUP0, 0xB=AUP1, 0xC=AUP2, 0xFC=Relay, 0xFE=Disabled, 0xFF=Test.  Default=3." />
          </ELEMENTS>
        </ELEMENTS>
        <ELEMENTS Name="Flags Ext" Type="BITFIELD" Size="1">
          <ELEMENTS Name="Prefill Nontransparent ToAir Data" Default="0x0" Start="0" End="0" Description="For non-transparent ToAir data, enables prefilling of the encoding buffer with a default pattern that will get transmitted OTA if the ToAir ISR does not complete its encoding in time.  This relaxes the deadline for encoding in the ToAir ISR:  the SLC will configure the LC HW with the address and length of this stuff pattern buffer, then the ToAir ISR can continue to run to complete its encoding of real data which will overwrite this default stuff pattern in the same buffer.  If the encoding doesn't complete before the LC HW starts transmitting OTA, then this stuff pattern will get transmitted instead.  Note that this runs the risk of transmitting different data in retransmission slots. Default=0." />
          <ELEMENTS Name="LE ISO RTSC Enable" Default="0x0" Start="1" End="1" Description="Enables RTSC (HW Based EDP) for LE ISO packets." />
          <ELEMENTS Name="Hard Clash Detection" Default="0x1" Start="2" End="2" Description="Uses a hard clash detection to select when to reject eSCO parameters with RESERVED_SLOT_VIOLATION or POSSIBLE_BUT_NOT_PREFERRED" />
          <ELEMENTS Name="Peer eSCO Accept Option" Default="0x1" Start="3" End="3" Description="When set will accept non hard clashing peer eSCO parameters rather than downgrade eSCO by selecting a new combination. Only applicable if &quot;Hard Clash Detection&quot; bit is set to 1." />
          <ELEMENTS Name="T_18_ESCO_SUPPORT" Default="0x1" Start="4" End="4" Description="Enables support for T=18 eSCO" />
          <ELEMENTS Name="ForceVoicePath" Default="0x0" Start="5" End="5" Description="When forceNvmPath=1, ignore  enhanceSCO.data_path=1~0xFE, which means vsc, when enhancesco_data_path is 0 or 0xff, follow btspec." />
          <ELEMENTS Name="48Khz Frame Sync Enable" Default="0x0" Start="6" End="6" Description="If set, then the 48KHz sample rate is applied to NBS and WBS streams over the ACI transport." />
        </ELEMENTS>
        <ELEMENTS Name="WBM routing" Type="ENUM" Size="1" Default="0x1" Signed="false">
          <ELEMENTS Name="Disable" Default="0x0" Description="Disable WBM routing" />
          <ELEMENTS Name="Enable" Default="0x1" Description="Enable WBM routing" />
        </ELEMENTS>
        <ELEMENTS Name="ToAir Extra Sample Count" Type="INTEGER" Size="1" Min="0x0" Max="0xFF" Default="0x3" Signed="false" Description="There is a possibility that MIC ISR is interrupted by LC after encoding is done. In such case, it needs more size to buffer the samples. One way to solve this issue is increasing MIC ISR max execution time. But it causes more latency. The better way is add extra samples." />
        <ELEMENTS Name="COP_VER" Type="BITFIELD" Size="1">
          <ELEMENTS Name="FEEDBACK_CHANNEL" Default="0x1" Start="0" End="3" Description="Version of COP for the feedback channel to LPASS." />
          <ELEMENTS Name="SOURCE_CHANNEL" Default="0x0" Start="4" End="7" Description="Version of COP for the packets coming from LPASS." />
        </ELEMENTS>
      </ELEMENTS>
    </TAG>
    <TAG Number="46" Name="Default Voice Settings">
      <DESCRIPTION>This defines the default voice settings to use when initiating SCO connections. The parameters entered here have a lower priority than any settings written via the HCI Write_Voice_Settings command.</DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="Voice" PlatformSpecific="false" Platforms="Default" Features="" />
      <ELEMENTS Name="Default Settings" Type="BITFIELD" Size="2">
        <ELEMENTS Name="Air Format" Default="0x0" Start="0" End="1" Description="Bits0_1: Air Format (0=CVSD, 1=u-law,2=A-law)" />
        <ELEMENTS Name="Linear PCM MSB" Default="0x0" Start="2" End="4" Description="Bits2_4: Linear PCM MSB (0=MSB is bit 15, 1=MSB is bit 14 etc.)" />
        <ELEMENTS Name="Linear size" Default="0x1" Start="5" End="5" Description="Bit5: Linear size (0=8-bit, 1=16-bit)" />
        <ELEMENTS Name="Input Sign Format" Default="0x1" Start="6" End="7" Description="Bits6_7: Input Sign Format (0=1's comp, 1=2's comp, 2=signed magnitude, 3=CVSD (SiW Vendor Specific)" />
        <ELEMENTS Name="Input Format" Default="0x0" Start="8" End="9" Description="Bits8_9: Input Format (0=Linear, 1=u-law,2=A-law)" />
        <ELEMENTS Name="Audio SCO routing" Default="0x0" Start="10" End="10" Description="Bit 10: Create audio routing automatically on SCO link creation for Hydra architecture (1 - BTSS creates routing; 0 - do not create routing, another subsystem is expected to do this)" />
        <ELEMENTS Name="Undefined" Default="0x0" Start="11" End="15" Description="Bits11_15: Undefined" />
      </ELEMENTS>
    </TAG>
    <TAG Number="55" Name="GPIO Mapping">
      <DESCRIPTION></DESCRIPTION>
      <TAG_ATTRIBUTES Version="0" GenerateSource="true" Internal="false" Dynamic="false" TagGroups="SYS" PlatformSpecific="false" Platforms="Default" Features="" />
