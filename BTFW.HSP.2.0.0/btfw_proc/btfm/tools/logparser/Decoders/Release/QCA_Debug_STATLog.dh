    FIELD fQca_lmpVesion_ext          (Fixed 1 Byte)     (Hex)            "lmp version"
    FIELD fQca_attribute0_ext         (Fixed 1 Byte)     (Hex)            "Attribute0"
    FIELD fQca_attribute1_ext         (Fixed 1 Byte)     (Hex)            "Attribute1"
