            FIELD fQca_isoalFlushed                         (Fixed 2 Bytes)         (Decimal)                                 "Flushed"
            FIELD fQca_isoalGetSdu                          (Fixed 2 Bytes)         (Decimal)                                 "Get SDU"
            FIELD fQca_isoalPutSdu                          (Fixed 2 Bytes)         (Decimal)                                 "Put SDU"
            FIELD fQca_isoalSduNoBuf                        (Fixed 2 Bytes)         (Decimal)                                 "SDU No Buffer"

            FIELD fQca_isoalIcbAlloc                        (Fixed 2 Bytes)         (Decimal)                                 "ICB Alloc"
            FIELD fQca_isoalIcbUsed                         (Fixed 2 Bytes)         (Decimal)                                 "ICB Used"
            FIELD fQca_isoalIcbNotUsed                      (Fixed 2 Bytes)         (Decimal)                                 "ICB Not Used"
            FIELD fQca_isoalFreeIcbAtStop                   (Fixed 2 Bytes)         (Decimal)                                 "ICB Freed At Stop"
            FIELD fQca_isoalTxSkipPrepare                   (Fixed 2 Bytes)         (Decimal)                                 "Skip Prepare"
            FIELD fQca_isoalTxSduNoBufAsDepth               (Fixed 2 Bytes)         (Decimal)                                 "SDU No Buf AsDepth"

            FIELD fQca_isoalToHostNoBuf                     (Fixed 2 Bytes)         (Decimal)                                 "Loop No Buffer"
            FIELD fQca_isoalToHostSkipRetx                  (Fixed 2 Bytes)         (Decimal)                                 "Loop Skip Retransmission"
            FIELD fQca_isoalToHostCnt                       (Fixed 2 Bytes)         (Decimal)                                 "Loop Count"
        }                                                   
        GROUP gQca_LLM_IsoalRx "RX"                   
        {
