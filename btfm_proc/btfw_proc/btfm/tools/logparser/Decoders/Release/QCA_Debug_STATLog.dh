    FIELD fQca_STAT_bgdAuxSchedCnt  (Fixed 2 Bytes)   (Decimal)   "Bgd Adv Ext Ind with Aux Ptr Count"
    FIELD fQca_STAT_filterOutCnt    (Fixed 4 Bytes)   (Decimal)   "APCF Filter Out Count"
    FIELD fQca_STAT_ScanAbortCount  (Fixed 2 Bytes)   (Decimal)   "Scan Abort Count"
    FIELD fQca_STAT_ScanReqCmdLateCount    (Fixed 1 Byte)   (Decimal)    "Scan Req Cmd Late Count"
    FIELD fQca_STAT_ConnReqCmdLateCount    (Fixed 1 Byte)   (Decimal)    "Conn Req Cmd Late Count"
    FIELD fQca_STAT_ConsumedWindow         (Fixed 4 Bytes) RETRIEVE(MultiplyInteger 5) ALSO (DivideInteger 16)  (Decimal) ALSO (Constant "ms")  "Consumed Window"
    FIELD fQca_STAT_OffloadConsumedWindow  (Fixed 4 Bytes) RETRIEVE(MultiplyInteger 5) ALSO (DivideInteger 16)  (Decimal) ALSO (Constant "ms")  "Offload Consumed Window"
    FIELD fQca_STAT_ScanReqTxHighPrioCnt   (Fixed 2 Byte)   (Decimal)       "High Prio SCAN REQ TX Counts"
    FIELD fQca_STAT_ThresholdToTriggerADVIndGPM     (Fixed 2 Byte)   (Decimal)       "Threshold to trigger ADBV IND GPM"
    FIELD fQca_STAT_ADVIndGPMLastClk                (Fixed 4 Bytes)   (Hex)          "LastADVIndGPMSentClk"
    FIELD fQca_STAT_DecisionIndRxCnt        (Fixed 4 Bytes) (Decimal)   "Adv Decision Ind Rx Count"
    FIELD fQca_STAT_DecisionIndFilterOutCnt    (Fixed 4 Bytes) (Decimal)   "Adv Decision Ind Filter Out Count"

    FIELD fQca_STAT_spenAdvRxCnt            (Fixed 2 Byte)   PRINT_IF (FieldIs NotEqualTo 0) (Decimal)       "Spen Adv Rx Count"
    FIELD fQca_STAT_gsWatchAdvRspCnt        (Fixed 2 Byte)   PRINT_IF (FieldIs NotEqualTo 0) (Decimal)       "GS Watch Adv&ScanRsp Rx Count"
    FIELD fQca_STAT_paramErrDropCnt         (Fixed 2 Byte)   (Decimal)       "ADV Param Err Drop Count"
}

