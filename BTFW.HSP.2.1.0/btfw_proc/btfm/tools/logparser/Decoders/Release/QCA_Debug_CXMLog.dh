 * CXM log main table
************************************************/
TABLE tQca_CXMLogID APPENDS_ONLY tQca_EnhLogID
    {0x0400 "LOG_ID_CXM_MCI_INT_RAW"                "LOG_ID_CXM_MCI_INT_RAW"                0 gQca_CXM_MciIntRaw}
    {0x0410 "LOG_ID_CXM_MCI_RX"                     "LOG_ID_CXM_MCI_RX"                     0 gQca_CXM_MciMsg}
    {0x0420 "LOG_ID_CXM_MCI_TX"                     "LOG_ID_CXM_MCI_TX"                     0 gQca_CXM_MciMsg}
    {0x0430 "LOG_ID_CXM_MWS_INT_RAW"                "LOG_ID_CXM_MWS_INT_RAW"                0 gQca_CXM_MwsIntRaw}
    {0x0440 "LOG_ID_CXM_MWS_RX"                     "LOG_ID_CXM_MWS_RX"                     0 gQca_CXM_MwsMsg}
    {0x0450 "LOG_ID_CXM_MWS_TX"                     "LOG_ID_CXM_MWS_TX"                     0 gQca_CXM_MwsMsg}
    {0x0460 "LOG_ID_CXM_MCI_STATS"                  "LOG_ID_CXM_MCI_STATS"                  0 gQca_CXM_MciStats}
    {0x04E0 "LOG_ID_CXM_INFO_MCI_SERVER"            "LOG_ID_CXM_INFO_MCI_SERVER"            0 gQca_CXM_Info}
