    FIELD fQca_STAT_AsdStats_dsrAllocRssi   (Fixed 4 Bytes) (Decimal)           "Desired AllocRssi"
    FIELD fQca_STAT_AsdStats_dsrAllocRssit    (Fixed 0 Byte) RETRIEVE (MultiplyFieldByInteger fQca_STAT_AsdStats_dsrAllocRssi 100)(Decimal) SUPPRESS_DETAIL
