    FIELD fQca_LETxPhyCODED_500K_ULM        (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts CODED_500K"
    FIELD fQca_LETxPhyCODED_SIMUL_ULM       (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts CODED_SIMUL"
    FIELD fQca_LETxPhyLEHS_2P_ULM           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts LEHS 2P"
    FIELD fQca_LETxPhyLEHS_3P_ULM           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts LEHS 3P"
    FIELD fQca_LETxPhyLEHS_4P_ULM           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts LEHS 4P"
    FIELD fQca_LETxPhyLEHS_5P_ULM           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts LEHS 5P"
    FIELD fQca_LETxPhyLEHS_6P_ULM           (Fixed 2 Bytes)  PRINT_IF (FieldIs NotEqualTo 0)    (Decimal)   "Tx Counts LEHS 6P"
}

